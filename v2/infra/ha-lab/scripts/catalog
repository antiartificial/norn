#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"
command_name="${1:-status}"
lab_name="$(terraform -chdir="${lab_root}/terraform" output -raw name_prefix)"
"${script_dir}/secrets" ensure "${lab_name}" >/dev/null
secret_file="$(${script_dir}/secrets path "${lab_name}")"
set -a
# shellcheck disable=SC1090
source "${secret_file}"
set +a

repo="antiartificial/norn-ha-toy"
catalog_dir="${lab_root}/.tools/catalog/norn-ha-toy"

case "${command_name}" in
  sync)
    if [[ ! -f "${NORN_HA_GIT_DEPLOY_KEY_PATH}" ]]; then
      ssh-keygen -q -t ed25519 -N '' -C "${lab_name} read-only deploy" -f "${NORN_HA_GIT_DEPLOY_KEY_PATH}"
      chmod 0600 "${NORN_HA_GIT_DEPLOY_KEY_PATH}"
      chmod 0644 "${NORN_HA_GIT_DEPLOY_KEY_PATH}.pub"
    fi
    if ! gh repo view "${repo}" >/dev/null 2>&1; then
      gh repo create "${repo}" --private --description "Disposable Norn HA production-admission pilot" --disable-issues --disable-wiki
    fi
    # Reconcile the deploy key by its ACTUAL value, not just the title. When a lab
    # name is reused after the local key was regenerated (e.g. by `lab reset-local`),
    # a stale same-titled key from a prior run otherwise lingers on the repo and the
    # new key never gets registered — norn then fails to clone with "Permission
    # denied (publickey)" and silently falls back to a source-less local copy.
    want_key="$(awk '{print $2}' "${NORN_HA_GIT_DEPLOY_KEY_PATH}.pub")"
    registered_keys="$(gh repo deploy-key list -R "${repo}" --json id,key,title 2>/dev/null || echo '[]')"
    if ! printf '%s' "${registered_keys}" | jq -e --arg k "${want_key}" 'any(.[]; .key | contains($k))' >/dev/null 2>&1; then
      # our current key isn't registered: drop any stale key with our title, then add it
      printf '%s' "${registered_keys}" | jq -r --arg t "${lab_name} read-only deploy" '.[] | select(.title==$t) | .id' | while read -r stale_id; do
        [[ -n "${stale_id}" ]] && gh repo deploy-key delete "${stale_id}" -R "${repo}" >/dev/null 2>&1 || true
      done
      gh repo deploy-key add "${NORN_HA_GIT_DEPLOY_KEY_PATH}.pub" -R "${repo}" --title "${lab_name} read-only deploy"
    fi
    install -d -m 0700 "${catalog_dir}"
    if [[ ! -d "${catalog_dir}/.git" ]]; then
      git -C "${catalog_dir}" init -b main >/dev/null
      git -C "${catalog_dir}" remote add origin "https://github.com/${repo}.git"
    fi
    # Base on the remote's current main so the push fast-forwards even when a
    # prior run (or another operator) already pushed to this catalog repo. A
    # freshly init'd local repo shares no history with a non-empty remote, so
    # without this the push is rejected as a non-fast-forward.
    if git -C "${catalog_dir}" fetch -q origin main 2>/dev/null; then
      git -C "${catalog_dir}" reset -q --soft FETCH_HEAD
    fi
    rsync -a --delete --exclude .git "${lab_root}/toy-app/" "${catalog_dir}/"
    git -C "${catalog_dir}" add --all
    if ! git -C "${catalog_dir}" diff --cached --quiet; then
      git -C "${catalog_dir}" -c user.name='Norn HA Lab' -c user.email='norn-ha-lab@users.noreply.github.com' commit -m 'Update HA toy service' >/dev/null
      git -C "${catalog_dir}" push -u origin main >/dev/null
    fi
    if [[ ! -f "${NORN_HA_AGE_KEY_PATH}" ]]; then
      age-keygen -o "${NORN_HA_AGE_KEY_PATH}" >/dev/null
      chmod 0600 "${NORN_HA_AGE_KEY_PATH}"
    fi
    recipient="$(age-keygen -y "${NORN_HA_AGE_KEY_PATH}")"
    if grep -q '^NORN_HA_AGE_RECIPIENT=' "${secret_file}"; then
      sed -i '' "s|^NORN_HA_AGE_RECIPIENT=.*$|NORN_HA_AGE_RECIPIENT=${recipient}|" "${secret_file}"
    else
      printf 'NORN_HA_AGE_RECIPIENT=%s\n' "${recipient}" >>"${secret_file}"
    fi
    export NORN_HA_AGE_RECIPIENT="${recipient}"
    # If the fleet was provisioned with a managed database (use_managed_db), point the app at its
    # private DSN; otherwise use the co-located Patroni endpoint reached through the Linux bridge
    # gateway (Nomad's Docker bridge cannot use the container loopback address).
    managed_uri="$(terraform -chdir="${lab_root}/terraform" output -raw managed_db_uri 2>/dev/null || true)"
    if [[ -n "${managed_uri}" ]]; then
      database_url="${managed_uri}"
    else
      database_url="postgres://norn_test:${NORN_HA_NORN_DB_PASSWORD}@172.17.0.1:6432/norn_test?sslmode=require"
    fi
    printf 'DATABASE_URL: %s\n' "${database_url}" | sops --config /dev/null --encrypt --input-type yaml --output-type yaml --age "${recipient}" /dev/stdin >"${NORN_HA_TOY_SECRETS_PATH}"
    chmod 0600 "${NORN_HA_TOY_SECRETS_PATH}"
    git -C "${catalog_dir}" rev-parse HEAD
    ;;
  durability-sync)
    image="${2:-}"
    endpoint="${3:-}"
    [[ "${image}" =~ ^registry\.digitalocean\.com/antiartificial/norn-durability-pilot@sha256:[a-f0-9]{64}$ ]] || {
      echo "usage: catalog durability-sync registry.digitalocean.com/antiartificial/norn-durability-pilot@sha256:<64-hex> https://HOST" >&2
      exit 2
    }
    [[ "${endpoint}" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] && [[ "${endpoint}" != *.invalid ]] || {
      echo "durability endpoint must be a concrete HTTPS origin without a path" >&2
      exit 2
    }
    [[ -f "${NORN_HA_AGE_KEY_PATH}" ]] || {
      echo "missing age identity; run catalog sync once before enabling the durability pilot" >&2
      exit 1
    }
    durability_catalog_dir="${lab_root}/.tools/catalog/norn-durability-pilot"
    install -d -m 0700 "${durability_catalog_dir}"
    if [[ ! -d "${durability_catalog_dir}/.git" ]]; then
      git -C "${durability_catalog_dir}" init -b durability-pilot >/dev/null
      git -C "${durability_catalog_dir}" remote add origin "https://github.com/${repo}.git"
      if git -C "${durability_catalog_dir}" fetch origin durability-pilot >/dev/null 2>&1; then
        git -C "${durability_catalog_dir}" checkout -B durability-pilot FETCH_HEAD >/dev/null
      fi
    fi
    git -C "${durability_catalog_dir}" checkout -B durability-pilot >/dev/null
    rsync -a --delete --exclude .git "${lab_root}/durability-pilot/" "${durability_catalog_dir}/"
    # The checked-in spec is deliberately inert. The controller-only generated
    # copy receives the immutable image before it is committed to the private
    # branch and replicated to all Norn contenders.
    sed -i '' "s|registry.digitalocean.com/antiartificial/norn-durability-pilot@sha256:[a-f0-9]\{64\}|${image}|" "${durability_catalog_dir}/infraspec.yaml"
    sed -i '' "s|https://norn-durability-pilot.invalid|${endpoint}|" "${durability_catalog_dir}/infraspec.yaml"
    git -C "${durability_catalog_dir}" add --all
    if ! git -C "${durability_catalog_dir}" diff --cached --quiet; then
      git -C "${durability_catalog_dir}" -c user.name='Norn HA Lab' -c user.email='norn-ha-lab@users.noreply.github.com' commit -m 'Update durability pilot' >/dev/null
      git -C "${durability_catalog_dir}" push -u origin durability-pilot >/dev/null
    fi
    recipient="$(age-keygen -y "${NORN_HA_AGE_KEY_PATH}")"
    database_url="postgres://norn_durability:${NORN_HA_DURABILITY_DB_PASSWORD}@172.17.0.1:6432/norn_durability?sslmode=require"
    {
      printf 'DATABASE_URL: %s\n' "${database_url}"
      printf 'VALKEY_ADDR: norn-durability-valkey.service.consul:16379\n'
      printf 'KAFKA_BROKERS: norn-durability-redpanda.service.consul:19092\n'
    } | sops --config /dev/null --encrypt --input-type yaml --output-type yaml --age "${recipient}" /dev/stdin >"${NORN_HA_DURABILITY_SECRETS_PATH}"
    chmod 0600 "${NORN_HA_DURABILITY_SECRETS_PATH}"
    cp "${durability_catalog_dir}/infraspec.yaml" "${NORN_HA_DURABILITY_INFRASPEC_PATH}"
    chmod 0600 "${NORN_HA_DURABILITY_INFRASPEC_PATH}"
    if grep -q '^NORN_HA_ENABLE_DURABILITY_PILOT=' "${secret_file}"; then
      sed -i '' 's/^NORN_HA_ENABLE_DURABILITY_PILOT=.*/NORN_HA_ENABLE_DURABILITY_PILOT=true/' "${secret_file}"
    else
      printf 'NORN_HA_ENABLE_DURABILITY_PILOT=true\n' >>"${secret_file}"
    fi
    git -C "${durability_catalog_dir}" rev-parse HEAD
    ;;
  status)
    gh repo view "${repo}" --json nameWithOwner,visibility,url
    [[ -f "${NORN_HA_GIT_DEPLOY_KEY_PATH}" && -f "${NORN_HA_AGE_KEY_PATH}" && -f "${NORN_HA_TOY_SECRETS_PATH}" && -n "${NORN_HA_AGE_RECIPIENT:-}" ]] || {
      echo "catalog credentials or encrypted secret bundle are incomplete" >&2
      exit 1
    }
    git -C "${catalog_dir}" rev-parse HEAD
    ;;
  *)
    echo "usage: catalog sync | catalog durability-sync IMAGE@sha256:... https://HOST | catalog status" >&2
    exit 2
    ;;
esac
