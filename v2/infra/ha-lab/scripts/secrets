#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: secrets init NAME | secrets ensure NAME | secrets path NAME | secrets reset-security NAME --confirm-disposable-lab" >&2
  exit 2
}

new_uuid() {
  uuidgen | tr '[:upper:]' '[:lower:]'
}

ensure_value() {
  local key="$1" value="$2"
  if ! grep -q "^${key}=" "${secret_file}"; then
    printf '%s=%s\n' "${key}" "${value}" >>"${secret_file}"
  fi
}

write_security_values() {
  ensure_value NORN_HA_SECURITY_PHASE disabled
  ensure_value NORN_HA_NORN_PROFILE development
  ensure_value NORN_HA_CONSUL_MANAGEMENT_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_NORN_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_PATRONI_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_NOMAD_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_OBSERVABILITY_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_01 "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_02 "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_03 "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_MANAGEMENT_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_NORN_ACCESSOR "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_NORN_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_OBSERVABILITY_ACCESSOR "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_OBSERVABILITY_TOKEN "$(new_uuid)"
}

command_name="${1:-}"
lab_name="${2:-}"
[[ -n "${command_name}" && -n "${lab_name}" ]] || usage
[[ "${lab_name}" =~ ^[a-z][a-z0-9-]{2,23}$ ]] || { echo "invalid lab name" >&2; exit 2; }

config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/norn/ha-lab"
secret_file="${config_dir}/${lab_name}.env"

case "${command_name}" in
  path)
    printf '%s\n' "${secret_file}"
    ;;
  init)
    if [[ -e "${secret_file}" ]]; then
      echo "refusing to overwrite ${secret_file}" >&2
      exit 1
    fi
    install -d -m 0700 "${config_dir}"
    umask 077
    temp_file="$(mktemp "${config_dir}/.${lab_name}.XXXXXX")"
    trap 'rm -f "${temp_file}"' EXIT
    {
      printf 'NORN_HA_CONSUL_GOSSIP_KEY=%s\n' "$(openssl rand -base64 16)"
      printf 'NORN_HA_NOMAD_GOSSIP_KEY=%s\n' "$(openssl rand -base64 32)"
      printf 'NORN_HA_POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_REPLICATION_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_REWIND_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_NORN_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_DURABILITY_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_NORN_API_TOKEN=%s\n' "$(openssl rand -hex 32)"
      printf 'NORN_HA_AUDIT_SIGNING_KEY=%s\n' "$(openssl rand -hex 32)"
      printf 'NORN_HA_GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_COSIGN_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_COSIGN_PUBLIC_KEY_PATH=%s\n' "${config_dir}/${lab_name}-cosign.pub"
      printf 'NORN_HA_GIT_DEPLOY_KEY_PATH=%s\n' "${config_dir}/${lab_name}-github-deploy"
      printf 'NORN_HA_AGE_KEY_PATH=%s\n' "${config_dir}/${lab_name}-age-keys.txt"
      printf 'NORN_HA_TOY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-ha-toy-secrets.enc.yaml"
      printf 'NORN_HA_DURABILITY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-secrets.enc.yaml"
      printf 'NORN_HA_DURABILITY_INFRASPEC_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-infraspec.yaml"
      printf 'NORN_HA_ENABLE_DURABILITY_PILOT=false\n'
      printf 'NORN_HA_PKI_DIR=%s\n' "${config_dir}/${lab_name}-pki"
    } >"${temp_file}"
    chmod 0600 "${temp_file}"
    mv "${temp_file}" "${secret_file}"
    write_security_values
    trap - EXIT
    echo "created ${secret_file} (mode 0600)"
    ;;
  ensure)
    [[ -f "${secret_file}" ]] || { echo "missing ${secret_file}; run secrets init ${lab_name}" >&2; exit 1; }
    chmod 0600 "${secret_file}"
    if ! grep -q '^NORN_HA_NORN_API_TOKEN=' "${secret_file}"; then
      printf 'NORN_HA_NORN_API_TOKEN=%s\n' "$(openssl rand -hex 32)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_DB_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_AUDIT_SIGNING_KEY=' "${secret_file}"; then
      printf 'NORN_HA_AUDIT_SIGNING_KEY=%s\n' "$(openssl rand -hex 32)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_GRAFANA_ADMIN_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_COSIGN_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_COSIGN_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_COSIGN_PUBLIC_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_COSIGN_PUBLIC_KEY_PATH=%s\n' "${config_dir}/${lab_name}-cosign.pub" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_GIT_DEPLOY_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_GIT_DEPLOY_KEY_PATH=%s\n' "${config_dir}/${lab_name}-github-deploy" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_AGE_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_AGE_KEY_PATH=%s\n' "${config_dir}/${lab_name}-age-keys.txt" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_TOY_SECRETS_PATH=' "${secret_file}"; then
      printf 'NORN_HA_TOY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-ha-toy-secrets.enc.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_SECRETS_PATH=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-secrets.enc.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_INFRASPEC_PATH=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_INFRASPEC_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-infraspec.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_ENABLE_DURABILITY_PILOT=' "${secret_file}"; then
      printf 'NORN_HA_ENABLE_DURABILITY_PILOT=false\n' >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_PKI_DIR=' "${secret_file}"; then
      printf 'NORN_HA_PKI_DIR=%s\n' "${config_dir}/${lab_name}-pki" >>"${secret_file}"
    fi
    write_security_values
    echo "ensured Norn API and audit keys in ${secret_file}"
    ;;
  reset-security)
    [[ "${3:-}" == "--confirm-disposable-lab" ]] || {
      echo "refusing security reset without --confirm-disposable-lab" >&2
      exit 2
    }
    [[ -f "${secret_file}" ]] || { echo "missing ${secret_file}" >&2; exit 1; }
    temp_file="$(mktemp "${config_dir}/.${lab_name}.security.XXXXXX")"
    trap 'rm -f "${temp_file}"' EXIT
    awk '
      BEGIN { phase = 0; profile = 0 }
      /^NORN_HA_SECURITY_PHASE=/ { print "NORN_HA_SECURITY_PHASE=disabled"; phase = 1; next }
      /^NORN_HA_NORN_PROFILE=/ { print "NORN_HA_NORN_PROFILE=development"; profile = 1; next }
      { print }
      END {
        if (!phase) print "NORN_HA_SECURITY_PHASE=disabled"
        if (!profile) print "NORN_HA_NORN_PROFILE=development"
      }
    ' "${secret_file}" >"${temp_file}"
    chmod 0600 "${temp_file}"
    mv "${temp_file}" "${secret_file}"
    trap - EXIT
    echo "reset ${lab_name} to the pre-cutover development phase"
    ;;
  *) usage ;;
esac
