#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"
lab_python="${lab_root}/.tools/ansible/bin/python"

usage() {
  cat >&2 <<'EOF'
usage:
  secrets init NAME | ensure NAME | path NAME | reset-security NAME --confirm-disposable-lab

  # multi-operator sharing (SOPS/age): the local <NAME>.env stays the plaintext
  # working copy every script sources; the sealed <NAME>.sops.env is the shared,
  # multi-recipient artifact backed up to Spaces. See BREAK-GLASS.md.
  secrets operator-init | operator-id
  secrets operators NAME | add-operator NAME age1... | rm-operator NAME age1...
  secrets seal NAME | open NAME | view NAME [KEY]
  secrets push NAME | pull NAME
EOF
  exit 2
}

new_uuid() {
  uuidgen | tr '[:upper:]' '[:lower:]'
}

ensure_value() {
  local key="$1" value="$2"
  if ! grep -q "^${key}=" "${secret_file}"; then
    printf '%s=%s\n' "${key}" "${value}" >>"${secret_file}"
  fi
}

write_security_values() {
  ensure_value NORN_HA_SECURITY_PHASE disabled
  ensure_value NORN_HA_NORN_PROFILE development
  ensure_value NORN_HA_CONSUL_MANAGEMENT_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_NORN_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_PATRONI_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_NOMAD_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_OBSERVABILITY_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_01 "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_02 "$(new_uuid)"
  ensure_value NORN_HA_CONSUL_AGENT_TOKEN_03 "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_MANAGEMENT_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_NORN_ACCESSOR "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_NORN_TOKEN "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_OBSERVABILITY_ACCESSOR "$(new_uuid)"
  ensure_value NORN_HA_NOMAD_OBSERVABILITY_TOKEN "$(new_uuid)"
}

norn_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/norn"
operator_key="${norn_config_dir}/operator-age.key"

command_name="${1:-}"
[[ -n "${command_name}" ]] || usage

# ---- operator identity (lab-independent) --------------------------------------
# Each operator holds a personal age keypair. The private key is this operator's
# break-glass identity; guard it in a password manager (see BREAK-GLASS.md). Its
# public recipient is what an existing operator adds via `add-operator`.
case "${command_name}" in
  operator-init)
    install -d -m 0700 "${norn_config_dir}"
    if [[ -f "${operator_key}" ]]; then
      echo "operator identity already exists: ${operator_key}" >&2
    else
      umask 077
      age-keygen -o "${operator_key}" >/dev/null 2>&1
      chmod 0600 "${operator_key}"
      echo "created operator identity: ${operator_key}" >&2
    fi
    echo "your age recipient (share so an existing operator can add you):" >&2
    age-keygen -y "${operator_key}"
    exit 0
    ;;
  operator-id)
    [[ -f "${operator_key}" ]] || { echo "no operator identity; run: secrets operator-init" >&2; exit 1; }
    age-keygen -y "${operator_key}"
    exit 0
    ;;
esac

lab_name="${2:-}"
[[ -n "${lab_name}" ]] || usage
[[ "${lab_name}" =~ ^[a-z][a-z0-9-]{2,23}$ ]] || { echo "invalid lab name" >&2; exit 2; }

config_dir="${norn_config_dir}/ha-lab"
secret_file="${config_dir}/${lab_name}.env"
recipients_file="${config_dir}/${lab_name}.recipients"
sealed_file="${config_dir}/${lab_name}.sops.env"

# Comma-joined age recipients from the recipients file (blank/# lines ignored).
recipients_csv() {
  [[ -f "${recipients_file}" ]] || return 1
  awk 'NF && $1 !~ /^#/' "${recipients_file}" | paste -sd, -
}

# Encrypt the plaintext working file to every recipient (whole-file binary seal,
# so `open` reproduces the exact bytes every script expects to source).
do_seal() {
  local recips
  recips="$(recipients_csv)" || { echo "no recipients; add one: secrets add-operator ${lab_name} \$(secrets operator-id)" >&2; return 1; }
  [[ -n "${recips}" ]] || { echo "recipients file is empty for ${lab_name}" >&2; return 1; }
  [[ -f "${secret_file}" ]] || { echo "no plaintext ${secret_file} to seal" >&2; return 1; }
  install -d -m 0700 "${config_dir}"
  umask 077
  local tmp
  tmp="$(mktemp "${config_dir}/.${lab_name}.sops.XXXXXX")"
  sops --config /dev/null --encrypt --input-type binary --output-type binary --age "${recips}" "${secret_file}" >"${tmp}"
  chmod 0600 "${tmp}"
  mv "${tmp}" "${sealed_file}"
}

require_backup_creds() {
  : "${NORN_HA_BACKUP_ACCESS_KEY:?Spaces access key not set (export NORN_HA_BACKUP_* from your password manager, or source the working .env)}"
  : "${NORN_HA_BACKUP_SECRET_KEY:?Spaces secret key not set}"
  : "${NORN_HA_BACKUP_REGION:?Spaces region not set}"
  : "${NORN_HA_BACKUP_BUCKET:?Spaces bucket not set}"
  [[ -x "${lab_python}" ]] || { echo "lab python venv missing; run: lab bootstrap-tools" >&2; exit 1; }
}

# Run a boto3 snippet against Spaces with client `c`, bucket `b`, object `key`,
# and local `path` (the sealed file) already in scope. The sealed file is
# ciphertext, so transporting it through Spaces never exposes plaintext.
spaces_py() {
  AWS_ACCESS_KEY_ID="${NORN_HA_BACKUP_ACCESS_KEY}" \
  AWS_SECRET_ACCESS_KEY="${NORN_HA_BACKUP_SECRET_KEY}" \
  SP_ENDPOINT="https://${NORN_HA_BACKUP_REGION}.digitaloceanspaces.com" \
  SP_REGION="${NORN_HA_BACKUP_REGION}" SP_BUCKET="${NORN_HA_BACKUP_BUCKET}" \
  SP_KEY="secrets/${lab_name}.sops.env" SP_FILE="${sealed_file}" \
  "${lab_python}" -c "
import os, boto3
c = boto3.client('s3', endpoint_url=os.environ['SP_ENDPOINT'], region_name=os.environ['SP_REGION'])
b = os.environ['SP_BUCKET']; key = os.environ['SP_KEY']; path = os.environ['SP_FILE']
$1"
}

case "${command_name}" in
  path)
    printf '%s\n' "${secret_file}"
    ;;
  init)
    if [[ -e "${secret_file}" ]]; then
      echo "refusing to overwrite ${secret_file}" >&2
      exit 1
    fi
    install -d -m 0700 "${config_dir}"
    umask 077
    temp_file="$(mktemp "${config_dir}/.${lab_name}.XXXXXX")"
    trap 'rm -f "${temp_file}"' EXIT
    {
      printf 'NORN_HA_CONSUL_GOSSIP_KEY=%s\n' "$(openssl rand -base64 16)"
      printf 'NORN_HA_NOMAD_GOSSIP_KEY=%s\n' "$(openssl rand -base64 32)"
      printf 'NORN_HA_POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_REPLICATION_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_REWIND_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_NORN_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_DURABILITY_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_NORN_API_TOKEN=%s\n' "$(openssl rand -hex 32)"
      printf 'NORN_HA_AUDIT_SIGNING_KEY=%s\n' "$(openssl rand -hex 32)"
      printf 'NORN_HA_GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_COSIGN_PASSWORD=%s\n' "$(openssl rand -hex 24)"
      printf 'NORN_HA_COSIGN_PUBLIC_KEY_PATH=%s\n' "${config_dir}/${lab_name}-cosign.pub"
      printf 'NORN_HA_GIT_DEPLOY_KEY_PATH=%s\n' "${config_dir}/${lab_name}-github-deploy"
      printf 'NORN_HA_AGE_KEY_PATH=%s\n' "${config_dir}/${lab_name}-age-keys.txt"
      printf 'NORN_HA_TOY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-ha-toy-secrets.enc.yaml"
      printf 'NORN_HA_DURABILITY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-secrets.enc.yaml"
      printf 'NORN_HA_DURABILITY_INFRASPEC_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-infraspec.yaml"
      printf 'NORN_HA_ENABLE_DURABILITY_PILOT=false\n'
      printf 'NORN_HA_PKI_DIR=%s\n' "${config_dir}/${lab_name}-pki"
    } >"${temp_file}"
    chmod 0600 "${temp_file}"
    mv "${temp_file}" "${secret_file}"
    write_security_values
    trap - EXIT
    echo "created ${secret_file} (mode 0600)"
    ;;
  ensure)
    [[ -f "${secret_file}" ]] || { echo "missing ${secret_file}; run secrets init ${lab_name}" >&2; exit 1; }
    chmod 0600 "${secret_file}"
    if ! grep -q '^NORN_HA_NORN_API_TOKEN=' "${secret_file}"; then
      printf 'NORN_HA_NORN_API_TOKEN=%s\n' "$(openssl rand -hex 32)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_DB_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_DB_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_AUDIT_SIGNING_KEY=' "${secret_file}"; then
      printf 'NORN_HA_AUDIT_SIGNING_KEY=%s\n' "$(openssl rand -hex 32)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_GRAFANA_ADMIN_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_COSIGN_PASSWORD=' "${secret_file}"; then
      printf 'NORN_HA_COSIGN_PASSWORD=%s\n' "$(openssl rand -hex 24)" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_COSIGN_PUBLIC_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_COSIGN_PUBLIC_KEY_PATH=%s\n' "${config_dir}/${lab_name}-cosign.pub" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_GIT_DEPLOY_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_GIT_DEPLOY_KEY_PATH=%s\n' "${config_dir}/${lab_name}-github-deploy" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_AGE_KEY_PATH=' "${secret_file}"; then
      printf 'NORN_HA_AGE_KEY_PATH=%s\n' "${config_dir}/${lab_name}-age-keys.txt" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_TOY_SECRETS_PATH=' "${secret_file}"; then
      printf 'NORN_HA_TOY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-ha-toy-secrets.enc.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_SECRETS_PATH=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_SECRETS_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-secrets.enc.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_DURABILITY_INFRASPEC_PATH=' "${secret_file}"; then
      printf 'NORN_HA_DURABILITY_INFRASPEC_PATH=%s\n' "${config_dir}/${lab_name}-norn-durability-pilot-infraspec.yaml" >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_ENABLE_DURABILITY_PILOT=' "${secret_file}"; then
      printf 'NORN_HA_ENABLE_DURABILITY_PILOT=false\n' >>"${secret_file}"
    fi
    if ! grep -q '^NORN_HA_PKI_DIR=' "${secret_file}"; then
      printf 'NORN_HA_PKI_DIR=%s\n' "${config_dir}/${lab_name}-pki" >>"${secret_file}"
    fi
    write_security_values
    echo "ensured Norn API and audit keys in ${secret_file}"
    ;;
  reset-security)
    [[ "${3:-}" == "--confirm-disposable-lab" ]] || {
      echo "refusing security reset without --confirm-disposable-lab" >&2
      exit 2
    }
    [[ -f "${secret_file}" ]] || { echo "missing ${secret_file}" >&2; exit 1; }
    temp_file="$(mktemp "${config_dir}/.${lab_name}.security.XXXXXX")"
    trap 'rm -f "${temp_file}"' EXIT
    awk '
      BEGIN { phase = 0; profile = 0 }
      /^NORN_HA_SECURITY_PHASE=/ { print "NORN_HA_SECURITY_PHASE=disabled"; phase = 1; next }
      /^NORN_HA_NORN_PROFILE=/ { print "NORN_HA_NORN_PROFILE=development"; profile = 1; next }
      { print }
      END {
        if (!phase) print "NORN_HA_SECURITY_PHASE=disabled"
        if (!profile) print "NORN_HA_NORN_PROFILE=development"
      }
    ' "${secret_file}" >"${temp_file}"
    chmod 0600 "${temp_file}"
    mv "${temp_file}" "${secret_file}"
    trap - EXIT
    echo "reset ${lab_name} to the pre-cutover development phase"
    ;;
  operators)
    if [[ -f "${recipients_file}" ]] && [[ -n "$(recipients_csv)" ]]; then
      awk 'NF && $1 !~ /^#/' "${recipients_file}"
    else
      echo "(no recipients yet; add one: secrets add-operator ${lab_name} \$(secrets operator-id))" >&2
    fi
    ;;
  add-operator)
    recip="${3:-}"
    [[ "${recip}" =~ ^age1[0-9a-z]{58,}$ ]] || { echo "usage: secrets add-operator ${lab_name} age1..." >&2; exit 2; }
    install -d -m 0700 "${config_dir}"
    touch "${recipients_file}"; chmod 0600 "${recipients_file}"
    if grep -qxF "${recip}" "${recipients_file}"; then
      echo "recipient already present"
    else
      printf '%s\n' "${recip}" >>"${recipients_file}"
      echo "added recipient ${recip}"
    fi
    if [[ -f "${secret_file}" ]]; then do_seal && echo "re-sealed ${sealed_file}"; else
      echo "no working ${lab_name}.env yet; seal on next: secrets seal ${lab_name}"
    fi
    ;;
  rm-operator)
    recip="${3:-}"
    [[ -n "${recip}" ]] || { echo "usage: secrets rm-operator ${lab_name} age1..." >&2; exit 2; }
    [[ -f "${recipients_file}" ]] || { echo "no recipients file for ${lab_name}" >&2; exit 1; }
    tmp="$(mktemp "${config_dir}/.${lab_name}.recip.XXXXXX")"
    grep -vxF "${recip}" "${recipients_file}" >"${tmp}" || true
    chmod 0600 "${tmp}"; mv "${tmp}" "${recipients_file}"
    echo "removed recipient ${recip}"
    echo "NOTE: rotate secrets — a removed operator may still hold a previously-opened plaintext copy" >&2
    if [[ -f "${secret_file}" ]] && [[ -n "$(recipients_csv)" ]]; then do_seal && echo "re-sealed ${sealed_file}"; fi
    ;;
  seal)
    do_seal && echo "sealed ${sealed_file} (mode 0600)"
    ;;
  open)
    [[ -f "${sealed_file}" ]] || { echo "no sealed ${sealed_file}; run 'secrets pull ${lab_name}' or 'secrets seal ${lab_name}'" >&2; exit 1; }
    [[ -f "${operator_key}" ]] || { echo "no operator identity; run: secrets operator-init" >&2; exit 1; }
    install -d -m 0700 "${config_dir}"
    umask 077
    tmp="$(mktemp "${config_dir}/.${lab_name}.open.XXXXXX")"
    if ! SOPS_AGE_KEY_FILE="${operator_key}" sops --config /dev/null --decrypt --input-type binary --output-type binary "${sealed_file}" >"${tmp}" 2>/dev/null; then
      rm -f "${tmp}"
      echo "decrypt failed — is your operator recipient in 'secrets operators ${lab_name}'?" >&2
      exit 1
    fi
    chmod 0600 "${tmp}"; mv "${tmp}" "${secret_file}"
    echo "opened ${secret_file} (mode 0600)"
    ;;
  view)
    key="${3:-}"
    if [[ -f "${sealed_file}" ]]; then
      [[ -f "${operator_key}" ]] || { echo "no operator identity; run: secrets operator-init" >&2; exit 1; }
      out="$(SOPS_AGE_KEY_FILE="${operator_key}" sops --config /dev/null --decrypt --input-type binary --output-type binary "${sealed_file}" 2>/dev/null)" \
        || { echo "decrypt failed — is your operator recipient in 'secrets operators ${lab_name}'?" >&2; exit 1; }
    elif [[ -f "${secret_file}" ]]; then
      out="$(cat "${secret_file}")"
    else
      echo "no sealed or working secret for ${lab_name}" >&2; exit 1
    fi
    if [[ -n "${key}" ]]; then
      printf '%s\n' "${out}" | grep "^${key}=" || { echo "key ${key} not set" >&2; exit 1; }
    else
      printf '%s\n' "${out}"
    fi
    ;;
  push)
    [[ -f "${sealed_file}" ]] || { echo "nothing to push; run: secrets seal ${lab_name}" >&2; exit 1; }
    # shellcheck disable=SC1090
    [[ -f "${secret_file}" ]] && { set -a; source "${secret_file}"; set +a; }
    require_backup_creds
    spaces_py "
with open(path, 'rb') as f:
    r = c.put_object(Bucket=b, Key=key, Body=f.read())
print('pushed', key, 'to', b, 'version', r.get('VersionId', '(unversioned)'))"
    ;;
  pull)
    # DR path: creds come from the environment (the working .env may be gone).
    require_backup_creds
    install -d -m 0700 "${config_dir}"
    spaces_py "
r = c.get_object(Bucket=b, Key=key)
with open(path, 'wb') as f:
    f.write(r['Body'].read())
print('pulled', key, '->', path)"
    chmod 0600 "${sealed_file}"
    echo "next: secrets open ${lab_name}   (decrypts the sealed copy to ${secret_file})"
    ;;
  *) usage ;;
esac
