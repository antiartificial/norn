#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"
command_name="${1:-status}"
expiry="$(terraform -chdir="${lab_root}/terraform" output -json expiry | jq -er .expires_on)"
owner="$(terraform -chdir="${lab_root}/terraform" output -json expiry | jq -er .owner)"
name="$(terraform -chdir="${lab_root}/terraform" output -raw name_prefix)"
today="$(date -u +%Y-%m-%d)"
overdue=false
if [[ "${today}" > "${expiry}" ]]; then overdue=true; fi

case "${command_name}" in
  status)
    jq -n --arg name "${name}" --arg owner "${owner}" --arg today "${today}" --arg expiresOn "${expiry}" --argjson overdue "${overdue}" \
      '{schema:"norn.ha-expiry/v1",name:$name,owner:$owner,today:$today,expiresOn:$expiresOn,overdue:$overdue}'
    ;;
  check)
    if ${overdue}; then
      echo "${name} expired on ${expiry}; review a destroy plan immediately" >&2
      exit 1
    fi
    echo "${name} is within its declared lifetime through ${expiry}"
    ;;
  *) echo "usage: expiry status | expiry check" >&2; exit 2 ;;
esac
