#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"
export SSL_CERT_FILE="$("${lab_root}/.tools/ansible/bin/python" -m certifi)"
lab_name="$(terraform -chdir="${lab_root}/terraform" output -raw name_prefix)"
"${script_dir}/secrets" ensure "${lab_name}" >/dev/null
secret_file="$(${script_dir}/secrets path "${lab_name}")"
registry_config="$(mktemp)"
trap 'rm -f "${registry_config}"' EXIT

[[ -f "${secret_file}" ]] || { echo "missing ${secret_file}; run scripts/secrets init ${lab_name}" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
source "${secret_file}"
set +a
umask 077
doctl registry docker-config --expiry-seconds 259200 >"${registry_config}"
export NORN_HA_REGISTRY_CONFIG_PATH="${registry_config}"

GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
  go build -C "${lab_root}/../../api" -trimpath -o "${lab_root}/.tools/norn-server-linux-amd64" .

ansible-galaxy collection install -r "${lab_root}/ansible/requirements.yml"
ANSIBLE_CONFIG="${lab_root}/ansible/ansible.cfg" \
  ansible-playbook "${lab_root}/ansible/site.yml" "$@"
