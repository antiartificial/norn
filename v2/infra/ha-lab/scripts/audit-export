#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"

lab_name="$(terraform -chdir="${lab_root}/terraform" output -raw name_prefix)"
secret_file="$(${script_dir}/secrets path "${lab_name}")"
[[ -f "${secret_file}" ]] || { echo "missing ${secret_file}" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
source "${secret_file}"
set +a

for required in NORN_HA_BACKUP_BUCKET NORN_HA_BACKUP_REGION NORN_HA_NORN_API_TOKEN; do
  [[ -n "${!required:-}" ]] || { echo "${required} is not configured" >&2; exit 1; }
done

node1="$(terraform -chdir="${lab_root}/terraform" output -json lab_nodes | jq -r 'to_entries | sort_by(.key) | first.value.public_ip')"
active="$(ssh -o BatchMode=yes "root@${node1}" "curl -fsS 'http://127.0.0.1:8500/v1/health/service/norn-api?passing=true' | jq -er 'if length == 1 then .[0].Service.Address else error(\"single active Norn service required\") end'")"
local_port=58801
ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -N -L "${local_port}:${active}:8800" "root@${node1}" &
tunnel_pid=$!
trap 'kill "${tunnel_pid}" 2>/dev/null || true' EXIT
sleep 2

curl -fsS \
  -H "Authorization: Bearer ${NORN_HA_NORN_API_TOKEN}" \
  "http://127.0.0.1:${local_port}/api/v1/audit/mutations?limit=500" |
  "${lab_root}/.tools/ansible/bin/python" "${script_dir}/audit-export.py" \
    --lab-name "${lab_name}" \
    --bucket "${NORN_HA_BACKUP_BUCKET}" \
    --region "${NORN_HA_BACKUP_REGION}"
