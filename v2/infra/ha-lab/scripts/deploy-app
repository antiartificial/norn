#!/usr/bin/env bash
set -euo pipefail

# Deploy the demo workload THROUGH Norn (managed path), not straight to Nomad.
# Builds+signs the toy image into your registry, pins it into the infraspec,
# replicates the catalog, then triggers the Norn admission->build->submit pipeline
# via POST /api/apps/norn-ha-toy/deploy on the leader-following :8810 frontend.
#
# Portability note: build-toy, the catalog repo, and the infraspec are pinned to
# the 'antiartificial' DO registry/GitHub org (the eval context). Deploying from a
# different org requires parameterizing those references (tracked for a later pass).
#
# usage: lab deploy-app [VERSION]   (VERSION default: demo)

version="${1:-demo}"
[[ "${version}" =~ ^[a-zA-Z0-9._-]{1,40}$ ]] || { echo "VERSION must be 1-40 chars [a-zA-Z0-9._-]" >&2; exit 2; }

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "${script_dir}/.." && pwd)"
export PATH="${lab_root}/.tools/bin:${PATH}"
terraform_dir="${lab_root}/terraform"
tf() { terraform -chdir="${terraform_dir}" "$@"; }
lab="${script_dir}/lab"
infraspec="${lab_root}/toy-app/infraspec.yaml"

lab_name="$(tf output -raw name_prefix 2>/dev/null || true)"
[[ -n "${lab_name}" ]] || { echo "no applied cluster; run 'lab up' first" >&2; exit 1; }
first_public="$(tf output -json lab_nodes | jq -r 'to_entries | sort_by(.key) | first.value.public_ip')"
lb_ip="$(tf output -json regional_ingress 2>/dev/null | jq -r '.ip // empty' || true)"

echo "==> build + push the demo image"
digest="$(${script_dir}/build-toy "${version}" | tail -1)"
[[ "${digest}" =~ ^registry\.digitalocean\.com/antiartificial/norn-ha-toy@sha256:[a-f0-9]{64}$ ]] || {
  echo "build-toy did not emit an immutable digest (got: ${digest})" >&2; exit 1; }
echo "    ${digest}"

echo "==> cosign sign the digest"
"${lab}" supply-chain sign "${digest}"

echo "==> pin the digest into the infraspec"
sed -i '' -E "s#^  image: registry\.digitalocean\.com/antiartificial/norn-ha-toy@sha256:[a-f0-9]{64}#  image: ${digest}#" "${infraspec}"
grep -q "  image: ${digest}" "${infraspec}" || { echo "failed to pin digest into ${infraspec}" >&2; exit 1; }

echo "==> sync + replicate the app catalog"
"${lab}" catalog sync >/dev/null
"${lab}" converge --tags catalog

# Managed database: ensure the app role can create its schema objects (PG15+ default revokes this).
# No-op for the co-located self-managed database.
"${lab}" managed-db-grant

echo "==> trigger the Norn deploy pipeline (leader-following :8810)"
saga="$(ssh -o BatchMode=yes "root@${first_public}" '
  set -a; source /etc/norn/norn.env; set +a
  curl -fsS -X POST \
    -H "Authorization: Bearer ${NORN_API_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"ref\":\"HEAD\"}" \
    http://127.0.0.1:8810/api/apps/norn-ha-toy/deploy' | jq -r '.sagaId // empty')"
[[ -n "${saga}" ]] || { echo "deploy request was not accepted" >&2; exit 1; }
echo "    sagaId=${saga}"

echo "==> wait for two healthy allocations"
for _ in $(seq 1 90); do
  if ssh -o BatchMode=yes "root@${first_public}" '
    set -a; source /etc/norn/norn.env; set +a; export NOMAD_ADDR="${NORN_NOMAD_ADDR}"
    nomad job status -json norn-ha-toy 2>/dev/null | jq -e ".[0].Summary.Summary.web.Running >= 2" >/dev/null &&
    nomad deployment list -json 2>/dev/null | jq -e "[.[] | select(.JobID==\"norn-ha-toy\")] | sort_by(.CreateIndex) | last | .Status == \"successful\"" >/dev/null'; then
    echo "demo app '${version}' deployed via Norn (${digest})"
    [[ -n "${lb_ip}" ]] && echo "reach it: curl -H 'Host: norn-ha-ingress-test.slopistry.com' http://${lb_ip}/"
    exit 0
  fi
  sleep 4
done
echo "deploy did not reach two running allocations; inspect: lab connect + NornUI, or 'nomad job status norn-ha-toy' on ${first_public}" >&2
exit 1
