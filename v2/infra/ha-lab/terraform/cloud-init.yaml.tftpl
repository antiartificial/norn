#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - gpg
  - jq
  - python3
  - python3-apt
  - unzip

ssh_pwauth: false
disable_root: false

write_files:
  - path: /etc/ssh/sshd_config.d/60-norn-ha-lab.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no
  - path: /etc/norn-ha-lab
    owner: root:root
    permissions: "0644"
    content: |
      managed=true
      hostname=${hostname}

runcmd:
  - systemctl reload ssh
  - touch /var/lib/cloud/instance/norn-bootstrap-ready

final_message: "Norn HA lab bootstrap complete after $UPTIME seconds"
