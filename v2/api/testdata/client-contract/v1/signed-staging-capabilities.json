{
  "auth": {
    "deviceEnrollment": true,
    "principal": {
      "authenticated": true,
      "deviceId": "client-fixture-device",
      "legacy": false,
      "scopes": [
        "api:read",
        "api:write",
        "events:read"
      ],
      "subject": "norn-client-fixture-operator"
    },
    "scopes": [
      "api:read",
      "api:write",
      "events:read",
      "apps:exec",
      "platform:operate",
      "host:operate",
      "release:attest",
      "release:stage",
      "release:qualify",
      "release:promote",
      "release:rollback",
      "fleet:operate",
      "fleet:external-admission",
      "admin"
    ],
    "stepUp": {
      "algorithm": "ES256",
      "challengeTTLSeconds": 120,
      "header": "X-Norn-Step-Up",
      "publicKeyFormat": "P-256-X9.63",
      "purposes": [
        "exec"
      ]
    },
    "tokens": {
      "deviceTTLSeconds": 2592000,
      "revocation": "registry",
      "rotation": "atomic"
    },
    "websocketBearerHeader": true,
    "websocketQueryToken": false
  },
