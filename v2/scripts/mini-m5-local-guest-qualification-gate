#!/usr/bin/env python3
"""Require an owner-signed isolated guest qualification before copied inputs."""

import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def verify(receipt, attestation, guest, marker_sha, source_sha):
    expected = {"schema", "guestName", "createMarkerSHA256", "qualificationRunId", "sourceSHA",
                "attestationSHA256", "runner"}
    if set(receipt) != expected or receipt["schema"] != "norn.m5-local-guest-qualified/v1":
        raise ValueError("unexpected qualification receipt")
    if (not re.fullmatch(r"norn-m5-[0-9]{1,20}", guest) or
            not re.fullmatch(r"[0-9a-f]{64}", marker_sha) or
            not re.fullmatch(r"[0-9a-f]{40}", source_sha)):
        raise ValueError("invalid guest/source binding")
    if (receipt["guestName"] != guest or receipt["createMarkerSHA256"] != marker_sha or
            receipt["sourceSHA"] != source_sha or receipt["runner"] != "norn-m5-isolated-01" or
            not re.fullmatch(r"[0-9]{1,20}", receipt["qualificationRunId"])):
        raise ValueError("qualification does not match protected guest and source")
    if (attestation.get("schema") != "norn.m5-isolated-runner-attestation/v1" or
            attestation.get("runner") != "norn-m5-isolated-01" or
            attestation.get("hostOutbound") != "loopback-only" or
            attestation.get("credentialSurfacesAbsentOrUnreadable") is not True or
            attestation.get("preexistingNetworkSockets") != 0 or
            not re.fullmatch(r"gui/[0-9]+", attestation.get("guiDomain", ""))):
        raise ValueError("guest isolation proof is incomplete")
    return {"schema": "norn.m5-local-guest-qualified-gate/v1", "guestName": guest,
            "createMarkerSHA256": marker_sha, "sourceSHA": source_sha,
            "qualificationRunId": receipt["qualificationRunId"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("receipt", "signature", "public-key", "attestation", "guest-name",
                 "create-marker-sha256", "source-sha"):
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args()
    subprocess.run(("/opt/homebrew/opt/openssl@3/bin/openssl", "pkeyutl", "-verify", "-pubin",
                    "-inkey", args.public_key, "-sigfile", args.signature, "-rawin", "-in", args.receipt),
                   check=True, capture_output=True, timeout=10)
    receipt = json.loads(Path(args.receipt).read_bytes())
    attestation = json.loads(Path(args.attestation).read_bytes())
    if receipt.get("attestationSHA256") != digest(args.attestation):
        raise ValueError("attestation digest mismatch")
    result = verify(receipt, attestation, args.guest_name, args.create_marker_sha256, args.source_sha)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    main()
