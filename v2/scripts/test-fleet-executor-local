def spawn_bg(name: str, argv, env=None) -> int:
    logf = open(WORK / f"{name}.log", "ab")
    proc = subprocess.Popen([str(a) for a in argv], stdout=logf, stderr=logf, env=env, stdin=subprocess.DEVNULL,
                            start_new_session=True)
    pids = state().get("pids", {})
    pids[name] = proc.pid
    save_state(pids=pids)
    return proc.pid


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def stop_bg(name: str, sig=signal.SIGTERM, wait=15) -> None:
    pids = state().get("pids", {})
    pid = pids.get(name)
    if not pid or not alive(pid):
        return
    os.kill(pid, sig)
    deadline = time.time() + wait
    while time.time() < deadline and alive(pid):
        time.sleep(0.2)
    if alive(pid):
        os.kill(pid, signal.SIGKILL)


def http_up(url: str, timeout=60) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            urllib.request.urlopen(url, timeout=3)
            return True
        except urllib.error.HTTPError:
            return True
        except OSError:
            time.sleep(0.5)
    return False


def start_authority() -> None:
    st = state()
    pid = st.get("pids", {}).get("authority")
    if pid and alive(pid):
        return
    spawn_bg("authority", [st["authority_bin"], "-test.run", "TestFleetExecutorLocalAuthority", "-test.timeout", "0", "-test.v"],
             authority_env())
    if not http_up(norn_url() + "/api/health", 60):
        die("authority did not come up; see " + str(WORK / "authority.log"))
    log(f"authority up on {norn_url()} (pid {state()['pids']['authority']})")


def stop_authority(sig=signal.SIGTERM) -> None:
    stop_bg("authority", sig)


def start_services() -> None:
    st = state()
    pids = st.get("pids", {})
    me = [sys.executable, str(Path(__file__).resolve())]
    env = dict(os.environ, Q1_WORK=str(WORK))
    if not (pids.get("fake-github") and alive(pids["fake-github"])):
        spawn_bg("fake-github", [*me, "fake-github"], env)
        if not http_up(f"http://127.0.0.1:{CTL_PORT}/state", 15):
            die("fake GitHub did not start")
    if not (pids.get("proxy") and alive(pids["proxy"])):
        spawn_bg("proxy", [*me, "proxy"], env)
        time.sleep(0.5)
    start_authority()


def cmd_setup(args) -> int:
    WORK.mkdir(parents=True, exist_ok=True)
    st = state()
    if "api_token" not in st:
        save_state(api_token=secrets.token_urlsafe(40), audit_key=secrets.token_urlsafe(40), created=rfc3339(),
                   db="norn_q1_" + dt.datetime.now().strftime("%Y%m%d%H%M%S"))
    gen_pki()
    save_state(**gen_keys())
    first = make_fixture_repo()
    save_state(first_commit=first)
    st = state()
    if not psql("postgres", f"select 1 from pg_database where datname='{st['db']}'").stdout.strip():
        psql("postgres", f"create database {st['db']}")
        log(f"created PostgreSQL database {st['db']}")
    if "norn_bin" not in st or args.rebuild:
        build_binaries()
    start_services()
    log("setup done")
    return 0


# ---------------------------------------------------------------------------
# status / teardown
# ---------------------------------------------------------------------------

def cmd_status(args) -> int:
    st = state()
    print(json.dumps({k: v for k, v in st.items() if k not in ("api_token", "audit_key")}, indent=2, sort_keys=True))
    for name, pid in st.get("pids", {}).items():
        print(f"{name}: pid {pid} {'alive' if alive(pid) else 'dead'}")
    code, body = api_call("GET", f"/api/v1/fleet/resources/{RESOURCE}")
    print("resource:", code, json.dumps(body, indent=1)[:2000])
    return 0


def cmd_teardown(args) -> int:
    st = state()
    for name in ("authority", "etcd-runtime", "proxy", "fake-github"):
        stop_bg(name)
    if st.get("db"):
        psql("postgres", f"drop database if exists {st['db']} with (force)", check=False)
        log(f"dropped database {st['db']}")
    log("Mac-side processes stopped; the VM is left running")
    return 0


def cmd_reset(args) -> int:
    """Start from a clean slate without recreating the VM: new database, new fixture repository, empty MinIO state,
    executor state removed (it enrolls again)."""
    st = state()
    log("reset: stopping Mac services and the executor")
    for name in ("authority", "proxy", "fake-github"):
        stop_bg(name)
    vm("systemctl stop norn-fleet-executor; rm -rf /var/lib/norn-fleet-executor/{token,token.json,intent.json,evidence,repo,refused,lock-foreign,last-applied}"
       " /run/norn-fleet-executor/grants/* /var/lib/norn-fleet-phase/*; "
       f"systemctl stop minio; rm -rf /var/lib/minio/{BUCKET}/* /var/lib/minio/.minio.sys/buckets/{BUCKET} /etc/q1-gate/hold-*; systemctl start minio",
       check=False)
    if st.get("db"):
        psql("postgres", f"drop database if exists {st['db']} with (force)", check=False)
    shutil.rmtree(WORK / "gh", ignore_errors=True)
    shutil.rmtree(WORK / "repo-work", ignore_errors=True)
    for f in ("proxy.log", "proxy-rules.json", "authority.log"):
        (WORK / f).unlink(missing_ok=True)
    new_db = "norn_q1_" + dt.datetime.now().strftime("%Y%m%d%H%M%S")
    save_state(db=new_db, pids={}, target_id="", baseline_plan="")
    psql("postgres", f"create database {new_db}")
    save_state(first_commit=make_fixture_repo())
    start_services()
    log(f"reset done; database {new_db}")
    return 0


# ---------------------------------------------------------------------------
# VM preparation, the real Ansible role, device enrollment
# ---------------------------------------------------------------------------

Q1_HOOK = """#!/bin/sh
# Q1 gate. q1-hook <gate>: block while /etc/q1-gate/hold-<gate> exists, then succeed.
# `plan` is the OpenTofu external data source (JSON on stdout); every other gate prints nothing.
gate="$1"
while [ -e "/etc/q1-gate/hold-$gate" ]; do sleep 0.3; done
if [ "$gate" = plan ]; then printf '{"ok":"1"}'; fi
exit 0
"""

TLS_UNIT = """[Unit]
Description=Q1 TLS terminator for {name} ({bind}:443 -> {target})
After=network-online.target
[Service]
ExecStart=/usr/bin/socat OPENSSL-LISTEN:443,bind={bind},reuseaddr,fork,cert=/etc/q1/srv.pem,key=/etc/q1/srv.key,verify=0 TCP:{target},connect-timeout=2,retry=10,interval=0.2
Restart=always
[Install]
WantedBy=multi-user.target
"""


def fleet_sha() -> str:
    return git(FLEET_DIR, "rev-parse", "HEAD").stdout.strip()


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def fetch_checksum(url: str, name: str) -> str:
    text = run(["curl", "-fsSL", url]).stdout
    for line in text.splitlines():
        if line.rstrip().endswith(name):
            return line.split()[0]
    die(f"{name} not in {url}")


def build_role_inputs() -> dict:
    d = WORK / "ansible"
    d.mkdir(parents=True, exist_ok=True)
    sha = fleet_sha()
    release = d / "executor-release.tar.gz"
    run(["git", "-C", FLEET_DIR, "archive", "--format=tar.gz", "-o", release, sha, "scripts"])
    exp = d / "exp"
    shutil.rmtree(exp, ignore_errors=True)
    exp.mkdir()
    run(["tar", "-xzf", release, "-C", exp])
    tree = run(["python3", FLEET_DIR / "ansible/roles/fleet_executor/files/tree_hash.py", exp / "scripts"]).stdout.strip()
    # Wheelhouse archive from the one the VM script built (arm64, hash-pinned): wheelhouse/*.whl + requirements.txt
    vm("rm -rf /tmp/q1-wh && mkdir /tmp/q1-wh && cp -r /opt/norn-fleet-executor/wheelhouse /tmp/q1-wh/wheelhouse"
       f" && cp {FLEET_DIR}/scripts/requirements-pilot.txt /tmp/q1-wh/requirements.txt"
       " && tar -C /tmp/q1-wh -czf /tmp/q1-wheelhouse.tar.gz . && chmod 644 /tmp/q1-wheelhouse.tar.gz")
    wheel_tar = d / "executor-wheelhouse.tar.gz"
    run(["limactl", "copy", f"{VM}:/tmp/q1-wheelhouse.tar.gz", wheel_tar])
    wheel_digest = vm("cat /opt/norn-fleet-executor/WHEELHOUSE_SHA256").stdout.strip()
    tofu_v, sops_v, age_v = "1.10.6", "3.9.4", "1.2.1"
    arch = "arm64"
    tofu_sha = fetch_checksum(f"https://github.com/opentofu/opentofu/releases/download/v{tofu_v}/tofu_{tofu_v}_SHA256SUMS",
                              f"tofu_{tofu_v}_linux_{arch}.zip")
    sops_sha = fetch_checksum(f"https://github.com/getsops/sops/releases/download/v{sops_v}/sops-v{sops_v}.checksums.txt",
                              f"sops-v{sops_v}.linux.{arch}")
    age_tar = d / f"age-v{age_v}-linux-{arch}.tar.gz"
    if not age_tar.exists():
        run(["curl", "-fsSL", "-o", age_tar, f"https://github.com/FiloSottile/age/releases/download/v{age_v}/age-v{age_v}-linux-{arch}.tar.gz"])
    return {"executor_release_sha": sha, "executor_release_archive": str(release),
            "executor_release_archive_sha256": sha256_file(release), "executor_release_tree_sha256": tree,
            "executor_wheelhouse_archive": str(wheel_tar), "executor_wheelhouse_archive_sha256": sha256_file(wheel_tar),
            "executor_wheelhouse_sha256": wheel_digest, "executor_tofu_sha256": tofu_sha, "executor_sops_sha256": sops_sha,
            "executor_age_sha256": sha256_file(age_tar)}


def build_fixture_secrets() -> tuple[Path, Path, str]:
    """The SOPS file (all credential types, fixture values) and the phase-owned secret tree that the unchanged
    validate_release_contract.py reads at nodes_configured. Returns (sops file, tree tarball, catalog sha256)."""
    st = state()
    d = WORK / "secrets"
    tree = d / "tree"
    shutil.rmtree(tree, ignore_errors=True)
    (tree / "norn").mkdir(parents=True)
    (tree / "etcd").mkdir()
    pin = "a" * 40
    repo = f"{OWNER}/{REPO}"
    norn_files = {
        "control-authority": "7d3b6a52-9c3e-4a8e-8c1f-2f0b6f6a1e11", "api.token": "x" * 40, "audit-signing.key": "y" * 40,
        "allowed-origins": "https://norn-staging.example.test", "ingress-url": "https://ingress.example.test",
        "registry-url": "registry.example.test/norn", "registry-auth.json": "{}",
        "release-attestation-issuer": "https://token.actions.githubusercontent.com",
        "release-attestation-repositories": repo,
        "release-attestation-workflow-refs": f"{repo}/.github/workflows/release.yml@{pin}",
        "private-attestation-trusted-keys": "q1", "catalog-age-keys.txt": "q1", "qualification-signing.key": "q1",
        "private-attestation-signing.pem": "q1",
        "oidc.env": "\n".join([
            "NORN_GITHUB_ACTIONS_OIDC_AUDIENCE=norn-fleet-staging", f"NORN_GITHUB_ACTIONS_RELEASE_BINDINGS=demo={repo}@1@2",
            f"NORN_GITHUB_ACTIONS_ALLOWED_WORKFLOW_REFS={repo}/.github/workflows/release.yml@{pin}",
            "NORN_GITHUB_ACTIONS_ALLOWED_REFS=refs/heads/main", "NORN_GITHUB_ACTIONS_ALLOWED_EVENTS=push",
            "NORN_GITHUB_ACTIONS_ALLOWED_ENVIRONMENTS=staging", "NORN_GITHUB_ACTIONS_DEFAULT_BRANCH=main",
            f"NORN_GITHUB_ACTIONS_FLEET_ALLOWED_REPOSITORY={repo}@1@2",
            f"NORN_GITHUB_ACTIONS_FLEET_ALLOWED_WORKFLOW_REFS={repo}/.github/workflows/apply.yml@{pin}",
            "NORN_GITHUB_ACTIONS_FLEET_ALLOWED_ENVIRONMENTS=staging", "NORN_GITHUB_ACTIONS_FLEET_ALLOWED_INTENTS=apply,recover", ""]),
    }
    for name, value in norn_files.items():
        (tree / "norn" / name).write_text(value)
    for name, value in {"root.password": "r" * 20, "norn.username": "norn", "norn.password": "p" * 20}.items():
        (tree / "etcd" / name).write_text(value)
    cat = d / "catalog"
    shutil.rmtree(cat, ignore_errors=True)
    (cat / "demo").mkdir(parents=True)
    (cat / "demo" / "infraspec.yaml").write_text("name: demo\n")
    tar_env = dict(os.environ, COPYFILE_DISABLE="1")  # no AppleDouble ._ members: the validator refuses them
    run(["tar", "-czf", tree / "catalog.tar.gz", "-C", cat, "demo"], env=tar_env)
    catalog_sha = sha256_file(tree / "catalog.tar.gz")
    for p in tree.rglob("*"):
        os.chmod(p, 0o700 if p.is_dir() else 0o600)
    os.chmod(tree, 0o700)
    tarball = d / "fixture-secrets.tar"
    run(["tar", "-cf", tarball, "-C", tree, "."], env=tar_env)
    key = (WORK / "keys/id_ed25519").read_text()
    plain = {
        "do-read": {"DIGITALOCEAN_TOKEN": "q1-fake-do-read-token", "SSH_KEY_FINGERPRINTS_JSON": json.dumps([st["ssh_fingerprint"]]),
                    "ADMIN_CIDRS_JSON": json.dumps(["10.0.0.0/8"]), "SSH_PUBLIC_KEY": st["ssh_public_key"]},
        "do-write": {"DIGITALOCEAN_TOKEN": "q1-fake-do-write-token", "SSH_KEY_FINGERPRINTS_JSON": json.dumps([st["ssh_fingerprint"]]),
                     "ADMIN_CIDRS_JSON": json.dumps(["10.0.0.0/8"])},
        "spaces-rw": {"AWS_ACCESS_KEY_ID": MINIO_USER, "AWS_SECRET_ACCESS_KEY": MINIO_PASS, "STATE_BUCKET": BUCKET,
                      "STATE_REGION": "us-east-1", "STATE_ENDPOINT": "http://127.0.0.1:9000"},
        "spaces-read": {"AWS_ACCESS_KEY_ID": MINIO_USER, "AWS_SECRET_ACCESS_KEY": MINIO_PASS, "STATE_BUCKET": BUCKET,
                        "STATE_REGION": "us-east-1", "STATE_ENDPOINT": "http://127.0.0.1:9000"},
        "ssh-node": {"id_ed25519": key, "known_hosts": "# q1 fixture: no real nodes\n"},
        "bootstrap-dir": {"bootstrap-vars.yml": "fleet_secret_dir: /etc/norn-fleet-phase/fixture-secrets\n"
                          "norn_catalog_source: /etc/norn-fleet-phase/fixture-secrets/catalog.tar.gz\n"
                          f"norn_catalog_sha256: {catalog_sha}\nnorn_environment: staging\n"},
        "release-github": {"NORN_RELEASE_GITHUB_TOKEN": "q1-unused"},
    }
    def seal(document: dict, name: str) -> Path:
        plain_file = d / (name + ".plain.json")
        plain_file.write_text(json.dumps(document))
        os.chmod(plain_file, 0o600)
        out = d / name
        # cwd is the secrets dir: a .sops.yaml in an ancestor of the checkout would otherwise be consulted.
        out.write_text(run(["sops", "--encrypt", "--age", st["age_recipient"], "--input-type", "json", "--output-type", "yaml",
                            plain_file.name], cwd=d).stdout)
        plain_file.unlink()
        return out

    enc = seal(plain, "staging.sops.yaml")
    # Accommodation W1 (bug 5): the unchanged recovery cannot parse tofu's coloured lock error. TF_CLI_ARGS=-no-color
    # reaches every tofu phase through the spaces-* credential entries. The role's check_secrets.py rejects the extra
    # key by design, so this file is copied in after the role has run.
    w1 = json.loads(json.dumps(plain))
    for t in ("spaces-rw", "spaces-read"):
        w1[t]["TF_CLI_ARGS"] = "-no-color"
    state_w1 = seal(w1, "staging.w1.sops.yaml")
    save_state(sops_w1=str(state_w1))
    return enc, tarball, catalog_sha


def vm_ssh_inventory() -> Path:
    cfg = (Path.home() / ".lima" / VM / "ssh.config").read_text()
    port = re.search(r"^\s*Port\s+(\d+)", cfg, re.M).group(1)
    user = re.search(r"^\s*User\s+(\S+)", cfg, re.M).group(1)
    inv = WORK / "ansible" / "inventory.ini"
    inv.write_text("[management_executor]\n"
                   f"norn-exec ansible_host=127.0.0.1 ansible_port={port} ansible_user={user} "
                   f"ansible_ssh_private_key_file={Path.home()}/.lima/_config/user "
                   "ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o IdentitiesOnly=yes' "
                   "ansible_python_interpreter=/usr/bin/python3\n")
    return inv


def vm_prepare_base() -> None:
    """Things the role does not install: TLS front-ends, the CA, the hook script, ruby (see report), the provider mirror."""
    st = state()
    pki = WORK / "pki"
    log("VM: packages (socat, ruby), CA, TLS terminators, gate script")
    vm("DEBIAN_FRONTEND=noninteractive apt-get install -y -qq socat ruby >/dev/null", timeout=900)
    vm("install -d -m 0755 /etc/q1 /etc/q1-gate")
    vm_copy_in(pki / "ca.pem", "/usr/local/share/ca-certificates/q1-ca.crt")
    vm("update-ca-certificates >/dev/null")
    vm_copy_in(pki / "srv.pem", "/etc/q1/srv.pem")
    vm_copy_in(pki / "srv.key", "/etc/q1/srv.key", mode="0600")
    hook = WORK / "q1-hook"
    hook.write_text(Q1_HOOK)
    vm_copy_in(hook, "/usr/local/bin/q1-hook", mode="0755")
    (WORK / "tls-norn.service").write_text(TLS_UNIT.format(name="norn.test", bind="127.0.0.12", target=f"host.lima.internal:{PROXY_PORT}"))
    (WORK / "tls-github.service").write_text(TLS_UNIT.format(name="github.com", bind="127.0.0.11", target=f"host.lima.internal:{GH_PORT}"))
    vm_copy_in(WORK / "tls-norn.service", "/etc/systemd/system/q1-tls-norn.service")
    vm_copy_in(WORK / "tls-github.service", "/etc/systemd/system/q1-tls-github.service")
    vm("grep -q ' norn.test' /etc/hosts || echo '127.0.0.12 norn.test' >> /etc/hosts")
    vm("systemctl daemon-reload && systemctl enable --now q1-tls-norn.service")


def vm_enable_github_front() -> None:
    vm("grep -q ' github.com' /etc/hosts || echo '127.0.0.11 github.com' >> /etc/hosts")
    vm("systemctl enable --now q1-tls-github.service")


def role_apply(inputs: dict, enc: Path, tags: str = "") -> None:
    st = state()
    inv = vm_ssh_inventory()
    vars_file = WORK / "ansible" / "vars.json"
    vars_file.write_text(json.dumps({
        "executor_norn_url": "https://norn.test", "executor_resource": RESOURCE,
        "executor_repo_url": f"https://github.com/{OWNER}/{REPO}.git",
        "executor_phase_env": {"NORN_FLEET_SSH_USER": "root", "NORN_FLEET_PRIVATE_INTERFACE": "eth0",
                               "NORN_FLEET_PUBLIC_HOSTNAME": "staging.fleet.test"},
        "executor_sops_file_src": str(enc), "executor_age_key_src": str(WORK / "keys/age.key"),
        "executor_host_age_recipient": st["age_recipient"], **inputs}, indent=1))
    log("applying ansible/playbooks/management-executor.yml (the real role) to the VM")
    env = dict(os.environ, ANSIBLE_HOST_KEY_CHECKING="False", ANSIBLE_FORCE_COLOR="0", ANSIBLE_NOCOLOR="1",
               ANSIBLE_SSH_ARGS="-o ControlMaster=auto -o ControlPersist=60s -o ServerAliveInterval=15 "
                                "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null")
    argv = ["ansible-playbook", "-i", inv, FLEET_DIR / "ansible/playbooks/management-executor.yml", "-e", f"@{vars_file}"]
    if tags:
        argv += ["--tags", tags]
    done = run(argv,
               cwd=FLEET_DIR / "ansible", env=env, check=False, timeout=3600)
    (WORK / "ansible" / ("role-run-%s.log" % tags if tags else "role-run.log")).write_text(
        done.stdout + "\n--- stderr ---\n" + done.stderr)
    if done.returncode != 0:
        die("ansible role failed; see " + str(WORK / "ansible/role-run.log") + "\n" + done.stdout[-3000:] + done.stderr[-1500:])
    save_state(role_applied=rfc3339(), release_sha=inputs["executor_release_sha"])


def install_fixture_secret_tree(tarball: Path) -> None:
    run(["limactl", "copy", str(tarball), f"{VM}:/tmp/q1-fixture-secrets.tar"])
    vm("rm -rf /etc/norn-fleet-phase/fixture-secrets && install -d -m 0700 -o norn-phase -g norn-phase /etc/norn-fleet-phase/fixture-secrets"
       " && tar -xf /tmp/q1-fixture-secrets.tar -C /etc/norn-fleet-phase/fixture-secrets"
       " && chown -R norn-phase:norn-phase /etc/norn-fleet-phase/fixture-secrets && rm -f /tmp/q1-fixture-secrets.tar")


def deliver_sops_w1() -> None:
    """Copy the accommodation-W1 SOPS file over the role's (atomically, same owner and mode as the role sets)."""
    w1 = state().get("sops_w1")
    if not w1:
        return
    vm_copy_in(Path(w1), "/etc/norn-fleet-executor/staging.sops.yaml.new", mode="0400", owner="norn-exec:norn-exec")
    vm("mv /etc/norn-fleet-executor/staging.sops.yaml.new /etc/norn-fleet-executor/staging.sops.yaml")


def pairing_line() -> tuple[str, str] | None:
    out = journal(grep="approve enrollment", lines=2000)
    found = re.findall(r"approve enrollment (\S+) \(code (\S+)\) with scope fleet:execute", out)
    return found[-1] if found else None


def ensure_vm_provisioned() -> None:
    """norn-exec-vm provision (users, tools, wheelhouse, MinIO, fake metadata). MinIO's official download answers 410
    (Gone) since the project stopped publishing binaries, so build it from source for the VM's architecture when needed."""
    if vm("test -x /usr/local/bin/minio && systemctl is-active minio fake-do-metadata", check=False).returncode == 0:
        return
    if vm("test -x /usr/local/bin/minio", check=False).returncode != 0:
        log("MinIO binary missing in the VM: cross-building github.com/minio/minio from source")
        env = dict(os.environ, GOOS="linux", GOARCH="arm64", CGO_ENABLED="0")
        run(["go", "install", "github.com/minio/minio@latest"], env=env, timeout=1800)
        gopath = run(["go", "env", "GOPATH"]).stdout.strip()
        run(["limactl", "copy", f"{gopath}/bin/linux_arm64/minio", f"{VM}:/tmp/minio"])
        vm("install -m 0755 /tmp/minio /usr/local/bin/minio")
    run(["bash", str(HERE / "norn-exec-vm"), "provision"], timeout=3600)


def cmd_vm(args) -> int:
    st = state()
    if "api_token" not in st:
        die("run setup first")
    ensure_vm_provisioned()
    enc, tarball, catalog_sha = build_fixture_secrets()
    vm_prepare_base()
    inputs = build_role_inputs()
    save_state(role_inputs={k: v for k, v in inputs.items() if k.endswith("sha256") or k.endswith("sha")})
    if not st.get("role_applied"):
        role_apply(inputs, enc)
    else:
        role_apply(inputs, enc, tags="secrets")  # redeliver the SOPS file (the role's rotation path)
    install_fixture_secret_tree(tarball)
    if not getattr(args, "as_shipped", False):
        deliver_sops_w1()
    vm_enable_github_front()
    # Pairing: approve the loop's pending enrollment (scope fleet:execute only).
    vm(f"systemctl start {UNIT}")
    if vm("test -s /var/lib/norn-fleet-executor/token", check=False).returncode != 0:
        pair = wait_for("the executor's pairing line", pairing_line, timeout=240, interval=5)
        log(f"executor pairing line: enrollment {pair[0]} code {pair[1]}")
        rc, out = norn_cli("access", "approve", pair[1], "--scope", "fleet:execute")
        log(out.splitlines()[0] if out else "approved")
        wait_for("the executor token", lambda: vm("test -s /var/lib/norn-fleet-executor/token", check=False).returncode == 0, timeout=120, interval=3)
    log("executor enrolled; token present")
    return 0


def cmd_tls(args) -> int:
    """Reinstall the VM-side TLS terminators (units) and restart them."""
    (WORK / "tls-norn.service").write_text(TLS_UNIT.format(name="norn.test", bind="127.0.0.12", target=f"host.lima.internal:{PROXY_PORT}"))
    (WORK / "tls-github.service").write_text(TLS_UNIT.format(name="github.com", bind="127.0.0.11", target=f"host.lima.internal:{GH_PORT}"))
    vm_copy_in(WORK / "tls-norn.service", "/etc/systemd/system/q1-tls-norn.service")
    vm_copy_in(WORK / "tls-github.service", "/etc/systemd/system/q1-tls-github.service")
    vm("systemctl daemon-reload && systemctl restart q1-tls-norn.service q1-tls-github.service")
    return 0


# ---------------------------------------------------------------------------
# bootstrap: target, resource, controller mode, first (approved) converge
# ---------------------------------------------------------------------------

def register_target_and_resource() -> str:
    code, body = api_call("POST", "/api/v1/fleet/targets", {
        "provider": "digitalocean", "providerAccount": "q1-local", "stateBackend": f"s3://{BUCKET}/staging",
        "aliases": [f"cluster:{CLUSTER}", "environment:staging/nyc3"]}, key="q1-register-target")
    if code not in (200, 201):
        die(f"register target: {code} {body}")
    target = body["ref"]
    code, body = api_call("POST", f"/api/v1/fleet/resources/{RESOURCE}", {"targetId": target}, key="q1-create-resource")
    if code not in (200, 201):
        die(f"create resource: {code} {body}")
    save_state(target_id=target)
    return target


def set_mode(mode: str) -> None:
    rc, out = norn_cli("fleet", "mode", RESOURCE, mode)
    log(f"mode {mode}: {out.splitlines()[0] if out else rc}")


def converge_view() -> dict:
    r = resource()
    return (r.get("desired") or {}).get("converge") or {}


def active() -> dict:
    return (resource().get("status") or {}).get("active") or {}


def exec_attempts(plan_id: str) -> list:
    code, body = api_call("GET", f"/api/v1/fleet/plans/{plan_id}/attempts")
    if code != 200:
        return []
    return body if isinstance(body, list) else body.get("attempts", [])


def attempt_summary(a: dict) -> str:
    return f"{a.get('id', '?')[:8]} status={a.get('status')} phase={a.get('currentPhase')} retryOf={(a.get('retryOf') or '')[:8]}"


def push_and_rescan(files: dict, message: str, wait_plan: bool = True, **kw) -> tuple[str, str]:
    """Commit to protected main, then rescan now (the watcher also polls every 60 s). Returns (sha, plan id)."""
    prev_plan = (resource().get("desired") or {}).get("planId", "")
    sha = commit_push(files, message, **kw)
    log(f"pushed {sha[:10]}: {message}")
    rc, out = norn_cli("fleet", "converge", RESOURCE, check=False)
    log("rescan: " + (out.splitlines()[0] if out else str(rc)))
    if not wait_plan:
        return sha, ""

    def planned():
        d = resource().get("desired") or {}
        return d.get("commitSha") == sha and d.get("planId") and d["planId"] != prev_plan and d["planId"]

    plan = wait_for(f"a converge plan for {sha[:10]}", planned, timeout=150, interval=3)
    return sha, plan


def wait_applied(sha: str, timeout=900):
    """Wait until Norn reports sha as the last applied commit and the fence is free."""
    def done():
        r = resource()
        applied = ((r.get("status") or {}).get("lastApplied") or {}).get("commitSha")
        act = (r.get("status") or {}).get("active")
        return applied == sha and (not act or act.get("occupancy") == "Free")
    return wait_for(f"{sha[:10]} to be applied", done, timeout=timeout, interval=5)


def vm_tofu_state() -> list[str]:
    """`tofu state list` against the MinIO state, as root in a scratch copy of the fixture root."""
    out = vm_tofu("state list")
    return [l for l in out.splitlines() if l and not l.startswith(("Warning", "│", "╷", "╵"))]


def vm_tofu(command: str, *, check=True) -> str:
    """Run a tofu command against the fixture root's MinIO backend (read-only inspection; as root, not as a phase)."""
    script = f"""set -e
d=/tmp/q1-tofu-inspect; rm -rf $d; mkdir -p $d
cp -r /tmp/q1-fixture-tree/. $d/ 2>/dev/null || true
cd $d
export AWS_ACCESS_KEY_ID={MINIO_USER} AWS_SECRET_ACCESS_KEY={MINIO_PASS} AWS_EC2_METADATA_DISABLED=true
tofu init -input=false -lockfile=readonly -backend-config=bucket={BUCKET} -backend-config=key={STATE_KEY} \
 -backend-config=region=us-east-1 -backend-config=endpoint=http://127.0.0.1:9000 -backend-config=skip_credentials_validation=true \
 -backend-config=skip_region_validation=true -backend-config=skip_requesting_account_id=true -backend-config=skip_metadata_api_check=true \
 -backend-config=skip_s3_checksum=true -backend-config=use_path_style=true -backend-config=use_lockfile=true >/dev/null 2>&1 || true
tofu {command} 2>&1
"""
    done = vm(script, check=False, timeout=300)
    if check and done.returncode != 0:
        die(f"tofu {command} failed in VM: {done.stdout[-800:]}")
    return done.stdout


def refresh_inspect_tree() -> None:
    """Copy the applied fixture root into the VM for the inspection helper (workdir is tracked at HEAD of the work clone)."""
    work = WORK / "repo-work"
    tar = WORK / "inspect-tree.tar"
    run(["tar", "-cf", tar, "-C", work / "environments/staging/nyc3", "."])
    run(["limactl", "copy", str(tar), f"{VM}:/tmp/q1-inspect-tree.tar"])
    vm("rm -rf /tmp/q1-fixture-tree && mkdir -p /tmp/q1-fixture-tree && tar -xf /tmp/q1-inspect-tree.tar -C /tmp/q1-fixture-tree")


def minio_keys() -> list[str]:
    """Object keys under the state bucket (the MinIO data directory is the bucket)."""
    out = vm(f"cd /var/lib/minio/{BUCKET} 2>/dev/null && find . -type f | sed 's#^\\./##' | sort", check=False).stdout
    return [l for l in out.splitlines() if l]


def cmd_bootstrap(args) -> int:
    if not state().get("target_id"):
        register_target_and_resource()
    r = resource()
    if r.get("executionMode") != "controller":
        set_mode("controller")
    log("resource: " + json.dumps({k: r.get(k) for k in ("name", "executionMode", "blocker")}))
    refresh_inspect_tree()
    # The first converge: lastApplied is empty, so E3 classes the range executable and the plan needs an approve.
    rc, out = norn_cli("fleet", "converge", RESOURCE, check=False)
    log("rescan: " + (out.splitlines()[0] if out else "rescan"))

    def planned():
        d = resource().get("desired") or {}
        return d.get("planId") if d.get("commitSha") == git(WORK / "repo-work", "rev-parse", "HEAD").stdout.strip() else ""
    plan = wait_for("the first converge plan", planned, timeout=150, interval=3)
    view = converge_view()
    log(f"first plan {plan}: requiresApproval={view.get('requiresApproval')} approved={view.get('approved')}")
    save_state(baseline_plan=plan)
    return 0


def cmd_baseline(args) -> int:
    """Approve the first converge (empty last-applied: executable by rule) and wait for it to be applied."""
    plan = state().get("baseline_plan") or current_plan()
    sha = (resource().get("desired") or {}).get("commitSha", "")
    view = converge_view()
    log(f"baseline plan {plan}: requiresApproval={view.get('requiresApproval')}")
    rc, out = norn_cli("fleet", "approve", plan)
    log(out.splitlines()[-1] if out else str(rc))
    wait_applied(sha, timeout=900)
    log(f"baseline applied: {last_applied()}")
    save_state(baseline_sha=sha)
    return 0


# ---------------------------------------------------------------------------
# Row framework and helpers
# ---------------------------------------------------------------------------

RESULTS = WORK / "results"


class Row:
    def __init__(self, n, title: str):
        self.n, self.title = n, title
        self.result = "PASS"
        self.lines: list[str] = []
        self.failures: list[str] = []
        self.started = rfc3339()

    def ev(self, label: str, text: str = "") -> None:
        text = text.strip()
        entry = f"{label}: {text}" if text else label
        self.lines.append(entry)
        log(f"row {self.n}: {entry[:400]}")

    def check(self, cond: bool, msg: str) -> bool:
        if cond:
            self.ev("ok", msg)
        else:
            self.failures.append(msg)
            self.ev("CHECK FAILED", msg)
        return bool(cond)

    def finish(self) -> dict:
        if self.failures and self.result == "PASS":
            self.result = "FAIL"
        out = {"row": self.n, "title": self.title, "result": self.result, "started": self.started, "finished": rfc3339(),
               "failures": self.failures, "evidence": self.lines}
        RESULTS.mkdir(parents=True, exist_ok=True)
        (RESULTS / f"row-{self.n}.json").write_text(json.dumps(out, indent=1))
        return out


def run_row(n, title: str, fn) -> dict:
    row = Row(n, title)
    log(f"=== row {n}: {title}")
    try:
        fn(row)
    except SystemExit as exc:
        row.result = "FAIL"
        row.failures.append(f"aborted: {exc}")
        row.ev("ABORTED", str(exc))
    except Exception as exc:  # a harness or product failure must be recorded, never hidden
        import traceback
        row.result = "FAIL"
        row.failures.append(f"exception: {exc!r}")
        row.ev("EXCEPTION", traceback.format_exc()[-1500:])
    out = row.finish()
    log(f"=== row {n}: {out['result']}")
    return out


def psql_json(sql: str) -> list:
    st = state()
    done = psql(st["db"], f"select coalesce(json_agg(q), '[]'::json) from ({sql}) q")
    return json.loads(done.stdout.strip() or "[]")


def ledger(kind: str, plan: str = "", since: str = "") -> list:
    cond = f"kind like '{kind}'"
    if plan:
        cond += f" and ref='{plan}'"
    if since:
        cond += f" and started_at >= '{since}'"
    return psql_json(f"select id, kind, ref, status, started_at, payload, metadata from operations where {cond} order by started_at")


def attempts_db(plan: str) -> list:
    return psql_json(f"select id, attempt, status, current_phase, retry_of, recovery, metadata->>'invocationId' as invocation, "
                     f"metadata->>'bootId' as boot, metadata->>'dropletId' as droplet, heartbeat_expires_at, finished_at, last_error "
                     f"from fleet_runner_attempts where plan_id='{plan}' order by attempt")


def gate(name: str, hold: bool) -> None:
    vm(f"install -d /etc/q1-gate && " + (f"touch /etc/q1-gate/hold-{name}" if hold else f"rm -f /etc/q1-gate/hold-{name}"))


def phase_procs(pattern: str = "") -> str:
    return vm(f"ps -u norn-phase -o pid,args --no-headers | grep -E {shlex.quote(pattern or '.')} | grep -v grep || true",
              check=False).stdout.strip()


def wait_hook_running(name: str, timeout=360) -> str:
    return wait_for(f"the {name} hook to be waiting in a phase", lambda: phase_procs(f"q1-hook {name}"), timeout=timeout, interval=2)


def kill_phase_tofu(sig="KILL") -> str:
    out = vm(f"pgrep -u norn-phase -x tofu -a; pkill -{sig} -u norn-phase -x tofu; echo killed=$?", check=False).stdout
    return out.strip()


def minio_py(snippet: str) -> str:
    code = ("import boto3,sys,json\n"
            f"s3=boto3.client('s3',endpoint_url='http://127.0.0.1:9000',aws_access_key_id='{MINIO_USER}',"
            f"aws_secret_access_key='{MINIO_PASS}',region_name='us-east-1')\nB='{BUCKET}'\n" + snippet)
    done = vm("/opt/norn-fleet-executor/venv/bin/python - <<'PYEOF'\n" + code + "\nPYEOF", check=False)
    if done.returncode != 0:
        return "ERROR " + done.stdout + done.stderr
    return done.stdout.strip()


def minio_keys_s3() -> list[str]:
    out = minio_py("print(json.dumps([o['Key'] for o in s3.list_objects_v2(Bucket=B).get('Contents',[])]))")
    try:
        return json.loads(out)
    except ValueError:
        return [out]


def tflock() -> dict | None:
    out = minio_py(f"""
try:
    print(s3.get_object(Bucket=B,Key='{STATE_KEY}.tflock')['Body'].read().decode())
except Exception as e:
    print('NOLOCK', type(e).__name__)""")
    if out.startswith(("NOLOCK", "ERROR")):
        return None
    try:
        return json.loads(out)
    except ValueError:
        return {"raw": out}


def delete_tflock() -> str:
    return minio_py(f"s3.delete_object(Bucket=B,Key='{STATE_KEY}.tflock'); print('deleted')")


def state_serial() -> str:
    return minio_py(f"print(json.loads(s3.get_object(Bucket=B,Key='{STATE_KEY}')['Body'].read())['serial'])")


def state_resources() -> list[str]:
    return sorted(set(json.loads(minio_py(
        f"d=json.loads(s3.get_object(Bucket=B,Key='{STATE_KEY}')['Body'].read())\n"
        "print(json.dumps([f\"{r['type']}.{r['name']}[{i.get('index_key','')}]\" for r in d['resources'] for i in r['instances']]))") or "[]")))


def invocation_id() -> str:
    return vm(f"systemctl show -p InvocationID --value {UNIT}").stdout.strip()


def boot_id() -> str:
    return vm("cat /proc/sys/kernel/random/boot_id").stdout.strip()


def unit_active() -> str:
    return vm(f"systemctl is-active {UNIT}", check=False).stdout.strip()


def current_plan() -> str:
    return (resource().get("desired") or {}).get("planId", "")


def last_applied() -> str:
    return ((resource().get("status") or {}).get("lastApplied") or {}).get("commitSha", "")


def hold_attempt_info(plan: str) -> dict:
    a = attempts_db(plan)
    return a[-1] if a else {}


def status_text() -> str:
    return norn_cli("fleet", "status", RESOURCE, check=False)[1]


def wait_blocker(fragment: str, timeout=240):
    return wait_for(f"status text containing {fragment!r}", lambda: fragment in status_text(), timeout=timeout, interval=5)


def config_only_edit(marker: str) -> dict:
    """A cluster.yaml-only change that does not alter the node set (drainTimeout of the ingress pool)."""
    text = read_work("environments/staging/nyc3/cluster.yaml")
    parts = text.split("drainTimeout:")
    # the ingress pool is the second pool: its drainTimeout is the second occurrence
    if len(parts) != 3:
        die("unexpected cluster.yaml layout")
    tail = parts[2]
    line_end = tail.index("\n")
    new_val = f" {marker}"
    return {"environments/staging/nyc3/cluster.yaml": parts[0] + "drainTimeout:" + parts[1] + "drainTimeout:" + new_val + tail[line_end:]}


def tf_resource(name: str, gate_name: str = "") -> str:
    cmd = f"/usr/local/bin/q1-hook {gate_name}" if gate_name else "/bin/true"
    return (f'resource "terraform_data" "{name}" {{\n  input = "{name}"\n  provisioner "local-exec" {{\n'
            f'    command = "{cmd}"\n  }}\n}}\n')


def approve_current(row: Row | None = None) -> str:
    plan = current_plan()
    rc, out = norn_cli("fleet", "approve", plan)
    if row:
        row.ev("norn fleet approve", out.splitlines()[-1] if out else str(rc))
    return plan


def executor_log_since(since: str, grep: str = "") -> str:
    return journal(since=since, lines=3000, grep=grep or "^[^ ]+ [^ ]+ [^ ]+ (python|systemd)")


SIGNAL = ("busy|wait:|refused|retry|attest|exiting|executor failed|norn unavailable|cannot|Started norn|Stopping norn|Stopped norn|"
          "Main process exited|Scheduled restart|state lock|force-unlock|Apply complete|Plan:|plan actions|Error|error|Failed|"
          "approve enrollment|rescanned|open attempt")


def short_journal(since: str, lines: int = 25, pattern: str = SIGNAL) -> str:
    out = vm(f"journalctl -u {UNIT} -o short-iso --no-pager --since {shlex.quote(since)} | grep -E {shlex.quote(pattern)} | "
             f"sed -E 's/lima-norn-exec //; s/^([^ ]+)-05:00 /\\1 /' | cut -c1-230 | tail -{lines}", check=False).stdout
    return out


def attempt_chain(plan: str) -> str:
    return "; ".join(f"#{a['attempt']} {a['id'][:8]} {a['status']}/{a['current_phase']} retryOf={(a['retry_of'] or '')[:8]} "
                     f"inv={(a['invocation'] or '')[:8]} boot={(a['boot'] or '')[:8]}" for a in attempts_db(plan))


REVALIDATION_SKEW = 300  # lifecycle.RevalidationSkew (5 min). See the Q1 report, bug 2.


def wait_revalidation_window(row: "Row | None" = None) -> None:
    """A converge plan recorded less than 5 minutes after the fence's last release can never start
    (fleet_plan_revalidation_required, and the rescan never re-records it): wait until a plan recorded now
    would be admissible. This is a harness accommodation for product bug 2, not product behaviour."""
    st = state()
    rows = psql_json("select extract(epoch from last_release_at) as epoch from fleet_target_fences")
    if not rows or rows[0]["epoch"] is None:
        return
    ready_at = float(rows[0]["epoch"]) + REVALIDATION_SKEW + 8
    wait = ready_at - time.time()
    if wait > 0:
        msg = f"waiting {wait:.0f}s so a new plan is recorded after the previous release + 5 min (bug 2 accommodation)"
        if row:
            row.ev("harness", msg)
        else:
            log(msg)
        time.sleep(wait)


def cmd_gate(args) -> int:
    """gate NAME [hold|release]: set or clear a q1-hook gate in the VM."""
    gate(args.name, args.action == "hold")
    log(f"gate {args.name}: {args.action}")
    return 0


def cmd_reclone(args) -> int:
    """Operator remediation for bug 6 (a corrupted executor clone after a power-off): remove the clone; the loop re-clones."""
    out = vm("find /var/lib/norn-fleet-executor/repo/.git/objects -type f -size 0 | wc -l", check=False).stdout.strip()
    log(f"empty loose objects in the executor clone: {out}")
    vm("rm -rf /var/lib/norn-fleet-executor/repo")
    log("clone removed; the loop re-clones with a repo-read grant on its next fetch")
    return 0


# ---------------------------------------------------------------------------
# Rows
# ---------------------------------------------------------------------------

def ingress_desired(n: int) -> dict:
    text = read_work("environments/staging/nyc3/cluster.yaml")
    head, sep, tail = text.partition("  ingress:")
    tail = re.sub(r"desired: \d+", f"desired: {n}", tail, count=1)
    return {"environments/staging/nyc3/cluster.yaml": head + sep + tail}


def row1(row: Row) -> None:
    """merge -> automatic converge (config-only change)."""
    base = last_applied()
    row.check(bool(base), f"baseline applied at {base[:10]}")
    wait_revalidation_window(row)
    t0 = vm_now()
    sha = commit_push(ingress_desired(3), "q1 row1: ingress pool desired 2 -> 3 (cluster.yaml only)")
    row.ev("merge", f"pushed {sha[:10]} to protected main of the fake GitHub; validate.yml push run is auto-green; no rescan, no approve")
    plan = wait_for("the watcher to record a plan for the merge (60 s poll)",
                    lambda: (resource().get("desired") or {}).get("commitSha") == sha and current_plan(), timeout=200, interval=3)
    view = converge_view()
    row.check(view.get("requiresApproval") is False, f"plan {plan[:8]} requiresApproval={view.get('requiresApproval')} (config path class)")
    row.check("approve_converge" not in status_text(), "status never asks for an approve")
    wait_applied(sha, timeout=600)
    row.ev("applied", f"lastApplied={last_applied()[:10]} generation={(resource().get('desired') or {}).get('generation')}")
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 1 and a[0]["status"] == "succeeded", "exactly one attempt, succeeded")
    approvals = ledger("fleet.converge.approve", plan)
    row.check(not approvals, "no fleet.converge.approve exists for this plan (no human action)")
    resources = state_resources()
    row.check('terraform_data.node[ingress-03]' in resources, "MinIO state holds terraform_data.node[ingress-03]")
    row.ev("MinIO state serial", state_serial())
    row.ev("executor journal", short_journal(t0, 14))


def row2(row: Row) -> None:
    """executable diff -> blocks on approval -> `norn fleet approve` -> converges."""
    wait_revalidation_window(row)
    t0 = vm_now()
    sha = commit_push({"environments/staging/nyc3/row2.tf": tf_resource("row2")},
                      "q1 row2: add environments/staging/nyc3/row2.tf (executable path class)")
    rc, out = norn_cli("fleet", "converge", RESOURCE, check=False)
    row.ev("rescan", out.splitlines()[0] if out else str(rc))
    plan = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha and current_plan(), timeout=150)
    view = converge_view()
    row.check(view.get("requiresApproval") is True and view.get("approved") is False,
              f"plan {plan[:8]} requiresApproval=true approved=false")
    st = status_text()
    row.check("approve_converge" in st, "status nextAction is approve_converge")
    row.ev("status while blocked", "\n".join(l for l in st.splitlines() if l.strip().startswith(("blocker", "next", "converge"))))
    # The loop polls every 60 s: sit through at least one full poll and prove it did not start anything.
    time.sleep(80)
    row.check(len(attempts_db(plan)) == 0, "no attempt exists after more than one executor poll")
    waits = short_journal(t0, 40)
    row.check("the converge plan needs an approve" in waits, "executor journal says: wait: the converge plan needs an approve")
    plan = approve_current(row)
    wait_applied(sha, timeout=600)
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 1 and a[0]["status"] == "succeeded", "one attempt, succeeded, after the approve")
    ap = ledger("fleet.converge.approve", plan)
    row.check(len(ap) == 1, "one fleet.converge.approve in the ledger")
    row.check('terraform_data.row2[]' in state_resources(), "MinIO state holds terraform_data.row2")
    row.ev("executor journal", short_journal(t0, 10))


# ---------------------------------------------------------------------------
# Rows 3-7: stop safety and recovery
# ---------------------------------------------------------------------------

def gated_exec(row: Row, name: str, gate_name: str, message: str, extra: dict | None = None) -> tuple[str, str]:
    """Hold `gate_name`, push an executable commit whose new resource blocks in q1-hook until released, get it
    approved, and wait until its apply is in flight. Returns (sha, plan id)."""
    wait_revalidation_window(row)
    gate(gate_name, True)
    files = {f"environments/staging/nyc3/{name}.tf": tf_resource(name, gate_name)}
    files.update(extra or {})
    sha = commit_push(files, message)
    rc, out = norn_cli("fleet", "converge", RESOURCE, check=False)
    row.ev("pushed + rescan", f"{sha[:10]} {out.splitlines()[0] if out else rc}")
    plan = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha and current_plan(), timeout=150)
    row.check(converge_view().get("requiresApproval") is True, "executable path class: plan requires an approve")
    approve_current(row)
    return sha, plan


def wait_attested(plan: str, count: int, timeout=300):
    return wait_for(f"{count} stop attestation(s) for the plan", lambda: (lambda r: r if len(r) >= count else None)(
        ledger("fleet.executor.stop-attestation", plan)), timeout=timeout, interval=4)


def attestation_summary(rec: dict) -> str:
    p = rec["payload"]
    keep = ("sourceAttemptId", "dropletId", "bootId", "invocationId", "phaseUidEmpty", "phaseProcessGroupReaped",
            "sourceCgroupEmpty", "tofuLock")
    return json.dumps({k: (v[:8] if isinstance(v, str) and len(v) > 24 and k != "tofuLock" else v) for k, v in p.items() if k in keep})


def row3(row: Row) -> None:
    """kill a phase mid-apply -> stop attestation -> `norn fleet converge --resume` -> recovers."""
    t0 = vm_now()
    sha, plan = gated_exec(row, "row3", "row3", "q1 row3: executable change; its apply is gated")
    wait_hook_running("row3")
    a = attempts_db(plan)
    row.check(len(a) == 1 and a[0]["status"] == "running", "one running attempt while tofu apply is in flight")
    src_attempt = a[0]["id"]
    lock = tflock()
    row.ev("MinIO lock before the kill", json.dumps(lock))
    row.check(bool(lock) and lock.get("Operation") == "OperationTypeApply" and str(lock.get("Who", "")).startswith("norn-phase@"),
              "an apply lock owned by norn-phase@<host> is held in MinIO")
    inv0 = invocation_id()
    row.ev("kill", kill_phase_tofu())
    wait_for("the loop to exit and systemd to start a new invocation", lambda: invocation_id() != inv0 and unit_active() == "active",
             timeout=200, interval=3)
    row.ev("new invocation", f"{inv0[:8]} -> {invocation_id()[:8]}")
    row.ev("journal", short_journal(t0, 8))
    att = wait_attested(plan, 1)
    row.ev("stop attestation #1", attestation_summary(att[0]))
    p = att[0]["payload"]
    row.check(p.get("phaseUidEmpty") and p.get("sourceCgroupEmpty") and p.get("phaseProcessGroupReaped"),
              "attestation: phase uid empty, cgroup empty, process group reaped")
    row.check(p.get("sourceAttemptId") == src_attempt and p.get("dropletId") == DEFAULT_DROPLET, "attestation names the source attempt and this droplet")
    wait_blocker("norn fleet converge")
    row.ev("status", "\n".join(l for l in status_text().splitlines() if l.strip().startswith(("blocker", "next", "active"))))
    stale = tflock()
    row.check(bool(stale) and stale.get("ID") == lock.get("ID"), "the stale .tflock is still in MinIO after the kill")
    gate("row3", False)
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume", out.splitlines()[-1] if out else str(rc))
    wait_applied(sha, timeout=900)
    chain = attempt_chain(plan)
    row.ev("attempts", chain)
    a = attempts_db(plan)
    row.check(len(a) == 2 and a[1]["retry_of"] == src_attempt and a[1]["status"] == "succeeded" and a[1]["recovery"],
              "recovery attempt retries the source and succeeded")
    att = ledger("fleet.executor.stop-attestation", plan)
    locked = [r for r in att if (r["payload"] or {}).get("tofuLock")]
    row.check(len(locked) == 1 and locked[0]["payload"]["tofuLock"].get("id") == lock.get("ID"),
              "the recovery's attestation recorded tofuLock.id == the stale lock's ID before the unlock")
    if locked:
        row.ev("stop attestation (recovery)", attestation_summary(locked[0]))
    row.check(tflock() is None, "the lock is gone from MinIO after recovery")
    row.check("terraform_data.row3[]" in state_resources(), "the gated resource exists in state")
    row.ev("journal", short_journal(t0, 30))


def row4(row: Row) -> None:
    """`systemctl restart` mid-configure."""
    wait_revalidation_window(row)
    t0 = vm_now()
    gate("nodes_configured", True)
    sha = commit_push(config_only_edit("17m"), "q1 row4: ingress drainTimeout 17m (config-only); nodes_configured hook is gated")
    plan = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha and current_plan(), timeout=150)
    row.check(converge_view().get("requiresApproval") is False, "config-only: no approve")
    wait_hook_running("nodes_configured", timeout=420)
    a = attempts_db(plan)
    row.ev("attempt at the gate", f"{a[0]['status']}/{a[0]['current_phase']}" if a else "none")
    row.check(bool(a) and a[0]["current_phase"] == "nodes_configured", "attempt is at nodes_configured with the hook running")
    src_attempt = a[0]["id"]
    boot0, inv0 = boot_id(), invocation_id()
    row.ev("systemctl restart", vm(f"systemctl restart {UNIT}; sleep 1; systemctl is-active {UNIT}", check=False).stdout.strip())
    inv1 = invocation_id()
    row.check(inv1 != inv0, f"new systemd invocation {inv0[:8]} -> {inv1[:8]}")
    row.check(not phase_procs("q1-hook"), "no norn-phase process survived the restart (KillMode=control-group)")
    att = wait_attested(plan, 1)
    p = att[0]["payload"]
    row.ev("stop attestation", attestation_summary(att[0]))
    row.check(p["bootId"] == boot0 and p["invocationId"] != inv0, "same boot, different invocation; attested by the restarted loop")
    row.check(p.get("phaseUidEmpty") and p.get("sourceCgroupEmpty"), "no norn-phase process and an empty unit cgroup")
    wait_blocker("norn fleet converge")
    gate("nodes_configured", False)
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume", out.splitlines()[-1] if out else str(rc))
    wait_applied(sha, timeout=900)
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 2 and a[1]["retry_of"] == src_attempt and a[1]["status"] == "succeeded", "recovery attempt succeeded")
    recon = psql_json(f"select payload->>'phase' as phase, payload->>'attemptId' as attempt, status from operations "
                      f"where kind='fleet.reconciliation' and ref='{plan}' order by started_at")
    row.ev("checkpoints", "; ".join(f"{r['phase']}/{r['attempt'][:8]}/{r['status']}" for r in recon))
    row.ev("journal", short_journal(t0, 20))


def power_cycle(row: Row) -> str:
    """Hard power-off (limactl stop --force), then boot. Returns the new boot id."""
    row.ev("power-off", run(["limactl", "stop", "--force", VM], check=False).stdout.strip() or "limactl stop --force")
    deadline = time.time() + 30
    while time.time() < deadline and "Running" in run(["limactl", "list", VM], check=False).stdout:
        time.sleep(1)
    row.ev("VM status", run(["limactl", "list", VM], check=False).stdout.strip().splitlines()[-1])
    done = run(["limactl", "start", "--tty=false", VM], check=False, timeout=600)
    row.ev("limactl start", (done.stdout + done.stderr).strip().splitlines()[-1] if (done.stdout + done.stderr).strip() else str(done.returncode))
    wait_for("the VM to answer", lambda: vm("true", check=False).returncode == 0, timeout=300, interval=5)
    return boot_id()


def row5(row: Row) -> None:
    """VM power-off mid-apply -> boot -> attestation with a new boot_id -> resume."""
    t0 = vm_now()
    sha, plan = gated_exec(row, "row5", "row5", "q1 row5: executable change; apply gated, VM powered off mid-apply")
    wait_hook_running("row5")
    a = attempts_db(plan)
    src_attempt = a[0]["id"]
    lock = tflock()
    boot0 = boot_id()
    row.ev("before power-off", f"boot_id={boot0} attempt={src_attempt[:8]} lock={json.dumps(lock)}")
    row.check(bool(lock) and lock.get("Operation") == "OperationTypeApply", "apply lock held at the moment of power-off")
    boot1 = power_cycle(row)
    row.check(boot1 != boot0, f"boot_id changed {boot0[:8]} -> {boot1[:8]}")
    row.ev("unit after boot", unit_active())
    att = wait_attested(plan, 1, timeout=420)
    p = att[0]["payload"]
    row.ev("stop attestation", attestation_summary(att[0]))
    row.check(p["bootId"] == boot1 and p["bootId"] != boot0, "attestation carries the NEW boot_id (the old attempt's boot differs)")
    old_boot = (attempts_db(plan)[0].get("boot") or "")
    row.check(old_boot == boot0, f"source attempt recorded the old boot_id ({old_boot[:8]})")
    wait_blocker("norn fleet converge")
    stale = tflock()
    row.check(bool(stale) and stale.get("ID") == lock.get("ID"), "the stale .tflock survived the power-off")
    gate("row5", False)
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume", out.splitlines()[-1] if out else str(rc))
    wait_applied(sha, timeout=900)
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 2 and a[1]["retry_of"] == src_attempt and a[1]["status"] == "succeeded", "recovery attempt succeeded after the reboot")
    locked = [r for r in ledger("fleet.executor.stop-attestation", plan) if (r["payload"] or {}).get("tofuLock")]
    row.check(len(locked) == 1 and locked[0]["payload"]["tofuLock"]["id"] == lock.get("ID"), "stale lock unlocked via the attested tofuLock id")
    row.check(tflock() is None, "lock gone")
    row.check("terraform_data.row5[]" in state_resources(), "resource created by the recovery")
    row.ev("journal (since boot)", short_journal(t0, 20))


def row6(row: Row) -> None:
    """lost attempt-start response replays (a: transport retry; b: every response lost, journal replay after restart)."""
    wait_revalidation_window(row)
    t0 = vm_now()
    key_re = r"/api/v1/fleet/plans/[^/]+/attempts$"
    proxy_rule("POST", key_re, "drop_response", 1)
    open(WORK / "proxy.log", "a").write("--- row 6a armed ---\n")
    sha = commit_push(config_only_edit("18m"), "q1 row6a: config-only; the first attempt-start response will be dropped")
    plan = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha and current_plan(), timeout=150)
    wait_applied(sha, timeout=600)
    log6 = proxy_log_tail(200, f"POST /api/v1/fleet/plans/{plan}/attempts")
    row.ev("proxy log (attempt start)", log6)
    lines = [l for l in log6.splitlines() if "/attempts " in l]
    row.check(len(lines) >= 2 and "(drop_response)" in lines[0] and "(pass)" in lines[1], "first attempt-start response dropped, retry passed")
    idem = {re.search(r"idem=(\S+)", l).group(1) for l in lines}
    row.check(len(idem) == 1, "the retry reuses the same Idempotency-Key")
    a = attempts_db(plan)
    row.ev("attempts", attempt_chain(plan))
    row.check(len(a) == 1 and a[0]["status"] == "succeeded", "exactly one attempt exists: the lost response created it, the replay returned it")
    row.ev("journal 6a", short_journal(t0, 8))
    # 6b: every transport retry loses its response: the loop exits, the journal replays after the restart.
    wait_revalidation_window(row)
    t1 = vm_now()
    proxy_rule("POST", key_re, "drop_response", 5)
    sha2 = commit_push(config_only_edit("19m"), "q1 row6b: config-only; five attempt-start responses will be dropped")
    plan2 = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha2 and current_plan(), timeout=150)
    att = wait_attested(plan2, 1, timeout=420)
    row.ev("6b stop attestation", attestation_summary(att[0]))
    j = short_journal(t1, 10)
    row.ev("6b journal", j)
    a = attempts_db(plan2)
    row.check(len(a) == 1, "6b: exactly one attempt exists although five responses were lost")
    log6b = proxy_log_tail(200, f"POST /api/v1/fleet/plans/{plan2}/attempts")
    row.ev("6b proxy log", log6b)
    keys = {re.search(r"idem=(\S+)", l).group(1) for l in log6b.splitlines() if "/attempts " in l}
    row.check(len(keys) == 1 and len([l for l in log6b.splitlines() if "/attempts " in l]) == 6,
              "6b: the journal replay is the 6th request with the same key and returns the stored attempt")
    wait_blocker("norn fleet converge")
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume", out.splitlines()[-1] if out else str(rc))
    wait_applied(sha2, timeout=900)
    row.ev("6b attempts", attempt_chain(plan2))


def row7(row: Row) -> None:
    """authority restart mid-run."""
    t0 = vm_now()
    sha, plan = gated_exec(row, "row7", "row7", "q1 row7: executable change; apply gated while the authority restarts")
    wait_hook_running("row7")
    row.ev("apply is running; sleeping so a supervise heartbeat falls into the outage", "")
    time.sleep(25)
    pid_before = state()["pids"]["authority"]
    stop_authority(signal.SIGTERM)
    row.ev("authority stopped", f"pid {pid_before}")
    time.sleep(22)  # covers the 40 s supervise heartbeat boundary partially and several executor/phase retries
    start_authority()
    row.ev("authority restarted", f"pid {state()['pids']['authority']} on the same database")
    gate("row7", False)
    wait_applied(sha, timeout=900)
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 1 and a[0]["status"] == "succeeded", "one attempt, succeeded, with no recovery needed")
    out = proxy_log_tail(400, "502|upstream")
    row.ev("proxy errors during the outage", out or "(none: no executor request fell into the window)")
    row.check("terraform_data.row7[]" in state_resources(), "resource created")
    row.ev("journal", short_journal(t0, 12))


