        "NORN_GITHUB_ACTIONS_ALLOWED_REFS": "refs/heads/main", "NORN_GITHUB_ACTIONS_ALLOWED_EVENTS": "push,workflow_dispatch",
        "NORN_GITHUB_ACTIONS_FLEET_ALLOWED_ENVIRONMENTS": "staging", "NORN_GITHUB_ACTIONS_FLEET_ALLOWED_INTENTS": "apply,recover",
        "NORN_GITHUB_ACTIONS_FLEET_ALLOWED_WORKFLOW_REFS": f"{OWNER}/{REPO}/.github/workflows/apply.yml@{'a' * 40}",
