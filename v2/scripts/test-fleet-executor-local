#!/usr/bin/env python3
"""Q1: local end-to-end qualification of the Fleet controller executor lane.

(docs/v3/fleet-controller/plan-5-7.md, WP Q1; ADR 0010.) Results of the 2026-10-05 run:
docs/v3/fleet-controller/qualification-executor-local-2026-10-05.md.

Topology (everything is local and fake; no real cloud or GitHub credential):

  Mac   the Norn authority (serveFleetAuthorityOnly: the real router, reconciler, converge watcher and executor lane)
        started from a test binary (v2/api/fleet_executor_local_authority_test.go, -tags fleetlocal) on its own
        PostgreSQL database; a fake GitHub (REST over http and https, plus git smart-HTTP) serving a local bare
        repository; a logging fault proxy between the VM and Norn; the etcd runtime for the gate check.
  VM    the Lima VM from v2/scripts/norn-exec-vm: the real Ansible role (ansible/roles/fleet_executor in norn-fleet)
        applied to it, the real systemd unit, real tofu 1.10.6 against MinIO with use_lockfile=true, the fake DO
        metadata service. github.com and norn.test resolve to VM-local TLS terminators (socat) that forward to the
        Mac, so the unit runs exactly as the role writes it (https Norn URL, https github.com clone URL).

Usage: test-fleet-executor-local <command> [args]
  all              setup, vm, bootstrap, baseline, every row, etcd-gate
  setup [--rebuild]  build binaries, PKI, keys, fixture repository, database; start Mac services
  vm               prepare the VM, apply the Ansible role (or redeliver secrets), enroll the executor
  bootstrap        register the target and resource, switch to controller mode, record the first plan
  baseline         approve the first converge (empty last-applied is executable) and wait for it
  rows [n ...]     run qualification rows (default: all but 8, in a safe order; row 8 leaves the fence held by the
                   GitHub lane and runs last); results in $Q1_WORK/results/row-<n>.json
  etcd-gate        start the etcd runtime and show the executor lane is gated off there
  reset            clean slate without recreating the VM (new database, repository, MinIO state)
  tls              reinstall the VM-side TLS terminators
  status           show where things are
  teardown         stop Mac processes and drop the database (the VM is left running)
  fake-github, proxy   (internal) the fake GitHub and the logging fault proxy

Environment: Q1_WORK (work dir), NORN_FLEET_DIR (norn-fleet checkout), NORN_EXEC_VM_NAME (VM name).
Needs: limactl, a provisioned norn-exec VM (v2/scripts/norn-exec-vm up), go, tofu, sops, age, ansible-playbook,
PostgreSQL 16 on 127.0.0.1:55432 (role norn_fc), etcd on 127.0.0.1:23790.

Harness accommodations, each tied to a finding in the report (they hide nothing: the findings are reported):
  * the authority runs from a test binary because validateFleetAuthorityOnly pins a verify-full PostgreSQL DSN;
  * every converge waits until its plan was recorded 5 min after the previous release (bug 2);
  * ruby is installed in the VM because the executor venv has no PyYAML (bug 4);
  * the OpenTofu fixture uses no provider plugin (bug 1) and its post-apply hooks are local scripts;
  * MinIO is cross-built from source when dl.min.io answers 410.
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import hashlib
import http.client
import http.server
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socketserver
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
NORN_ROOT = HERE.parents[1]
FLEET_DIR = Path(os.environ.get("NORN_FLEET_DIR", NORN_ROOT.parent / "norn-fleet-controller-executor")).resolve()
WORK = Path(os.environ.get("Q1_WORK", Path(tempfile.gettempdir()) / "norn-fleet-executor-local"))
VM = os.environ.get("NORN_EXEC_VM_NAME", "norn-exec")
STATE_FILE = WORK / "state.json"
OWNER, REPO = "antiartificial", "norn-fleet"
CLUSTER = "tk-staging-nyc3"
RESOURCE = "staging"
BUCKET = os.environ.get("MINIO_BUCKET", "norn-exec-state")
STATE_KEY = "staging/nyc3/terraform.tfstate"
MINIO_USER, MINIO_PASS = "norn-exec-test", "norn-exec-test-secret"
GH_PORT, NORN_PORT, PROXY_PORT, CTL_PORT, GH_TLS_PORT = 18801, 18800, 18802, 18803, 18804
UNIT = "norn-fleet-executor"
DEFAULT_DROPLET = "4242"


def log(msg: str) -> None:
    print(f"[q1 {dt.datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)


def die(msg: str) -> "None":
    print(f"test-fleet-executor-local: {msg}", file=sys.stderr)
    raise SystemExit(1)


def run(argv, *, check=True, input=None, env=None, cwd=None, timeout=None, quiet=False):
    """Run a command; return CompletedProcess with text output."""
    done = subprocess.run([str(a) for a in argv], input=input, text=True, capture_output=True,
                          env=env, cwd=cwd, timeout=timeout)
    if check and done.returncode != 0:
        die(f"command failed ({done.returncode}): {' '.join(map(str, argv))}\n{done.stdout}\n{done.stderr}")
    return done


def sh(script: str, **kw):
    return run(["bash", "-c", script], **kw)


def state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return {}


def save_state(**updates) -> dict:
    current = state()
    current.update(updates)
    WORK.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(current, indent=2, sort_keys=True))
    tmp.replace(STATE_FILE)
    return current


def rfc3339(t: dt.datetime | None = None) -> str:
    return (t or dt.datetime.now(dt.timezone.utc)).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------------------
# VM access
# ---------------------------------------------------------------------------

def vm(script: str, *, check=True, timeout=900, user="root") -> subprocess.CompletedProcess:
    """Run a bash script in the VM (as root through sudo unless user is arti)."""
    if user == "root":
        argv = ["limactl", "shell", VM, "--", "sudo", "bash", "-c", script]
    else:
        argv = ["limactl", "shell", VM, "--", "bash", "-c", script]
    return run(argv, check=check, timeout=timeout)


def vm_copy_in(local: Path, remote: str, mode: str = "0644", owner: str = "root:root") -> None:
    run(["limactl", "copy", str(local), f"{VM}:/tmp/q1-in-{local.name}"])
    vm(f"install -m {mode} -o {owner.split(':')[0]} -g {owner.split(':')[1]} /tmp/q1-in-{local.name} {shlex.quote(remote)}; rm -f /tmp/q1-in-{local.name}")


def journal(since: str = "", lines: int = 400, grep: str = "") -> str:
    cmd = f"journalctl -u {UNIT} -o short-iso --no-pager -n {lines}"
    if since:
        cmd += f" --since {shlex.quote(since)}"
    if grep:
        cmd += f" | grep -E {shlex.quote(grep)}"
    return vm(cmd, check=False).stdout


def vm_now() -> str:
    return vm("date '+%Y-%m-%d %H:%M:%S'").stdout.strip()


# ---------------------------------------------------------------------------
# Norn (authority) access from the Mac
# ---------------------------------------------------------------------------

def norn_url() -> str:
    return f"http://127.0.0.1:{NORN_PORT}"


def api_call(method: str, path: str, body=None, *, token: str | None = None, key: str = "", base: str | None = None,
             timeout=30):
    st = state()
    token = st["api_token"] if token is None else token
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request((base or norn_url()) + path, data=data, method=method)
    req.add_header("Accept", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    if key:
        req.add_header("Idempotency-Key", key)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw.strip() else {})
    except urllib.error.HTTPError as exc:
        raw = exc.read()
        try:
            return exc.code, json.loads(raw)
        except ValueError:
            return exc.code, {"raw": raw.decode(errors="replace")}
    except (urllib.error.URLError, OSError) as exc:
        return 0, {"error": str(exc)}


def norn_cli(*args, check=True, expect_fail=False, timeout=120):
    st = state()
    env = dict(os.environ, NORN_URL=norn_url(), NORN_TOKEN=st["api_token"], NO_COLOR="1")
    done = run([st["norn_bin"], *args], env=env, check=False, timeout=timeout)
    out = (done.stdout + done.stderr).strip()
    if check and not expect_fail and done.returncode != 0:
        die(f"norn {' '.join(args)} failed:\n{out}")
    return done.returncode, out


def resource() -> dict:
    code, body = api_call("GET", f"/api/v1/fleet/resources/{RESOURCE}")
    return body if code == 200 else {"_status": code, **body}


def ops(kind: str = "", ref: str = "", limit: int = 100) -> list:
    q = {"limit": str(limit)}
    if kind:
        q["kind"] = kind
    if ref:
        q["ref"] = ref
    code, body = api_call("GET", "/api/operations?" + urllib.parse.urlencode(q))
    if code != 200:
        return []
    return body if isinstance(body, list) else body.get("operations", body.get("items", []))


def wait_for(what: str, cond, timeout: int = 300, interval: float = 3.0, quiet: bool = False):
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        last = cond()
        if last:
            return last
        time.sleep(interval)
    die(f"timed out after {timeout}s waiting for {what}")


def try_wait(what: str, cond, timeout: int = 300, interval: float = 3.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        value = cond()
        if value:
            return value
        time.sleep(interval)
    return None


# ---------------------------------------------------------------------------
# Fake GitHub (REST + git smart HTTP). Runs as `fake-github`.
# ---------------------------------------------------------------------------

class FakeGitHub:
    """State lives in a JSON file so the harness can inspect and steer it."""

    def __init__(self, root: Path, port: int, ctl_port: int):
        self.root, self.port = root, port
        self.repo_dir = root / "repos" / OWNER / f"{REPO}.git"
        self.state_file = root / "gh-state.json"
        self.lock = threading.Lock()
        self.requests: list[str] = []
        if not self.state_file.exists():
            self.save({"protected": True, "validate": {}, "tokens": {}, "minted": 0, "dispatches": [], "prs": {},
                       "plan_runs": [], "artifacts": {}, "runs": {}, "next_id": 1000, "fail_next": [], "app_slug": "norn-q1"})

    def load(self) -> dict:
        return json.loads(self.state_file.read_text())

    def save(self, st: dict) -> None:
        tmp = self.state_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(st, indent=1, sort_keys=True))
        tmp.replace(self.state_file)

    def git(self, *args, check=True):
        done = subprocess.run(["git", "-C", str(self.repo_dir), *args], capture_output=True, text=True)
        if check and done.returncode != 0:
            raise RuntimeError(done.stderr)
        return done

    def tip(self, branch="main"):
        done = self.git("rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}", check=False)
        return done.stdout.strip() if done.returncode == 0 else ""

    def has(self, sha: str) -> bool:
        return bool(re.fullmatch(r"[0-9a-f]{40}", sha)) and self.git("cat-file", "-e", sha + "^{commit}", check=False).returncode == 0

    def valid_token(self, token: str) -> bool:
        st = self.load()
        exp = st["tokens"].get(token)
        return bool(exp) and exp > time.time()


def make_handler(gh: FakeGitHub):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "fake-github/1"

        def log_message(self, fmt, *args):
            line = f"{dt.datetime.now().strftime('%H:%M:%S')} {self.client_address[0]} {self.command} {self.path} -> {getattr(self, '_status', '?')}"
            gh.requests.append(line)
            del gh.requests[:-500]
            with open(gh.root / "gh-requests.log", "a") as f:
                f.write(line + "\n")

        def send_json(self, status, body, headers=None):
            raw = json.dumps(body).encode()
            self._status = status
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            for k, v in (headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(raw)

        def body(self) -> bytes:
            n = int(self.headers.get("Content-Length") or 0)
            return self.rfile.read(n) if n else b""

        def bearer(self) -> str:
            auth = self.headers.get("Authorization", "")
            return auth.split(" ", 1)[1] if auth.lower().startswith(("bearer ", "token ")) else ""

        def do_GET(self):
            self.route()

        def do_POST(self):
            self.route()

        def do_DELETE(self):
            self.route()

        def do_PUT(self):
            self.route()

        def route(self):
            parsed = urllib.parse.urlparse(self.path)
            path, query = parsed.path, urllib.parse.parse_qs(parsed.query)
            st = gh.load()
            for rule in list(st.get("fail_next", [])):
                if rule["method"] == self.command and re.search(rule["path"], path):
                    st["fail_next"].remove(rule)
                    gh.save(st)
                    self.body()
                    return self.send_json(rule.get("status", 500), {"message": "injected failure"})
            if path.startswith(f"/{OWNER}/{REPO}.git/"):
                return self.git_http(parsed)
            if path == "/app" and self.command == "GET":
                return self.send_json(200, {"slug": st["app_slug"]})
            m = re.fullmatch(r"/app/installations/(\d+)/access_tokens", path)
            if m and self.command == "POST":
                self.body()
                token = "ghs_" + secrets.token_hex(20)
                exp = time.time() + 3600
                st["tokens"][token] = exp
                st["minted"] += 1
                gh.save(st)
                return self.send_json(201, {"token": token, "expires_at": rfc3339(dt.datetime.fromtimestamp(exp, dt.timezone.utc)),
                                            "permissions": {}})
            if path == "/installation/token" and self.command == "DELETE":
                st["tokens"].pop(self.bearer(), None)
                gh.save(st)
                self._status = 204
                self.send_response(204)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            if not gh.valid_token(self.bearer()):
                return self.send_json(401, {"message": "Bad credentials"})
            base = f"/repos/{OWNER}/{REPO}"
            if path != base and not path.startswith(base + "/"):
                return self.send_json(404, {"message": "Not Found"})
            rest = path[len(base):]
            return self.repo_api(rest, query, st)

        def repo_api(self, rest, query, st):
            if rest in ("", "/"):
                return self.send_json(200, {"full_name": f"{OWNER}/{REPO}", "default_branch": "main"})
            m = re.fullmatch(r"/branches/([^/]+)", rest)
            if m:
                tip = gh.tip(urllib.parse.unquote(m.group(1)))
                if not tip:
                    return self.send_json(404, {"message": "Branch not found"})
                date = gh.git("log", "-1", "--format=%cI", tip).stdout.strip()
                etag = '"' + hashlib.sha1(f"{tip}:{st['protected']}".encode()).hexdigest() + '"'
                if self.headers.get("If-None-Match") == etag:
                    self._status = 304
                    self.send_response(304)
                    self.send_header("ETag", etag)
                    self.end_headers()
                    return
                return self.send_json(200, {"name": m.group(1), "protected": bool(st["protected"]),
                                            "commit": {"sha": tip, "commit": {"committer": {"date": date}}}},
                                      {"ETag": etag})
            m = re.fullmatch(r"/actions/workflows/([^/]+)/runs", rest)
            if m:
                return self.workflow_runs(urllib.parse.unquote(m.group(1)), query, st)
            m = re.fullmatch(r"/compare/(.+)", rest)
            if m:
                return self.compare(urllib.parse.unquote(m.group(1)), query)
            return self.dispatch_api(rest, query, st)

        def workflow_runs(self, wf, query, st):
            if wf == "validate.yml":
                sha = (query.get("head_sha") or [""])[0]
                mode = st["validate"].get(sha, "auto")
                if mode == "auto":
                    mode = "success" if gh.has(sha) else "none"
                if mode == "none":
                    return self.send_json(200, {"workflow_runs": []})
                run = {"id": 5000 + int(sha[:6], 16) % 100000, "head_sha": sha, "head_branch": "main", "event": "push",
                       "path": ".github/workflows/validate.yml", "head_repository": {"full_name": f"{OWNER}/{REPO}"},
                       "status": "completed" if mode in ("success", "failure") else "in_progress",
                       "conclusion": mode if mode in ("success", "failure") else None}
                return self.send_json(200, {"workflow_runs": [run]})
            return self.dispatch_workflow_runs(wf, query, st)

        def compare(self, spec, query):
            if "..." not in spec:
                return self.send_json(404, {"message": "Not Found"})
            base, head = spec.split("...", 1)
            if not gh.has(base) or not gh.has(head):
                return self.send_json(404, {"message": "No common ancestor"})
            if base == head:
                status = "identical"
            elif gh.git("merge-base", "--is-ancestor", base, head, check=False).returncode == 0:
                status = "ahead"
            elif gh.git("merge-base", "--is-ancestor", head, base, check=False).returncode == 0:
                status = "behind"
            else:
                status = "diverged"
            files = []
            ahead = 0
            if status == "ahead":
                files = [{"filename": p} for p in gh.git("diff", "--name-only", base, head).stdout.split("\n") if p]
                ahead = int(gh.git("rev-list", "--count", f"{base}..{head}").stdout.strip() or 0)
            page, per = int((query.get("page") or ["1"])[0]), int((query.get("per_page") or ["100"])[0])
            return self.send_json(200, {"status": status, "ahead_by": ahead, "total_commits": ahead,
                                        "files": files[(page - 1) * per:page * per]})

        # -- git smart HTTP via git http-backend --
        def git_http(self, parsed):
            auth = self.headers.get("Authorization", "")
            ok = False
            if auth.lower().startswith("basic "):
                try:
                    user, _, pw = base64.b64decode(auth.split(" ", 1)[1]).decode().partition(":")
                    ok = gh.valid_token(pw)
                except ValueError:
                    ok = False
            body = self.body()
            if not ok:
                self._status = 401
                self.send_response(401)
                self.send_header("WWW-Authenticate", 'Basic realm="GitHub"')
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            env = {"PATH": os.environ["PATH"], "GIT_PROJECT_ROOT": str(gh.root / "repos"), "GIT_HTTP_EXPORT_ALL": "1",
                   "PATH_INFO": parsed.path, "REQUEST_METHOD": self.command, "QUERY_STRING": parsed.query,
                   "CONTENT_TYPE": self.headers.get("Content-Type", ""), "CONTENT_LENGTH": str(len(body)),
                   "REMOTE_USER": "x-access-token", "REMOTE_ADDR": self.client_address[0],
                   "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null"}
            if self.headers.get("Content-Encoding"):
                env["HTTP_CONTENT_ENCODING"] = self.headers["Content-Encoding"]
            if self.headers.get("Git-Protocol"):
                env["HTTP_GIT_PROTOCOL"] = self.headers["Git-Protocol"]
            done = subprocess.run(["git", "http-backend"], input=body, env=env, capture_output=True)
            head, _, payload = done.stdout.partition(b"\r\n\r\n")
            if not _:
                head, _, payload = done.stdout.partition(b"\n\n")
            status = 200
            headers = []
            for line in head.decode(errors="replace").splitlines():
                key, _, value = line.partition(":")
                if key.lower() == "status":
                    status = int(value.strip().split()[0])
                elif key:
                    headers.append((key, value.strip()))
            self._status = status
            self.send_response(status)
            for key, value in headers:
                if key.lower() != "content-length":
                    self.send_header(key, value)
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        # GitHub-lane plan, pull request and dispatch endpoints (row 8)
        def dispatch_api(self, rest, query, st):
            return gh_lane_api(self, gh, rest, query, st)

        def dispatch_workflow_runs(self, wf, query, st):
            return gh_lane_workflow_runs(self, gh, wf, query, st)

    return Handler


def gh_lane_api(h, gh, rest, query, st):
    """GitHub-lane endpoints Norn's dispatch path uses (ResolveApprovedPlan, DispatchBoundPlan): a merged plan PR, a
    successful push plan run with its artifact, and the apply workflow dispatch with its run."""
    import io
    import zipfile
    merge_sha = st.get("lane_merge_sha") or gh.tip()
    if rest == "/pulls" and h.command == "GET":
        head = (query.get("head") or [""])[0]
        branch = head.split(":", 1)[-1]
        m = re.fullmatch(r"norn/plan-([0-9a-f-]{36})", branch)
        if not m or not st.get("lane_ready"):
            return h.send_json(200, [])
        n = 100 + int(m.group(1)[:5], 16) % 9000
        return h.send_json(200, [{"number": n, "html_url": f"https://github.com/{OWNER}/{REPO}/pull/{n}", "state": "closed",
                                  "merged_at": "2026-10-05T12:00:00Z", "head": {"ref": branch, "sha": merge_sha},
                                  "base": {"ref": "main"}, "title": "Fleet: q1 plan", "body": ""}])
    m = re.fullmatch(r"/pulls/(\d+)", rest)
    if m and h.command == "GET":
        return h.send_json(200, {"number": int(m.group(1)), "merge_commit_sha": merge_sha, "merged_at": "2026-10-05T12:00:00Z"})
    m = re.fullmatch(r"/actions/runs/(\d+)/artifacts", rest)
    if m and h.command == "GET":
        rid = int(m.group(1))
        return h.send_json(200, {"artifacts": [{"id": rid + 1, "name": f"fleet-plan-staging-nyc3-{rid}", "expired": False}]})
    m = re.fullmatch(r"/actions/artifacts/(\d+)/zip", rest)
    if m and h.command == "GET":
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            z.writestr("fleet-plan.sha256", hashlib.sha256(b"q1 lane plan").hexdigest() + "\n")
        raw = buf.getvalue()
        h._status = 200
        h.send_response(200)
        h.send_header("Content-Type", "application/zip")
        h.send_header("Content-Length", str(len(raw)))
        h.end_headers()
        h.wfile.write(raw)
        return
    m = re.fullmatch(r"/actions/runs/(\d+)", rest)
    if m and h.command == "GET":
        run = st["runs"].get(m.group(1))
        return h.send_json(200, run) if run else h.send_json(404, {"message": "Not Found"})
    if rest == "/actions/workflows/apply.yml/dispatches" and h.command == "POST":
        body = json.loads(h.body() or b"{}")
        inputs = body.get("inputs") or {}
        st["next_id"] += 1
        rid = st["next_id"]
        run = {"id": rid, "html_url": f"https://github.com/{OWNER}/{REPO}/actions/runs/{rid}", "event": "workflow_dispatch",
               "head_sha": merge_sha, "head_branch": "main", "path": ".github/workflows/apply.yml@refs/heads/main", "name": "apply",
               "display_title": f"Apply {inputs.get('fleet_environment')} Norn plan {inputs.get('norn_plan_id')} nonce {inputs.get('dispatch_nonce')}",
               "status": "queued", "conclusion": None, "run_attempt": 1, "inputs": inputs,
               "actor": {"login": st["app_slug"] + "[bot]", "type": "Bot"}}
        st["runs"][str(rid)] = run
        st["dispatches"].append({"run": rid, "plan": inputs.get("norn_plan_id"), "at": rfc3339()})
        gh.save(st)
        return h.send_json(200, {"workflow_run_id": rid, "html_url": run["html_url"]})
    return h.send_json(404, {"message": "Not Found", "path": rest})


def gh_lane_workflow_runs(h, gh, wf, query, st):
    merge_sha = st.get("lane_merge_sha") or gh.tip()
    if wf == "plan.yml":
        if not st.get("lane_ready"):
            return h.send_json(200, {"workflow_runs": []})
        return h.send_json(200, {"workflow_runs": [{"id": 9100, "head_sha": merge_sha, "status": "completed", "conclusion": "success"}]})
    if wf == "apply.yml":
        return h.send_json(200, {"workflow_runs": [{"id": int(rid)} for rid in st["runs"]]})
    return h.send_json(404, {"message": "Not Found", "workflow": wf})


class CtlHandler(http.server.BaseHTTPRequestHandler):
    gh: FakeGitHub

    def log_message(self, *a):
        pass

    def reply(self, status, body):
        raw = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        st = self.gh.load()
        if self.path == "/state":
            return self.reply(200, {**st, "tip": self.gh.tip()})
        if self.path == "/requests":
            return self.reply(200, self.gh.requests[-100:])
        self.reply(404, {})

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(n) or b"{}")
        with self.gh.lock:
            st = self.gh.load()
            if self.path == "/protected":
                st["protected"] = bool(body["value"])
            elif self.path == "/validate":
                st["validate"][body["sha"]] = body["state"]
            elif self.path == "/fail-next":
                st["fail_next"].append({"method": body["method"], "path": body["path"], "status": body.get("status", 500)})
            elif self.path == "/set":
                st.update(body)
            else:
                return self.reply(404, {})
            self.gh.save(st)
        self.reply(200, {"ok": True})


def serve_fake_github() -> int:
    gh = FakeGitHub(WORK / "gh", GH_PORT, CTL_PORT)
    CtlHandler.gh = gh
    ctl = http.server.ThreadingHTTPServer(("127.0.0.1", CTL_PORT), CtlHandler)
    threading.Thread(target=ctl.serve_forever, daemon=True).start()
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", GH_PORT), make_handler(gh))
    srv.daemon_threads = True
    # The same API over TLS for Norn: the authority-only handler pins https://api.github.com, and the
    # harness binary redirects that name to this listener (trusting the local CA).
    import ssl
    tls = http.server.ThreadingHTTPServer(("127.0.0.1", GH_TLS_PORT), make_handler(gh))
    tls.daemon_threads = True
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(str(WORK / "pki/srv.pem"), str(WORK / "pki/srv.key"))
    tls.socket = ctx.wrap_socket(tls.socket, server_side=True)
    threading.Thread(target=tls.serve_forever, daemon=True).start()
    log(f"fake GitHub on 127.0.0.1:{GH_PORT} http, {GH_TLS_PORT} https (control {CTL_PORT}), repo {gh.repo_dir}")
    srv.serve_forever()
    return 0


def gh_ctl(path: str, body=None):
    req = urllib.request.Request(f"http://127.0.0.1:{CTL_PORT}{path}", data=json.dumps(body).encode() if body is not None else None,
                                 method="POST" if body is not None else "GET")
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


# ---------------------------------------------------------------------------
# Logging fault proxy: VM -> (this) -> Norn. Rules in proxy-rules.json.
# ---------------------------------------------------------------------------

class ProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    rules_file: Path
    log_file: Path

    def log_message(self, *a):
        pass

    def rules(self) -> list:
        try:
            return json.loads(self.rules_file.read_text())
        except (OSError, ValueError):
            return []

    def save_rules(self, rules) -> None:
        self.rules_file.write_text(json.dumps(rules))

    def forward(self):
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n) if n else b""
        headers = {k: v for k, v in self.headers.items() if k.lower() not in ("host", "connection", "content-length")}
        rule = None
        with threading.Lock():
            rules = self.rules()
            for r in rules:
                if r["method"] == self.command and re.search(r["path"], self.path) and r.get("count", 1) > 0:
                    rule = dict(r)
                    r["count"] = r.get("count", 1) - 1
                    break
            if rule:
                self.save_rules(rules)
        try:
            conn = http.client.HTTPConnection("127.0.0.1", NORN_PORT, timeout=120)
            conn.request(self.command, self.path, body=body or None, headers={**headers, "Content-Length": str(len(body))} if body else headers)
            resp = conn.getresponse()
            payload = resp.read()
            status, rheaders = resp.status, resp.getheaders()
            conn.close()
        except OSError as exc:
            self._log(f"{self.command} {self.path} -> upstream error {exc}")
            payload = json.dumps({"code": "proxy_upstream_unreachable"}).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return
        action = rule["action"] if rule else "pass"
        detail = ""
        if status >= 400:
            detail = " body=" + payload[:200].decode(errors="replace").replace("\n", " ")
        self._log(f"{self.command} {self.path} -> {status} ({action}) idem={self.headers.get('Idempotency-Key', '')[:24]}{detail}")
        if action == "drop_response":
            self.close_connection = True
            try:
                self.connection.shutdown(2)
            except OSError:
                pass
            self.connection.close()
            return
        self.send_response(status)
        for k, v in rheaders:
            if k.lower() not in ("content-length", "transfer-encoding", "connection"):
                self.send_header(k, v)
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _log(self, line: str) -> None:
        with open(self.log_file, "a") as f:
            f.write(f"{dt.datetime.now().strftime('%H:%M:%S.%f')[:-3]} {line}\n")

    do_GET = do_POST = do_DELETE = do_PUT = forward


def serve_proxy() -> int:
    ProxyHandler.rules_file = WORK / "proxy-rules.json"
    ProxyHandler.log_file = WORK / "proxy.log"
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", PROXY_PORT), ProxyHandler)
    srv.daemon_threads = True
    log(f"proxy on 127.0.0.1:{PROXY_PORT} -> 127.0.0.1:{NORN_PORT}")
    srv.serve_forever()
    return 0


def proxy_rule(method: str, path: str, action: str = "drop_response", count: int = 1) -> None:
    f = WORK / "proxy-rules.json"
    try:
        rules = json.loads(f.read_text())
    except (OSError, ValueError):
        rules = []
    rules.append({"method": method, "path": path, "action": action, "count": count})
    f.write_text(json.dumps(rules))


def proxy_log_tail(n=40, grep="") -> str:
    try:
        lines = (WORK / "proxy.log").read_text().splitlines()
    except OSError:
        return ""
    if grep:
        lines = [l for l in lines if re.search(grep, l)]
    return "\n".join(lines[-n:])


# ---------------------------------------------------------------------------
# Mac-side setup: PKI, keys, fixture repository, database, binaries, services
# ---------------------------------------------------------------------------

def openssl(*args, **kw):
    return run(["openssl", *args], **kw)


def gen_pki() -> None:
    d = WORK / "pki"
    d.mkdir(parents=True, exist_ok=True)
    if (d / "ca.pem").exists():
        return
    openssl("req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", d / "ca.key", "-out", d / "ca.pem", "-days", "30",
            "-subj", "/CN=norn-q1-local-ca")
    openssl("req", "-newkey", "rsa:2048", "-nodes", "-keyout", d / "srv.key", "-out", d / "srv.csr", "-subj", "/CN=norn.test")
    (d / "ext.cnf").write_text("subjectAltName=DNS:norn.test,DNS:github.com,DNS:api.github.com\nextendedKeyUsage=serverAuth\n")
    openssl("x509", "-req", "-in", d / "srv.csr", "-CA", d / "ca.pem", "-CAkey", d / "ca.key", "-CAcreateserial", "-out", d / "srv.pem",
            "-days", "30", "-extfile", d / "ext.cnf")
    # GitHub App key (RS256) for Norn's installation-token minting.
    openssl("genrsa", "-out", d / "app.pem", "2048")
    os.chmod(d / "app.pem", 0o600)
    (d / "full.pem").write_text((d / "srv.pem").read_text() + (d / "srv.key").read_text())


def gen_keys() -> dict:
    d = WORK / "keys"
    d.mkdir(parents=True, exist_ok=True)
    if not (d / "age.key").exists():
        run(["age-keygen", "-o", d / "age.key"])
        os.chmod(d / "age.key", 0o600)
    recipient = run(["age-keygen", "-y", d / "age.key"]).stdout.strip()
    if not (d / "id_ed25519").exists():
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "q1-fixture", "-f", d / "id_ed25519"])
    pub = (d / "id_ed25519.pub").read_text().strip()
    wire = base64.b64decode(pub.split()[1])
    md5 = hashlib.md5(wire).hexdigest()
    fingerprint = ":".join(md5[i:i + 2] for i in range(0, 32, 2))
    return {"age_recipient": recipient, "ssh_public_key": pub, "ssh_fingerprint": fingerprint}


FIXTURE_MAIN_TF = '''# Q1 fixture OpenTofu root: no cloud provider and no provider plugin. Nodes are terraform_data resources derived
# from cluster.yaml, so a cluster.yaml change (config-only path class) is a real, non-destructive converge.
# (A plugin-backed provider, even hashicorp/external, makes the recovery lock probe fail on the standard path
# layout: its go-plugin unix socket path exceeds 107 bytes. See the Q1 report, bug 1.)
variable "ssh_key_fingerprints" {
  type    = list(string)
  default = []
}

variable "admin_cidrs" {
  type    = list(string)
  default = []
}

locals {
  cluster = yamldecode(file("${path.module}/cluster.yaml"))
  nodes = merge([for pool, p in local.cluster.nodePools : {
    for i in range(p.desired) : format("%s-%02d", pool, i + 1) => pool
  }]...)
}

resource "terraform_data" "node" {
  for_each = local.nodes
  input    = each.value

  provisioner "local-exec" {
    command = "/usr/local/bin/q1-hook node-create"
  }
}

output "nodes" {
  value = { for name, pool in local.nodes : name => { pool = pool, private_address = "10.20.0.${100 + index(keys(local.nodes), name)}" } }
}

output "ingress_ip" {
  value = "203.0.113.7"
}
'''

FIXTURE_VERSIONS_TF = '''terraform {
  required_version = ">= 1.8.0"
  backend "s3" {}
}
'''

FIXTURE_HOOKS = {
    "version": 1,
    "phases": {
        "nodes_configured": {"command": ["/usr/local/bin/q1-hook", "nodes_configured"], "timeoutSeconds": 900, "attempts": 1},
        "nodes_enrolled": {"command": ["/usr/local/bin/q1-hook", "nodes_enrolled"], "timeoutSeconds": 900, "attempts": 1},
        "readiness_verified": {"command": ["/usr/local/bin/q1-hook", "readiness_verified"], "timeoutSeconds": 900, "attempts": 1},
        "old_nodes_drained": {"command": ["/usr/local/bin/q1-hook", "old_nodes_drained"], "timeoutSeconds": 900, "attempts": 1},
    },
}

FIXTURE_VALIDATE_YML = "name: validate\non: [push, pull_request]\njobs: {validate: {runs-on: ubuntu-24.04, steps: [{run: echo ok}]}}\n"


def git_env():
    return dict(os.environ, GIT_AUTHOR_NAME="q1", GIT_AUTHOR_EMAIL="q1@example.test", GIT_COMMITTER_NAME="q1",
                GIT_COMMITTER_EMAIL="q1@example.test", GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_SYSTEM="/dev/null")


def git(cwd, *args, check=True):
    return run(["git", "-C", cwd, *args], env=git_env(), check=check)


def make_fixture_repo() -> str:
    """Bare repo served by the fake GitHub + a work clone. Returns the first commit sha."""
    bare = WORK / "gh" / "repos" / OWNER / f"{REPO}.git"
    work = WORK / "repo-work"
    if (work / ".git").exists():
        return git(work, "rev-parse", "HEAD").stdout.strip()
    bare.parent.mkdir(parents=True, exist_ok=True)
    run(["git", "init", "-q", "--bare", "-b", "main", bare])
    run(["git", "init", "-q", "-b", "main", work])
    # scripts/ from the norn-fleet checkout (the phases run plan_policy.py, sanity.py, ... from the converged tree)
    dest = work / "scripts"
    shutil.copytree(FLEET_DIR / "scripts", dest, ignore=shutil.ignore_patterns("__pycache__", "test_*", "executor", "*.pyc"))
    env_dir = work / "environments" / "staging" / "nyc3"
    env_dir.mkdir(parents=True)
    shutil.copy(FLEET_DIR / "environments/staging/nyc3/cluster.yaml", env_dir / "cluster.yaml")
    (env_dir / "main.tf").write_text(FIXTURE_MAIN_TF)
    (env_dir / "versions.tf").write_text(FIXTURE_VERSIONS_TF)
    (env_dir / "reconcile-hooks.json").write_text(json.dumps(FIXTURE_HOOKS, indent=2) + "\n")
    (work / ".github" / "workflows").mkdir(parents=True)
    (work / ".github" / "workflows" / "validate.yml").write_text(FIXTURE_VALIDATE_YML)
    (work / "README.md").write_text("Q1 fixture repository (a subset of norn-fleet plus a provider-free OpenTofu root).\n")
    git(work, "add", "-A")
    git(work, "commit", "-q", "-m", "q1 fixture: initial")
    git(work, "remote", "add", "origin", str(bare))
    git(work, "push", "-q", "origin", "main")
    return git(work, "rev-parse", "HEAD").stdout.strip()


def commit_push(files: dict[str, str | None], message: str, *, force=False, amend_parent: str | None = None,
                orphan: bool = False) -> str:
    """Write (or delete, value None) files in the work clone, commit, push to the fake GitHub's bare repo."""
    work = WORK / "repo-work"
    if orphan:
        git(work, "checkout", "-q", "--orphan", "rewrite-tmp")
        git(work, "rm", "-rf", "-q", "--cached", ".", check=False)
    for rel, content in files.items():
        p = work / rel
        if content is None:
            if p.exists():
                p.unlink()
            continue
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content)
    git(work, "add", "-A")
    git(work, "commit", "-q", "--allow-empty", "-m", message)
    sha = git(work, "rev-parse", "HEAD").stdout.strip()
    if orphan:
        git(work, "branch", "-q", "-M", "main")
    git(work, "push", "-q", *(["-f"] if force or orphan else []), "origin", "main")
    return sha


def read_work(rel: str) -> str:
    return (WORK / "repo-work" / rel).read_text()


def pg_url(db: str) -> str:
    return f"postgresql://norn_fc@127.0.0.1:55432/{db}?sslmode=disable"


def psql(db: str, sql: str, check=True):
    env = dict(os.environ, PATH="/opt/homebrew/opt/postgresql@16/bin:" + os.environ["PATH"])
    return run(["psql", pg_url(db), "-Atc", sql], env=env, check=check)


def build_binaries() -> None:
    d = WORK / "bin"
    d.mkdir(parents=True, exist_ok=True)
    log("building Norn CLI, authority harness binary and etcd/PG API binary from the worktree")
    run(["go", "build", "-buildvcs=false", "-o", d / "norn", "./"], cwd=NORN_ROOT / "v2" / "cli")
    run(["go", "test", "-tags", "fleetlocal", "-buildvcs=false", "-c", "-o", d / "authority.test", "."], cwd=NORN_ROOT / "v2" / "api")
    run(["go", "build", "-buildvcs=false", "-o", d / "norn-api", "."], cwd=NORN_ROOT / "v2" / "api")
    save_state(norn_bin=str(d / "norn"), authority_bin=str(d / "authority.test"), api_bin=str(d / "norn-api"))


