# Rows 9-12 and the etcd gate
# ---------------------------------------------------------------------------

def row9(row: Row) -> None:
    """force-push gives history_rewritten."""
    work = WORK / "repo-work"
    applied = last_applied()
    row.check(bool(applied), f"lastApplied is {applied[:10]}")
    old_tip = git(work, "rev-parse", "HEAD").stdout.strip()
    plan_before = current_plan()
    new_root = commit_push({"NOTE.md": "history rewritten by the Q1 harness\n"}, "q1 row9: force-pushed rewrite of main", orphan=True)
    row.ev("force-push", f"main now {new_root[:10]} (a new root); the old tip {old_tip[:10]} is no longer reachable from main")
    rc, out = norn_cli("fleet", "converge", RESOURCE, check=False)
    row.ev("norn fleet converge (rescan)", out.splitlines()[0] if out else str(rc))
    row.check("history_rewritten" in out, "the rescan reports history_rewritten")
    st = status_text()
    row.ev("status", "\n".join(l for l in st.splitlines() if l.strip().startswith(("desired", "applied", "blocker", "next"))))
    row.check("history_rewritten" in st, "status carries blocker history_rewritten")
    row.check(current_plan() == plan_before, "no new converge plan was recorded for the rewritten tip")
    time.sleep(75)
    row.check(last_applied() == applied, "lastApplied unchanged; nothing was applied")
    # Variant: the old history is garbage collected, so GitHub's compare 404s for the last-applied commit.
    gh = WORK / "gh/repos" / OWNER / f"{REPO}.git"
    run(["git", "-C", gh, "reflog", "expire", "--expire=now", "--all"], env=git_env())
    run(["git", "-C", gh, "gc", "--prune=now", "-q"], env=git_env())
    rc, out2 = norn_cli("fleet", "converge", RESOURCE, check=False)
    row.ev("after pruning the bare repo (compare 404)", out2.splitlines()[0] if out2 else str(rc))
    row.check("history_rewritten" in out2, "history_rewritten also when the last-applied commit no longer resolves (compare 404)")
    # Operator path: revert on main (restore the old history), then converge resumes.
    git(work, "checkout", "-q", "-B", "main", old_tip)
    git(work, "push", "-q", "-f", "origin", "main")
    row.ev("operator revert", f"main force-pushed back to {old_tip[:10]} (the applied tip)")
    rc, out3 = norn_cli("fleet", "converge", RESOURCE, check=False)
    row.ev("rescan after revert", out3.splitlines()[0] if out3 else str(rc))
    row.check("history_rewritten" not in out3, "blocker clears once main descends from the last-applied commit again")
    row.check("history_rewritten" not in status_text(), "status no longer shows history_rewritten")


def row10(row: Row) -> None:
    """stale MinIO .tflock left by a killed real `tofu apply`: an owned lock is unlocked, a foreign lock is refused,
    including a kill during the recovery's own `tofu plan` (P3)."""
    t0 = vm_now()
    slow = ('locals {\n  # CPU-bound on purpose (about 4 s per plan) so a plan can be killed while it holds the lock\n'
            '  q1_slow = length(flatten([for i in range(1000) : [for j in range(1000) : i * j]]))\n}\n')
    sha, plan = gated_exec(row, "row10", "row10", "q1 row10: gated apply and a deliberately slow plan",
                           extra={"environments/staging/nyc3/slow.tf": slow})
    wait_hook_running("row10", timeout=420)
    src = attempts_db(plan)[0]["id"]
    lock1 = tflock()
    row.ev("lock 1 (held by the real tofu apply)", json.dumps(lock1))
    inv0 = invocation_id()
    row.ev("kill -9 tofu apply", kill_phase_tofu())
    wait_for("a new invocation", lambda: invocation_id() != inv0 and unit_active() == "active", timeout=200, interval=3)
    wait_attested(plan, 1)
    wait_blocker("norn fleet converge")
    row.check(bool(tflock()) and tflock().get("ID") == lock1.get("ID"), "the killed apply left lock 1 in MinIO")
    # Watcher inside the VM: kill the recovery's own `tofu plan` (not the lock probe) once it holds the lock.
    watcher = ("rm -f /tmp/q1-killed; for i in $(seq 1 6000); do "
               "p=$(pgrep -u norn-phase -f 'tofu .* plan -lock-timeout=5m' | head -1); "
               "if [ -n \"$p\" ]; then sleep 1.5; kill -9 \"$p\"; echo killed-$p > /tmp/q1-killed; exit 0; fi; sleep 0.05; done")
    vm("nohup bash -c " + shlex.quote(watcher) + " >/dev/null 2>&1 &")
    gate("row10", False)
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume (1st)", out.splitlines()[-1] if out else str(rc))
    wait_for("the recovery's plan to be killed", lambda: vm("cat /tmp/q1-killed 2>/dev/null", check=False).stdout.strip(), timeout=420, interval=4)
    row.ev("killed the recovery's own tofu plan", vm("cat /tmp/q1-killed").stdout.strip())
    # recovery 1 owned lock 1 and unlocked it; its re-plan was killed and left lock 2 (Operation plan)
    att = wait_attested(plan, 3, timeout=420)
    locked = [r for r in att if (r["payload"] or {}).get("tofuLock")]
    row.check(len(locked) == 1 and locked[0]["payload"]["tofuLock"]["id"] == lock1.get("ID"),
              "owned lock: recovery 1 recorded tofuLock.id == lock 1's ID, then force-unlocked it")
    row.ev("attestation with tofuLock", attestation_summary(locked[0]) if locked else "none")
    lock2 = wait_for("lock 2 (left by the killed plan)", lambda: (lambda l: l if l and l.get("ID") != lock1.get("ID") else None)(tflock()), timeout=120, interval=3)
    row.ev("lock 2", json.dumps(lock2))
    row.check(lock2.get("Operation") == "OperationTypePlan", "the killed `tofu plan` left an Operation=OperationTypePlan lock")
    a = attempts_db(plan)
    row.ev("attempts", attempt_chain(plan))
    wait_blocker("norn fleet converge")  # the recovery attempt is the latest and its approve is consumed (budget 0)
    ids = (resource().get("status") or {}).get("active", {}).get("attemptIds") or []
    row.ev("status.active.attemptIds", json.dumps([i[:8] for i in ids]) + f" (newest attempt is {a[-1]['id'][:8]})")
    row.check(bool(ids) and ids[-1] == a[-1]["id"], "attemptIds[-1] (what the loop reads as the latest attempt) is the newest attempt")
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume (2nd)", out.splitlines()[-1] if out else str(rc))
    reported = try_wait("the state_lock_foreign blocker", lambda: "state_lock_foreign" in status_text(), timeout=200, interval=5)
    row.ev("status", "\n".join(l for l in status_text().splitlines() if l.strip().startswith(("blocker", "next"))))
    refusal = ledger("fleet.converge.refusal", plan)
    row.check(bool(reported) and any((r["payload"] or {}).get("code") == "state_lock_foreign" for r in refusal),
              "the loop reported state_lock_foreign and Norn recorded it")
    row.ev("loop journal (refusal)", short_journal(t0, 4, pattern="state lock|not reported"))
    if refusal:
        row.ev("refusal", json.dumps({k: v for k, v in refusal[-1]["payload"].items() if k in ("code", "sourceAttemptId", "tofuLock")}))
    still = tflock()
    row.check(bool(still) and still.get("ID") == lock2.get("ID"), "the foreign lock was NOT unlocked by the executor")
    # MinIO + use_lockfile=true: force-unlock with another ID refuses.
    refuse = vm_tofu("force-unlock -force 00000000-0000-0000-0000-000000000000", check=False)
    row.ev("tofu force-unlock -force <wrong id>", refuse.strip()[-300:])
    row.check(tflock() is not None and tflock().get("ID") == lock2.get("ID"), "force-unlock with another ID left the lock in place")
    row.check("force-unlock" in refuse.lower() or "failed" in refuse.lower() or "does not match" in refuse.lower() or "error" in refuse.lower(),
              "tofu refused the wrong ID on MinIO")
    # The operator clears the lock (tofu force-unlock with the right ID), then the backoff is lifted for the test.
    cleared = vm_tofu(f"force-unlock -force {lock2['ID']}", check=False)
    row.ev("operator: tofu force-unlock -force <lock 2 id>", cleared.strip()[-200:])
    row.check(tflock() is None, "operator cleared lock 2")
    vm("rm -f /var/lib/norn-fleet-executor/lock-foreign/*.json")  # skip the 30 min back-off (test accelerator)
    done = try_wait("the plan to be applied", lambda: last_applied() == sha, timeout=420, interval=6)
    row.ev("attempts", attempt_chain(plan))
    row.check(bool(done) and "terraform_data.row10[]" in state_resources(), "recovery completed after the lock was cleared")
    row.ev("journal", short_journal(t0, 30))


def row11(row: Row) -> None:
    """token self-rotation while idle."""
    meta = json.loads(vm("cat /var/lib/norn-fleet-executor/token.json").stdout)
    old_token = vm("cat /var/lib/norn-fleet-executor/token").stdout.strip()
    row.ev("token.json before", json.dumps(meta))
    code, body = api_call("GET", f"/api/v1/fleet/resources/{RESOURCE}", token=old_token)
    row.check(code == 200, f"old token works (HTTP {code})")
    # 7-day token with the 84 h rotation threshold: shorten the *recorded* expiry so the next idle tick rotates.
    soon = rfc3339(dt.datetime.now(dt.timezone.utc) + dt.timedelta(hours=2))
    meta2 = dict(meta, expiresAt=soon)
    vm(f"python3 - <<'EOF'\nimport json,os\np='/var/lib/norn-fleet-executor/token.json'\nst=os.stat(p)\n"
       f"open(p,'w').write(json.dumps({json.dumps(meta2)}))\nos.chown(p,st.st_uid,st.st_gid)\nos.chmod(p,0o600)\nEOF")
    t0 = vm_now()
    row.ev("recorded expiry set to", soon + " (token itself unchanged)")
    new = wait_for("the executor to rotate its token on an idle tick",
                   lambda: (lambda t: t if t and t != old_token else None)(vm("cat /var/lib/norn-fleet-executor/token").stdout.strip()),
                   timeout=240, interval=5)
    meta3 = json.loads(vm("cat /var/lib/norn-fleet-executor/token.json").stdout)
    row.ev("token.json after", json.dumps(meta3))
    row.check(meta3["deviceId"] == meta["deviceId"], "same device after rotation")
    remaining = (parse_ts(meta3["expiresAt"]) - dt.datetime.now(dt.timezone.utc)).total_seconds()
    row.check(remaining > 6.5 * 86400, f"new token lives about 7 days ({remaining / 86400:.2f} d)")
    row.check(meta3["scopes"] == ["fleet:execute"], "scope is still exactly fleet:execute")
    code_old, _ = api_call("GET", f"/api/v1/fleet/resources/{RESOURCE}", token=old_token)
    code_new, _ = api_call("GET", f"/api/v1/fleet/resources/{RESOURCE}", token=new)
    row.check(code_old == 401 and code_new == 200, f"old token revoked (HTTP {code_old}), new token works (HTTP {code_new})")
    row.check(vm("stat -c '%a %U' /var/lib/norn-fleet-executor/token").stdout.strip() == "600 norn-exec", "token file is 0600 norn-exec")
    row.ev("proxy log (rotate)", proxy_log_tail(10, "auth/rotate"))
    time.sleep(70)
    row.check("norn unavailable" not in short_journal(t0, 50), "the loop keeps polling with the new token")
    row.check(unit_active() == "active", "unit still active (no exit 3)")


def parse_ts(value: str) -> dt.datetime:
    value = re.sub(r"(\.\d{6})\d+", r"\1", value.replace("Z", "+00:00"))
    return dt.datetime.fromisoformat(value)


def row12(row: Row) -> None:
    """a cloned VM disk (a different droplet ID) cannot attest."""
    t0 = vm_now()
    sha, plan = gated_exec(row, "row12", "row12", "q1 row12: executable change; the loop is killed, then the 'clone' boots")
    wait_hook_running("row12")
    src = attempts_db(plan)[0]
    inv0 = invocation_id()
    row.ev("kill", kill_phase_tofu())
    # RestartSec=30s: re-point the fake metadata service at another droplet before the restarted loop reads it.
    run(["bash", str(HERE / "norn-exec-vm"), "droplet-id", "9999"])
    row.ev("droplet id", "metadata service now answers 9999 (this is the cloned disk's new droplet)")
    wait_for("the restarted loop", lambda: invocation_id() != inv0 and unit_active() == "active", timeout=200, interval=3)
    time.sleep(8)
    j = short_journal(t0, 12)
    row.ev("journal", j)
    row.check("belongs to another droplet" in j, "loop logs: open attempt belongs to another droplet: needs providerEvidence, not attestation")
    row.check(len(ledger("fleet.executor.stop-attestation", plan)) == 0, "no stop attestation was recorded")
    # Forge one with the executor's own token: the server must refuse a droplet that is not the attempt's.
    token = vm("cat /var/lib/norn-fleet-executor/token").stdout.strip()
    machine = vm("cat /etc/machine-id").stdout.strip()
    forged = {"sourceAttemptId": src["id"], "dropletId": "9999", "machineId": machine, "bootId": boot_id(),
              "invocationId": invocation_id().replace("-", "")[:32], "phaseUidEmpty": True, "phaseProcessGroupReaped": True,
              "sourceCgroupEmpty": True, "observedAt": rfc3339()}
    code, body = api_call("POST", "/api/v1/fleet/executor/stop-attestations", forged, token=token, key="q1-forged-" + secrets.token_hex(6))
    row.ev("forged attestation (dropletId=9999)", f"HTTP {code} {json.dumps(body)[:260]}")
    row.check(code in (400, 403, 409, 422), f"Norn refuses the clone's attestation (HTTP {code})")
    row.check(len(ledger("fleet.executor.stop-attestation", plan)) == 0, "still no attestation in the ledger")
    st = status_text()
    row.ev("status", "\n".join(l for l in st.splitlines() if l.strip().startswith(("blocker", "next", "active"))))
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume", check=False)
    row.ev("norn fleet converge --resume while only the clone is up", f"rc={rc} {out.splitlines()[-1] if out else ''}")
    time.sleep(75)
    a = attempts_db(plan)
    row.check(len(a) == 1, "the clone started no recovery attempt (still only the source attempt)")
    # Put the original identity back; the real host attests and recovers.
    run(["bash", str(HERE / "norn-exec-vm"), "droplet-id", DEFAULT_DROPLET])
    gate("row12", False)
    vm(f"systemctl restart {UNIT}")
    att = wait_attested(plan, 1, timeout=300)
    row.ev("stop attestation (original droplet)", attestation_summary(att[0]))
    row.check(att[0]["payload"]["dropletId"] == DEFAULT_DROPLET, "the original droplet attests")
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    wait_applied(sha, timeout=900)
    row.ev("attempts", attempt_chain(plan))


def row10b(row: Row) -> None:
    """a foreign lock (another user, another operation) left in MinIO: refused, reported, cleared by the operator, then
    the single recovery completes (the variant of row 10 that does not depend on attempt-ID ordering, bug 7)."""
    t0 = vm_now()
    slow = ('locals {\n  q1_slow = length(flatten([for i in range(1000) : [for j in range(1000) : i * j]]))\n}\n')
    sha, plan = gated_exec(row, "row10b", "row10b", "q1 row10b: gated apply and a deliberately slow plan",
                           extra={"environments/staging/nyc3/slow.tf": slow})
    wait_hook_running("row10b", timeout=420)
    src = attempts_db(plan)[0]["id"]
    inv0 = invocation_id()
    row.ev("kill -9 tofu apply", kill_phase_tofu())
    wait_for("a new invocation", lambda: invocation_id() != inv0 and unit_active() == "active", timeout=200, interval=3)
    wait_attested(plan, 1)
    own = tflock()
    row.ev("stale lock of the killed apply (owned)", json.dumps(own))
    row.ev("remove it", delete_tflock())
    # a foreign lock: `tofu plan` as root (Operation plan, Who root@host), killed while it holds the lock
    refresh_inspect_tree()
    script = ("d=/tmp/q1-foreign; rm -rf $d; mkdir -p $d; tar -xf /tmp/q1-inspect-tree.tar -C $d 2>/dev/null; cd $d; "
              f"export AWS_ACCESS_KEY_ID={MINIO_USER} AWS_SECRET_ACCESS_KEY={MINIO_PASS} AWS_EC2_METADATA_DISABLED=true; "
              f"tofu init -input=false -lockfile=readonly -backend-config=bucket={BUCKET} -backend-config=key={STATE_KEY} "
              "-backend-config=region=us-east-1 -backend-config=endpoint=http://127.0.0.1:9000 -backend-config=skip_credentials_validation=true "
              "-backend-config=skip_region_validation=true -backend-config=skip_requesting_account_id=true -backend-config=skip_metadata_api_check=true "
              "-backend-config=skip_s3_checksum=true -backend-config=use_path_style=true -backend-config=use_lockfile=true >/dev/null 2>&1; "
              "tofu plan -lock-timeout=0s -input=false -out=$d/p.tfplan >/tmp/q1-foreign.log 2>&1 & pid=$!; sleep 2; kill -9 $pid; echo killed-$pid")
    row.ev("foreign planner (root)", vm(script, check=False).stdout.strip())
    foreign = tflock()
    row.ev("foreign lock", json.dumps(foreign))
    row.check(bool(foreign) and foreign.get("Operation") == "OperationTypePlan" and str(foreign.get("Who", "")).startswith("root@"),
              "a lock held by root@host with Operation=OperationTypePlan is in MinIO")
    rc, out = norn_cli("fleet", "converge", RESOURCE, "--resume")
    row.ev("norn fleet converge --resume", out.splitlines()[-1] if out else str(rc))
    wait_blocker("state_lock_foreign", timeout=300)
    row.ev("status", "\n".join(l for l in status_text().splitlines() if l.strip().startswith(("blocker", "next"))))
    refusal = ledger("fleet.converge.refusal", plan)
    row.check(any((r["payload"] or {}).get("code") == "state_lock_foreign" for r in refusal), "fleet.converge.refusal state_lock_foreign is in the ledger")
    if refusal:
        row.ev("refusal payload", json.dumps({k: v for k, v in refusal[-1]["payload"].items() if k in ("code", "sourceAttemptId", "tofuLock")}))
        row.check(refusal[-1]["payload"].get("sourceAttemptId") == src, "the refusal names the source attempt")
    row.check(not [r for r in ledger("fleet.executor.stop-attestation", plan) if (r["payload"] or {}).get("tofuLock")],
              "no attestation carries a tofuLock: nothing was unlocked")
    row.check(tflock() is not None and tflock().get("ID") == foreign.get("ID"), "the foreign lock is still in place")
    refuse = vm_tofu("force-unlock -force 00000000-0000-0000-0000-000000000000", check=False)
    row.ev("tofu force-unlock -force <wrong id> (MinIO, use_lockfile)", refuse.strip()[:260])
    row.check("does not match" in refuse and tflock() is not None and tflock().get("ID") == foreign.get("ID"),
              "tofu refuses a force-unlock with another lock ID and leaves the lock")
    cleared = vm_tofu(f"force-unlock -force {foreign['ID']}", check=False)
    row.ev("operator: tofu force-unlock -force <the lock id>", cleared.strip()[-160:])
    row.check(tflock() is None, "the operator cleared the lock")
    vm("rm -f /var/lib/norn-fleet-executor/lock-foreign/*.json")  # skip the 30 min back-off (test accelerator)
    gate("row10b", False)
    wait_applied(sha, timeout=900)
    row.ev("attempts", attempt_chain(plan))
    a = attempts_db(plan)
    row.check(len(a) == 2 and a[1]["retry_of"] == src and a[1]["status"] == "succeeded", "the one recovery succeeded after the lock was cleared")
    row.check("terraform_data.row10b[]" in state_resources(), "resource created")
    row.ev("journal", short_journal(t0, 24))


# ---------------------------------------------------------------------------
# Row 8: GitHub-lane dispatch racing the executor on one fence
# ---------------------------------------------------------------------------

def lane_prime() -> str:
    tip = gh_ctl("/state")["tip"]
    gh_ctl("/set", {"lane_ready": True, "lane_merge_sha": tip})
    return tip


def lane_plan(row: Row, desired: int = 0) -> str:
    if not desired:  # the other value: a real change to the ingress pool of the checked-out document
        text = read_work("environments/staging/nyc3/cluster.yaml").partition("  ingress:")[2]
        current = int(re.search(r"desired: (\d+)", text).group(1))
        desired = 3 if current == 2 else 2
    code, body = api_call("POST", "/api/v1/fleet/node-pools/ingress/plan",
                          {"desired": desired, "reason": "q1 row8 GitHub-lane plan"}, key="q1-lane-plan-" + secrets.token_hex(6))
    if code not in (200, 201) or "id" not in body:
        die(f"GitHub-lane capacity plan failed: {code} {json.dumps(body)[:300]}")
    row.ev("GitHub-lane capacity plan", f"{body['id']} (ingress pool desired {desired})")
    return body["id"]


def lane_dispatch(plan: str) -> tuple[int, dict]:
    # allowDestructive is harmless for a scale-up and required when the proposal is a contraction (3 -> 2)
    return api_call("POST", f"/api/v1/fleet/plans/{plan}/github/dispatch", {"allowDestructive": True},
                    key="q1-lane-dispatch-" + secrets.token_hex(6), timeout=60)


def fence_info() -> dict:
    rows = psql_json("select held, holder_plan_id, generation, last_release_reason from fleet_target_fences")
    return rows[0] if rows else {}


def row8(row: Row) -> None:
    """GitHub-lane dispatch racing the executor on the same fence (through the fake GitHub dispatch path)."""
    tip = lane_prime()
    row.ev("fake GitHub primed", f"plan PR merged at {tip[:10]}, plan workflow green, apply dispatch endpoint live")
    # 8a: the executor holds the fence (its apply is in flight): the GitHub-lane dispatch loses.
    sha, plan = gated_exec(row, "row8", "row8", "q1 row8a: executable change; its apply holds the fence")
    wait_hook_running("row8")
    holder = fence_info()
    row.check(holder.get("held") and holder.get("holder_plan_id") == plan, f"fence held by the executor plan {plan[:8]}")
    lp = lane_plan(row)
    code, body = lane_dispatch(lp)
    row.ev("8a GitHub dispatch while the executor holds the fence", f"HTTP {code} {body.get('code', body)}")
    row.check(code == 409 and body.get("code") == "fleet_target_execution_occupied", "GitHub lane refused with fleet_target_execution_occupied")
    row.check(not gh_ctl("/state")["dispatches"], "no workflow dispatch was sent to the fake GitHub")
    gate("row8", False)
    wait_applied(sha, timeout=900)
    row.ev("8a executor attempt", attempt_chain(plan))
    # 8c: simultaneous start of both lanes. Stop the real loop so only this harness contends for the executor side.
    wait_revalidation_window(row)
    lp2 = lane_plan(row)
    vm(f"systemctl stop {UNIT}")
    sha2 = commit_push(config_only_edit("21m"), "q1 row8c: config-only change; the executor and GitHub lanes start at once")
    plan2 = wait_for("a converge plan", lambda: (resource().get("desired") or {}).get("commitSha") == sha2 and current_plan(), timeout=150)
    view = converge_view()
    token = vm("cat /var/lib/norn-fleet-executor/token").stdout.strip()
    machine = vm("cat /etc/machine-id").stdout.strip()
    inv = secrets.token_hex(16)
    wheel = vm("cat /opt/norn-fleet-executor/WHEELHOUSE_SHA256").stdout.strip()
    body = {"schemaVersion": "norn.fleet-runner-attempt/v1", "runnerAttemptId": f"executor:{DEFAULT_DROPLET}:{inv}:{plan2}",
            "commitSha": sha2, "planSha256": view["planSha256"], "workflowUrl": f"norn-executor://{DEFAULT_DROPLET}/{inv}",
            "heartbeatTimeoutSeconds": 120, "operationClass": "unknown",
            "executor": {"lane": "executor", "dropletId": DEFAULT_DROPLET, "machineId": machine, "bootId": boot_id(),
                         "invocationId": inv, "loopRelease": state().get("release_sha", "q1"), "commitSha": sha2,
                         "wheelhouseSha256": wheel, "tofuVersion": "1.10.6"}}
    results: dict = {}
    barrier = threading.Barrier(2)

    def gh_side():
        barrier.wait()
        results["github"] = lane_dispatch(lp2)

    def exec_side():
        barrier.wait()
        time.sleep(0.15)
        results["executor"] = api_call("POST", f"/api/v1/fleet/plans/{plan2}/attempts", body, token=token,
                                       key="executor-attempt:q1race" + secrets.token_hex(8), timeout=60)

    threads = [threading.Thread(target=gh_side), threading.Thread(target=exec_side)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    gcode, gbody = results["github"]
    ecode, ebody = results["executor"]
    row.ev("8c GitHub-lane dispatch", f"HTTP {gcode} {gbody.get('code', gbody.get('status', ''))}")
    row.ev("8c executor-lane attempt start (executor token)", f"HTTP {ecode} {ebody.get('code', ebody.get('status', ''))}")
    wins = [name for name, code in (("github", gcode), ("executor", ecode)) if code in (200, 201, 202)]
    row.check(len(wins) == 1, f"exactly one lane acquired the fence ({wins})")
    loser = results["executor" if "github" in wins else "github"]
    row.check(loser[0] == 409 and loser[1].get("code") == "fleet_target_execution_occupied",
              f"the other lane got 409 fleet_target_execution_occupied (HTTP {loser[0]} {loser[1].get('code')})")
    f = fence_info()
    row.ev("fence after the race", json.dumps(f))
    row.check(bool(f.get("held")), "the fence is held by exactly the winner")
    if "github" in wins:
        row.ev("fake GitHub dispatches", json.dumps(gh_ctl("/state")["dispatches"][-1:]))
    # restart the real loop: it must see a held fence and wait (busy), not start a second owner
    vm(f"systemctl start {UNIT}")
    time.sleep(75)
    row.ev("real loop after restart", short_journal(vm_now_minus(120), 6, pattern="busy|wait|attest|refused"))
    st = status_text()
    row.ev("status", "\n".join(l for l in st.splitlines() if l.strip().startswith(("active", "blocker", "next"))))


def vm_now_minus(seconds: int) -> str:
    return vm(f"date -d '-{seconds} seconds' '+%Y-%m-%d %H:%M:%S'").stdout.strip()


# ---------------------------------------------------------------------------
# etcd runtime: the executor lane is gated off there
# ---------------------------------------------------------------------------

ETCD_PORT = 18805
EXECUTOR_ROUTES = [
    ("GET", "/api/v1/fleet/resources/staging"),
    ("POST", "/api/v1/fleet/resources/staging/converge"),
    ("POST", "/api/v1/fleet/plans/00000000-0000-4000-8000-000000000000/attempts"),
    ("POST", "/api/v1/fleet/plans/00000000-0000-4000-8000-000000000000/credential-grants"),
    ("POST", "/api/v1/fleet/plans/00000000-0000-4000-8000-000000000000/converge-refusals"),
    ("POST", "/api/v1/fleet/plans/00000000-0000-4000-8000-000000000000/converge/approve"),
    ("POST", "/api/v1/fleet/plans/00000000-0000-4000-8000-000000000000/provider-evidence"),
    ("POST", "/api/v1/fleet/executor/stop-attestations"),
    ("POST", "/api/v1/enrollments"),
    ("POST", "/api/v1/enrollments/approve"),
]


def etcd_env(secret: str, prefix: str, authority: str, extra: dict | None = None) -> dict:
    env = dict(os.environ)
    env.update({
        "NORN_CONTROL_BACKEND": "etcd", "NORN_ETCD_ENDPOINTS": "http://127.0.0.1:23790", "NORN_ETCD_PREFIX": prefix,
        "NORN_CONTROL_AUTHORITY": authority, "NORN_PROFILE": "development", "NORN_ENVIRONMENT": "staging",
        "NORN_API_TOKEN": secret, "NORN_AUDIT_SIGNING_KEY": "q1-etcd-gate-audit-key-0000000000", "NORN_AUDIT_RETENTION_DAYS": "365",
        "NORN_REQUIRE_EXPLICIT_AUTH": "true", "NORN_BIND_ADDR": "127.0.0.1", "NORN_PORT": str(ETCD_PORT),
        "NORN_FLEET_CONFIG": str(WORK / "repo-work/environments/staging/nyc3/cluster.yaml"), "NORN_UI_DIR": "",
        "NORN_LEGACY_TOKEN_SIGNING_UNTIL": "2020-01-01T00:00:00Z",
        "NORN_NOMAD_ADDR": "https://nomad.example.test:4646", "NORN_CONSUL_ADDR": "https://consul.example.test:8501",
        "CONSUL_HTTP_SSL_VERIFY": "true", "NORN_REGISTRY_URL": "registry.example.test/norn",
        "NORN_FLEET_GITHUB_APP_ID": "123", "NORN_FLEET_GITHUB_INSTALLATION_ID": "456",
        "NORN_FLEET_GITHUB_PRIVATE_KEY_FILE": str(WORK / "pki/app.pem"), "NORN_FLEET_GITHUB_REPOSITORY": f"{OWNER}/{REPO}",
        "NORN_FLEET_GITHUB_ENVIRONMENT": "staging", "NORN_FLEET_GITHUB_CONFIG_PATH": "environments/staging/nyc3/cluster.yaml",
        "NORN_FLEET_GITHUB_API_BASE_URL": f"http://127.0.0.1:{GH_PORT}",
        # staging validation: exact GitHub Actions bindings and allowlists (values are fixtures, never contacted)
        "NORN_RELEASE_ADMISSION_MODE": "keyless", "NORN_RELEASE_ATTESTATION_ISSUER": "https://token.actions.githubusercontent.com",
        "NORN_RELEASE_ATTESTATION_ALLOWED_REPOSITORIES": "example/norn",
        "NORN_RELEASE_ATTESTATION_ALLOWED_WORKFLOW_REFS": "example/norn/.github/workflows/release.yml@" + "a" * 40,
        "NORN_RELEASE_REQUIRE_SBOM": "true", "NORN_GITHUB_ACTIONS_OIDC_AUDIENCE": "norn",
        "NORN_GITHUB_ACTIONS_RELEASE_BINDINGS": "demo=example/norn@1@2", "NORN_GITHUB_ACTIONS_ALLOWED_REPOSITORIES": "example/norn@1@2",
        "NORN_GITHUB_ACTIONS_ALLOWED_WORKFLOW_REFS": "example/norn/.github/workflows/release.yml@" + "a" * 40,
        "NORN_GITHUB_ACTIONS_ALLOWED_REFS": "refs/tags/v*", "NORN_GITHUB_ACTIONS_ALLOWED_EVENTS": "push",
        "NORN_GITHUB_ACTIONS_ALLOWED_APPS": "demo", "NORN_GITHUB_ACTIONS_ALLOWED_ENVIRONMENTS": "staging",
        "NORN_GITHUB_ACTIONS_DEFAULT_BRANCH": "main",
        "NORN_QUALIFICATION_SIGNING_KEY": base64.b64encode(b"q" * 32).decode().rstrip("="),
    })
    env.pop("NORN_DATABASE_URL", None)
    env.update(extra or {})
    return env


def cmd_etcd_gate(args) -> int:
    st = state()
    out = WORK / "results"
    out.mkdir(parents=True, exist_ok=True)
    row = Row("etcd-gate", "the etcd runtime serves no executor-lane routes (gate holds)")
    secret = secrets.token_urlsafe(40)
    prefix = f"/norn-q1-{dt.datetime.now().strftime('%Y%m%d%H%M%S')}/"
    authority = "1f0e5c1e-3b0b-4b53-9a9e-0d9a5b7f0a11"
    try:
        token_file = WORK / "etcd-bootstrap-token"
        token_file.unlink(missing_ok=True)
        env = etcd_env(secret, prefix, authority, {
            "NORN_ETCD_BOOTSTRAP_TOKEN_FILE": str(token_file), "NORN_ETCD_BOOTSTRAP_SUBJECT": "q1-operator",
            "NORN_ETCD_BOOTSTRAP_SCOPES": "api:read,api:write,platform:operate", "NORN_ETCD_BOOTSTRAP_TTL": "2h"})
        done = run([st["api_bin"], "--norn-etcd-bootstrap"], env=env, check=False, timeout=60)
        row.ev("bootstrap token", (done.stdout + done.stderr).strip()[-200:] or f"rc={done.returncode}")
        token = token_file.read_text().strip() if token_file.exists() else ""
        row.check(bool(token), "an etcd managed operator token exists (api:read api:write platform:operate)")
        log_f = open(WORK / "etcd-runtime.log", "wb")
        proc = subprocess.Popen([st["api_bin"]], env=etcd_env(secret, prefix, authority), stdout=log_f, stderr=log_f,
                                stdin=subprocess.DEVNULL, start_new_session=True)
        save_state(pids={**state().get("pids", {}), "etcd-runtime": proc.pid})
        base = f"http://127.0.0.1:{ETCD_PORT}"
        if not http_up(base + "/api/health", 60):
            row.result = "FAIL"
            row.ev("etcd runtime did not start", (WORK / "etcd-runtime.log").read_text()[-800:])
            return 1
        row.ev("etcd runtime up", f"pid {proc.pid} on {base}, prefix {prefix}")
        code, caps = api_call("GET", "/api/v1/capabilities", token=token, base=base)
        features = caps.get("features", [])
        row.ev("capabilities", f"backend={caps.get('backend')} mode={caps.get('mode')} features={features}")
        row.check("fleet-executor-v1" not in features, "capabilities do not advertise fleet-executor-v1")
        row.check(not any("fleetConverge" in k or "fleetExecutor" in k or "fleetCredential" in k for k in (caps.get("endpoints") or {})),
                  "capabilities list no executor-lane endpoint")
        for method, path in EXECUTOR_ROUTES:
            code, body = api_call(method, path, {} if method == "POST" else None, token=token, key="q1-gate-" + secrets.token_hex(4), base=base)
            row.ev(f"{method} {path.split('/api/v1/')[1]}", f"HTTP {code} {body.get('code', body.get('error', ''))}")
            if path.endswith("/resources/staging") or path.endswith("/attempts"):
                # pre-existing Fleet runner/resource routes: they exist on etcd for ordinary scopes; the lane principal
                # is refused on them while the gate is closed (etcdFleetLaneAuthGated laneOpen=false).
                row.ev("  (not lane-only: exists for ordinary scopes)", f"HTTP {code}")
                continue
            row.check(code == 501 and body.get("code") == "backend_route_unsupported",
                      f"{method} {path.split('/api/v1/')[1]} is not served (HTTP {code} {body.get('code', '')})")
        # a request carrying an executor-shaped bearer that is not a valid token is simply unauthorized
        code, body = api_call("POST", "/api/v1/fleet/executor/stop-attestations", {}, token="not-a-token", key="q1-gate-x", base=base)
        row.ev("unauthenticated attestation POST", f"HTTP {code}")
        row.check(code in (401, 404, 501), "no route and no auth path for the lane")
        log_text = (WORK / "etcd-runtime.log").read_text()
        row.check("watcher" not in log_text.lower() or "converge watcher enabled" not in log_text.lower(), "no converge watcher started on the etcd runtime")
    finally:
        stop_bg("etcd-runtime")
        # remove the test prefix from etcd
        run(["etcdctl", "--endpoints=http://127.0.0.1:23790", "del", "--prefix", prefix], check=False)
    res = row.finish()
    print(json.dumps({k: res[k] for k in ("row", "result", "failures")}))
    return 0 if res["result"] == "PASS" else 1


ROW_TABLE = {
    "1": ("merge -> automatic converge (config-only)", "row1"),
    "2": ("executable diff -> approval -> converge", "row2"),
    "3": ("kill a phase mid-apply -> attestation -> --resume", "row3"),
    "4": ("systemctl restart mid-configure", "row4"),
    "5": ("VM power-off mid-apply -> boot -> new boot_id attestation -> resume", "row5"),
    "6": ("lost attempt-start response replays", "row6"),
    "7": ("authority restart mid-run", "row7"),
    "8": ("GitHub-lane dispatch racing the executor on one fence", "row8"),
    "9": ("force-push gives history_rewritten", "row9"),
    "10": ("stale MinIO .tflock: owned unlocked, foreign refused", "row10"),
    "10b": ("foreign lock refused, reported, cleared, single recovery completes", "row10b"),
    "11": ("token self-rotation while idle", "row11"),
    "12": ("cloned VM disk (new droplet id) cannot attest", "row12"),
}
# Order: converge-heavy rows first, rows that leave a held fence (8) last.
DEFAULT_ORDER = ["1", "2", "3", "4", "6", "7", "5", "12", "10", "10b", "9", "11"]


def cmd_rows(args) -> int:
    wanted = args.rows or DEFAULT_ORDER
    summary = []
    for n in wanted:
        if n not in ROW_TABLE:
            die(f"unknown row {n}")
        title, fn_name = ROW_TABLE[n]
        out = run_row(n, title, globals()[fn_name])
        summary.append(out)
        if out["result"] != "PASS":
            log(f"row {n} did not pass: {out['failures']}")
    print("\n== summary ==")
    for out in summary:
        print(f"row {out['row']:>3}  {out['result']:<8} {out['title']}")
    return 0 if all(o["result"] == "PASS" for o in summary) else 1


def cmd_all(args) -> int:
    """setup -> vm -> bootstrap -> baseline -> every row -> etcd-gate (the VM is left running; use teardown)."""
    ns = argparse.Namespace(rebuild=False, rows=[])
    for step in (cmd_setup, cmd_vm, cmd_bootstrap, cmd_baseline):
        step(ns)
    rc = cmd_rows(argparse.Namespace(rows=DEFAULT_ORDER + ["8"]))
    return cmd_etcd_gate(ns) or rc


# ---MAIN---
def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    s = sub.add_parser("setup")
    s.add_argument("--rebuild", action="store_true")
    v = sub.add_parser("vm")
    v.add_argument("--as-shipped", action="store_true", help="skip accommodation W1 (TF_CLI_ARGS=-no-color)")
    for name in ("bootstrap", "etcd-gate", "status", "teardown", "fake-github", "proxy", "reset", "tls", "baseline", "all", "reclone"):
        sub.add_parser(name)
    g = sub.add_parser("gate")
    g.add_argument("name")
    g.add_argument("action", choices=("hold", "release"), nargs="?", default="release")
    r = sub.add_parser("rows")
    r.add_argument("rows", nargs="*")
    args = parser.parse_args(argv)
    WORK.mkdir(parents=True, exist_ok=True)
    fn = globals().get("cmd_" + args.command.replace("-", "_"))
    if args.command == "fake-github":
        return serve_fake_github()
    if args.command == "proxy":
        return serve_proxy()
    if fn is None:
        die(f"command {args.command} not implemented yet")
    return fn(args) or 0


if __name__ == "__main__":
    raise SystemExit(main())
