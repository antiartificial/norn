#!/usr/bin/env bash
# Opt-in M5 composition: verified signed candidate + private restored database
# + a disposable macOS LaunchAgent. It never targets the live API label/port.
set -euo pipefail

write_shadow_env() {
  local output=$1
  RUNTIME_ENV="$output" PRIVATE_DATABASE_URL="$NORN_REHEARSAL_PRIVATE_DATABASE_URL" IDENTITY_KEY="$NORN_M5_SHADOW_IDENTITY_KEY" SHADOW_PORT="$NORN_M5_SHADOW_PORT" SHADOW_DB_SESSION="$NORN_M5_SHADOW_DB_SESSION" python3 - <<'PY'
import os, re, shlex, stat, urllib.parse

output = os.environ['RUNTIME_ENV']
database_url = os.environ['PRIVATE_DATABASE_URL']
parsed = urllib.parse.urlparse(database_url)
query = urllib.parse.parse_qs(parsed.query, keep_blank_values=True, strict_parsing=True)
session = os.environ['SHADOW_DB_SESSION']
identity_key = os.environ['IDENTITY_KEY']
if (parsed.scheme not in ('postgres', 'postgresql') or parsed.hostname is not None
        or parsed.path != '/norn_private' or parsed.fragment
        or set(query) != {'host', 'port', 'sslmode'}
        or any(len(values) != 1 for values in query.values())):
    raise SystemExit('private database URL does not name the isolated socket target')
if not re.fullmatch(r'norn-m5-shadow-[0-9a-f]{16}', session):
    raise SystemExit('private database session marker is invalid')
if not re.fullmatch(r'[0-9a-f]{64}', identity_key):
    raise SystemExit('shadow database identity key is unavailable')
socket_dir = query['host'][0]
scratch_dir = os.path.dirname(socket_dir)
if (not os.path.isabs(socket_dir) or os.path.islink(socket_dir) or os.path.islink(scratch_dir)
        or not os.path.basename(scratch_dir).startswith('norn-mini-private-copy.')):
    raise SystemExit('private database socket target is outside the rehearsal')
info = os.stat(socket_dir)
scratch_info = os.stat(scratch_dir)
if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) != 0o700
        or not stat.S_ISDIR(scratch_info.st_mode) or scratch_info.st_uid != os.getuid()
        or stat.S_IMODE(scratch_info.st_mode) != 0o700):
    raise SystemExit('private database socket target ownership or mode is unsafe')
try:
    port = int(query['port'][0])
except ValueError:
    raise SystemExit('private database socket port is invalid')
if not 1 <= port <= 65535 or query['sslmode'][0] != 'disable':
    raise SystemExit('private database socket settings are invalid')
runtime_query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
runtime_query.append(('application_name', session))
runtime_url = urllib.parse.urlunparse(parsed._replace(query=urllib.parse.urlencode(runtime_query)))
values = {
    'NORN_DATABASE_URL': runtime_url,
    'NORN_AUDIT_SIGNING_KEY': identity_key,
    'NORN_PORT': os.environ['SHADOW_PORT'],
    'NORN_BIND_ADDR': '127.0.0.1',
    'NORN_STARTUP_MODE': 'passive',
    'NORN_SCHEMA_MODE': 'check',
    'NORN_SKIP_DEPLOYMENT_RECOVERY': 'true',
    'NORN_SKIP_OPERATION_RECOVERY': 'true',
    'NORN_SKIP_OPERATION_WORKER': 'true',
    'NORN_SKIP_NOMAD_WATCHER': 'true',
}
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
fd = os.open(output, flags, 0o600)
with os.fdopen(fd, 'w', encoding='utf-8') as handle:
    for name, value in values.items():
        handle.write(f'{name}={shlex.quote(value)}\n')
PY
  local round_trip
  round_trip=$(/bin/bash -c 'set -a; . "$1"; printf %s "$NORN_DATABASE_URL"' _ "$output")
  ROUND_TRIP="$round_trip" PRIVATE_DATABASE_URL="$NORN_REHEARSAL_PRIVATE_DATABASE_URL" SHADOW_DB_SESSION="$NORN_M5_SHADOW_DB_SESSION" python3 - <<'PY' || {
import os, urllib.parse
actual = urllib.parse.urlparse(os.environ['ROUND_TRIP'])
expected = urllib.parse.urlparse(os.environ['PRIVATE_DATABASE_URL'])
query = urllib.parse.parse_qs(actual.query, keep_blank_values=True, strict_parsing=True)
if query.pop('application_name', []) != [os.environ['SHADOW_DB_SESSION']]:
    raise SystemExit(1)
actual_base = actual._replace(query='')
expected_base = expected._replace(query='')
actual_query = sorted((key, value) for key, values in query.items() for value in values)
expected_query = sorted(urllib.parse.parse_qsl(expected.query, keep_blank_values=True))
if actual_base != expected_base or actual_query != expected_query:
    raise SystemExit(1)
PY
    echo 'private database URL changed while rendering the shadow environment' >&2
    return 2
  }
}

verify_shadow_schema() {
  local schema_json=$1
  # The API replaces libpq application_name with its reader-contract label, so
  # pg_stat_activity cannot retain the rehearsal marker. Instead bind the
  # LaunchAgent PID to the HMAC of its exact sourced DSN. This payload is only
  # constructed after store.Connect has pinged PostgreSQL and the passive
  # schema check has completed a read-only transaction.
  SCHEMA_JSON="$schema_json" DATABASE_URL="$NORN_DATABASE_URL" SIGNING_KEY="$NORN_M5_SHADOW_IDENTITY_KEY" EXPECTED_PID="$NORN_M5_SHADOW_PID" EXPECTED_VERSION="$NORN_M5_SHADOW_VERSION" python3 - <<'PY'
import hashlib, hmac, json, os

database_url = os.environ['DATABASE_URL']
signing_key = os.environ['SIGNING_KEY']
if not database_url or len(signing_key) < 32:
    raise SystemExit('shadow database binding inputs are unavailable')
mac = hmac.new(signing_key.encode(), digestmod=hashlib.sha256)
mac.update(b'norn.database-identity/v1\x00')
mac.update(database_url.encode())
expected_identity = 'hmac-sha256:' + mac.hexdigest()
with open(os.environ['SCHEMA_JSON'], encoding='utf-8') as source:
    schema = json.load(source)
if schema.get('processId') != int(os.environ['EXPECTED_PID']):
    raise SystemExit('shadow schema response does not belong to the LaunchAgent process')
if not hmac.compare_digest(str(schema.get('databaseIdentity', '')), expected_identity):
    raise SystemExit('shadow schema response is not bound to the exact private database URL')
if schema.get('version') != os.environ['EXPECTED_VERSION']:
    raise SystemExit('shadow schema response does not belong to the verified candidate')
if schema.get('startupMode') != 'passive' or schema.get('schemaMode') != 'check':
    raise SystemExit('shadow LaunchAgent startup mode is not isolated')
if any(schema.get(key) is not False for key in ('operationRecoveryEnabled', 'operationWorkerEnabled', 'nomadWatcherEnabled')):
    raise SystemExit('shadow LaunchAgent enabled recovery or workers')
PY
}

remove_scratch() {
  local path=$1
  if [[ -d $path ]]; then
    find "$path" -type d -exec chmod u+w -- {} + 2>/dev/null || true
    rm -rf -- "$path"
  fi
}

shadow_start() {
  [[ ${NORN_M5_SIGNED_SHADOW_REHEARSAL:-} == 1 ]] || { echo 'shadow handoff requires explicit rehearsal opt-in' >&2; return 2; }
  [[ ${NORN_M5_SHADOW_SESSION:-} == /* && -f ${NORN_M5_SHADOW_SESSION:-} && ! -L ${NORN_M5_SHADOW_SESSION:-} ]] || { echo 'shadow handoff capability is absent' >&2; return 2; }
  read -r session_label session_port session_token session_identity_key <"$NORN_M5_SHADOW_SESSION"
  [[ $session_label == "${NORN_M5_SHADOW_LABEL:-}" && $session_port == "${NORN_M5_SHADOW_PORT:-}" && $session_token == "${NORN_M5_SHADOW_HANDOFF_TOKEN:-}" ]] || { echo 'shadow handoff capability does not match this run' >&2; return 2; }
  [[ $session_identity_key =~ ^[0-9a-f]{64}$ ]] || { echo 'shadow handoff identity key is invalid' >&2; return 2; }
  [[ -n ${NORN_REHEARSAL_PRIVATE_DATABASE_URL:-} ]] || { echo 'missing socket-only private database URL' >&2; return 2; }
  [[ ${NORN_M5_SHADOW_LABEL:-} =~ ^com\.norn\.m5\.shadow\.[0-9a-f]{12}\.[0-9a-f]{16}$ ]] || { echo 'shadow label is invalid' >&2; return 2; }
  [[ ${NORN_M5_SHADOW_DB_SESSION:-} == "norn-m5-shadow-${NORN_M5_SHADOW_LABEL##*.}" ]] || { echo 'shadow database session does not match this run' >&2; return 2; }
  [[ ${NORN_M5_SHADOW_PORT:-} =~ ^[0-9]+$ && $NORN_M5_SHADOW_PORT -ge 1024 && $NORN_M5_SHADOW_PORT -le 65535 && $NORN_M5_SHADOW_PORT -ne 8800 ]] || { echo 'shadow port is invalid' >&2; return 2; }
  NORN_M5_SHADOW_ROOT="$NORN_M5_SHADOW_ROOT" NORN_M5_SHADOW_SESSION="$NORN_M5_SHADOW_SESSION" NORN_M5_SHADOW_PLIST="$NORN_M5_SHADOW_PLIST" NORN_M5_SHADOW_ENV="$NORN_M5_SHADOW_ENV" NORN_M5_SHADOW_LAUNCHER="$NORN_M5_SHADOW_LAUNCHER" NORN_M5_SHADOW_API="$NORN_M5_SHADOW_API" NORN_M5_SHADOW_RELEASE="$NORN_M5_SHADOW_RELEASE" python3 - <<'PY'
import os, stat
root=os.path.realpath(os.environ['NORN_M5_SHADOW_ROOT'])
info=os.lstat(root)
if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700: raise SystemExit('shadow root ownership or mode is unsafe')
for name in ('NORN_M5_SHADOW_SESSION','NORN_M5_SHADOW_PLIST','NORN_M5_SHADOW_ENV','NORN_M5_SHADOW_LAUNCHER','NORN_M5_SHADOW_API','NORN_M5_SHADOW_RELEASE'):
    path=os.environ[name]
    if os.path.islink(path) or os.path.commonpath((root, os.path.realpath(path))) != root: raise SystemExit('shadow path escapes its private root')
session=os.lstat(os.environ['NORN_M5_SHADOW_SESSION'])
release=os.lstat(os.environ['NORN_M5_SHADOW_RELEASE'])
api=os.lstat(os.environ['NORN_M5_SHADOW_API'])
if session.st_uid != os.getuid() or stat.S_IMODE(session.st_mode) != 0o600: raise SystemExit('shadow handoff capability ownership or mode is unsafe')
if not stat.S_ISDIR(release.st_mode) or release.st_uid != os.getuid() or not stat.S_ISREG(api.st_mode) or api.st_uid != os.getuid(): raise SystemExit('shadow signed snapshot ownership is unsafe')
PY
  canonical_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
  canonical_manifest="$canonical_root/v2/scripts/platform-release-manifest"
  canonical_artifact="$canonical_root/v2/scripts/platform-release-artifact"
  [[ $("$canonical_manifest" verify --release "$NORN_M5_SHADOW_RELEASE" --expected-sha "$NORN_M5_SHADOW_SHA") == signed ]] || { echo 'shadow candidate snapshot no longer verifies as signed' >&2; return 1; }
  "$canonical_artifact" verify --release-dir "$NORN_M5_SHADOW_RELEASE" --public-key "$NORN_M5_SHADOW_PUBLIC_KEY" --quiet
  [[ ${NORN_M5_SHADOW_PLIST:-} != "$HOME/Library/LaunchAgents"/* ]] || { echo 'shadow plist must not use the live LaunchAgents directory' >&2; return 2; }
  NORN_M5_SHADOW_IDENTITY_KEY="$session_identity_key" write_shadow_env "$NORN_M5_SHADOW_ENV"
  printf '#!/usr/bin/env bash\nset -a\n. %q\nset +a\nexec %q\n' "$NORN_M5_SHADOW_ENV" "$NORN_M5_SHADOW_API" >"$NORN_M5_SHADOW_LAUNCHER"
  chmod 700 "$NORN_M5_SHADOW_LAUNCHER"
  PLIST="$NORN_M5_SHADOW_PLIST" LABEL="$NORN_M5_SHADOW_LABEL" LAUNCHER="$NORN_M5_SHADOW_LAUNCHER" python3 - <<'PY'
import os, plistlib
with open(os.environ['PLIST'], 'wb') as f:
    plistlib.dump({'Label': os.environ['LABEL'], 'ProgramArguments': [os.environ['LAUNCHER']],
                   'RunAtLoad': True, 'KeepAlive': False,
                   'StandardOutPath': os.environ['PLIST'] + '.out',
                   'StandardErrorPath': os.environ['PLIST'] + '.err'}, f)
PY
  chmod 600 "$NORN_M5_SHADOW_PLIST"
  command -v launchctl >/dev/null || { echo 'launchctl is required for the shadow run' >&2; return 2; }
  command -v lsof >/dev/null || { echo 'lsof is required for the shadow run' >&2; return 2; }
  : >"$NORN_M5_SHADOW_RUNTIME_ATTEMPTED_FILE"
  launchctl bootstrap "gui/$(id -u)" "$NORN_M5_SHADOW_PLIST"
  : >"$NORN_M5_SHADOW_BOOTSTRAPPED_FILE"
  shadow_pid=
  for _ in $(seq 1 50); do
    shadow_state=$(launchctl print "gui/$(id -u)/$NORN_M5_SHADOW_LABEL" 2>/dev/null || true)
    shadow_pid=$(awk '/^[[:space:]]*pid = [1-9][0-9]*/ { print $3; exit }' <<<"$shadow_state")
    [[ $shadow_pid =~ ^[1-9][0-9]*$ ]] && break
    sleep 0.1
  done
  [[ $shadow_pid =~ ^[1-9][0-9]*$ ]] || { echo 'shadow LaunchAgent has no running PID' >&2; return 1; }
  shadow_ready=false
  for _ in $(seq 1 50); do
    if curl -fsS "http://127.0.0.1:$NORN_M5_SHADOW_PORT/api/health" >"$NORN_M5_SHADOW_ROOT/health.json" 2>/dev/null; then
      shadow_ready=true
      break
    fi
    kill -0 "$shadow_pid" >/dev/null 2>&1 || break
    sleep 0.1
  done
  [[ $shadow_ready == true ]] || {
    echo 'shadow LaunchAgent failed to serve health' >&2
    sed -n '1,120p' "$NORN_M5_SHADOW_PLIST.err" >&2
    return 1
  }
  [[ $(lsof -nP -iTCP:"$NORN_M5_SHADOW_PORT" -sTCP:LISTEN -t 2>/dev/null | sort -u) == "$shadow_pid" ]] || {
    echo 'shadow port is not solely owned by the shadow LaunchAgent' >&2; return 1;
  }
  curl -fsS "http://127.0.0.1:$NORN_M5_SHADOW_PORT/api/version" >"$NORN_M5_SHADOW_ROOT/version.json"
  curl -fsS "http://127.0.0.1:$NORN_M5_SHADOW_PORT/api/schema" >"$NORN_M5_SHADOW_ROOT/schema.json"
  local runtime_database_url
  runtime_database_url=$(/bin/bash -c 'set -a; . "$1"; printf %s "$NORN_DATABASE_URL"' _ "$NORN_M5_SHADOW_ENV")
  NORN_DATABASE_URL="$runtime_database_url" NORN_M5_SHADOW_IDENTITY_KEY="$session_identity_key" NORN_M5_SHADOW_PID="$shadow_pid" verify_shadow_schema "$NORN_M5_SHADOW_ROOT/schema.json"
  VERSION_JSON="$NORN_M5_SHADOW_ROOT/version.json" EXPECTED_VERSION="$NORN_M5_SHADOW_VERSION" python3 - <<'PY'
import json, os
with open(os.environ['VERSION_JSON'], encoding='utf-8') as source:
    version = json.load(source)
if version.get('version') != os.environ['EXPECTED_VERSION']:
    raise SystemExit('shadow LaunchAgent did not serve the verified candidate')
PY
  launchctl bootout "gui/$(id -u)/$NORN_M5_SHADOW_LABEL"
  : >"$NORN_M5_SHADOW_RUNTIME_PASSED_FILE"
  echo "signed shadow LaunchAgent passed: $NORN_M5_SHADOW_LABEL"
}

if [[ ${1:-} == render-env ]]; then write_shadow_env "${2:-}"; exit $?; fi
if [[ ${1:-} == verify-shadow-schema ]]; then verify_shadow_schema "${2:-}"; exit $?; fi
if [[ ${1:-} == shadow-start ]]; then shadow_start; exit $?; fi

usage() { echo 'set NORN_M5_SIGNED_SHADOW_REHEARSAL=1 and use: run --candidate-release <absolute> --public-key <absolute>' >&2; exit 2; }
[[ ${NORN_M5_SIGNED_SHADOW_REHEARSAL:-} == 1 && ${1:-} == run ]] || usage
shift
release= public_key=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidate-release) release=${2:-}; shift 2 ;;
    --public-key) public_key=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done
[[ $release == /* && -d $release && ! -L $release && $public_key == /* && -f $public_key && ! -L $public_key ]] || usage
[[ -n ${NORN_REHEARSAL_BACKUP_ARTIFACT:-} && -n ${NORN_REHEARSAL_BACKUP_PROOF:-} && -z ${NORN_REHEARSAL_SOURCE_DATABASE_URL:-} ]] || { echo 'signed shadow rehearsal requires protected backup mode without a source URL' >&2; exit 2; }
root=$(cd "$(dirname "$0")/../.." && pwd)
source_release=$release
manifest="$root/v2/scripts/platform-release-manifest"
artifact="$root/v2/scripts/platform-release-artifact"
receipt=${NORN_M5_SHADOW_RECEIPT:-}
[[ $receipt == /* && ! -e $receipt && -d $(dirname "$receipt") ]] || { echo 'NORN_M5_SHADOW_RECEIPT must be a new absolute path in an existing directory' >&2; exit 2; }
scratch=$(mktemp -d "${TMPDIR:-/tmp}/norn-m5-signed-shadow.XXXXXX")
chmod 700 "$scratch"
trap 'remove_scratch "$scratch"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
candidate_copy="$scratch/$(basename "$source_release")"
key_copy="$scratch/pinned-release-public-key"
PUBLIC_KEY="$public_key" KEY_COPY="$key_copy" python3 - <<'PY'
import os, stat
source=os.environ['PUBLIC_KEY']; target=os.environ['KEY_COPY']
flags=os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
fd=os.open(source, flags)
try:
    info=os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid(): raise SystemExit('pinned public key is unsafe')
    out=os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        while chunk:=os.read(fd, 65536): os.write(out, chunk)
    finally: os.close(out)
finally: os.close(fd)
PY
public_key="$key_copy"
cp -RP "$release" "$candidate_copy"
[[ -z $(find "$candidate_copy" -type l -print -quit) ]] || { remove_scratch "$scratch"; echo 'candidate release snapshot contains a symbolic link' >&2; exit 2; }
release="$candidate_copy"
api="$release/bin/norn-api"
[[ -x $manifest && -x $artifact && -x $api && -f $release/release.env ]] || { remove_scratch "$scratch"; echo 'candidate release or trusted verifier is incomplete' >&2; exit 2; }
read -r sha version < <(RELEASE_ENV="$release/release.env" python3 - <<'PY'
import os, re
rows = dict(row.rstrip('\n').split('=', 1) for row in open(os.environ['RELEASE_ENV'], encoding='utf-8') if '=' in row)
sha, version = rows.get('NORN_RELEASE_SHA',''), rows.get('NORN_RELEASE_VERSION','')
if not re.fullmatch(r'[0-9a-f]{40}', sha) or not re.fullmatch(r'v[0-9]+\.[0-9]+\.[0-9]+-platform(?:-[0-9]+-g[0-9a-f]{7,40})?', version): raise SystemExit(2)
if '-g' in version and not sha.startswith(version.rsplit('-g',1)[1]): raise SystemExit(2)
print(sha, version)
PY
)
[[ $(basename "$source_release") == "$sha" ]] || { echo 'candidate release directory does not match its signed SHA' >&2; exit 1; }
[[ $("$manifest" verify --release "$release" --expected-sha "$sha") == signed ]] || { echo 'candidate manifest is not signed' >&2; exit 1; }
"$artifact" verify --release-dir "$release" --public-key "$public_key" --quiet
nonce=$(python3 -c 'import secrets; print(secrets.token_hex(8))')
label="com.norn.m5.shadow.${sha:0:12}.$nonce"
db_session="norn-m5-shadow-$nonce"
identity_key=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
port=$(python3 - <<'PY'
import socket
while True:
    s=socket.socket(); s.bind(('127.0.0.1', 0)); port=s.getsockname()[1]; s.close()
    if port != 8800: print(port); break
PY
)
hook="$scratch/shadow-hook"
printf '#!/usr/bin/env bash\nexec %q shadow-start\n' "$0" >"$hook"; chmod 700 "$hook"
session="$scratch/handoff-capability"
token=$(python3 -c 'import secrets; print(secrets.token_hex(32))')
printf '%s %s %s %s\n' "$label" "$port" "$token" "$identity_key" >"$session"; chmod 600 "$session"
bootstrapped="$scratch/bootstrapped"
runtime_attempted="$scratch/runtime-attempted"
runtime_passed="$scratch/runtime-passed"
write_receipt() { status=$1 RECEIPT="$receipt" SHA="$sha" LABEL="$label" PORT="$port" ATTEMPTED="$runtime_attempted" PASSED="$runtime_passed" BACKUP_ARTIFACT="$NORN_REHEARSAL_BACKUP_ARTIFACT" BACKUP_PROOF="$NORN_REHEARSAL_BACKUP_PROOF" python3 - <<'PY'
import datetime,hashlib,json,os,tempfile
runtime='passed' if os.path.exists(os.environ['PASSED']) and int(os.environ['status']) == 0 else ('failed' if os.path.exists(os.environ['ATTEMPTED']) else 'not-run')
with open(os.environ['BACKUP_PROOF'], encoding='utf-8') as source: proof=json.load(source)
digest=hashlib.sha256()
with open(os.environ['BACKUP_ARTIFACT'],'rb') as source:
    for chunk in iter(lambda:source.read(1024*1024),b''): digest.update(chunk)
size=os.path.getsize(os.environ['BACKUP_ARTIFACT'])
if proof.get('backupSHA256') != digest.hexdigest() or proof.get('backupBytes') != size:
    raise SystemExit('protected backup changed before shadow receipt publication')
value={'schema':'norn.m5-signed-shadow-launchagent-rehearsal/v2','completedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'exitCode':int(os.environ['status']),'candidateSHA':os.environ['SHA'],'shadowLabel':os.environ['LABEL'],'shadowPort':int(os.environ['PORT']),'runtimeClaim':runtime,'privateRestoreClaim':'passed' if runtime == 'passed' else 'unproven','backupSHA256':digest.hexdigest(),'backupBytes':size}
fd,path=tempfile.mkstemp(prefix='.norn-m5-shadow-receipt.',dir=os.path.dirname(os.environ['RECEIPT'])); os.fchmod(fd,0o600)
with os.fdopen(fd,'w') as f: json.dump(value,f,sort_keys=True); f.write('\n')
try: os.link(path, os.environ['RECEIPT'])
except FileExistsError: raise SystemExit('shadow receipt path was claimed concurrently')
finally: os.unlink(path)
PY
}
cleanup() {
  status=$?
  trap - EXIT INT TERM HUP
  cleanup_failed=false
  if [[ -f $bootstrapped ]]; then launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true; fi
  write_receipt "$status" || cleanup_failed=true
  remove_scratch "$scratch" || cleanup_failed=true
  if [[ $cleanup_failed == true && $status -eq 0 ]]; then status=1; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
export NORN_M5_SHADOW_ROOT="$scratch" NORN_M5_SHADOW_LABEL="$label" NORN_M5_SHADOW_DB_SESSION="$db_session" NORN_M5_SHADOW_PORT="$port" NORN_M5_SHADOW_VERSION="$version" NORN_M5_SHADOW_API="$api" NORN_M5_SHADOW_RELEASE="$release" NORN_M5_SHADOW_SHA="$sha" NORN_M5_SHADOW_MANIFEST="$manifest" NORN_M5_SHADOW_ARTIFACT="$artifact" NORN_M5_SHADOW_PUBLIC_KEY="$public_key" NORN_M5_SHADOW_SESSION="$session" NORN_M5_SHADOW_HANDOFF_TOKEN="$token" NORN_M5_SHADOW_BOOTSTRAPPED_FILE="$bootstrapped" NORN_M5_SHADOW_RUNTIME_ATTEMPTED_FILE="$runtime_attempted" NORN_M5_SHADOW_RUNTIME_PASSED_FILE="$runtime_passed"
export NORN_M5_SHADOW_PLIST="$scratch/$label.plist" NORN_M5_SHADOW_ENV="$scratch/runtime.env" NORN_M5_SHADOW_LAUNCHER="$scratch/launch-shadow-api"
NORN_CANDIDATE_SHA="$sha" NORN_CANDIDATE_VERSION="$version" NORN_REHEARSAL_SHADOW_COMMAND="$hook" "$root/v2/scripts/mini-private-copy-rehearsal" "$api"
