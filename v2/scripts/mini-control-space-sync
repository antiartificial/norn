#!/usr/bin/env python3
"""Upload one verified Mini control checkpoint to a private Space and read it back."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys

import boto3


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--directory", required=True, type=Path)
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--credentials", required=True, type=Path)
    parser.add_argument("--bucket", required=True)
    parser.add_argument("--region", required=True)
    args = parser.parse_args()
    info = args.credentials.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError("Space credentials must be an owner-only regular file")
    if not args.bucket.startswith("norn-mini-control-temp-") or args.region != "nyc3":
        raise ValueError("unexpected temporary Space identity")
    credential = json.loads(args.credentials.read_text())
    if not credential.get("access_key") or not credential.get("secret_key"):
        raise ValueError("Space credentials are incomplete")
    checked = subprocess.run([sys.executable, str(Path(__file__).with_name("mini-control-checkpoint")),
                              "--directory", str(args.directory), "--verify", args.checkpoint],
                             check=True, capture_output=True, text=True, timeout=90)
    manifest = json.loads(checked.stdout)
    archive = args.directory / manifest["archive"]
    manifest_path = args.directory / (args.checkpoint + ".json")
    client = boto3.client("s3", endpoint_url=f"https://{args.region}.digitaloceanspaces.com",
                          region_name=args.region, aws_access_key_id=credential["access_key"],
                          aws_secret_access_key=credential["secret_key"])
    prefix = "control/" + args.checkpoint
    object_key = prefix + ".dump"
    client.upload_file(str(archive), args.bucket, object_key,
                       ExtraArgs={"ACL": "private", "Metadata": {"sha256": manifest["sha256"]}})
    remote = client.get_object(Bucket=args.bucket, Key=object_key)
    value = hashlib.sha256()
    count = 0
    for chunk in remote["Body"].iter_chunks(chunk_size=1024 * 1024):
        value.update(chunk)
        count += len(chunk)
    if count != manifest["bytes"] or value.hexdigest() != manifest["sha256"]:
        raise ValueError("remote checkpoint bytes differ from verified local bytes")
    client.put_object(Bucket=args.bucket, Key=prefix + ".json", Body=manifest_path.read_bytes(), ACL="private")
    if json.loads(client.get_object(Bucket=args.bucket, Key=prefix + ".json")["Body"].read()) != manifest:
        raise ValueError("remote checkpoint manifest differs from local manifest")
    print(json.dumps({"remote_checkpoint": args.checkpoint, "bucket": args.bucket,
                      "bytes": count, "sha256": value.hexdigest()}))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("Mini control Space sync failed: " + type(exc).__name__, file=sys.stderr)
        raise SystemExit(1)
