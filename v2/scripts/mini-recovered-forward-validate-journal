#!/usr/bin/env python3
"""Validate the exact owner-only journal before recovered-forward resumption."""

import json
import os
import re
import stat
import sys
from pathlib import Path


PHASES = {
    "prepared", "host-agent-fencing", "host-agent-fenced", "api-fencing",
    "legacy-fenced", "migration-started", "schema-migrated",
    "candidate-activation-started", "candidate-postflight-failed",
    "candidate-preservation-pending", "candidate-finalize-requested",
    "candidate-normal-activation-pending", "candidate-normal-active-pending-host-agent",
    "candidate-normal-active-pending-host-agent-restart", "candidate-promoted",
}


def main() -> int:
    if len(sys.argv) != 10:
        raise ValueError("usage: mini-recovered-forward-validate-journal journal transition source candidate evidence evidence-sha backup-proof backup-artifact shadow-receipt")
    path, transition, source, candidate, evidence, evidence_sha, backup, artifact, shadow = sys.argv[1:]
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError("journal must be owner-only mode-0600 regular file")
    with open(path, "rb") as journal:
        value = json.load(journal, object_pairs_hook=unique_object)
    if type(value) is not dict or value.get("schema") != "norn.recovered-forward-transition/v1":
        raise ValueError("journal schema is invalid")
    expected = {
        "transitionID": transition,
        "sourceSHA": source,
        "candidateReleaseSHA": candidate,
        "sourceEvidencePath": evidence,
        "sourceEvidenceSHA256": evidence_sha,
        "backupProofPath": backup,
        "backupArtifactPath": artifact,
        "shadowReceiptPath": shadow,
    }
    for key, expected_value in expected.items():
        if value.get(key) != expected_value:
            raise ValueError("journal binding changed: " + key)
    if not re.fullmatch(r"[0-9a-f]{40}", source) or not re.fullmatch(r"[0-9a-f]{40}", candidate):
        raise ValueError("journal source/candidate SHA is invalid")
    if not re.fullmatch(r"[0-9a-f]{64}", evidence_sha):
        raise ValueError("journal source evidence digest is invalid")
    root = Path(path).parent
    fixed = root / (Path(path).name + ".source-evidence.json")
    versioned = root / ("retarget-" + candidate) / "source-evidence.json"
    evidence_path = Path(evidence)
    if evidence_path not in (fixed, versioned):
        raise ValueError("journal evidence path is outside the fixed or candidate-versioned transition location")
    if root.is_symlink() or (evidence_path.parent != root and evidence_path.parent.is_symlink()):
        raise ValueError("journal evidence path traverses a symlink")
    if evidence_path == versioned:
        info = evidence_path.parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ValueError("versioned evidence directory must be owner-only mode 0700")
    phase = value.get("state")
    if phase not in PHASES:
        raise ValueError("journal phase is not a supported recovered-forward resume phase")
    print(phase)
    return 0


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("journal contains a duplicate JSON key: " + key)
        result[key] = value
    return result


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
