#!/usr/bin/env python3
"""Validate the durable file bindings for a completed Mini recovery."""

import hashlib
import hmac
import json
import os
import re
import stat
import sys
from pathlib import Path


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("JSON contains duplicate key: " + key)
        result[key] = value
    return result


def private_file(path: Path, label: str) -> bytes:
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ValueError(f"{label} must be an owner-only mode-0600 regular file")
    return path.read_bytes()


def main() -> int:
    if len(sys.argv) != 5:
        raise ValueError("usage: mini-recovered-forward-completed-gate journal current-link releases preservation-receipt")
    journal_path, current_link, releases, preservation_path = map(Path, sys.argv[1:])
    journal_raw = private_file(journal_path, "recovered-forward journal")
    value = json.loads(journal_raw, object_pairs_hook=unique_object)
    if type(value) is not dict or value.get("schema") != "norn.recovered-forward-transition/v1":
        raise ValueError("recovered-forward journal schema is invalid")
    if value.get("state") != "candidate-promoted":
        raise ValueError("only a fully promoted recovered-forward journal can authorize a later forward upgrade")
    transition = value.get("transitionID", "")
    source = value.get("sourceSHA", "")
    candidate = value.get("candidateReleaseSHA", "")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}", transition):
        raise ValueError("recovered-forward transition identity is invalid")
    for identity in (source, candidate):
        if not re.fullmatch(r"[0-9a-f]{40}", identity):
            raise ValueError("recovered-forward release identity is invalid")
    current_link = current_link.absolute()
    if not current_link.is_symlink():
        raise ValueError("Mini current release must remain an exact symlink")
    release_root = releases.resolve(strict=True)
    current_target = current_link.resolve(strict=True)
    if current_target != release_root / candidate:
        raise ValueError("Mini current release no longer points to the exact promoted recovery candidate")
    paths = {}
    for field in ("sourceEvidencePath", "backupProofPath", "backupArtifactPath", "shadowReceiptPath"):
        raw = value.get(field)
        if not isinstance(raw, str) or not raw or "\n" in raw or "\t" in raw:
            raise ValueError(f"recovered-forward {field} is invalid")
        paths[field] = Path(raw)
    evidence_digest = value.get("sourceEvidenceSHA256")
    preservation_digest = value.get("preservationReceiptSHA256")
    for digest in (evidence_digest, preservation_digest):
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError("recovered-forward evidence digest is invalid")
    expected_preservation = Path.home() / ".config/norn/recovered-forward/preservation-receipt.json"
    if Path(value.get("preservationReceiptPath", "")).absolute() != expected_preservation.absolute():
        raise ValueError("recovered-forward preservation receipt path is not canonical")
    preservation_raw = private_file(preservation_path, "preservation receipt")
    if hashlib.sha256(preservation_raw).hexdigest() != preservation_digest:
        raise ValueError("recovered-forward preservation receipt digest changed")
    audit_key = os.environ.get("NORN_AUDIT_SIGNING_KEY", "").encode()
    if not audit_key:
        raise ValueError("audit signing key is unavailable for the preservation receipt")
    receipt = json.loads(preservation_raw, object_pairs_hook=unique_object)
    receipt_fields = {"schema", "transitionId", "candidateSHA", "sourceEvidenceSHA256", "beforeDigest",
                      "afterDigest", "preservationMatched", "finalizedAt", "signature"}
    if type(receipt) is not dict or set(receipt) != receipt_fields or receipt.get("schema") != "norn.recovered-forward-preservation/v1":
        raise ValueError("preservation receipt schema or fields are invalid")
    signed = dict(receipt)
    signature = signed.pop("signature")
    canonical = json.dumps(signed, sort_keys=True, separators=(",", ":")).encode()
    expected_signature = "hmac-sha256:" + hmac.new(audit_key, receipt["schema"].encode() + b"\0" + canonical, hashlib.sha256).hexdigest()
    if not isinstance(signature, str) or not hmac.compare_digest(signature, expected_signature):
        raise ValueError("preservation receipt signature does not verify")
    if (receipt.get("transitionId") != transition or receipt.get("candidateSHA") != candidate
            or receipt.get("sourceEvidenceSHA256") != evidence_digest
            or receipt.get("preservationMatched") is not True
            or not isinstance(receipt.get("beforeDigest"), str)
            or receipt.get("beforeDigest") != receipt.get("afterDigest")):
        raise ValueError("preservation receipt does not prove the exact recovered-forward candidate")
    for sha in (source, candidate):
        release = release_root / sha
        info = release.lstat()
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            raise ValueError("recovered-forward source or candidate release is missing or unsafe")
        values = {}
        with (release / "release.env").open(encoding="utf-8") as source_file:
            for line in source_file:
                if "=" in line:
                    key, item = line.rstrip("\n").split("=", 1)
                    values[key] = item
        if values.get("NORN_RELEASE_SHA") != sha:
            raise ValueError("recovered-forward immutable release identity does not match its directory")
    fields = (transition, source, candidate, str(paths["sourceEvidencePath"]), evidence_digest,
              str(paths["backupProofPath"]), str(paths["backupArtifactPath"]),
              str(paths["shadowReceiptPath"]), preservation_digest)
    if any("\t" in item or "\n" in item for item in fields):
        raise ValueError("recovered-forward journal binding contains a delimiter")
    print("\t".join(fields))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
