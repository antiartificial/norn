#!/usr/bin/env python3
"""Create and verify deterministic Norn platform release manifests."""

from __future__ import annotations

import argparse
import ctypes
import errno
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path
from typing import Any


MANIFEST_SCHEMA = "norn.platform-release/v1"
SIGNATURE_SCHEMA = "norn.platform-signature-state/v1"
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
SOURCE_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
REQUIRED_BINARIES = {
    "host-runtime",
    "norn",
    "norn-api",
    "norn-host-agent",
    "platform-release-manifest",
    "platform-release-artifact",
    "platform-release-fetch-github",
    "platform-release-verify-github",
    "platform-upgrade",
}
ALLOWED_ROOT_ENTRIES = {
    "bin",
    "ui",
    "signatures",
    "release.env",
    "release.json",
    "release.signature.json",
}


class ManifestError(RuntimeError):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def regular_files(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    return sorted(
        (path for path in root.rglob("*") if path.is_file() and not path.is_symlink()),
        key=lambda path: path.relative_to(root).as_posix(),
    )


def validate_release_tree(root: Path) -> None:
    try:
        root_stat = root.lstat()
    except OSError as error:
        raise ManifestError(f"cannot inspect release root: {error}") from error
    if not stat.S_ISDIR(root_stat.st_mode) or root.is_symlink():
        raise ManifestError("release root must be a non-symlink directory")
    if root_stat.st_mode & 0o222:
        raise ManifestError("release root must be read-only")

    unexpected = {entry.name for entry in root.iterdir()} - ALLOWED_ROOT_ENTRIES
    if unexpected:
        raise ManifestError(f"release contains unexpected root entries: {sorted(unexpected)}")

    seen_inodes: dict[tuple[int, int], str] = {}
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix()
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise ManifestError(f"release contains a symlink: {relative}")
        if not stat.S_ISDIR(info.st_mode) and not stat.S_ISREG(info.st_mode):
            raise ManifestError(f"release contains a special file: {relative}")
        if info.st_mode & 0o222:
            raise ManifestError(f"release entry is writable: {relative}")
        if stat.S_ISREG(info.st_mode):
            inode = (info.st_dev, info.st_ino)
            if inode in seen_inodes:
                raise ManifestError(
                    f"release contains hard-linked files: {seen_inodes[inode]} and {relative}"
                )
            seen_inodes[inode] = relative

    required_root_files = ("release.env", "release.json", "release.signature.json")
    for name in required_root_files:
        path = root / name
        if not path.is_file() or path.is_symlink():
            raise ManifestError(f"release is missing required runtime file: {name}")
    bin_root = root / "bin"
    if not bin_root.is_dir() or bin_root.is_symlink():
        raise ManifestError("release is missing its non-symlink bin directory")
    if any(path.is_dir() for path in bin_root.iterdir()):
        raise ManifestError("release bin directory must not contain nested directories")
    actual_binaries = {path.name for path in regular_files(bin_root)}
    if actual_binaries != REQUIRED_BINARIES:
        raise ManifestError(
            f"release binary set differs from required runtime files: {sorted(actual_binaries)}"
        )
    for name in REQUIRED_BINARIES:
        if not ((bin_root / name).stat().st_mode & 0o111):
            raise ManifestError(f"required runtime binary is not executable: {name}")


def file_map(root: Path) -> dict[str, str]:
    return {
        path.relative_to(root).as_posix(): sha256_file(path)
        for path in regular_files(root)
    }


def canonical_tree_digest(files: dict[str, str]) -> str:
    digest = hashlib.sha256()
    for relative, file_digest in sorted(files.items()):
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(file_digest.encode("ascii"))
        digest.update(b"\n")
    return digest.hexdigest()


def write_json(path: Path, value: Any) -> None:
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(
        json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)


def lockfile_map(source: Path) -> dict[str, str]:
    paths: set[Path] = set()
    for pattern in ("v2/**/go.sum", "v2/**/pnpm-lock.yaml"):
        paths.update(path for path in source.glob(pattern) if path.is_file())
    return {
        path.relative_to(source).as_posix(): sha256_file(path)
        for path in sorted(paths, key=lambda item: item.relative_to(source).as_posix())
    }


def create(args: argparse.Namespace) -> None:
    release = args.release.resolve()
    source = args.source.resolve()
    binaries = {
        f"bin/{relative}": digest
        for relative, digest in file_map(release / "bin").items()
    }
    if not binaries:
        raise ManifestError("release contains no binaries")
    ui_files = file_map(release / "ui")
    manifest = {
        "schema": MANIFEST_SCHEMA,
        # Keep the flat identity fields understood by existing release-list APIs.
        "sha": args.sha,
        "version": args.version,
        "createdAt": args.created_at,
        "source": {
            "sha": args.sha,
            "version": args.version,
            "createdAt": args.created_at,
        },
        "target": {"os": args.os, "arch": args.arch},
        "toolchain": {
            "go": {"version": args.go_version},
            "node": {"version": args.node_version, "required": args.node_required},
            "pnpm": {"version": args.pnpm_version, "required": args.pnpm_required},
        },
        "build": {
            "goFlags": args.go_flag,
            "goLdflags": args.go_ldflag,
            "goEnvironment": args.go_environment,
            "cgoEnabled": args.cgo_enabled,
            "sourceDateEpoch": args.source_date_epoch,
        },
        "inputs": {"lockfiles": lockfile_map(source)},
        "artifacts": {
            "binaries": binaries,
            "metadata": {"release.env": sha256_file(release / "release.env")},
        },
        "ui": {
            "algorithm": "sha256(path NUL file-sha256 LF)",
            "treeSha256": canonical_tree_digest(ui_files),
            "files": ui_files,
        },
    }
    manifest_path = release / "release.json"
    write_json(manifest_path, manifest)
    write_json(
        release / "release.signature.json",
        {
            "schema": SIGNATURE_SCHEMA,
            "status": "unsigned",
            "manifestSha256": sha256_file(manifest_path),
            "artifacts": {},
        },
    )


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ManifestError(f"cannot read {path.name}: {error}") from error
    if not isinstance(value, dict):
        raise ManifestError(f"{path.name} must contain a JSON object")
    return value


def require_digest_map(value: Any, label: str) -> dict[str, str]:
    if not isinstance(value, dict):
        raise ManifestError(f"{label} must be an object")
    result: dict[str, str] = {}
    for name, digest in value.items():
        if not isinstance(name, str) or not name or name.startswith("/") or ".." in Path(name).parts:
            raise ManifestError(f"{label} contains an unsafe path")
        if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
            raise ManifestError(f"{label} contains an invalid SHA-256 for {name}")
        result[name] = digest
    return result


def verify(args: argparse.Namespace) -> None:
    release = Path(os.path.abspath(args.release))
    validate_release_tree(release)
    manifest_path = release / "release.json"
    manifest = load_json(manifest_path)
    if manifest.get("schema") != MANIFEST_SCHEMA:
        raise ManifestError("unsupported release manifest schema")

    source = manifest.get("source")
    if not isinstance(source, dict) or not SOURCE_SHA_RE.fullmatch(str(source.get("sha", ""))):
        raise ManifestError("release manifest has an invalid source SHA")
    if manifest.get("sha") != source["sha"] or manifest.get("version") != source.get("version"):
        raise ManifestError("flat release identity does not match source identity")
    if manifest.get("createdAt") != source.get("createdAt"):
        raise ManifestError("flat release timestamp does not match source timestamp")
    if args.expected_sha and source["sha"] != args.expected_sha:
        raise ManifestError(
            f"release source SHA {source['sha']} does not match expected {args.expected_sha}"
        )
    if not args.expected_sha and release.name != source["sha"]:
        raise ManifestError(
            f"release directory {release.name} does not match source SHA {source['sha']}"
        )

    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, dict):
        raise ManifestError("release manifest artifacts must be an object")
    expected_binaries = require_digest_map(artifacts.get("binaries"), "artifact binaries")
    actual_binaries = {
        f"bin/{relative}": digest
        for relative, digest in file_map(release / "bin").items()
    }
    if expected_binaries != actual_binaries:
        raise ManifestError("release binary inventory or digest does not match the manifest")
    expected_metadata = require_digest_map(artifacts.get("metadata"), "artifact metadata")
    actual_metadata = {"release.env": sha256_file(release / "release.env")}
    if expected_metadata != actual_metadata:
        raise ManifestError("release metadata digest does not match the manifest")

    ui = manifest.get("ui")
    if not isinstance(ui, dict):
        raise ManifestError("release manifest UI entry must be an object")
    expected_ui = require_digest_map(ui.get("files"), "UI files")
    actual_ui = file_map(release / "ui")
    if expected_ui != actual_ui:
        raise ManifestError("release UI inventory or digest does not match the manifest")
    if ui.get("treeSha256") != canonical_tree_digest(actual_ui):
        raise ManifestError("release UI tree digest does not match the manifest")

    inputs = manifest.get("inputs")
    if not isinstance(inputs, dict):
        raise ManifestError("release manifest inputs must be an object")
    require_digest_map(inputs.get("lockfiles"), "lockfile inputs")

    signature = load_json(release / "release.signature.json")
    if signature.get("schema") != SIGNATURE_SCHEMA:
        raise ManifestError("unsupported release signature-state schema")
    status = signature.get("status")
    if status not in ("unsigned", "signed"):
        raise ManifestError("release signature status must be unsigned or signed")
    if signature.get("manifestSha256") != sha256_file(manifest_path):
        raise ManifestError("release signature state does not match release.json")
    signature_artifacts = require_digest_map(signature.get("artifacts"), "signature artifacts")
    actual_signature_artifacts = {
        f"signatures/{relative}": digest
        for relative, digest in file_map(release / "signatures").items()
    }
    if signature_artifacts != actual_signature_artifacts:
        raise ManifestError("release signature artifacts do not match signature state")
    if status == "unsigned" and signature_artifacts:
        raise ManifestError("unsigned release must not carry signature artifacts")
    if status == "signed" and not signature_artifacts:
        raise ManifestError("signed release must carry detached signature artifacts")
    print(status)


def compare(args: argparse.Namespace) -> None:
    retained = load_json(args.retained.resolve() / "release.json")
    rebuilt = load_json(args.rebuilt.resolve() / "release.json")
    if retained != rebuilt:
        retained_text = json.dumps(retained, indent=2, sort_keys=True).splitlines()
        rebuilt_text = json.dumps(rebuilt, indent=2, sort_keys=True).splitlines()
        import difflib

        diff = "\n".join(
            difflib.unified_diff(retained_text, rebuilt_text, "retained", "rebuilt", lineterm="")
        )
        raise ManifestError("rebuild manifest differs from retained release:\n" + diff)


def install_no_replace(args: argparse.Namespace) -> None:
    staging = Path(os.path.abspath(args.staging))
    destination = Path(os.path.abspath(args.destination))
    if staging.parent != destination.parent:
        raise ManifestError("staging and destination must share a filesystem directory")
    if destination.exists() or destination.is_symlink():
        raise ManifestError("release destination already exists")

    libc = ctypes.CDLL(None, use_errno=True)
    source_bytes = os.fsencode(staging)
    destination_bytes = os.fsencode(destination)
    if sys.platform.startswith("linux") and hasattr(libc, "renameat2"):
        if libc.renameat2(-100, source_bytes, -100, destination_bytes, 1) == 0:
            return
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise ManifestError("release destination already exists")
        if error not in (errno.ENOSYS, errno.EINVAL, errno.ENOTSUP):
            raise ManifestError(f"atomic release install failed: {os.strerror(error)}")
    if sys.platform == "darwin" and hasattr(libc, "renamex_np"):
        if libc.renamex_np(source_bytes, destination_bytes, 0x00000004) == 0:
            return
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise ManifestError("release destination already exists")
        if error not in (errno.ENOSYS, errno.EINVAL, errno.ENOTSUP):
            raise ManifestError(f"atomic release install failed: {os.strerror(error)}")

    lock = destination.parent / f".{destination.name}.install.lock"
    try:
        descriptor = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError as error:
        raise ManifestError("release install is already in progress") from error
    try:
        if destination.exists() or destination.is_symlink():
            raise ManifestError("release destination already exists")
        os.rename(staging, destination)
    finally:
        os.close(descriptor)
        lock.unlink(missing_ok=True)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    commands = root.add_subparsers(dest="command", required=True)

    create_parser = commands.add_parser("create")
    create_parser.add_argument("--release", type=Path, required=True)
    create_parser.add_argument("--source", type=Path, required=True)
    create_parser.add_argument("--sha", required=True)
    create_parser.add_argument("--version", required=True)
    create_parser.add_argument("--created-at", required=True)
    create_parser.add_argument("--os", required=True)
    create_parser.add_argument("--arch", required=True)
    create_parser.add_argument("--go-version", required=True)
    create_parser.add_argument("--node-version", required=True)
    create_parser.add_argument("--node-required", required=True)
    create_parser.add_argument("--pnpm-version", required=True)
    create_parser.add_argument("--pnpm-required", required=True)
    create_parser.add_argument("--go-flag", action="append", default=[])
    create_parser.add_argument("--go-ldflag", action="append", default=[])
    create_parser.add_argument("--go-environment", action="append", default=[])
    create_parser.add_argument("--cgo-enabled", required=True)
    create_parser.add_argument("--source-date-epoch", required=True)
    create_parser.set_defaults(handler=create)

    verify_parser = commands.add_parser("verify")
    verify_parser.add_argument("--release", type=Path, required=True)
    verify_parser.add_argument("--expected-sha")
    verify_parser.set_defaults(handler=verify)

    compare_parser = commands.add_parser("compare")
    compare_parser.add_argument("--retained", type=Path, required=True)
    compare_parser.add_argument("--rebuilt", type=Path, required=True)
    compare_parser.set_defaults(handler=compare)

    install_parser = commands.add_parser("install")
    install_parser.add_argument("--staging", type=Path, required=True)
    install_parser.add_argument("--destination", type=Path, required=True)
    install_parser.set_defaults(handler=install_no_replace)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        args.handler(args)
    except ManifestError as error:
        print(f"platform release manifest error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
