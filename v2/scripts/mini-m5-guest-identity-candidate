#!/usr/bin/env python3
"""Link a guest runner isolation proof to the signed Tart/SSH hardening identity."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess


OWNER_PUBLIC_KEY_SHA256 = "ba038c8f9e5d43ff4b5c03ffb1ea7ca1e4e9127c98b5810ed0c6a5dbc1c67eeb"


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def candidate(intent, attestation, attestation_sha, run_id, source_sha, runner):
    if (intent.get("schema") != "norn.m5-local-guest-hardening-intent/v1" or
            intent.get("sourceSHA") != source_sha or
            not re.fullmatch(r"norn-m5-[0-9]{1,20}", intent.get("guestName", "")) or
            not re.fullmatch(r"[0-9a-f]{64}", intent.get("createMarkerSHA256", "")) or
            not re.fullmatch(r"[0-9a-f]{64}", intent.get("sshHostKeySHA256", ""))):
        raise ValueError("signed hardening identity is invalid for this source")
    if (runner != "norn-m5-isolated-01" or
            attestation.get("runner") != runner or
            attestation.get("sshHostKeySHA256") != intent["sshHostKeySHA256"] or
            attestation.get("hostOutbound") != "loopback-only" or
            attestation.get("credentialSurfacesAbsentOrUnreadable") is not True or
            attestation.get("preexistingNetworkSockets") != 0):
        raise ValueError("guest attestation differs from signed Tart/SSH identity")
    if not re.fullmatch(r"[0-9]{1,20}", run_id):
        raise ValueError("invalid qualification run ID")
    return {"schema": "norn.m5-local-guest-qualified/v1", "guestName": intent["guestName"],
            "createMarkerSHA256": intent["createMarkerSHA256"], "qualificationRunId": run_id,
            "sourceSHA": source_sha, "attestationSHA256": attestation_sha, "runner": runner,
            "sshHostKeySHA256": intent["sshHostKeySHA256"],
            "tartConfigSHA256": intent["tartConfigSHA256"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("hardening-intent", "hardening-signature", "public-key", "attestation", "output"):
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args()
    if digest(args.public_key) != OWNER_PUBLIC_KEY_SHA256:
        raise ValueError("unreviewed owner public key")
    subprocess.run(("/opt/homebrew/opt/openssl@3/bin/openssl", "pkeyutl", "-verify", "-pubin",
                    "-inkey", args.public_key, "-sigfile", args.hardening_signature,
                    "-rawin", "-in", args.hardening_intent), check=True, capture_output=True, timeout=10)
    intent = json.loads(Path(args.hardening_intent).read_bytes())
    attestation = json.loads(Path(args.attestation).read_bytes())
    result = candidate(intent, attestation, digest(args.attestation), os.environ["GITHUB_RUN_ID"],
                       os.environ["GITHUB_SHA"], os.environ["RUNNER_NAME"])
    output = Path(args.output)
    if not output.is_absolute():
        raise ValueError("candidate output must be absolute")
    with output.open("x", encoding="utf-8") as target:
        json.dump(result, target, sort_keys=True, separators=(",", ":"))
        target.write("\n")


if __name__ == "__main__":
    main()
