#!/usr/bin/env python3
"""Run a Mini control checkpoint with only the database URL from SOPS."""

import json
import os
from pathlib import Path
import subprocess


def main():
    encrypted = Path(os.environ["NORN_CHECKPOINT_ENV_FILE"])
    directory = Path(os.environ["NORN_CHECKPOINT_DIRECTORY"])
    if not encrypted.is_absolute() or not directory.is_absolute():
        raise SystemExit("checkpoint paths must be absolute")
    values = json.loads(subprocess.check_output(
        ["/opt/homebrew/bin/sops", "--decrypt", "--output-type", "json", str(encrypted)],
        timeout=30,
    ))
    database_url = values.get("NORN_DATABASE_URL")
    if not isinstance(database_url, str) or not database_url:
        raise SystemExit("encrypted checkpoint environment has no database URL")
    script = Path(__file__).with_name("mini-control-checkpoint")
    argv = ["/usr/bin/python3", str(script), "--directory", str(directory),
            "--postgres-bin", "/Applications/Postgres.app/Contents/Versions/17/bin",
            "--keep-hours", "48"]
    created = subprocess.run(argv, check=True, capture_output=True, text=True, timeout=360,
                             env={"PATH": "/usr/bin:/bin", "NORN_DATABASE_URL": database_url})
    checkpoint = json.loads(created.stdout)["checkpoint"]
    bucket = os.environ.get("NORN_CHECKPOINT_SPACE_BUCKET")
    credentials = os.environ.get("NORN_CHECKPOINT_SPACE_CREDENTIALS")
    if bucket or credentials:
        if not bucket or not credentials:
            raise SystemExit("Space bucket and credentials must be configured together")
        sync = Path(__file__).with_name("mini-control-space-sync")
        remote = subprocess.run([str(Path(__file__).with_name("venv") / "bin/python"), str(sync),
                                 "--directory", str(directory), "--checkpoint", checkpoint,
                                 "--credentials", credentials, "--bucket", bucket,
                                 "--region", "nyc3"], check=True, capture_output=True,
                                text=True, timeout=360)
        print(remote.stdout.strip())
    else:
        print(created.stdout.strip())


if __name__ == "__main__":
    main()
