#!/usr/bin/env python3
"""Root-only one-use PF deny window for the disposable M5 host."""

import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


ANCHOR = "com.norn.m5.historical"
STATE_DIR = Path("/var/db/norn-m5-window")
CLAIM = STATE_DIR / "claim.json"
RULES = "pass out quick on lo0 all\nblock drop out quick all\n"


def pf(*args):
    subprocess.run(("/sbin/pfctl", *args), check=True, timeout=10,
                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


def main():
    if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[1] not in ("enable", "disable"):
        raise SystemExit("root-only usage: mini-m5-firewall-window enable|disable <run-id>")
    action, run_id = sys.argv[1:]
    if not re.fullmatch(r"[0-9]{1,20}", run_id):
        raise SystemExit("invalid protected run id")
    info = STATE_DIR.stat()
    if info.st_uid != 0 or not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700:
        raise SystemExit("firewall state directory is unsafe")
    if action == "enable":
        fd = os.open(CLAIM, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as output:
                json.dump({"schema": "norn.m5-firewall-window/v1", "runId": run_id}, output)
                output.write("\n")
                output.flush()
                os.fsync(output.fileno())
            rule_path = STATE_DIR / ("rules-" + run_id)
            rule_fd = os.open(rule_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(rule_fd, "w", encoding="utf-8") as rule_file:
                rule_file.write(RULES)
                rule_file.flush()
                os.fsync(rule_file.fileno())
            try:
                pf("-a", ANCHOR, "-f", str(rule_path))
                # A previously allowed connection must not survive the new
                # deny policy through PF's state table.
                pf("-F", "states")
            finally:
                rule_path.unlink()
        except BaseException:
            # Leave the claim for protected reconciliation if PF may have
            # partially accepted a deny rule. Never silently re-open egress.
            raise
    else:
        fd = os.open(CLAIM, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "r", encoding="utf-8") as source:
            info = os.fstat(source.fileno())
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
                raise SystemExit("firewall claim is unsafe")
            claim = json.load(source)
        if claim != {"schema": "norn.m5-firewall-window/v1", "runId": run_id}:
            raise SystemExit("firewall claim does not match this run")
        pf("-a", ANCHOR, "-F", "rules")
        CLAIM.unlink()


if __name__ == "__main__":
    main()
