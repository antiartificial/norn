  log "proxy upstream set to $target"
  log "wrote $proxy_caddyfile"
  if [[ "$proxy_reload" == "true" ]]; then
    require_cmd caddy
    caddy reload --config "$proxy_caddyfile"
  fi
  exit 0
fi

