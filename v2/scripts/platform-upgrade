#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  platform-upgrade preflight [ref]
  platform-upgrade upgrade [ref]
  platform-upgrade legacy-baseline [ref] --legacy-release <full-sha> --backup-proof <path> --backup-artifact <path>
  platform-upgrade legacy-baseline-finalize --transition-id <id>
  platform-upgrade recovered-forward <candidate-sha> --source-sha <full-sha> --source-evidence <path> --source-evidence-sha256 <sha256> --backup-proof <path> --backup-artifact <path> --shadow-receipt <path>
  platform-upgrade recovered-forward-finalize --transition-id <id> --preservation-receipt <path>
  platform-upgrade recovered-baseline-adopt --incident-binding <path> --receipt <path> --expected-current-sha <full-sha>
  platform-upgrade rebuild <ref> --verify
  platform-upgrade releases
  platform-upgrade rollback <sha-prefix>
  platform-upgrade smoke
  platform-upgrade env-exec -- <command> [args...]
  platform-upgrade mini-protected-backup
  platform-upgrade mini-signed-shadow <candidate-sha>
  platform-upgrade startup-contract <norn-api-binary>
  platform-upgrade proxy-plan
  platform-upgrade proxy-status
  platform-upgrade proxy-render
  platform-upgrade proxy-switch <port>

Builds Norn into a versioned release directory. Preflight starts the candidate
API on an alternate local port and verifies health/version without touching the
running LaunchAgent. Upgrade promotes the release, restarts com.norn.api, and
rolls back if postflight health fails.

Environment:
  NORN_PLATFORM_REPO       Norn repo path. Defaults to this script's repo.
  NORN_RELEASES_DIR        Release root. Defaults to $HOME/norn/releases.
  NORN_CURRENT_LINK        Current-release symlink. Defaults to $HOME/norn/current.
  NORN_BIN_DIR             Compatibility bin dir. Defaults to $HOME/go/bin.
  NORN_LAUNCH_LABEL        LaunchAgent label. Defaults to com.norn.api.
  NORN_API_BASE            Running API base. Defaults to http://127.0.0.1:8800.
  NORN_TOKEN               Optional bearer token for operation drain checks.
  NORN_API_TOKEN           Optional bearer token for operation drain checks.
  NORN_CANDIDATE_PORT      Candidate API port. Defaults to 18800.
  NORN_DRAIN_MODE          fail, wait, or force. Defaults to fail.
  NORN_DRAIN_EXCLUDE_OPERATION_ID Exclude the executor's own durable operation.
  NORN_SKIP_CANDIDATE_API  Set true to skip candidate API boot.
  NORN_PLATFORM_UPGRADE_MODE restart or proxy. Defaults to restart.
  NORN_PROXY_LISTEN        Stable proxy listen address. Defaults to :8800.
  NORN_PROXY_ACTIVE_PORT   Active API private port. Defaults to 18801.
  NORN_PROXY_CANDIDATE_PORT Candidate API private port. Defaults to 18802.
  NORN_PROXY_DIR           Proxy state dir. Defaults to $HOME/norn/proxy.
  NORN_PROXY_CADDYFILE     Managed Caddyfile path.
  NORN_PROXY_RELOAD        Set true to reload caddy after proxy-switch.
  NORN_API_ENV_FILE        SOPS JSON env file for smoke/env-exec.
  NORN_NODE_BIN            Exact pinned Node.js executable for UI release builds.
  NORN_EXPECTED_NODE_VERSION Exact Node version. Repo config wins; default v24.19.0.
  NORN_EXPECTED_PNPM_VERSION Exact pnpm version. Repo config wins; default 10.32.1.
  NORN_RELEASE_FETCH_HOOK  Executable called with <ref> <releases-dir> when absent.
  NORN_RELEASE_VERIFY_HOOK Executable called with <release-dir> <release.json>.
  NORN_RELEASE_CONFIG_FILE Private strict key=value host config. Defaults to
                           $HOME/.config/norn/release.env when it exists.
  NORN_RELEASE_MANIFEST_HELPER Process-local trusted manifest helper. Keep an
                           approved rollback-bridge helper outside the managed
                           helper directory because activation resynchronizes it.
  NORN_RELEASE_SIGNATURE_POLICY allow-unsigned or require-signed.
  NORN_ALLOW_LEGACY_RELEASES Explicit one-time unsigned legacy rollback escape hatch.
  NORN_RELEASE_LOGS_DIR    Mutable release logs outside immutable artifacts.
  NORN_LEGACY_API_PATH     Legacy LaunchAgent executable. Defaults to NORN_BIN_DIR/norn-api.
  NORN_LEGACY_BACKUP_MAX_AGE_SECONDS Maximum permitted backup-proof age. Defaults to 3600.
  NORN_LEGACY_FENCE_STATE_PATH Persistent legacy-fence record. Defaults beside NORN_LEGACY_API_PATH.
  NORN_HOST_AGENT_LABEL    LaunchAgent label for norn-host-agent. Defaults to com.norn.host-agent.
USAGE
}

log() {
  printf '[platform] %s\n' "$*"
}

fail() {
  printf '[platform] error: %s\n' "$*" >&2
  exit 1
}

recovered_forward_evidence_path_valid() {
  local evidence_path="$1" candidate_sha="$2" root="$3"
  python3 - "$evidence_path" "$candidate_sha" "$root" <<'PY'
import os,stat,sys
from pathlib import Path
path=Path(sys.argv[1]); candidate=sys.argv[2]; root=Path(sys.argv[3])
fixed=root/"transition.json.source-evidence.json"
versioned=root/("retarget-"+candidate)/"source-evidence.json"
if path not in (fixed,versioned): raise SystemExit("source-evidence path is outside exact candidate-versioned transition location")
if root.is_symlink() or path.is_symlink() or (path.parent!=root and path.parent.is_symlink()): raise SystemExit("source-evidence path traverses a symlink")
if path==versioned:
 info=path.parent.lstat()
 if not stat.S_ISDIR(info.st_mode) or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o700: raise SystemExit("versioned evidence directory must be owner-only mode 0700")
PY
}

# Permit only the signed candidate's sibling transition wrapper through the
# protected env-exec lane. It needs the API runtime environment to validate
# evidence before it calls the candidate platform controller.
recovered_forward_transition_child_validate() {
  [[ "$#" -ge 2 ]] || fail "recovered-forward transition child requires its candidate SHA and argument list"
  local child="$1" candidate_sha="$2"; shift 2
  # Keep candidate identity independent from NORN_PLATFORM_SCRIPT_BIN, which
  # remains the managed host-tool install target for the transition controller.
  # The wrapper is allowed only beside the platform controller in its exact
  # signed candidate release.
  local candidate_platform="$(dirname "$child")/platform-upgrade"
  local release_root="${NORN_RELEASES_DIR:-$HOME/norn/releases}"
  local verifier="${NORN_RELEASE_VERIFY_HOOK:-}"
  [[ -n "$verifier" && "$verifier" == /* && -x "$verifier" && ! -L "$verifier" ]] \
    || fail "recovered-forward transition child requires the pinned external release verifier"
python3 - "$child" "$candidate_platform" "$release_root" "$candidate_sha" "$@" <<'PY' || fail "recovered-forward transition child is not inside the exact candidate release or has invalid arguments"
import json, os, re, stat, sys
child, platform, root_text = map(os.path.abspath, sys.argv[1:4])
requested_sha = sys.argv[4]
args = sys.argv[5:]
root = os.path.abspath(os.path.expanduser(root_text))
sha = os.path.basename(os.path.dirname(os.path.dirname(platform)))
release = os.path.join(root, sha)
expected_platform = os.path.join(release, "bin", "platform-upgrade")
expected_child = os.path.join(release, "bin", "mini-recovered-forward-transition")
if (not re.fullmatch(r"[0-9a-f]{40}", sha) or platform != expected_platform or child != expected_child):
    raise SystemExit(1)
for path, kind in ((root, stat.S_ISDIR), (release, stat.S_ISDIR),
                   (os.path.join(release, "bin"), stat.S_ISDIR),
                   (platform, stat.S_ISREG), (child, stat.S_ISREG),
                   (os.path.join(release, "release.env"), stat.S_ISREG),
                   (os.path.join(release, "release.json"), stat.S_ISREG)):
    try:
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not kind(info.st_mode) or info.st_uid != os.geteuid():
            raise SystemExit(1)
        if os.path.realpath(path) != path:
            raise SystemExit(1)
    except OSError:
        raise SystemExit(1)
if not os.access(platform, os.X_OK) or not os.access(child, os.X_OK):
    raise SystemExit(1)
values = {}
for line in open(os.path.join(release, "release.env"), encoding="utf-8"):
    if "=" in line:
        key, value = line.rstrip("\n").split("=", 1)
        values[key] = value
try:
    manifest = json.load(open(os.path.join(release, "release.json"), encoding="utf-8"))
except (OSError, ValueError):
    raise SystemExit(1)
if values.get("NORN_RELEASE_SHA") != sha or manifest.get("sha") != sha:
    raise SystemExit(1)
if requested_sha != sha:
    raise SystemExit(1)
allowed = {"--source-sha", "--transition-id", "--backup-proof", "--backup-artifact",
           "--shadow-receipt", "--retarget-bundle", "--api"}
required = {"--source-sha", "--transition-id", "--backup-proof", "--backup-artifact", "--shadow-receipt"}
seen = set()
index = 0
while index < len(args):
    name = args[index]
    if name not in allowed or name in seen or index + 1 >= len(args) or not args[index + 1] or args[index + 1].startswith("--"):
        raise SystemExit(1)
    seen.add(name)
    index += 2
if not required.issubset(seen):
    raise SystemExit(1)
PY
  "$verifier" "$(dirname "$(dirname "$candidate_platform")")" \
    "$(dirname "$(dirname "$candidate_platform")")/release.json" >/dev/null \
    || fail "recovered-forward transition child candidate signature verification failed"
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 not found"
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_recovered_generation() {
  local base_root="$1" resolver="$script_dir/mini-recovered-forward-generation-resolve"
  local pointer="$base_root/active-generation.json" output fields
  if [[ ! -x "$resolver" ]]; then
    [[ ! -e "$pointer" && ! -L "$pointer" ]] || fail "active recovered-forward generation pointer exists but its signed resolver is unavailable"
    return 0
  fi
  output="$(NORN_AUDIT_SIGNING_KEY="${NORN_AUDIT_SIGNING_KEY:-}" "$resolver" --root "$base_root")" \
    || fail "active recovered-forward generation does not verify"
  fields="$(python3 -c 'import json,sys
v=json.load(sys.stdin)
if type(v) is not dict or v.get("root") != sys.argv[1] or v.get("selection") not in {"legacy-fixed","generation"}: raise SystemExit("resolver selection is invalid")
items=(v.get("selection"),v.get("generationID") or "-",v.get("journalPath"),v.get("preservationReceiptPath"),v.get("transitionID") or "-",v.get("sourceSHA") or "-",v.get("candidateSHA") or "-")
if any(not isinstance(x,str) or not x or "\t" in x or "\n" in x for x in items): raise SystemExit("resolver path or identity is invalid")
print("\t".join(items))' "$base_root" <<<"$output")" \
    || fail "active recovered-forward generation selection is malformed"
  IFS=$'\t' read -r recovered_selected_generation_kind recovered_selected_generation_id \
    recovered_journal_path recovered_preservation_receipt recovered_selected_transition_id \
    recovered_selected_source_sha recovered_selected_candidate_sha <<<"$fields"
  recovered_transition_root="$(dirname "$recovered_journal_path")"
}

mode="${1:-}"
if [[ -z "$mode" || "$mode" == "-h" || "$mode" == "--help" ]]; then
  usage
  exit 0
fi
shift || true

internal_recovered_forward_controller=false
if [[ "$mode" == "recovered-forward-controller" ]]; then
  internal_recovered_forward_controller=true
  mode="recovered-forward"
fi

case "$mode" in
  preflight|upgrade|legacy-baseline|legacy-baseline-finalize|recovered-forward|recovered-forward-finalize|recovered-baseline-adopt|releases|rollback|smoke|env-exec|startup-contract|proxy-plan|proxy-status|proxy-render|rebuild|proxy-switch|mini-protected-backup|mini-signed-shadow) ;;
  *) usage >&2; exit 2 ;;
esac

release_config_file="${NORN_RELEASE_CONFIG_FILE:-$HOME/.config/norn/release.env}"
if [[ -n "${NORN_RELEASE_CONFIG_FILE:-}" && ! -f "$release_config_file" ]]; then
  fail "release config file not found: $release_config_file"
fi
if [[ -f "$release_config_file" ]]; then
  require_cmd python3
  python3 - "$release_config_file" <<'PY'
import os
import stat
import sys

path = os.path.abspath(os.path.expanduser(sys.argv[1]))
info = os.lstat(path)
if not stat.S_ISREG(info.st_mode):
    raise SystemExit("release config must be a regular file")
if info.st_uid != os.getuid() or info.st_mode & 0o077:
    raise SystemExit("release config must be owned by the current user with mode 0600")
PY
  while IFS= read -r release_config_line || [[ -n "$release_config_line" ]]; do
    [[ -z "$release_config_line" || "$release_config_line" == \#* ]] && continue
    [[ "$release_config_line" =~ ^([A-Z0-9_]+)=([A-Za-z0-9_./:@+-]+)$ ]] || fail "invalid release config line"
    release_config_key="${BASH_REMATCH[1]}"
    release_config_value="${BASH_REMATCH[2]}"
    case "$release_config_key" in
      NORN_RELEASE_FETCH_HOOK|NORN_RELEASE_VERIFY_HOOK|NORN_RELEASE_SIGNATURE_POLICY|NORN_RELEASE_REPOSITORY|NORN_RELEASE_PUBLIC_KEY|NORN_RELEASE_GITHUB_TOKEN_FILE|NORN_RELEASE_CACHE_DIR|NORN_RELEASE_TAG_PREFIX|NORN_RELEASE_OS|NORN_RELEASE_ARCH|NORN_RELEASE_GITHUB_API_URL)
        export "$release_config_key=$release_config_value"
        ;;
      *) fail "unsupported release config key: $release_config_key" ;;
    esac
  done < "$release_config_file"
fi

ref="${1:-HEAD}"
legacy_release_sha=""
legacy_backup_proof=""
legacy_backup_artifact=""
legacy_finalize_transition_id=""
recovered_transition_id=""
recovered_source_sha=""
recovered_source_evidence=""
recovered_source_evidence_sha256=""
recovered_retargeted_from_sha=""
recovered_backup_proof=""
recovered_backup_artifact=""
recovered_shadow_receipt=""
recovered_preservation_receipt=""
recovered_preservation_receipt_sha256=""
recovered_base_root="$HOME/.config/norn/recovered-forward"
recovered_transition_root="$recovered_base_root"
recovered_journal_path="$recovered_base_root/transition.json"
recovered_preservation_receipt="$recovered_base_root/preservation-receipt.json"
recovered_selected_generation_kind="legacy-fixed"
recovered_selected_generation_id="-"
recovered_selected_transition_id="-"
recovered_selected_source_sha="-"
recovered_selected_candidate_sha="-"
recovered_incident_binding=""
recovered_receipt=""
recovered_expected_current_sha=""
recovered_accept_preservation_unproven=false
recovered_reason_file=""
case "$mode" in
  upgrade|rebuild|rollback|recovered-forward|recovered-forward-finalize|preflight)
    if [[ -d "$recovered_base_root" && ! -L "$recovered_base_root" ]]; then
      resolve_recovered_generation "$recovered_base_root"
    elif [[ "$mode" == recovered-forward || "$mode" == recovered-forward-finalize ]]; then
      fail "recovered-forward state directory is unavailable"
    fi
    ;;
esac
if [[ "$mode" == "legacy-baseline" ]]; then
  ref="HEAD"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --legacy-release)
        [[ "$#" -ge 2 ]] || fail "legacy-baseline requires a value after --legacy-release"
        legacy_release_sha="$2"
        shift 2
        ;;
      --backup-proof)
        [[ "$#" -ge 2 ]] || fail "legacy-baseline requires a value after --backup-proof"
        legacy_backup_proof="$2"
        shift 2
        ;;
      --backup-artifact)
        [[ "$#" -ge 2 ]] || fail "legacy-baseline requires a value after --backup-artifact"
        legacy_backup_artifact="$2"
        shift 2
        ;;
      --*) fail "unknown legacy-baseline option: $1" ;;
      *)
        [[ "$ref" == "HEAD" ]] || fail "legacy-baseline accepts at most one release ref"
        ref="$1"
        shift
        ;;
    esac
  done
  [[ -n "$legacy_release_sha" ]] || fail "legacy-baseline requires --legacy-release"
  [[ -n "$legacy_backup_proof" ]] || fail "legacy-baseline requires --backup-proof"
  [[ -n "$legacy_backup_artifact" ]] || fail "legacy-baseline requires --backup-artifact"
fi
if [[ "$mode" == "legacy-baseline-finalize" ]]; then
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --transition-id)
        [[ "$#" -ge 2 ]] || fail "legacy-baseline-finalize requires a value after --transition-id"
        legacy_finalize_transition_id="$2"; shift 2 ;;
      *) fail "unknown legacy-baseline-finalize option: $1" ;;
    esac
  done
  [[ "$legacy_finalize_transition_id" =~ ^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$ ]] || fail "legacy-baseline-finalize requires a valid transition ID"
fi
if [[ "$mode" == "recovered-forward" ]]; then
  ref="${1:-}"
  [[ "$ref" =~ ^[0-9a-f]{40}$ ]] || fail "recovered-forward requires an exact 40-character candidate SHA"
  shift
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --source-sha) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --source-sha"; recovered_source_sha="$2"; shift 2 ;;
      --transition-id) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --transition-id"; recovered_transition_id="$2"; shift 2 ;;
      --source-evidence) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --source-evidence"; recovered_source_evidence="$2"; shift 2 ;;
      --source-evidence-sha256) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --source-evidence-sha256"; recovered_source_evidence_sha256="$2"; shift 2 ;;
      --backup-proof) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --backup-proof"; recovered_backup_proof="$2"; shift 2 ;;
      --backup-artifact) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --backup-artifact"; recovered_backup_artifact="$2"; shift 2 ;;
      --shadow-receipt) [[ "$#" -ge 2 ]] || fail "recovered-forward requires --shadow-receipt"; recovered_shadow_receipt="$2"; shift 2 ;;
      *) fail "unknown recovered-forward option: $1" ;;
    esac
  done
  [[ "$recovered_source_sha" =~ ^[0-9a-f]{40}$ ]] || fail "recovered-forward requires an exact source SHA"
  [[ "$recovered_transition_id" =~ ^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$ ]] || fail "recovered-forward requires a valid transition ID"
  recovered_forward_evidence_path_valid "$recovered_source_evidence" "$ref" "$recovered_transition_root" || fail "recovered-forward source evidence path is not fixed or exact-candidate-versioned"
  [[ "$recovered_source_evidence_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "recovered-forward requires the exact source-evidence SHA-256"
  [[ -n "$recovered_backup_proof" && -n "$recovered_backup_artifact" && -n "$recovered_shadow_receipt" ]] || fail "recovered-forward requires backup proof, backup artifact, and signed shadow receipt"
fi
if [[ "$internal_recovered_forward_controller" == true ]]; then
  [[ -n "${NORN_RECOVERED_FORWARD_WRAPPER_ACTIVE:-}" && "$NORN_RECOVERED_FORWARD_WRAPPER_ACTIVE" == "$recovered_transition_id" ]] || fail "recovered-forward controller mode requires the exact signed transition-wrapper handoff"
fi
if [[ "$mode" == "recovered-forward-finalize" ]]; then
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --transition-id) [[ "$#" -ge 2 ]] || fail "recovered-forward-finalize requires --transition-id"; recovered_transition_id="$2"; shift 2 ;;
      --preservation-receipt) [[ "$#" -ge 2 ]] || fail "recovered-forward-finalize requires --preservation-receipt"; recovered_preservation_receipt="$2"; shift 2 ;;
      *) fail "unknown recovered-forward-finalize option: $1" ;;
    esac
  done
  [[ "$recovered_transition_id" =~ ^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$ ]] || fail "recovered-forward-finalize requires a valid transition ID"
  [[ "$recovered_preservation_receipt" == "$recovered_transition_root/preservation-receipt.json" ]] || fail "recovered-forward-finalize receipt must use the selected owner-only transition path"
fi
if [[ "$mode" == "recovered-baseline-adopt" ]]; then
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --incident-binding) [[ "$#" -ge 2 ]] || fail "recovered-baseline-adopt requires a value after --incident-binding"; recovered_incident_binding="$2"; shift 2 ;;
      --receipt) [[ "$#" -ge 2 ]] || fail "recovered-baseline-adopt requires a value after --receipt"; recovered_receipt="$2"; shift 2 ;;
      --expected-current-sha) [[ "$#" -ge 2 ]] || fail "recovered-baseline-adopt requires a value after --expected-current-sha"; recovered_expected_current_sha="$2"; shift 2 ;;
      --accept-preservation-unproven) recovered_accept_preservation_unproven=true; shift ;;
      --reason-file) [[ "$#" -ge 2 ]] || fail "recovered-baseline-adopt requires a value after --reason-file"; recovered_reason_file="$2"; shift 2 ;;
      *) fail "unknown recovered-baseline-adopt option: $1" ;;
    esac
  done
  [[ -n "$recovered_incident_binding" && -n "$recovered_receipt" && -n "$recovered_expected_current_sha" && "$recovered_accept_preservation_unproven" == true && -n "$recovered_reason_file" ]] || fail "recovered-baseline-adopt requires incident binding, receipt, expected current SHA, explicit preservation-unproven acknowledgement, and reason file"
  [[ "$recovered_expected_current_sha" =~ ^[0-9a-f]{40}$ ]] || fail "recovered-baseline-adopt requires a 40-character lowercase expected current SHA"
fi
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
default_repo="$(cd "$script_dir/../.." && pwd)"
repo="${NORN_PLATFORM_REPO:-}"
if [[ -z "$repo" ]]; then
  for candidate in "$default_repo" "$PWD" "$HOME/projects/norn"; do
    if [[ -f "$candidate/v2/Makefile" ]]; then
      repo="$candidate"
      break
    fi
  done
fi
repo="${repo:-$default_repo}"
v2="$repo/v2"
releases="${NORN_RELEASES_DIR:-$HOME/norn/releases}"
release_logs_root="${NORN_RELEASE_LOGS_DIR:-$HOME/norn/release-logs}"
current_link="${NORN_CURRENT_LINK:-$HOME/norn/current}"
bin_dir="${NORN_BIN_DIR:-$HOME/go/bin}"
legacy_api_path="${NORN_LEGACY_API_PATH:-$bin_dir/norn-api}"
legacy_backup_max_age_seconds="${NORN_LEGACY_BACKUP_MAX_AGE_SECONDS:-3600}"
legacy_fence_state_path="${NORN_LEGACY_FENCE_STATE_PATH:-$(dirname "$legacy_api_path")/.norn-legacy-baseline-fence.json}"
recovered_original_fence_path="$legacy_fence_state_path"
legacy_transition_id="${NORN_LEGACY_BASELINE_TRANSITION_ID:-}"
legacy_record_state=""
if [[ -e "$legacy_fence_state_path" ]]; then
  require_cmd python3
  legacy_record_state="$(python3 - "$legacy_fence_state_path" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    record = json.load(source)
if record.get("schema") != "norn.legacy-baseline-fence/v1":
    raise SystemExit("unexpected legacy baseline transition state schema")
state = record.get("state")
if not isinstance(state, str) or not state:
    raise SystemExit("missing legacy baseline transition state")
print(state)
PY
)" || fail "cannot verify existing legacy baseline transition state"
recovered_baseline_receipt_validate() {
  local receipt_path="$HOME/.config/norn/.norn-recovered-baseline-adoption-v2.json"
  [[ -n "$receipt_path" ]] || return 1
  NORN_AUDIT_SIGNING_KEY="${NORN_AUDIT_SIGNING_KEY:-}" python3 - "$receipt_path" "$current_link" "$releases" "$recovered_journal_path" <<'PY'
import hashlib, hmac, json, os, stat, sys
path = os.path.abspath(os.path.expanduser(sys.argv[1]))
current_link = os.path.abspath(os.path.expanduser(sys.argv[2]))
release_root = os.path.realpath(os.path.expanduser(sys.argv[3]))
transition_path = os.path.abspath(os.path.expanduser(sys.argv[4]))
key = os.environ.get("NORN_AUDIT_SIGNING_KEY", "").encode()
if not key:
    raise SystemExit("audit signing key is unavailable")
info = os.lstat(path)
if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
    raise SystemExit("recovered baseline receipt must be an owner-only mode-0600 regular file")
value = json.load(open(path, encoding="utf-8"))
signature = value.pop("signature", None)
required = {"schema", "sourceSHA", "incidentCandidateSHA", "adopterSHA", "incidentBindingSHA256", "preservationUnprovenReasonSHA256", "legacyFence", "ledger", "reconciliation", "preservationProven", "signature"}
if set(value) | {"signature"} != required or value.get("schema") != "norn.recovered-baseline-adoption/v2" or value.get("preservationProven") is not False:
    raise SystemExit("recovered baseline receipt has an unexpected schema")
for field in ("sourceSHA", "incidentCandidateSHA"):
    if not isinstance(value.get(field), str) or len(value[field]) != 40 or any(ch not in "0123456789abcdef" for ch in value[field]):
        raise SystemExit("recovered baseline receipt has a malformed release identity")
try:
    source_release = os.path.join(release_root, value["sourceSHA"])
    if os.path.realpath(source_release) != source_release or os.path.commonpath((release_root, source_release)) != release_root:
        raise SystemExit("Mini adoption source is outside the exact immutable release root")
    source_info = os.lstat(source_release)
    if not stat.S_ISDIR(source_info.st_mode) or stat.S_ISLNK(source_info.st_mode):
        raise SystemExit("Mini adoption source release is missing or unsafe")
    with open(os.path.join(source_release, "release.env"), encoding="utf-8") as source:
        release_values = dict(line.strip().split("=", 1) for line in source if "=" in line)
except (OSError, ValueError):
    raise SystemExit("Mini adoption source release identity cannot be verified")
if release_values.get("NORN_RELEASE_SHA") != value["sourceSHA"]:
    raise SystemExit("recovered baseline receipt is not bound to the exact immutable source release")
try:
    current_target = os.path.realpath(current_link)
    current_sha = os.path.basename(current_target)
    canonical_current = os.path.join(release_root, current_sha)
    if current_target != canonical_current or os.path.commonpath((release_root, current_target)) != release_root:
        raise SystemExit("Mini current release is outside the canonical immutable release root")
    current_info = os.lstat(canonical_current)
    if not stat.S_ISDIR(current_info.st_mode) or stat.S_ISLNK(current_info.st_mode):
        raise SystemExit("Mini current release is missing or unsafe")
    with open(os.path.join(canonical_current, "release.env"), encoding="utf-8") as source:
        current_values = dict(line.strip().split("=", 1) for line in source if "=" in line)
except (OSError, ValueError):
    raise SystemExit("Mini current release identity cannot be verified")
if current_values.get("NORN_RELEASE_SHA") != current_sha:
    raise SystemExit("Mini current release identity differs from its immutable directory")
if current_sha != value["sourceSHA"]:
    try:
        transition_info = os.lstat(transition_path)
        if (not stat.S_ISREG(transition_info.st_mode) or transition_info.st_uid != os.geteuid()
                or stat.S_IMODE(transition_info.st_mode) != 0o600):
            raise SystemExit("recovered-forward journal is unsafe")
        with open(transition_path, encoding="utf-8") as source:
            transition = json.load(source)
        phases = {"candidate-postflight-failed", "candidate-activation-started", "candidate-preservation-pending",
                  "candidate-finalize-requested", "candidate-normal-activation-pending",
                  "candidate-normal-active-pending-host-agent", "candidate-normal-active-pending-host-agent-restart",
                  "candidate-promoted"}
        if (transition.get("schema") != "norn.recovered-forward-transition/v1"
                or transition.get("sourceSHA") != value["sourceSHA"]
                or transition.get("candidateReleaseSHA") != current_sha
                or transition.get("state") not in phases):
            raise SystemExit("current Mini release is not the source or exact journaled recovery candidate")
    except (OSError, ValueError):
        raise SystemExit("current Mini release is not the source or exact journaled recovery candidate")
if not isinstance(signature, str) or not signature.startswith("hmac-sha256:"):
    raise SystemExit("recovered baseline receipt signature is missing")
canonical = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
expected = "hmac-sha256:" + hmac.new(key, value["schema"].encode() + b"\0" + canonical, hashlib.sha256).hexdigest()
if not hmac.compare_digest(signature, expected):
    raise SystemExit("recovered baseline receipt signature does not verify")
for name in ("legacyFence", "ledger", "reconciliation"):
    item = value.get(name)
    if not isinstance(item, dict) or set(item) != {"path", "sha256"} or not isinstance(item["path"], str) or not isinstance(item["sha256"], str):
        raise SystemExit("recovered baseline receipt evidence is malformed")
    target = os.path.abspath(os.path.expanduser(item["path"]))
    meta = os.lstat(target)
    if not stat.S_ISREG(meta.st_mode) or stat.S_ISLNK(meta.st_mode) or meta.st_uid != os.geteuid():
        raise SystemExit("recovered baseline evidence is no longer an owned regular file")
    digest = hashlib.sha256(open(target, "rb").read()).hexdigest()
    if not hmac.compare_digest(digest, item["sha256"]):
        raise SystemExit("recovered baseline evidence bytes changed")
fence = json.load(open(value["legacyFence"]["path"], encoding="utf-8"))
ledger = json.load(open(value["ledger"]["path"], encoding="utf-8"))
reconciliation = json.load(open(value["reconciliation"]["path"], encoding="utf-8"))
release, transition = reconciliation.get("release"), reconciliation.get("transition")
if fence.get("schema") != "norn.legacy-baseline-fence/v1" or fence.get("state") != "candidate-postflight-failed":
    raise SystemExit("recovered baseline fence semantic binding is invalid")
if ledger.get("schema") != "norn.m5-protected-transition/v1" or ledger.get("state") != "candidate-recovery-required" or ledger.get("candidateSHA") != value["incidentCandidateSHA"] or ledger.get("legacyReleaseSHA") != fence.get("legacyReleaseSHA") or ledger.get("upgradeExitCode") != 1 or not isinstance(ledger.get("beforeDigest"), str):
    raise SystemExit("recovered baseline ledger semantic binding is invalid")
if reconciliation.get("schema") != "norn.m5-post-transition-reconciliation/v1" or not isinstance(release, dict) or not isinstance(transition, dict) or release.get("sha") != value["incidentCandidateSHA"] or release.get("verified") is not True or transition.get("beforeDigest") != ledger["beforeDigest"] or transition.get("ledgerState") != "candidate-recovery-required" or transition.get("matchesBefore") is not False or transition.get("upgradeExitCode") != 1:
    raise SystemExit("recovered baseline reconciliation semantic binding is invalid")
PY
}

  if [[ "$legacy_record_state" == "candidate-postflight-failed" ]]; then
    # The exact recovered-baseline gate below validates the owner-only receipt
    # before any release preparation. Keep this early parser gate narrow so a
    # valid receipt can unlock only the ordinary forward lane.
    case "$mode" in
      legacy-baseline|legacy-baseline-finalize) fail "recovered baseline permanently rejects legacy-baseline replay" ;;
      recovered-forward|recovered-forward-finalize) recovered_baseline_receipt_validate || fail "recovered-forward requires the exact valid adoption receipt before Mini transition work" ;;
      proxy-switch|proxy-render) fail "recovered baseline blocks proxy changes while the failed fence is retained" ;;
      # The later finalized-recovery gate validates the completed journal,
      # both signed releases, preservation evidence, and the live runtime
      # before ordinary forward-upgrade preparation can begin.
      upgrade) : ;;
      preflight|mini-protected-backup|mini-signed-shadow) recovered_baseline_receipt_validate || fail "recovered baseline adoption receipt is required and must validate before Mini evidence work" ;;
      env-exec)
        recovered_early_args=("$@")
        [[ "${recovered_early_args[0]:-}" == "--" ]] && recovered_early_args=("${recovered_early_args[@]:1}")
        if [[ "${recovered_early_args[0]:-}" == "${NORN_HOST_AGENT_BIN:-$HOME/.config/norn/host/bin/norn-host-agent}" ]]; then
          recovered_agent_args=("${recovered_early_args[@]:1}")
          if [[ "${recovered_agent_args[0]:-}" == "--repo" ]]; then
            [[ "${recovered_agent_args[1]:-}" == "$repo" ]] || fail "recovered baseline host-agent repo differs from the configured checkout"
            recovered_agent_args=("${recovered_agent_args[@]:2}")
          fi
          [[ "${#recovered_agent_args[@]}" -eq 4 && "${recovered_agent_args[0]}" == "--platform-script" && "${recovered_agent_args[1]}" == "${NORN_PLATFORM_SCRIPT_BIN:-$HOME/.config/norn/host/bin/platform-upgrade}" && "${recovered_agent_args[2]}" == "--host-script" && "${recovered_agent_args[3]}" == "${NORN_HOST_RUNTIME_BIN:-$HOME/.config/norn/host/bin/host-runtime}" ]] || fail "recovered baseline rejects noncanonical host-agent startup"
        else
          [[ "${#recovered_early_args[@]}" -ge 2 ]] || fail "recovered baseline permits env-exec only for a canonical platform-upgrade child"
          if [[ "$(basename "${recovered_early_args[0]}")" == "mini-recovered-forward-transition" ]]; then
            recovered_forward_transition_child_validate "${recovered_early_args[0]}" "${recovered_early_args[1]}" "${recovered_early_args[@]:2}"
          else
            case "${recovered_early_args[1]}" in
              upgrade) [[ "${recovered_early_args[0]}" == "${NORN_PLATFORM_SCRIPT_BIN:-$HOME/.config/norn/host/bin/platform-upgrade}" ]] || fail "recovered baseline requires the canonical managed platform-upgrade child" ;;
              preflight|mini-protected-backup|mini-signed-shadow|recovered-forward|recovered-forward-controller|recovered-forward-finalize) [[ "${recovered_early_args[0]}" == "${NORN_PLATFORM_SCRIPT_BIN:-$HOME/.config/norn/host/bin/platform-upgrade}" ]] || fail "recovered baseline requires the canonical managed platform-upgrade child" ;;
              recovered-baseline-adopt)
              recovered_adopter_release="$(python3 - "${recovered_early_args[0]}" "$releases" <<'PY'
import os, sys
child = os.path.realpath(sys.argv[1]); root = os.path.realpath(sys.argv[2])
release = os.path.dirname(os.path.dirname(child))
if os.path.basename(child) != "platform-upgrade" or os.path.basename(os.path.dirname(child)) != "bin" or os.path.dirname(release) != root or not os.path.isfile(child):
    raise SystemExit(1)
print(release)
PY
)" || fail "recovered baseline adoption child is not directly inside immutable releases"
              recovered_adopter_sha="$(python3 - "$recovered_adopter_release/release.env" <<'PY'
import re, sys
values = dict(line.strip().split("=", 1) for line in open(sys.argv[1]) if "=" in line)
sha = values.get("NORN_RELEASE_SHA", "")
if not re.fullmatch("[0-9a-f]{40}", sha): raise SystemExit(1)
print(sha)
PY
)" || fail "recovered baseline adoption release has no exact SHA"
              [[ "$(python3 "${NORN_RELEASE_MANIFEST_HELPER:-$script_dir/platform-release-manifest}" verify --release "$recovered_adopter_release" --expected-sha "$recovered_adopter_sha")" == "signed" ]] || fail "recovered baseline adoption child is not a signed release"
              [[ -n "${NORN_RELEASE_VERIFY_HOOK:-}" && -x "${NORN_RELEASE_VERIFY_HOOK}" ]] || fail "recovered baseline adoption requires an external release verifier"
              "${NORN_RELEASE_VERIFY_HOOK}" "$recovered_adopter_release" "$recovered_adopter_release/release.json" || fail "recovered baseline adoption external verification failed"
                ;;
              *) fail "recovered baseline rejects env-exec child mode ${recovered_early_args[1]}" ;;
            esac
        fi
        fi
        ;;
      *) : ;;
    esac
  elif [[ "$legacy_record_state" != "candidate-promoted" ]]; then
    case "$mode" in
      recovered-baseline-adopt|legacy-baseline-finalize|releases|startup-contract|proxy-status|proxy-plan|smoke) ;;
      recovered-forward|recovered-forward-finalize)
        [[ "$legacy_record_state" == "candidate-postflight-failed" ]] || fail "recovered-forward is limited to the retained candidate-postflight-failed sentinel"
        recovered_baseline_receipt_validate || fail "recovered-forward adoption receipt is missing or invalid"
        ;;
      *) fail "legacy baseline transition is pending; platform mutation requires its exact finalize or recovery path" ;;
    esac
  fi
fi
transition_state_path="$legacy_fence_state_path"
if [[ "$mode" == "recovered-forward" || "$mode" == "recovered-forward-finalize" ]]; then
  transition_state_path="$recovered_journal_path"
fi
host_agent_bin="${NORN_HOST_AGENT_BIN:-$HOME/.config/norn/host/bin/norn-host-agent}"
host_agent_label="${NORN_HOST_AGENT_LABEL:-com.norn.host-agent}"
host_agent_direct_exec="${NORN_HOST_AGENT_DIRECT_EXEC:-false}"
host_cli_bin="${NORN_HOST_CLI_BIN:-$HOME/.config/norn/host/bin/norn}"
platform_script_bin="${NORN_PLATFORM_SCRIPT_BIN:-$HOME/.config/norn/host/bin/platform-upgrade}"
host_runtime_bin="${NORN_HOST_RUNTIME_BIN:-$HOME/.config/norn/host/bin/host-runtime}"
launch_label="${NORN_LAUNCH_LABEL:-com.norn.api}"
api_base="${NORN_API_BASE:-http://127.0.0.1:8800}"
candidate_port="${NORN_CANDIDATE_PORT:-18800}"
drain_mode="${NORN_DRAIN_MODE:-fail}"
drain_exclude_operation_id="${NORN_DRAIN_EXCLUDE_OPERATION_ID:-}"
skip_candidate="${NORN_SKIP_CANDIDATE_API:-false}"
proxy_listen="${NORN_PROXY_LISTEN:-:8800}"
proxy_active_port="${NORN_PROXY_ACTIVE_PORT:-18801}"
proxy_candidate_port="${NORN_PROXY_CANDIDATE_PORT:-18802}"
proxy_dir="${NORN_PROXY_DIR:-$HOME/norn/proxy}"
proxy_upstream_file="${NORN_PROXY_UPSTREAM_FILE:-$proxy_dir/upstream}"
proxy_caddyfile="${NORN_PROXY_CADDYFILE:-$proxy_dir/Caddyfile}"
proxy_pid_file="${NORN_PROXY_PID_FILE:-$proxy_dir/api.pid}"
proxy_reload="${NORN_PROXY_RELOAD:-false}"
upgrade_mode="${NORN_PLATFORM_UPGRADE_MODE:-restart}"
api_env_file="${NORN_API_ENV_FILE:-$HOME/.config/norn/api.env.enc.json}"
