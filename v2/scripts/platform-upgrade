node_bin="${NORN_NODE_BIN:-}"
expected_node_override="${NORN_EXPECTED_NODE_VERSION:-}"
expected_pnpm_override="${NORN_EXPECTED_PNPM_VERSION:-}"
release_fetch_hook="${NORN_RELEASE_FETCH_HOOK:-}"
release_verify_hook="${NORN_RELEASE_VERIFY_HOOK:-}"
signature_policy="${NORN_RELEASE_SIGNATURE_POLICY:-allow-unsigned}"
allow_legacy_releases="${NORN_ALLOW_LEGACY_RELEASES:-false}"
