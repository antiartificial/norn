promotion_guard_pid=""
promotion_control_fifo=""
promotion_lock_error=""
promotion_work_root=""

release_promotion_lock() {
  if [[ -n "$promotion_guard_pid" ]]; then
    exec 9>&- || true
    wait "$promotion_guard_pid" >/dev/null 2>&1 || true
    promotion_guard_pid=""
  fi
  [[ -z "$promotion_control_fifo" ]] || rm -f "$promotion_control_fifo"
  [[ -z "$promotion_lock_error" ]] || rm -f "$promotion_lock_error"
  if [[ -n "$promotion_work_root" && -d "$promotion_work_root" ]]; then
    rm -rf "$promotion_work_root"
  fi
  promotion_work_root=""
}

acquire_promotion_lock() {
  [[ -z "$promotion_guard_pid" ]] || fail "platform promotion lock is already held by this process"
  command -v python3 >/dev/null 2>&1 || fail "python3 not found"
  mkdir -p "$releases"
  promotion_work_root="$(mktemp -d "${TMPDIR:-/tmp}/norn-promotion-lock.XXXXXX")"
  local status_fifo="$promotion_work_root/status"
  promotion_control_fifo="$promotion_work_root/control"
  promotion_lock_error="$promotion_work_root/error"
  mkfifo "$status_fifo" "$promotion_control_fifo"

  # Open both FIFOs in the parent before starting the guard. The child closes
  # the inherited descriptors, holds an advisory lock, and exits automatically
  # when this process closes fd 9 or dies.
  exec 8<>"$status_fifo"
  exec 9<>"$promotion_control_fifo"
  python3 - "$releases/.promotion.lock" "$promotion_control_fifo" \
    8>&- 9>&- >"$status_fifo" 2>"$promotion_lock_error" <<'PY' &
import fcntl
import os
import stat
import sys

lock_path, control_path = sys.argv[1:]
descriptor = None
try:
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(lock_path, flags, 0o600)
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError("promotion lock is not a regular file")
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError("promotion lock must be private and owned by the current user")
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        raise RuntimeError("another platform promotion is already active") from error
    os.ftruncate(descriptor, 0)
    os.write(descriptor, f"pid={os.getppid()}\n".encode())
    os.fsync(descriptor)
    print("acquired", flush=True)
    with open(control_path, "rb", buffering=0) as control:
        while control.read(4096):
            pass
except Exception as error:
    print(f"error:{error}", flush=True)
finally:
    if descriptor is not None:
        os.close(descriptor)
PY
  promotion_guard_pid="$!"

  local status=""
  IFS= read -r status <&8 || true
  exec 8>&-
  rm -f "$status_fifo"
  if [[ "$status" != "acquired" ]]; then
    exec 9>&-
    wait "$promotion_guard_pid" >/dev/null 2>&1 || true
    promotion_guard_pid=""
    if [[ -s "$promotion_lock_error" ]]; then
      sed -n '1,20p' "$promotion_lock_error" >&2
    fi
    fail "${status#error:}"
  fi
  log "platform promotion lock acquired"
}

trap release_promotion_lock EXIT
if [[ -z "$node_bin" ]]; then
  for candidate in /opt/homebrew/opt/node@24/bin/node /usr/local/opt/node@24/bin/node; do
    if [[ -x "$candidate" ]]; then
      node_bin="$candidate"
      break
    fi
  done
fi
node_bin="${node_bin:-node}"

startup_contract_name='norn.startup/v2'
last_startup_contract=''

probe_startup_contract() {
  local binary="$1"
  [[ -x "$binary" ]] || fail "startup contract probe target is not executable: $binary"
  # Older binaries ignore this flag and may enter active startup. Reject a
  # missing contract marker before executing them; the bounded probe below
  # still has to validate the exact response for marker-bearing binaries.
  if ! grep -aFq "$startup_contract_name" "$binary"; then
    fail "release binary lacks the ${startup_contract_name} marker; refusing to execute a legacy startup path"
  fi
  local probe_dir probe_out probe_err probe_pid probe_result="" probe_done=false probe_status=0
  probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/norn-startup-probe.XXXXXX")"
  probe_out="$probe_dir/stdout"
  probe_err="$probe_dir/stderr"
  env -i \
    PATH="$PATH" \
    TMPDIR="${TMPDIR:-/tmp}" \
    NORN_DATABASE_URL="postgresql://norn-probe@127.0.0.1:1/norn_probe?sslmode=disable&connect_timeout=1" \
    "$binary" --norn-startup-contract >"$probe_out" 2>"$probe_err" &
  probe_pid="$!"
  for _ in $(seq 1 50); do
    if ! kill -0 "$probe_pid" >/dev/null 2>&1; then
      if wait "$probe_pid"; then
        probe_status=0
      else
        probe_status="$?"
      fi
      probe_done=true
      break
    fi
    sleep 0.1
  done
  if [[ "$probe_done" != "true" ]]; then
    kill "$probe_pid" >/dev/null 2>&1 || true
    for _ in $(seq 1 10); do
      if ! kill -0 "$probe_pid" >/dev/null 2>&1; then
        break
      fi
      sleep 0.1
    done
    if kill -0 "$probe_pid" >/dev/null 2>&1; then
      kill -9 "$probe_pid" >/dev/null 2>&1 || true
    fi
    wait "$probe_pid" >/dev/null 2>&1 || true
    rm -rf "$probe_dir"
    fail "release binary does not provide the bounded ${startup_contract_name} capability probe; refusing to execute it with passive or migration startup flags"
  fi
  if [[ "$probe_status" != "0" ]]; then
    rm -rf "$probe_dir"
    fail "release binary did not exit successfully from the exact ${startup_contract_name} probe; refusing to execute it against the control database"
  fi
  if [[ ! -s "$probe_out" || "$(wc -c <"$probe_out")" -gt 8192 ]]; then
    rm -rf "$probe_dir"
    fail "release binary returned a missing or oversized ${startup_contract_name} contract; refusing to execute it against the control database"
  fi
  require_cmd python3
  if ! probe_result="$(python3 - "$probe_out" <<'PY'
import json
import sys

def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON field {key}")
        result[key] = value
    return result

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    contract = json.load(handle, object_pairs_hook=strict_object)
expected_top = {"name", "schemaModes", "startupModes", "passiveRoutes", "schemaContract"}
if type(contract) is not dict or set(contract) != expected_top:
    raise SystemExit("startup contract fields are not exact")
if contract["name"] != "norn.startup/v2":
    raise SystemExit("startup contract name is unsupported")
if contract["schemaModes"] != ["auto", "check", "migrate-only"]:
    raise SystemExit("schema modes are unsupported")
if contract["startupModes"] != ["active", "passive"]:
    raise SystemExit("startup modes are unsupported")
if contract["passiveRoutes"] != ["/api/health", "/api/version", "/api/schema"]:
    raise SystemExit("passive routes are unsupported")
schema = contract["schemaContract"]
expected_schema = {
    "readerVersion", "writerVersion", "catalogMigrationVersion",
    "catalogMinimumReaderVersion", "catalogMinimumWriterVersion",
}
if type(schema) is not dict or set(schema) != expected_schema:
    raise SystemExit("schema contract fields are not exact")
for field in expected_schema:
    if type(schema[field]) is not int or schema[field] < 0:
        raise SystemExit(f"schema contract field {field} must be a nonnegative integer")
if schema["catalogMigrationVersion"] < 1:
    raise SystemExit("compiled migration catalog must be nonempty")
if schema["catalogMinimumReaderVersion"] > schema["readerVersion"]:
    raise SystemExit("binary cannot read its prospective catalog")
if schema["catalogMinimumWriterVersion"] > schema["writerVersion"]:
    raise SystemExit("binary cannot write its prospective catalog")
print(json.dumps(contract, separators=(",", ":"), sort_keys=True))
PY
)"; then
    rm -rf "$probe_dir"
    fail "release binary does not advertise the exact ${startup_contract_name} contract; refusing to execute it against the control database"
  fi
  last_startup_contract="$probe_result"
  rm -rf "$probe_dir"
}

if [[ "$mode" == "startup-contract" ]]; then
  [[ -n "${1:-}" ]] || fail "startup-contract requires a norn-api binary"
  probe_startup_contract "$1"
  printf '%s\n' "$last_startup_contract"
  exit 0
fi

if [[ "$upgrade_mode" == "proxy" && -z "${NORN_CANDIDATE_PORT:-}" ]]; then
  candidate_port="$proxy_candidate_port"
fi

if [[ "$mode" == "upgrade" && "$upgrade_mode" == "proxy" ]]; then
  fail "proxy upgrade handoff is not yet supported by the owner-fenced startup contract; use NORN_PLATFORM_UPGRADE_MODE=restart after an explicit maintenance window"
fi

run_with_api_env() {
  require_cmd python3
  require_cmd "$sops_bin"
  [[ -f "$api_env_file" ]] || fail "API env file not found: $api_env_file"
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  [[ "$#" -gt 0 ]] || fail "env-exec requires a command"
  python3 - "$api_env_file" "$sops_bin" "$@" <<'PY'
import json
import os
import subprocess
import sys

env_file = sys.argv[1]
sops_bin = sys.argv[2]
argv = sys.argv[3:]
raw = subprocess.check_output([sops_bin, "--decrypt", "--output-type", "json", os.path.expanduser(env_file)])
runtime_env = os.environ.copy()
env = runtime_env.copy()
env.update({str(k): str(v) for k, v in json.loads(raw).items()})
# SOPS remains authoritative for normal application configuration. Recovered-
# forward transition bindings are short-lived runtime inputs from the signed
# journal/controller, however; letting stale encrypted values override them
# can make a newly retargeted candidate boot with the previous candidate's
# evidence. Preserve the runtime values for this exact protocol namespace.
for name, value in runtime_env.items():
    if name.startswith("NORN_RECOVERED_FORWARD_"):
        env[name] = value
for name in ("PATH", "HOME", "USER", "TMPDIR", "LANG", "LC_ALL"):
    if name in runtime_env:
        env[name] = runtime_env[name]
if "NORN_TOKEN" not in env and "NORN_API_BEARER_TOKEN" in env:
    env["NORN_TOKEN"] = env["NORN_API_BEARER_TOKEN"]
if "NORN_API_TOKEN" not in env and "NORN_API_BEARER_TOKEN" in env:
    env["NORN_API_TOKEN"] = env["NORN_API_BEARER_TOKEN"]
os.execvpe(argv[0], argv, env)
PY
}

mini_evidence_root="$HOME/.config/norn/m5-v3-rc1"
mini_evidence_backup_dir="$mini_evidence_root/backup"
mini_evidence_receipt_dir="$mini_evidence_root/receipts"

mini_current_release_sha() {
  [[ -L "$current_link" ]] || fail "Mini evidence requires a current release symlink"
  local current_release
  current_release="$(current_release_target)"
  [[ -n "$current_release" && "$current_release" == "$releases"/* && -f "$current_release/release.env" ]] || fail "Mini current release is outside the immutable release root"
  python3 - "$current_release/release.env" <<'PY'
import re, sys
values = dict(line.strip().split("=", 1) for line in open(sys.argv[1], encoding="utf-8") if "=" in line)
sha = values.get("NORN_RELEASE_SHA", "")
if not re.fullmatch(r"[0-9a-f]{40}", sha): raise SystemExit("current release has no exact source SHA")
print(sha)
PY
}

run_mini_protected_backup() {
  [[ "$#" == 0 ]] || fail "mini-protected-backup accepts no arguments"
  [[ -n "${NORN_DATABASE_URL:-}" && -n "${NORN_AUDIT_SIGNING_KEY:-}" ]] || fail "Mini protected backup requires the authenticated runtime environment"
  local source_sha helper
  source_sha="$(mini_current_release_sha)"
  helper="$script_dir/mini-create-protected-backup"
  [[ -f "$helper" && -x "$helper" && ! -L "$helper" ]] || fail "signed release does not include the protected Mini backup helper"
  [[ -d "$mini_evidence_backup_dir" && ! -L "$mini_evidence_backup_dir" ]] || fail "Mini protected backup directory must already exist"
  "$helper" --legacy-release "$source_sha" --output-dir "$mini_evidence_backup_dir"
}

run_mini_signed_shadow() {
  [[ "$#" == 1 && "$1" =~ ^[0-9a-f]{40}$ ]] || fail "mini-signed-shadow requires one full candidate SHA"
  [[ -n "${NORN_AUDIT_SIGNING_KEY:-}" && -n "${NORN_RELEASE_PUBLIC_KEY:-}" ]] || fail "Mini signed shadow requires the authenticated runtime environment and pinned release key"
  local source_sha candidate_sha candidate_release backup_proof backup_artifact receipt stamp helper
  source_sha="$(mini_current_release_sha)"
  candidate_sha="$1"
  candidate_release="$releases/$candidate_sha"
  [[ -d "$candidate_release" && ! -L "$candidate_release" ]] || fail "signed shadow candidate is not imported"
  [[ "$("$manifest_helper" verify --release "$candidate_release" --expected-sha "$candidate_sha")" == signed ]] || fail "signed shadow candidate verification failed"
  [[ -d "$mini_evidence_backup_dir" && ! -L "$mini_evidence_backup_dir" ]] || fail "Mini protected backup directory is missing"
  [[ -d "$mini_evidence_receipt_dir" && ! -L "$mini_evidence_receipt_dir" ]] || fail "Mini evidence receipt directory is missing"
  local backup_selection
  backup_selection="$(python3 - "$mini_evidence_backup_dir" "$source_sha" "${NORN_LEGACY_BACKUP_MAX_AGE_SECONDS:-3600}" <<'PY'
import datetime, glob, json, os, re, sys
root, source_sha, max_age_text = sys.argv[1:]
try: max_age = int(max_age_text)
except ValueError: raise SystemExit("invalid backup evidence age limit")
now = datetime.datetime.now(datetime.timezone.utc)
candidates = []
for proof in glob.glob(os.path.join(root, "*.proof.json")):
    artifact = proof[:-len(".proof.json")] + ".dump"
    try:
        with open(proof, encoding="utf-8") as source: value = json.load(source)
        created = datetime.datetime.fromisoformat(value["createdAt"].replace("Z", "+00:00"))
        age = (now - created.astimezone(datetime.timezone.utc)).total_seconds()
        if (value.get("schema") == "norn.legacy-control-backup/v1"
                and value.get("sourceReleaseSHA") == source_sha
                and os.path.isfile(artifact) and not os.path.islink(proof)
                and not os.path.islink(artifact) and 0 <= age <= max_age):
            candidates.append((created, proof, artifact))
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        continue
if not candidates: raise SystemExit("no fresh protected backup exists for the current Mini release")
_, proof, artifact = max(candidates)
print(proof, artifact)
PY
  )" || fail "cannot select fresh protected backup evidence for the signed shadow"
  read -r backup_proof backup_artifact <<<"$backup_selection"
  "$script_dir/mini-verify-protected-backup" "$backup_proof" "$backup_artifact" "$source_sha" >/dev/null || fail "protected Mini backup verification failed"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$(python3 -c 'import secrets; print(secrets.token_hex(4))')"
  receipt="$mini_evidence_receipt_dir/shadow-$stamp.json"
  helper="$script_dir/mini-signed-shadow-launchagent-rehearsal"
  [[ -f "$helper" && -x "$helper" && ! -L "$helper" ]] || fail "signed release does not include the Mini shadow rehearsal helper"
  NORN_M5_SIGNED_SHADOW_REHEARSAL=1 \
  NORN_REHEARSAL_BACKUP_ARTIFACT="$backup_artifact" \
  NORN_REHEARSAL_BACKUP_PROOF="$backup_proof" \
  NORN_REHEARSAL_LEGACY_RELEASE_SHA="$source_sha" \
  NORN_M5_SHADOW_RECEIPT="$receipt" \
    "$helper" run --candidate-release "$candidate_release" --public-key "$NORN_RELEASE_PUBLIC_KEY"
}

current_proxy_upstream() {
  if [[ -f "$proxy_upstream_file" ]]; then
    head -1 "$proxy_upstream_file"
    return
  fi
  printf '127.0.0.1:%s\n' "$proxy_active_port"
}

current_release_target() {
  [[ -L "$current_link" ]] || return 0
  local target
  target="$(readlink "$current_link")"
  if [[ "$target" != /* ]]; then
    target="$(dirname "$current_link")/$target"
  fi
  python3 - "$target" <<'PY'
import os
import sys
print(os.path.abspath(sys.argv[1]))
PY
}

render_proxy_config() {
  local upstream
  upstream="$(current_proxy_upstream)"
  cat <<EOF
${proxy_listen} {
  reverse_proxy ${upstream}
}
EOF
}

write_proxy_config() {
  mkdir -p "$proxy_dir"
  render_proxy_config > "$proxy_caddyfile"
}

