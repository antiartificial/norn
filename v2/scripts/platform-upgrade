  current_pid="-"
  if [[ -f "$proxy_pid_file" ]]; then
    current_pid="$(head -1 "$proxy_pid_file")"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$proxy_listen" "$(current_proxy_upstream)" "$current_pid" "$proxy_caddyfile" "$proxy_reload"
  exit 0
fi

if [[ "$mode" == "proxy-render" ]]; then
  render_proxy_config
