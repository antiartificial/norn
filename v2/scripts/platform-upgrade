  [[ -n "$target" ]] || fail "proxy-switch requires a target port or host:port"
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    target="127.0.0.1:$target"
  fi
  acquire_promotion_lock
  mkdir -p "$proxy_dir"
  printf '%s\n' "$target" > "$proxy_upstream_file"
  write_proxy_config
  log "proxy upstream set to $target"
  log "wrote $proxy_caddyfile"
  if [[ "$proxy_reload" == "true" ]]; then
    require_cmd caddy
    caddy reload --config "$proxy_caddyfile"
  fi
  exit 0
fi

case "$signature_policy" in
  allow-unsigned|require-signed) ;;
  *) fail "invalid NORN_RELEASE_SIGNATURE_POLICY: $signature_policy" ;;
esac
case "$allow_legacy_releases" in
  true|false) ;;
  *) fail "NORN_ALLOW_LEGACY_RELEASES must be true or false" ;;
esac
if [[ "$profile" == "production" && "$mode" =~ ^(preflight|upgrade|rebuild|rollback)$ ]]; then
  signature_policy="require-signed"
  allow_legacy_releases=false
  [[ -n "$release_verify_hook" ]] || fail "NORN_PROFILE=production requires NORN_RELEASE_VERIFY_HOOK"
  [[ -x "$release_verify_hook" ]] || fail "production release verify hook is not executable: $release_verify_hook"
fi

require_cmd curl
require_cmd install
require_cmd cmp
require_cmd python3
[[ -f "$manifest_helper" ]] || fail "release manifest helper not found: $manifest_helper"

