if [[ "$mode" == "proxy-plan" ]]; then
  cat <<EOF
# Norn proxy handoff status
#
# Proxy upgrade is intentionally unavailable in this bounded tranche. The old
# implementation retained a worker-disabled preflight process as the active
# API, which cannot safely promote worker/recovery ownership. Use the restart
# lane during an explicit control-plane maintenance window. A future proxy
# handoff must start a fresh active process and prove ownership transfer before
# this plan can be enabled.
EOF
  exit 0
fi

