#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: host-runtime <install|prerequisites|setup|render|doctor|recover|cloudflared-recover|assure|status|migrate-state|security-plan|security-init> [options]

Manage a persistent macOS Norn runtime without embedding machine-specific paths
in the repository.

Options:
  --repo PATH           Norn checkout (default: NORN_HOST_REPO or inferred)
  --config-dir PATH     Managed config root (default: ~/.config/norn/host)
  --state-dir PATH      Persistent state root (default: ~/.local/share/norn/host)
  --log-dir PATH        Log directory (default: ~/.local/log)
  --launch-agents-dir PATH
                        LaunchAgent directory (default: ~/Library/LaunchAgents)
  --nomad-source PATH   Source Nomad HCL to preserve host volumes
  --consul-source PATH  Source Consul HCL
  --address ADDRESS     Advertise/bind address (default: auto-detected IPv4)
  --api-label LABEL     Norn API launchd label (default: com.norn.api)
  --cloudflared-config PATH
                        Named-tunnel config (default: ~/.cloudflared/config.yml)
  --cloudflared-label LABEL
                        Norn-owned launchd label (default: com.norn.cloudflared)
  --cloudflared-probe URL
                        Public URL checked after cloudflared recovery
  --skip-cloudflared    Do not install or recover a cloudflared LaunchAgent
  --catch-up APP:PROC   Trigger a bounded cron catch-up after recovery (repeatable)
  --required APP:PROC   Assure a required app process is passing (repeatable)
  --probe NAME=URL      Probe a user-facing HTTP endpoint (repeatable)
  --serve PORT=TARGET   Reconcile a Tailscale Serve route; TARGET may contain {address}
  --forge APP           Reconcile an app's public Cloudflare routes (repeatable)
  --assure-interval N   Periodic assurance interval in seconds (default: 300)
  --security-dir PATH   Staged/active security artifacts (default: CONFIG_DIR/security)
  --cert-days N         Leaf certificate validity for security-init (default: 365)
  --nomad-security-fragment PATH
                        Reserved; activation is refused until recovery is TLS/ACL-aware
  --consul-security-fragment PATH
                        Reserved; activation is refused until recovery is TLS/ACL-aware
  --from-nomad PATH     Stopped Nomad state source for migrate-state
  --from-consul PATH    Stopped Consul state source for migrate-state
  --dry-run             Print planned writes/actions
  --connector NAME      Prerequisites to check: nomad-consul (default) or apple-container
  --setup               With prerequisites, interactively install supported missing prerequisites
  --check               Check only; never install or start a runtime
  --yes                 Accept setup prompts (still never bypasses macOS sudo authentication)
  --non-interactive     Refuse an action that would require an interactive prompt

`prerequisites` is safe before a host runtime is installed. `setup` is a
shortcut for `prerequisites --setup`: it can install the optional Apple
Container development connector on a supported Apple-silicon macOS host. It
downloads a version-pinned signed package from Apple's GitHub release, checks
the Developer ID and notarization locally, then uses macOS Installer. It never
executes downloaded code as a shell script.

install writes managed files but does not interrupt live agents. Run
migrate-state only while Nomad and Consul are stopped, then run recover.
USAGE
}

die() {
  echo "host-runtime: $*" >&2
  exit 1
}

note() {
  echo "host-runtime: $*"
}

expand_home() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

mode="${1:-}"
[ -n "$mode" ] || { usage >&2; exit 2; }
shift

repo="${NORN_HOST_REPO:-}"
config_dir="${NORN_HOST_CONFIG_DIR:-$HOME/.config/norn/host}"
state_dir="${NORN_HOST_STATE_DIR:-$HOME/.local/share/norn/host}"
log_dir="${NORN_HOST_LOG_DIR:-$HOME/.local/log}"
launch_agents="${NORN_HOST_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
nomad_source="${NORN_HOST_NOMAD_SOURCE:-}"
consul_source="${NORN_HOST_CONSUL_SOURCE:-}"
security_dir="${NORN_HOST_SECURITY_DIR:-}"
nomad_security_fragment="${NORN_HOST_NOMAD_SECURITY_FRAGMENT:-}"
consul_security_fragment="${NORN_HOST_CONSUL_SECURITY_FRAGMENT:-}"
cert_days="${NORN_HOST_CERT_DAYS:-365}"
address="${NORN_HOST_ADDRESS:-auto}"
api_label="${NORN_HOST_API_LABEL:-com.norn.api}"
cloudflared_config="${NORN_HOST_CLOUDFLARED_CONFIG:-${NORN_CLOUDFLARED_CONFIG:-$HOME/.cloudflared/config.yml}}"
cloudflared_label="${NORN_HOST_CLOUDFLARED_LABEL:-${NORN_CLOUDFLARED_LAUNCH_LABEL:-com.norn.cloudflared}}"
cloudflared_probe="${NORN_HOST_CLOUDFLARED_PROBE:-}"
skip_cloudflared=false
from_nomad=""
from_consul=""
dry_run=false
connector="${NORN_WORKLOAD_CONNECTOR:-nomad-consul}"
setup_requested=false
check_only=false
yes=false
non_interactive=false
catch_up_specs=""
required_specs=""
probe_specs=""
serve_specs=""
forge_specs=""
assure_interval="${NORN_HOST_ASSURE_INTERVAL:-300}"

append_spec() {
  local current="$1" value="$2"
  if [ -n "$current" ]; then
    printf '%s\n%s\n' "$current" "$value"
  else
    printf '%s\n' "$value"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --config-dir) config_dir="$2"; shift 2 ;;
    --state-dir) state_dir="$2"; shift 2 ;;
    --log-dir) log_dir="$2"; shift 2 ;;
    --launch-agents-dir) launch_agents="$2"; shift 2 ;;
    --nomad-source) nomad_source="$2"; shift 2 ;;
    --consul-source) consul_source="$2"; shift 2 ;;
    --security-dir) security_dir="$2"; shift 2 ;;
    --cert-days) cert_days="$2"; shift 2 ;;
    --nomad-security-fragment) nomad_security_fragment="$2"; shift 2 ;;
    --consul-security-fragment) consul_security_fragment="$2"; shift 2 ;;
    --address) address="$2"; shift 2 ;;
    --api-label) api_label="$2"; shift 2 ;;
    --cloudflared-config) cloudflared_config="$2"; shift 2 ;;
    --cloudflared-label) cloudflared_label="$2"; shift 2 ;;
    --cloudflared-probe) cloudflared_probe="$2"; shift 2 ;;
    --skip-cloudflared) skip_cloudflared=true; shift ;;
    --catch-up)
      catch_up_specs="$(append_spec "$catch_up_specs" "$2")"
      shift 2
      ;;
    --required) required_specs="$(append_spec "$required_specs" "$2")"; shift 2 ;;
    --probe) probe_specs="$(append_spec "$probe_specs" "$2")"; shift 2 ;;
    --serve) serve_specs="$(append_spec "$serve_specs" "$2")"; shift 2 ;;
    --forge) forge_specs="$(append_spec "$forge_specs" "$2")"; shift 2 ;;
    --assure-interval) assure_interval="$2"; shift 2 ;;
    --from-nomad) from_nomad="$2"; shift 2 ;;
    --from-consul) from_consul="$2"; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    --connector) connector="$2"; shift 2 ;;
    --setup) setup_requested=true; shift ;;
    --check) check_only=true; shift ;;
    --yes) yes=true; shift ;;
    --non-interactive) non_interactive=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

if [ "$mode" = "setup" ]; then
  setup_requested=true
fi

config_dir="$(expand_home "$config_dir")"
state_dir="$(expand_home "$state_dir")"
log_dir="$(expand_home "$log_dir")"
launch_agents="$(expand_home "$launch_agents")"
cloudflared_config="$(expand_home "$cloudflared_config")"
runtime_copy="$config_dir/bin/host-runtime"
norn_copy="$config_dir/bin/norn"
agent_copy="$config_dir/bin/norn-host-agent"
platform_copy="$config_dir/bin/platform-upgrade"
catch_up_file="$config_dir/catch-up-jobs"
required_file="$config_dir/assure-required"
probe_file="$config_dir/assure-probes"
serve_file="$config_dir/assure-serve"
forge_file="$config_dir/assure-forge"
assure_state="$state_dir/assurance-failed"
capacity_state="$state_dir/assurance-below-minimum"
assure_lock="$state_dir/assurance.lock"
nomad_config="$config_dir/nomad.hcl"
consul_config="$config_dir/consul.hcl"
if [ -z "$security_dir" ]; then security_dir="$config_dir/security"; fi
security_dir="$(expand_home "$security_dir")"
active_security_dir="$security_dir/active"
active_nomad_security="$active_security_dir/nomad.hcl"
active_consul_security="$active_security_dir/consul.hcl"
active_security_env="${NORN_HOST_SECURITY_ENV:-$active_security_dir/client.env}"
nomad_source_copy="$config_dir/sources/nomad.hcl"
consul_source_copy="$config_dir/sources/consul.hcl"
nomad_state="$state_dir/nomad"
consul_state="$state_dir/consul"
nomad_label="com.norn.nomad"
consul_label="com.norn.consul"
supervisor_label="com.norn.host-supervisor"
assurance_label="com.norn.host-assurance"
agent_label="com.norn.host-agent"
legacy_cloudflared_label="homebrew.mxcl.cloudflared"
cloudflared_plist_path="$launch_agents/$cloudflared_label.plist"

if [ -z "$repo" ]; then
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  candidate="$(cd "$script_dir/../.." 2>/dev/null && pwd || true)"
  if [ -f "$candidate/v2/Makefile" ]; then
    repo="$candidate"
  fi
fi
if [ -n "$repo" ]; then
  repo="$(expand_home "$repo")"
fi
if [ -z "$nomad_source" ] && [ -n "$repo" ]; then
  nomad_source="$repo/v2/dev/nomad-server.hcl"
fi
if [ -z "$consul_source" ] && [ -n "$repo" ]; then
  consul_source="$repo/v2/dev/consul-server.hcl"
fi
nomad_source="$(expand_home "$nomad_source")"
consul_source="$(expand_home "$consul_source")"
if [ -n "$nomad_security_fragment" ]; then nomad_security_fragment="$(expand_home "$nomad_security_fragment")"; fi
if [ -n "$consul_security_fragment" ]; then consul_security_fragment="$(expand_home "$consul_security_fragment")"; fi

command_path() {
  local name="$1"
  local candidate
  candidate="$(command -v "$name" 2>/dev/null || true)"
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  for candidate in "$config_dir/bin/$name" "$HOME/go/bin/$name" "/opt/homebrew/bin/$name" "/usr/local/bin/$name" "/usr/bin/$name"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

install_executable() {
  local source="$1" destination="$2"
  if [ -e "$destination" ] && [ "$source" -ef "$destination" ]; then
    chmod 755 "$destination"
    return 0
  fi
  cp "$source" "$destination"
  chmod 755 "$destination"
}

detect_address() {
  local iface candidate
  if [ "$address" != "auto" ]; then
    printf '%s\n' "$address"
    return
  fi
  iface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  if [ -n "$iface" ]; then
    candidate="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    if [ -n "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  fi
  for iface in en0 en1; do
    candidate="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    if [ -n "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  die "could not auto-detect a non-loopback IPv4 address; pass --address"
}

backup_if_present() {
  local path="$1"
  if [ -e "$path" ]; then
    local stamp
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    cp -p "$path" "$path.bak.$stamp"
  fi
}

write_file() {
  local path="$1" mode_bits="$2"
  local temp
  temp="$(mktemp "${TMPDIR:-/tmp}/norn-host.XXXXXX")"
  cat > "$temp"
  if $dry_run; then
    note "would write $path"
    rm -f "$temp"
    return
  fi
  mkdir -p "$(dirname "$path")"
  backup_if_present "$path"
  chmod "$mode_bits" "$temp"
  mv "$temp" "$path"
}

render_configs() {
  [ -f "$nomad_source_copy" ] || die "missing managed Nomad source: run install"
  [ -f "$consul_source_copy" ] || die "missing managed Consul source: run install"
  if [ -e "$active_nomad_security" ] || [ -e "$active_consul_security" ]; then
    [ -f "$active_nomad_security" ] && [ -f "$active_consul_security" ] || die "refusing incomplete active security fragment pair"
    die "security fragment activation is unavailable until host recovery and assurance use authenticated TLS probes"
  fi
  local detected
  detected="$(detect_address)"
  if $dry_run; then
    note "would render configs with address=$detected state_dir=$state_dir"
    return
  fi
  mkdir -p "$nomad_state" "$consul_state"
  python3 - "$nomad_source_copy" "$nomad_config" "$nomad_state" "$detected" <<'PY'
import pathlib, re, sys
source, destination, state, address = sys.argv[1:]
text = pathlib.Path(source).read_text()
text, count = re.subn(r'(?m)^data_dir\s*=\s*"[^"]*"', f'data_dir = "{state}"', text, count=1)
if count == 0:
    text = f'data_dir = "{state}"\n' + text
text, count = re.subn(
    r'(?m)^(\s*preferred_address_family\s*=\s*)"[^"]*"',
    r'\1"ipv4"',
    text,
    count=1,
)
if count == 0:
    text, count = re.subn(
        r'(?m)^(\s*client\s*\{\s*)$',
        lambda match: f'{match.group(1)}\n  preferred_address_family = "ipv4"',
        text,
        count=1,
    )
if count == 0:
    raise SystemExit("Nomad source config has no client block")
for key in ("http", "rpc", "serf"):
    text = re.sub(
        rf'(?m)^(\s*{key}\s*=\s*)"[^"]*"',
        lambda match: f'{match.group(1)}"{address}"',
        text,
        count=1,
    )
pathlib.Path(destination).write_text(text)
PY
  python3 - "$consul_source_copy" "$consul_config" "$consul_state" "$detected" <<'PY'
import pathlib, re, sys
source, destination, state, address = sys.argv[1:]
text = pathlib.Path(source).read_text()
text, count = re.subn(r'(?m)^data_dir\s*=\s*"[^"]*"', f'data_dir = "{state}"', text, count=1)
if count == 0:
    text = f'data_dir = "{state}"\n' + text
text, count = re.subn(r'(?m)^bind_addr\s*=\s*"[^"]*"', f'bind_addr = "{address}"', text, count=1)
if count == 0:
    text += f'\nbind_addr = "{address}"\n'
pathlib.Path(destination).write_text(text)
PY
  chmod 600 "$nomad_config" "$consul_config"
  note "rendered configs with address=$detected"
}

plist() {
  local label="$1" program="$2" config_flag="$3" config_path="$4"
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$program</string>
    <string>agent</string>
    <string>$config_flag</string>
    <string>$config_path</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$log_dir/$label.log</string>
  <key>StandardErrorPath</key><string>$log_dir/$label.log</string>
</dict>
</plist>
EOF
}

supervisor_plist() {
  local repo_args=""
  local cloudflared_args=""
  if [ -n "$repo" ]; then
    repo_args="    <string>--repo</string><string>$repo</string>"
  fi
  if $skip_cloudflared; then
    cloudflared_args="    <string>--skip-cloudflared</string>"
  else
    cloudflared_args="    <string>--cloudflared-config</string><string>$cloudflared_config</string>
    <string>--cloudflared-label</string><string>$cloudflared_label</string>"
    if [ -n "$cloudflared_probe" ]; then
      cloudflared_args="$cloudflared_args
    <string>--cloudflared-probe</string><string>$cloudflared_probe</string>"
    fi
  fi
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$supervisor_label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$runtime_copy</string>
    <string>supervise</string>
$repo_args
    <string>--config-dir</string><string>$config_dir</string>
    <string>--state-dir</string><string>$state_dir</string>
    <string>--log-dir</string><string>$log_dir</string>
    <string>--api-label</string><string>$api_label</string>
$cloudflared_args
  </array>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>$log_dir/$supervisor_label.log</string>
  <key>StandardErrorPath</key><string>$log_dir/$supervisor_label.log</string>
</dict>
</plist>
EOF
}

