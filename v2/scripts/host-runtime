cloudflared_tunnel_name() {
  sed -n 's/^[[:space:]]*tunnel:[[:space:]]*//p' "$cloudflared_config" | head -1 | tr -d "\"'"
}

validate_cloudflared_config() {
  local cloudflared_bin="$1"
  "$cloudflared_bin" --config "$cloudflared_config" tunnel ingress validate >/dev/null
}

cloudflared_plist() {
  local cloudflared_bin="$1" tunnel_name="$2"
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$cloudflared_label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$cloudflared_bin</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>$cloudflared_config</string>
    <string>run</string>
    <string>$tunnel_name</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>$log_dir/$cloudflared_label.log</string>
  <key>StandardErrorPath</key><string>$log_dir/$cloudflared_label.log</string>
</dict>
</plist>
EOF
}

validate_install_specs() {
  local spec name value extra
  case "$assure_interval" in
    ''|*[!0-9]*) die "--assure-interval must be an integer" ;;
  esac
  [ "$assure_interval" -ge 60 ] || die "--assure-interval must be at least 60 seconds"
  case "$cert_days" in ''|*[!0-9]*) die "--cert-days must be an integer" ;; esac
  [ "$cert_days" -ge 30 ] || die "--cert-days must be at least 30"
  if [ -n "$nomad_security_fragment$consul_security_fragment" ]; then
    [ -n "$nomad_security_fragment" ] && [ -n "$consul_security_fragment" ] || die "Nomad and Consul security fragments must be activated together"
    [ -f "$nomad_security_fragment" ] || die "Nomad security fragment not found: $nomad_security_fragment"
    [ -f "$consul_security_fragment" ] || die "Consul security fragment not found: $consul_security_fragment"
    die "security fragment activation is unavailable until host recovery and assurance use authenticated TLS probes"
  fi
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    case "$spec" in *:*) ;; *) die "invalid --required value (expected APP:PROCESS): $spec" ;; esac
  done <<EOF
$required_specs
EOF
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    case "$spec" in *=http://*|*=https://*) ;; *) die "invalid --probe value (expected NAME=URL): $spec" ;; esac
  done <<EOF
$probe_specs
EOF
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    name="${spec%%=*}"
    value="${spec#*=}"
    case "$name" in ''|*[!0-9]*) die "invalid --serve port: $name" ;; esac
    case "$value" in http://*|https://*) ;; *) die "invalid --serve target (expected URL): $value" ;; esac
  done <<EOF
$serve_specs
EOF
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    case "$spec" in *[!a-zA-Z0-9._-]*) die "invalid --forge app: $spec" ;; esac
  done <<EOF
$forge_specs
EOF
}

install_files() {
  [ "$(uname -s)" = "Darwin" ] || die "launchd host install currently supports macOS only"
  [ -f "$nomad_source" ] || die "Nomad source config not found: $nomad_source"
  [ -f "$consul_source" ] || die "Consul source config not found: $consul_source"
  local nomad_bin consul_bin cloudflared_bin tunnel_name script_self norn_cli host_agent platform_script spec
  validate_install_specs
  nomad_bin="$(command_path nomad)" || die "nomad binary not found"
  consul_bin="$(command_path consul)" || die "consul binary not found"
  script_self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  norn_cli="${NORN_HOST_CLI:-}"
  if [ -z "$norn_cli" ]; then
    norn_cli="$(command_path norn 2>/dev/null || true)"
  fi
  host_agent="${NORN_HOST_AGENT:-}"
  if [ -z "$host_agent" ] && [ -n "$norn_cli" ]; then
    host_agent="$(dirname "$norn_cli")/norn-host-agent"
  fi
  if [ -z "$host_agent" ] || [ ! -x "$host_agent" ]; then
    host_agent="$(command_path norn-host-agent 2>/dev/null || true)"
  fi
  [ -n "$host_agent" ] && [ -x "$host_agent" ] || die "norn-host-agent binary not found; run make build"
  platform_script="${NORN_PLATFORM_SCRIPT:-${repo:+$repo/v2/scripts/platform-upgrade}}"
  [ -n "$platform_script" ] && [ -f "$platform_script" ] || die "platform-upgrade script not found"
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    case "$spec" in
      *:*) ;;
      *) die "invalid --catch-up value (expected APP:PROCESS): $spec" ;;
    esac
  done <<EOF
$catch_up_specs
EOF
  if [ -n "$catch_up_specs$required_specs$forge_specs" ] && { [ -z "$norn_cli" ] || [ ! -x "$norn_cli" ]; }; then
    die "the norn CLI is required when catch-up or assurance actions are configured"
  fi
  if $dry_run; then
    note "would install managed runtime under $config_dir and $state_dir"
    return
  fi
  mkdir -p "$config_dir/bin" "$config_dir/sources" "$state_dir" "$log_dir" "$launch_agents"
  install_executable "$script_self" "$runtime_copy"
  if [ -n "$norn_cli" ] && [ -x "$norn_cli" ]; then
    install_executable "$norn_cli" "$norn_copy"
  fi
  install_executable "$host_agent" "$agent_copy"
  install_executable "$platform_script" "$platform_copy"
  cp "$nomad_source" "$nomad_source_copy"
  cp "$consul_source" "$consul_source_copy"
  render_configs
  plist "$consul_label" "$consul_bin" "-config-file" "$consul_config" | write_file "$launch_agents/$consul_label.plist" 644
  plist "$nomad_label" "$nomad_bin" "-config" "$nomad_config" | write_file "$launch_agents/$nomad_label.plist" 644
  supervisor_plist | write_file "$launch_agents/$supervisor_label.plist" 644
  assurance_plist | write_file "$launch_agents/$assurance_label.plist" 644
  agent_plist | write_file "$launch_agents/$agent_label.plist" 644
  if ! $skip_cloudflared; then
    cloudflared_bin="$(command_path cloudflared 2>/dev/null || true)"
    if [ -n "$cloudflared_bin" ] && [ -f "$cloudflared_config" ]; then
      validate_cloudflared_config "$cloudflared_bin" || die "invalid cloudflared config: $cloudflared_config"
      tunnel_name="$(cloudflared_tunnel_name)"
      [ -n "$tunnel_name" ] || die "cloudflared config has no top-level tunnel name: $cloudflared_config"
      cloudflared_plist "$cloudflared_bin" "$tunnel_name" | write_file "$cloudflared_plist_path" 644
      note "installed Norn-owned cloudflared LaunchAgent; run cloudflared-recover to activate it"
    elif [ -n "$cloudflared_bin" ] || [ -f "$cloudflared_config" ]; then
      die "cloudflared management requires both binary and config (binary=${cloudflared_bin:-missing}, config=$cloudflared_config)"
    else
      note "cloudflared not configured; skipping managed LaunchAgent"
    fi
  fi
  if [ -n "$catch_up_specs" ]; then
    printf '%s\n' "$catch_up_specs" | write_file "$catch_up_file" 600
  fi
  if [ -n "$required_specs" ]; then printf '%s\n' "$required_specs" | write_file "$required_file" 600; fi
  if [ -n "$probe_specs" ]; then printf '%s\n' "$probe_specs" | write_file "$probe_file" 600; fi
  if [ -n "$serve_specs" ]; then printf '%s\n' "$serve_specs" | write_file "$serve_file" 600; fi
  if [ -n "$forge_specs" ]; then printf '%s\n' "$forge_specs" | write_file "$forge_file" 600; fi
  note "installed launchd files; live services were not interrupted"
  note "next: stop live agents, run migrate-state, then run recover"
}

load_runtime_security_env() {
  [ -f "$active_security_env" ] || return 0
  local mode_bits
  mode_bits="$(stat -f '%Lp' "$active_security_env" 2>/dev/null || true)"
  [ -n "$mode_bits" ] || die "could not inspect active security environment: $active_security_env"
  [ $((8#$mode_bits & 077)) -eq 0 ] || die "active security environment must not be group/world accessible: $active_security_env"
  set -a
  # shellcheck disable=SC1090
  . "$active_security_env"
  set +a
}

runtime_base() {
  case "$1" in
    consul) printf '%s\n' "${CONSUL_HTTP_ADDR:-http://127.0.0.1:8500}" ;;
    nomad) printf '%s\n' "${NOMAD_ADDR:-http://127.0.0.1:4646}" ;;
    norn) printf '%s\n' "${NORN_URL:-http://127.0.0.1:8800}" ;;
    *) return 1 ;;
  esac
}

runtime_curl() {
  local service="$1" path="$2" base server_name port token_file token=""
  shift 2
  local -a args
  args=(curl)
  base="$(runtime_base "$service")"
  case "$service" in
    consul)
      [ -n "${CONSUL_CACERT:-}" ] && args+=(--cacert "$CONSUL_CACERT")
      [ -n "${CONSUL_CLIENT_CERT:-}" ] && args+=(--cert "$CONSUL_CLIENT_CERT")
      [ -n "${CONSUL_CLIENT_KEY:-}" ] && args+=(--key "$CONSUL_CLIENT_KEY")
      token="${CONSUL_HTTP_TOKEN:-}"
      token_file="${CONSUL_HTTP_TOKEN_FILE:-}"
      [ -z "$token" ] && [ -n "$token_file" ] && [ -r "$token_file" ] && token="$(<"$token_file")"
      [ -n "$token" ] && args+=(-H "X-Consul-Token: $token")
      server_name="${CONSUL_TLS_SERVER_NAME:-}"
      ;;
    nomad)
      [ -n "${NOMAD_CACERT:-}" ] && args+=(--cacert "$NOMAD_CACERT")
      [ -n "${NOMAD_CLIENT_CERT:-}" ] && args+=(--cert "$NOMAD_CLIENT_CERT")
      [ -n "${NOMAD_CLIENT_KEY:-}" ] && args+=(--key "$NOMAD_CLIENT_KEY")
      [ -n "${NOMAD_TOKEN:-}" ] && args+=(-H "X-Nomad-Token: $NOMAD_TOKEN")
      server_name="${NOMAD_TLS_SERVER_NAME:-}"
      ;;
    norn) server_name="" ;;
  esac
  if [[ "$base" == https://127.0.0.1:* ]] && [ -n "$server_name" ]; then
    port="${base##*:}"
    args+=(--resolve "$server_name:$port:127.0.0.1")
    base="https://$server_name:$port"
  fi
  args+=("$@" "${base%/}${path}")
  "${args[@]}"
}

load_runtime_security_env

wait_http() {
  local service="$1" path="$2" name="$3" attempts="${4:-60}" i=0
  while [ "$i" -lt "$attempts" ]; do
    if runtime_curl "$service" "$path" -fsS --max-time 2 >/dev/null 2>&1; then
      note "$name ready"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  die "$name did not become ready"
}

wait_leader() {
  local service="$1" path="$2" name="$3" attempts="${4:-60}" i=0 response
  while [ "$i" -lt "$attempts" ]; do
    response="$(runtime_curl "$service" "$path" -fsS --max-time 2 2>/dev/null || true)"
    if [ -n "$response" ] && [ "$response" != '""' ]; then
      note "$name leader ready"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  die "$name did not elect a leader"
}

bootstrap_label() {
  local label="$1" path="$2" domain="gui/$(id -u)" attempt
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  for attempt in $(seq 1 20); do
    launchctl print "$domain/$label" >/dev/null 2>&1 || break
    sleep 1
  done
  for attempt in $(seq 1 10); do
    if launchctl bootstrap "$domain" "$path"; then
      break
    fi
    [ "$attempt" -lt 10 ] || die "could not bootstrap $label after $attempt attempts"
    sleep "$attempt"
  done
  launchctl enable "$domain/$label" >/dev/null 2>&1 || true
  launchctl kickstart "$domain/$label"
}

load_periodic_label() {
  local label="$1" path="$2" domain="gui/$(id -u)" attempt
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  for attempt in $(seq 1 20); do
    launchctl print "$domain/$label" >/dev/null 2>&1 || break
    sleep 1
  done
  for attempt in $(seq 1 10); do
    if launchctl bootstrap "$domain" "$path"; then
      launchctl enable "$domain/$label" >/dev/null 2>&1 || true
      return 0
    fi
    [ "$attempt" -lt 10 ] || die "could not bootstrap $label after $attempt attempts"
    sleep "$attempt"
  done
}

assure_errors=""

record_assurance_failure() {
  if [ -n "$assure_errors" ]; then
    assure_errors="$assure_errors
$1"
  else
    assure_errors="$1"
  fi
  note "fail: $1"
}

service_passing_ipv4() {
  local service="$1"
  runtime_curl consul "/v1/health/service/$service?passing=true" -fsS --max-time 3 2>/dev/null |
    python3 -c '
import ipaddress, json, sys
try:
    instances = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
for item in instances:
    service = item.get("Service") or {}
    node = item.get("Node") or {}
    address = service.get("Address") or node.get("Address") or ""
    checks = item.get("Checks") or []
    try:
        ipv4 = ipaddress.ip_address(address).version == 4
    except ValueError:
        ipv4 = False
    if ipv4 and checks and all(check.get("Status") == "passing" for check in checks):
        raise SystemExit(0)
raise SystemExit(1)
'
}

job_exists() {
  local app="$1" code
  code="$(runtime_curl nomad "/v1/job/$app" -sS --max-time 3 -o /dev/null -w '%{http_code}' 2>/dev/null || true)"
  [ "$code" = "200" ]
}

wait_required_service() {
  local service="$1" attempt=0
  while [ "$attempt" -lt 24 ]; do
    if service_passing_ipv4 "$service"; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 5
  done
  return 1
}

run_managed_norn() {
  [ -x "$norn_copy" ] || { record_assurance_failure "managed norn CLI is missing"; return 1; }
  NORN_PLATFORM_REPO="$repo" "$norn_copy" "$@"
}

assure_required_service() {
  local app="$1" process="$2" service="$app-$process" attempt=0 action=""
  while [ "$attempt" -lt 3 ]; do
    if service_passing_ipv4 "$service"; then
      note "ok: required service $service is passing on IPv4"
      return 0
    fi
    attempt=$((attempt + 1))
    [ "$attempt" -lt 3 ] && sleep 2
  done

  if job_exists "$app"; then
    action="restart"
    note "repair: restarting unhealthy required app $app"
    if ! run_managed_norn restart "$app"; then
      record_assurance_failure "could not restart required app $app"
      return 1
    fi
  else
    action="deploy"
    note "repair: deploying absent required app $app"
    if ! run_managed_norn deploy "$app" HEAD; then
      record_assurance_failure "could not deploy absent required app $app"
      return 1
    fi
  fi

  if wait_required_service "$service"; then
    note "ok: required service $service recovered after $action"
    return 0
  fi
  record_assurance_failure "required service $service is not passing on IPv4 after $action"
  return 1
}

assure_nomad_ipv4() {
  if runtime_curl nomad /v1/nodes -fsS --max-time 3 2>/dev/null |
    python3 -c '
import ipaddress, json, sys
try:
    nodes = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
for node in nodes:
    if node.get("Status") != "ready":
        continue
    attributes = node.get("Attributes") or {}
    address = attributes.get("unique.network.ip-address") or node.get("Address") or ""
    try:
        if ipaddress.ip_address(address).version == 4:
            raise SystemExit(0)
    except ValueError:
        pass
raise SystemExit(1)
'; then
    note "ok: Nomad has a ready IPv4 node"
    return 0
  fi
  record_assurance_failure "Nomad has no ready IPv4 node"
  return 1
}

reconcile_serve_routes() {
  [ -s "$serve_file" ] || return 0
  local tailscale_bin spec port target detected
  if [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]; then
    tailscale_bin=/Applications/Tailscale.app/Contents/MacOS/Tailscale
  else
    tailscale_bin="$(command_path tailscale 2>/dev/null || true)"
  fi
  if [ -z "$tailscale_bin" ]; then
    record_assurance_failure "tailscale CLI is missing but Serve routes are configured"
    return 1
  fi
  detected="$(detect_address)"
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    port="${spec%%=*}"
    target="${spec#*=}"
    target="${target//\{address\}/$detected}"
    if "$tailscale_bin" serve --bg --https="$port" "$target" >/dev/null; then
      note "ok: Tailscale Serve :$port -> $target"
    else
      record_assurance_failure "could not reconcile Tailscale Serve :$port -> $target"
    fi
  done < "$serve_file"
}

reconcile_forge_routes() {
  [ -s "$forge_file" ] || return 0
  local app
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    if run_managed_norn forge "$app"; then
      note "ok: public routes reconciled for $app"
    else
      record_assurance_failure "could not reconcile public routes for $app"
    fi
  done < "$forge_file"
}

run_endpoint_probes() {
  [ -s "$probe_file" ] || return 0
  local spec name url attempt
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    name="${spec%%=*}"
    url="${spec#*=}"
    attempt=0
    while [ "$attempt" -lt 3 ]; do
      if curl -fLsS --max-time 10 "$url" >/dev/null 2>&1; then
        note "ok: probe $name ($url)"
        break
      fi
      attempt=$((attempt + 1))
      [ "$attempt" -lt 3 ] && sleep $((attempt * 2))
    done
    if [ "$attempt" -ge 3 ]; then
      record_assurance_failure "probe $name failed: $url"
    fi
  done < "$probe_file"
}

emit_assurance_event() {
  local severity="$1" event_type="$2" title="$3" body="$4" correlation="${5:-norn-host:assurance}" dedupe="${6:-norn-host:$2}" payload
  payload="$(mktemp "${TMPDIR:-/tmp}/norn-assure-event.XXXXXX")"
  python3 - "$payload" "$severity" "$event_type" "$title" "$body" "$correlation" "$dedupe" <<'PY'
import json, pathlib, sys
path, severity, event_type, title, body, correlation, dedupe = sys.argv[1:]
pathlib.Path(path).write_text(json.dumps({
    "app": "norn-host",
    "type": event_type,
    "severity": severity,
    "title": title,
    "body": body,
    "dedupeKey": dedupe,
    "metadata": {"correlationKey": correlation, "stage": "assure"},
}))
PY
  if ! curl -fsS --max-time 5 -H 'Content-Type: application/json' --data-binary "@$payload" \
    http://127.0.0.1:8800/api/events >/dev/null 2>&1; then
    note "warning: could not emit Beacon event $event_type"
  fi
  rm -f "$payload"
}

audit_minimum_capacity() {
  local current count body capacity_hash
  current="$(mktemp "${TMPDIR:-/tmp}/norn-capacity.XXXXXX")"
  if ! python3 - "$current" <<'PY'
import json, pathlib, sys, urllib.request

destination = pathlib.Path(sys.argv[1])
try:
    with urllib.request.urlopen("http://127.0.0.1:8800/api/apps", timeout=10) as response:
        apps = json.load(response)
except Exception as exc:
    raise SystemExit(f"could not load app capacity: {exc}")

missing = []
for app in apps:
    spec = app.get("spec") or {}
    if spec.get("deploy") is False:
        continue
    name = str(spec.get("name") or "")
    allocations = app.get("allocations") or []
    for process, process_spec in (spec.get("processes") or {}).items():
        process_spec = process_spec or {}
        if process_spec.get("schedule"):
            continue
        minimum = int((process_spec.get("scaling") or {}).get("min") or 0)
        if minimum < 1:
            continue
        available = sum(
            1 for allocation in allocations
            if allocation.get("taskGroup") == process
            and allocation.get("status") == "running"
            and allocation.get("lifecycle") == "active"
            and allocation.get("healthy") is not False
        )
        if available < minimum:
            missing.append((name, str(process), minimum, available))

destination.write_text("".join(
    f"{app}\t{process}\t{minimum}\t{available}\n"
    for app, process, minimum, available in sorted(missing)
))
PY
  then
    note "warning: could not audit declared minimum process capacity"
    rm -f "$current"
    return 0
  fi

  if [ -f "$capacity_state" ] && cmp -s "$current" "$capacity_state"; then
    rm -f "$current"
    return 0
  fi

  count="$(wc -l < "$current" | tr -d ' ')"
  if [ "$count" -gt 0 ]; then
    capacity_hash="$(python3 - "$current" <<'PY'
import hashlib, pathlib, sys
print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest()[:16])
PY
)"
    body="$(python3 - "$current" <<'PY'
import pathlib, sys

lines = []
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    app, process, minimum, available = line.split("\t")
    lines.append(f"- {app}:{process} has {available} available; minimum is {minimum}")
print("Declared minimum capacity is not satisfied:\n" + "\n".join(lines))
PY
)"
    emit_assurance_event warning service.capacity.below_minimum \
      "$count process(es) are below declared minimum capacity" "$body" \
      "norn-host:minimum-capacity" \
      "norn-host:service.capacity.below_minimum:$capacity_hash"
    cp "$current" "$capacity_state"
    note "warning: $count process(es) are below declared minimum capacity"
  elif [ -s "$capacity_state" ]; then
    capacity_hash="$(python3 - "$capacity_state" <<'PY'
import hashlib, pathlib, sys
print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest()[:16])
PY
)"
    emit_assurance_event info service.capacity.recovered \
      "Declared minimum capacity recovered" \
      "Every deployable, non-scheduled process with a declared minimum is available at or above that minimum." \
      "norn-host:minimum-capacity" \
      "norn-host:service.capacity.recovered:$capacity_hash"
    rm -f "$capacity_state"
    note "ok: declared minimum process capacity recovered"
  else
    rm -f "$capacity_state"
  fi
  rm -f "$current"
}

assure_host() {
  assure_errors=""
  mkdir -p "$state_dir"
  if ! mkdir "$assure_lock" 2>/dev/null; then
    local lock_pid=""
    [ -f "$assure_lock/pid" ] && lock_pid="$(sed -n '1p' "$assure_lock/pid" 2>/dev/null || true)"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      note "assurance already running as pid $lock_pid; skipping overlapping pass"
      return 0
    fi
    rm -f "$assure_lock/pid"
    rmdir "$assure_lock" 2>/dev/null || true
    mkdir "$assure_lock" 2>/dev/null || {
      note "assurance lock is unavailable; skipping overlapping pass"
      return 0
    }
  fi
  printf '%s\n' "$$" > "$assure_lock/pid"
  trap 'rm -f "$assure_lock/pid"; rmdir "$assure_lock" 2>/dev/null || true' EXIT

  local item spec app process extra core_ready=true
  for item in consul nomad norn; do
    case "$item" in consul) path=/v1/status/leader ;; nomad) path=/v1/status/leader ;; norn) path=/api/health ;; esac
    if runtime_curl "$item" "$path" -fsS --max-time 3 >/dev/null 2>&1; then
      note "ok: runtime $item"
    else
      record_assurance_failure "runtime $item is unavailable"
      core_ready=false
    fi
  done

  if $core_ready; then
    assure_nomad_ipv4 || true
    if [ -s "$required_file" ]; then
      while IFS=: read -r app process extra; do
        [ -n "$app" ] && [ -n "$process" ] && [ -z "$extra" ] || {
          record_assurance_failure "invalid required service entry: $app:$process${extra:+:$extra}"
          continue
        }
        assure_required_service "$app" "$process" || true
      done < "$required_file"
    fi
    audit_minimum_capacity
    reconcile_forge_routes || true
  fi
  reconcile_serve_routes || true
  run_endpoint_probes || true

  if [ -n "$assure_errors" ]; then
    printf '%s\n' "$assure_errors" > "$assure_state"
    emit_assurance_event critical host.assurance.failed "Norn host assurance failed" "$assure_errors"
    rm -f "$assure_lock/pid"
    rmdir "$assure_lock" 2>/dev/null || true
    trap - EXIT
    return 1
  fi

  if [ -f "$assure_state" ]; then
    emit_assurance_event info host.assurance.recovered "Norn host assurance recovered" "All required services, routes, and endpoint probes are passing."
    rm -f "$assure_state"
  fi
  note "host assurance complete"
  rm -f "$assure_lock/pid"
  rmdir "$assure_lock" 2>/dev/null || true
  trap - EXIT
}

recover_cloudflared() {
  $skip_cloudflared && { note "cloudflared recovery skipped"; return 0; }
  [ -f "$cloudflared_plist_path" ] || { note "cloudflared LaunchAgent not installed; skipping"; return 0; }
  [ -f "$cloudflared_config" ] || die "cloudflared config missing: $cloudflared_config"
  local cloudflared_bin legacy_plist domain attempt
  cloudflared_bin="$(command_path cloudflared)" || die "cloudflared binary not found"
  validate_cloudflared_config "$cloudflared_bin" || die "invalid cloudflared config: $cloudflared_config"

  domain="gui/$(id -u)"
  legacy_plist="$launch_agents/$legacy_cloudflared_label.plist"
  if [ "$cloudflared_label" != "$legacy_cloudflared_label" ] && launchctl print "$domain/$legacy_cloudflared_label" >/dev/null 2>&1; then
    if [ ! -f "$legacy_plist" ] || grep -Fq "$cloudflared_config" "$legacy_plist" || ! grep -q '<string>tunnel</string>' "$legacy_plist"; then
      launchctl bootout "$domain/$legacy_cloudflared_label" >/dev/null 2>&1 || true
      note "retired legacy Homebrew cloudflared LaunchAgent"
    else
      note "warning: leaving unrelated legacy cloudflared LaunchAgent active"
    fi
  fi

  bootstrap_label "$cloudflared_label" "$cloudflared_plist_path"
  for attempt in $(seq 1 20); do
    if launchctl print "$domain/$cloudflared_label" 2>/dev/null | grep -q 'state = running'; then
      note "cloudflared running"
      break
    fi
    [ "$attempt" -lt 20 ] || die "cloudflared did not remain running"
    sleep 1
  done
  if [ -n "$cloudflared_probe" ]; then
    for attempt in $(seq 1 30); do
      if curl -fsS --max-time 5 "$cloudflared_probe" >/dev/null 2>&1; then
        note "cloudflared public probe ready"
        return 0
      fi
      [ "$attempt" -lt 30 ] || die "cloudflared public probe did not become ready: $cloudflared_probe"
      sleep 1
    done
  fi
}

recover_host() {
  [ -f "$launch_agents/$consul_label.plist" ] || die "managed launchd files missing: run install"
  render_configs
  open -gja Docker >/dev/null 2>&1 || true
  local docker_bin
  docker_bin="$(command_path docker)" || die "docker CLI not found"
  local i=0
  while [ "$i" -lt 90 ]; do
    if "$docker_bin" info >/dev/null 2>&1; then
      note "docker ready"
      break
    fi
    i=$((i + 1))
    sleep 1
  done
  [ "$i" -lt 90 ] || die "Docker did not become ready"
  bootstrap_label "$consul_label" "$launch_agents/$consul_label.plist"
  wait_leader consul /v1/status/leader consul
  bootstrap_label "$nomad_label" "$launch_agents/$nomad_label.plist"
  wait_leader nomad /v1/status/leader nomad
  recover_cloudflared
  launchctl kickstart -k "gui/$(id -u)/$api_label"
  wait_http norn /api/health norn
  bootstrap_label "$agent_label" "$launch_agents/$agent_label.plist"
  run_catchups
  if ! assure_host; then
    note "warning: host assurance failed; periodic assurance will retry"
  fi
  load_periodic_label "$assurance_label" "$launch_agents/$assurance_label.plist"
  if [ -x "$config_dir/post-recover" ]; then
    "$config_dir/post-recover"
  fi
  note "host recovery complete"
}

run_catchups() {
  [ -s "$catch_up_file" ] || return 0
  if [ ! -x "$norn_copy" ]; then
    note "warning: catch-up jobs configured but managed norn CLI is missing"
    return 0
  fi
  local spec app process extra
  while IFS=: read -r app process extra; do
    [ -n "$app" ] && [ -n "$process" ] && [ -z "$extra" ] || {
      note "warning: ignoring invalid catch-up entry: $app:$process${extra:+:$extra}"
      continue
    }
    if NORN_PLATFORM_REPO="$repo" "$norn_copy" platform env -- "$norn_copy" cron trigger "$app" "$process"; then
      note "triggered recovery catch-up $app:$process"
    else
      note "warning: recovery catch-up failed for $app:$process"
    fi
  done < "$catch_up_file"
}

security_plan() {
  local staged_count=0 active=false nomad_acl=false nomad_tls=false consul_acl=false consul_tls=false
  if [ -d "$security_dir" ]; then
    staged_count="$(find "$security_dir" -maxdepth 1 -type d -name 'staged-*' | wc -l | tr -d ' ')"
  fi
  if [ -f "$active_nomad_security" ] && [ -f "$active_consul_security" ]; then active=true; fi
  if [ -f "$nomad_config" ]; then
    grep -Eq '^[[:space:]]*acl[[:space:]]*\{' "$nomad_config" && nomad_acl=true || true
    grep -Eq '^[[:space:]]*tls[[:space:]]*\{' "$nomad_config" && nomad_tls=true || true
  fi
  if [ -f "$consul_config" ]; then
    grep -Eq '^[[:space:]]*acl[[:space:]]*(=|\{)' "$consul_config" && consul_acl=true || true
    grep -Eq '^[[:space:]]*tls[[:space:]]*(=|\{)' "$consul_config" && consul_tls=true || true
  fi

  echo "norn host security plan"
  echo "security_dir=$security_dir"
  echo "staged_bundles=$staged_count"
  echo "active_fragments=$active"
  echo "nomad_acl_config=$nomad_acl"
  echo "nomad_tls_config=$nomad_tls"
  echo "consul_acl_config=$consul_acl"
  echo "consul_tls_config=$consul_tls"
  cat <<'PLAN'

cutover phases
1. Generate a staged PKI bundle with `norn host security init`; move both CA private keys to protected offline custody after issuing the required certificates.
2. Provision three Nomad and three Consul servers plus at least two Nomad clients before treating quorum checks as production-ready.
3. Add verified TLS client paths and future scoped ACL tokens to the SOPS-encrypted Norn API environment. Do not write tokens into the staged fragments.
4. Implement and test TLS/client-certificate/ACL-token-aware recovery, assurance, diagnostics, and rollback probes. Managed activation is refused until this prerequisite is complete.
5. In a drained maintenance window, validate both rendered configs and restart Consul and Nomad in the documented rolling order. Bootstrap ACLs, create least-privilege agent/Norn tokens, then restart the Norn API with its encrypted environment.
6. Change Consul from the transition `default_policy = "allow"` fragment to the generated default-deny fragment after every agent and service-registration path has a scoped token.
7. Run `norn production check`, deploy a disposable workload, restart it, exercise service discovery, and complete a rollback before admitting production traffic.

Activation is intentionally separate from initialization: generating certificates never changes a running agent or managed configuration. This release stages artifacts only and refuses managed activation.
PLAN
}

security_init() {
  case "$cert_days" in ''|*[!0-9]*) die "--cert-days must be an integer" ;; esac
  [ "$cert_days" -ge 30 ] || die "--cert-days must be at least 30"
  local detected timestamp stage temp_root bundle_root nomad_bin consul_bin node_name
  detected="$(detect_address)"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  stage="$security_dir/staged-$timestamp"
  if $dry_run; then
    note "would generate a non-active Nomad/Consul PKI bundle under $stage for address=$detected"
    note "would not modify managed configs, restart agents, or bootstrap ACL tokens"
    return 0
  fi
  [ ! -e "$stage" ] || die "security stage already exists: $stage"
  nomad_bin="$(command_path nomad)" || die "nomad binary not found"
  consul_bin="$(command_path consul)" || die "consul binary not found"
  node_name="$(hostname -s)"
  mkdir -p "$security_dir"
  chmod 700 "$security_dir"
  temp_root="$(mktemp -d "$security_dir/.staging.XXXXXX")"
  case "$temp_root" in
    "$security_dir"/.staging.*) ;;
    *) die "refusing unexpected security temp path: $temp_root" ;;
  esac
  chmod 700 "$temp_root"
  trap 'find "$temp_root" -depth -delete >/dev/null 2>&1 || true' EXIT
  bundle_root="$temp_root/bundle"
  mkdir -m 700 "$temp_root/nomad" "$temp_root/consul" "$bundle_root" "$bundle_root/nomad" "$bundle_root/consul"

  (
    cd "$temp_root/nomad"
    "$nomad_bin" tls ca create -days=1825
    "$nomad_bin" tls cert create -server -region=global -additional-ipaddress="$detected" -days="$cert_days"
    "$nomad_bin" tls cert create -cli -additional-ipaddress="$detected" -days="$cert_days"
  )
  (
    cd "$temp_root/consul"
    "$consul_bin" tls ca create -days="$((cert_days * 5))"
    "$consul_bin" tls cert create -server -dc=dc1 -node="$node_name" -additional-ipaddress="$detected" -days="$cert_days"
    "$consul_bin" tls cert create -client -additional-ipaddress="$detected" -days="$cert_days"
  )

  cp "$temp_root"/nomad/*.pem "$bundle_root/nomad/"
  cp "$temp_root"/consul/*.pem "$bundle_root/consul/"
  chmod 600 "$bundle_root"/nomad/*.pem "$bundle_root"/consul/*.pem
  chmod 644 "$bundle_root/nomad/nomad-agent-ca.pem" "$bundle_root/nomad/global-server-nomad.pem" "$bundle_root/nomad/global-cli-nomad.pem"
  chmod 644 "$bundle_root/consul/consul-agent-ca.pem" "$bundle_root/consul/dc1-server-consul-0.pem" "$bundle_root/consul/dc1-client-consul-0.pem"

  python3 - "$stage" "$bundle_root" <<'PY'
import json, pathlib, shlex, sys

final_stage = pathlib.Path(sys.argv[1])
stage = pathlib.Path(sys.argv[2])
nomad = final_stage / "nomad"
consul = final_stage / "consul"

nomad_fragment = f'''acl {{
  enabled = true
}}

tls {{
  http = true
  rpc = true
  ca_file = {json.dumps(str(nomad / "nomad-agent-ca.pem"))}
  cert_file = {json.dumps(str(nomad / "global-server-nomad.pem"))}
  key_file = {json.dumps(str(nomad / "global-server-nomad-key.pem"))}
  verify_server_hostname = true
  verify_https_client = true
  tls_min_version = "tls12"
}}
'''
(stage / "nomad.hcl").write_text(nomad_fragment)

def consul_fragment(default_policy: str) -> str:
    return f'''ports {{
  http = -1
  https = 8501
  grpc = -1
  grpc_tls = 8503
}}

acl {{
  enabled = true
  default_policy = {json.dumps(default_policy)}
  down_policy = "extend-cache"
  enable_token_persistence = true
}}

tls {{
  defaults {{
    ca_file = {json.dumps(str(consul / "consul-agent-ca.pem"))}
    cert_file = {json.dumps(str(consul / "dc1-server-consul-0.pem"))}
    key_file = {json.dumps(str(consul / "dc1-server-consul-0-key.pem"))}
    verify_incoming = true
    verify_outgoing = true
    verify_server_hostname = true
    tls_min_version = "TLSv1_2"
  }}
  https {{
    verify_incoming = true
  }}
  internal_rpc {{
    verify_incoming = true
    verify_outgoing = true
    verify_server_hostname = true
  }}
}}
'''

(stage / "consul-transition.hcl").write_text(consul_fragment("allow"))
(stage / "consul-default-deny.hcl").write_text(consul_fragment("deny"))

env = {
    "NORN_NOMAD_ADDR": "https://127.0.0.1:4646",
    "NOMAD_ADDR": "https://127.0.0.1:4646",
    "NOMAD_CACERT": str(nomad / "nomad-agent-ca.pem"),
    "NOMAD_CLIENT_CERT": str(nomad / "global-cli-nomad.pem"),
    "NOMAD_CLIENT_KEY": str(nomad / "global-cli-nomad-key.pem"),
    "NOMAD_TLS_SERVER_NAME": "server.global.nomad",
    "NORN_CONSUL_ADDR": "https://127.0.0.1:8501",
    "CONSUL_HTTP_ADDR": "https://127.0.0.1:8501",
    "CONSUL_CACERT": str(consul / "consul-agent-ca.pem"),
    "CONSUL_CLIENT_CERT": str(consul / "dc1-client-consul-0.pem"),
    "CONSUL_CLIENT_KEY": str(consul / "dc1-client-consul-0-key.pem"),
    "CONSUL_TLS_SERVER_NAME": "server.dc1.consul",
}
(stage / "client.env.example").write_text("".join(f"{key}={shlex.quote(value)}\n" for key, value in env.items()))
(stage / "manifest.json").write_text(json.dumps({
    "schema": "norn.host-security-stage/v1",
    "activated": False,
    "containsACLTokens": False,
    "nomadFragment": str(final_stage / "nomad.hcl"),
    "consulTransitionFragment": str(final_stage / "consul-transition.hcl"),
    "consulDefaultDenyFragment": str(final_stage / "consul-default-deny.hcl"),
    "clientEnvironmentTemplate": str(final_stage / "client.env.example"),
}, indent=2) + "\n")
PY
  chmod 600 "$bundle_root/nomad.hcl" "$bundle_root/consul-transition.hcl" "$bundle_root/consul-default-deny.hcl" "$bundle_root/client.env.example" "$bundle_root/manifest.json"
  mv "$bundle_root" "$stage"
  find "$temp_root" -depth -delete
  trap - EXIT
  note "generated inactive security stage: $stage"
  note "CA private keys remain in the stage; move them to protected offline custody after issuing all required node certificates"
  note "no managed config, running agent, ACL token, or encrypted environment was changed"
  note "review with: $0 security-plan --security-dir $security_dir"
}

is_tty() {
  [ -t 0 ] && [ -t 1 ]
}

confirm_setup() {
  local question="$1" answer=""
  if $yes; then
    return 0
  fi
  if $non_interactive || ! is_tty; then
    note "skipping: $question (pass --yes to approve non-interactively)"
    return 1
  fi
  printf '%s [y/N] ' "$question"
  IFS= read -r answer || true
  case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

run_setup_step() {
  local label="$1"
  shift
  if ! is_tty; then
    "$@"
    return
  fi
  local output pid spinner=0 status=0 frames='|/-\\'
  output="$(mktemp "${TMPDIR:-/tmp}/norn-setup.XXXXXX")"
  "$@" >"$output" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r[%s] %s' "${frames:$spinner:1}" "$label"
    spinner=$(((spinner + 1) % 4))
    sleep 0.12
  done
  if wait "$pid"; then
    printf '\r[ok] %s\n' "$label"
    rm -f "$output"
    return 0
  else
    status=$?
    printf '\r[fail] %s\n' "$label" >&2
    sed -n '1,160p' "$output" >&2
    rm -f "$output"
    return "$status"
  fi
}

macos_major_version() {
  local version
  version="$(/usr/bin/sw_vers -productVersion 2>/dev/null || true)"
  printf '%s\n' "${version%%.*}"
}

apple_container_platform_ready() {
  local major architecture
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "fail apple-container requires macOS"
    return 1
  fi
  architecture="$(uname -m)"
  if [ "$architecture" != "arm64" ]; then
    echo "fail apple-container requires Apple silicon (detected $architecture)"
    return 1
  fi
  major="$(macos_major_version)"
  if ! [[ "$major" =~ ^[0-9]+$ ]] || [ "$major" -lt 26 ]; then
    echo "fail apple-container requires macOS 26 or later (detected ${major:-unknown})"
    return 1
  fi
  echo "ok   apple-container platform=macOS-$major arm64"
}

apple_container_runtime_ready() {
  local container_bin status
  container_bin="$(command_path container 2>/dev/null || true)"
  if [ -z "$container_bin" ]; then
    echo "fail container CLI missing"
    return 1
  fi
  echo "ok   container=$container_bin ($($container_bin --version 2>/dev/null || echo version-unavailable))"
  status="$("$container_bin" system status --format json 2>/dev/null || true)"
  if printf '%s' "$status" | grep -Eq '"running"[[:space:]]*:[[:space:]]*true|"state"[[:space:]]*:[[:space:]]*"running"|"status"[[:space:]]*:[[:space:]]*"running"'; then
    echo "ok   container system running"
    return 0
  fi
  echo "fail container system is not running (run: container system start)"
  return 1
}

verify_apple_container_package() {
  local package="$1" signature assessment
  signature="$(/usr/sbin/pkgutil --check-signature "$package" 2>&1 || true)"
  if ! printf '%s\n' "$signature" | grep -Eq 'Apple Inc.*Containerization'; then
    printf '%s\n' "$signature" >&2
    die "Apple Container package signer is not the expected Apple Containerization Developer ID"
  fi
  if ! printf '%s\n' "$signature" | grep -qi 'notarized'; then
    printf '%s\n' "$signature" >&2
    die "Apple Container package is not notarized"
  fi
  assessment="$(/usr/sbin/spctl -a -vv -t install "$package" 2>&1 || true)"
  if ! printf '%s\n' "$assessment" | grep -qi 'accepted'; then
    printf '%s\n' "$assessment" >&2
    die "macOS Gatekeeper did not accept the Apple Container package"
  fi
  note "verified Apple Developer ID signature, notarization, and Gatekeeper assessment"
}

install_apple_container() {
  local version package_url package temp_dir curl_bin
  version="${NORN_APPLE_CONTAINER_VERSION:-1.3.0}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "NORN_APPLE_CONTAINER_VERSION must be a numeric release version"
  apple_container_platform_ready || return 1
  if command_path container >/dev/null 2>&1; then
    note "Apple Container CLI is already installed; not replacing it"
    return 0
  fi
  if $dry_run; then
    note "would download Apple Container $version from the official apple/container GitHub release"
    note "would verify its Apple Containerization Developer ID signature and notarization before invoking macOS Installer"
    return 0
  fi
  confirm_setup "Download and install signed Apple Container $version from Apple's GitHub release?" || return 1
  curl_bin="$(command_path curl)"
  temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/norn-apple-container.XXXXXX")"
  package="$temp_dir/container-${version}-installer-signed.pkg"
  package_url="https://github.com/apple/container/releases/download/${version}/container-${version}-installer-signed.pkg"
  run_setup_step "Downloading Apple Container $version" "$curl_bin" --fail --location --proto '=https' --tlsv1.2 --retry 3 --output "$package" "$package_url"
  verify_apple_container_package "$package"
  if $non_interactive; then
    sudo -n true 2>/dev/null || die "sudo credentials are required; run interactively once or establish an approved sudo session"
  else
    sudo -v
  fi
  run_setup_step "Installing Apple Container $version" sudo /usr/sbin/installer -pkg "$package" -target /
  rm -rf "$temp_dir"
}

start_apple_container() {
  local container_bin
  container_bin="$(command_path container 2>/dev/null || true)"
  [ -n "$container_bin" ] || die "Apple Container CLI is still unavailable after installation"
  if apple_container_runtime_ready >/dev/null 2>&1; then
    note "Apple Container system is already running"
    return 0
  fi
  if $dry_run; then
    note "would initialize and start the Apple Container system"
    return 0
  fi
  confirm_setup "Initialize and start the Apple Container system?" || return 1
  # The operator has already approved kernel installation through Norn's
  # prompt (or --yes). Avoid a second hidden prompt so unattended setup cannot
  # block indefinitely on a non-TTY stdin.
  run_setup_step "Starting Apple Container system" "$container_bin" system start --enable-kernel-install
}

prerequisites() {
  local failures=0 item path apple_platform_ok=true
  case "$connector" in
    nomad-consul|apple-container) ;;
    *) die "unsupported connector $connector (expected nomad-consul or apple-container)" ;;
  esac
  echo "Norn prerequisite check (connector=$connector)"
  if [ "$connector" = "apple-container" ]; then
    if ! apple_container_platform_ready; then
      failures=$((failures + 1))
      apple_platform_ok=false
    fi
    if $apple_platform_ok && $setup_requested && ! $check_only; then
      if ! command_path container >/dev/null 2>&1; then
        install_apple_container || failures=$((failures + 1))
      fi
      if command_path container >/dev/null 2>&1; then
        start_apple_container || failures=$((failures + 1))
      fi
    fi
    if ! apple_container_runtime_ready; then failures=$((failures + 1)); fi
  else
    echo "ok   connector=nomad-consul (production default)"
    for item in docker nomad consul curl launchctl plutil python3 sops; do
      if path="$(command_path "$item" 2>/dev/null)"; then
        echo "ok   $item=$path"
      else
        echo "fail $item missing"
        failures=$((failures + 1))
      fi
    done
    echo "info Nomad/Consul setup is intentionally not automated: configure TLS, ACLs, persistent state, and Docker according to the host-recovery runbook."
  fi
  if [ "$failures" -gt 0 ]; then
    echo "result: not ready"
    return 1
  fi
  echo "result: ready"
}

doctor() {
  local failures=0 item path cloudflared_bin
  [ "$(uname -s)" = "Darwin" ] && echo "ok   platform=macOS" || { echo "fail platform=$(uname -s)"; failures=$((failures + 1)); }
  for item in docker nomad consul curl launchctl plutil python3 sops; do
    if path="$(command_path "$item" 2>/dev/null)"; then
      echo "ok   $item=$path"
    else
      echo "fail $item missing"
      failures=$((failures + 1))
    fi
  done
  for path in "$nomad_config" "$consul_config" "$agent_copy" "$platform_copy" "$launch_agents/$nomad_label.plist" "$launch_agents/$consul_label.plist" "$launch_agents/$supervisor_label.plist" "$launch_agents/$assurance_label.plist" "$launch_agents/$agent_label.plist"; do
    if [ -f "$path" ]; then echo "ok   file=$path"; else echo "fail file=$path"; failures=$((failures + 1)); fi
  done
  for path in "$launch_agents/$nomad_label.plist" "$launch_agents/$consul_label.plist" "$launch_agents/$supervisor_label.plist" "$launch_agents/$assurance_label.plist" "$launch_agents/$agent_label.plist"; do
    if [ -f "$path" ] && plutil -lint "$path" >/dev/null 2>&1; then
      echo "ok   plist=$path"
    elif [ -f "$path" ]; then
      echo "fail invalid plist=$path"
      failures=$((failures + 1))
    fi
  done
  case "$nomad_state:$consul_state" in
    /tmp/*|*:/tmp/*) echo "fail state directory uses /tmp"; failures=$((failures + 1)) ;;
    *) echo "ok   persistent_state=$state_dir" ;;
  esac
  for item in consul nomad norn; do
    case "$item" in consul) path=/v1/status/leader ;; nomad) path=/v1/status/leader ;; norn) path=/api/health ;; esac
    if runtime_curl "$item" "$path" -fsS --max-time 2 >/dev/null 2>&1; then echo "ok   runtime=$item"; else echo "warn runtime=$item unavailable"; fi
  done
  if ! $skip_cloudflared && { [ -f "$cloudflared_config" ] || [ -f "$cloudflared_plist_path" ]; }; then
    if cloudflared_bin="$(command_path cloudflared 2>/dev/null)"; then
      echo "ok   cloudflared=$cloudflared_bin"
    else
      echo "fail cloudflared missing"
      failures=$((failures + 1))
    fi
    if [ -f "$cloudflared_config" ] && [ -n "${cloudflared_bin:-}" ] && validate_cloudflared_config "$cloudflared_bin" >/dev/null 2>&1; then
      echo "ok   cloudflared_config=$cloudflared_config"
    else
      echo "fail cloudflared_config=$cloudflared_config"
      failures=$((failures + 1))
    fi
    if [ -f "$cloudflared_plist_path" ] && plutil -lint "$cloudflared_plist_path" >/dev/null 2>&1 && grep -q '<string>tunnel</string>' "$cloudflared_plist_path" && grep -q '<string>run</string>' "$cloudflared_plist_path"; then
      echo "ok   cloudflared_plist=$cloudflared_plist_path"
    else
      echo "fail cloudflared_plist=$cloudflared_plist_path"
      failures=$((failures + 1))
    fi
    if launchctl print "gui/$(id -u)/$cloudflared_label" >/dev/null 2>&1; then echo "ok   runtime=$cloudflared_label"; else echo "warn runtime=$cloudflared_label unavailable"; fi
    if [ -n "$cloudflared_probe" ]; then
      if curl -fsS --max-time 5 "$cloudflared_probe" >/dev/null 2>&1; then echo "ok   cloudflared_probe=$cloudflared_probe"; else echo "warn cloudflared_probe=$cloudflared_probe unavailable"; fi
    fi
  fi
  [ "$failures" -eq 0 ] || return 1
}

status() {
  local label supervisor_output supervisor_state supervisor_exit
  for label in "$consul_label" "$nomad_label" "$api_label" "$agent_label"; do
    if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then echo "up   $label"; else echo "down $label"; fi
  done
  if supervisor_output="$(launchctl print "gui/$(id -u)/$supervisor_label" 2>/dev/null)"; then
    supervisor_state="$(printf '%s\n' "$supervisor_output" | awk '/state =/{print $3; exit}')"
    supervisor_exit="$(printf '%s\n' "$supervisor_output" | awk '/last exit code =/{print $5; exit}')"
    if [ "$supervisor_state" = "running" ]; then
      echo "running $supervisor_label"
    elif [ -z "$supervisor_exit" ] || [ "$supervisor_exit" = "0" ]; then
      echo "ready $supervisor_label last_exit=${supervisor_exit:-none}"
    else
      echo "failed $supervisor_label last_exit=$supervisor_exit"
    fi
  elif [ -f "$launch_agents/$supervisor_label.plist" ]; then
    echo "armed $supervisor_label (runs at next login)"
  else
    echo "down $supervisor_label"
  fi
  if launchctl print "gui/$(id -u)/$assurance_label" >/dev/null 2>&1; then
    echo "armed $assurance_label interval=${assure_interval}s"
  elif [ -f "$launch_agents/$assurance_label.plist" ]; then
    echo "written $assurance_label (loads during recovery)"
  else
    echo "down $assurance_label"
  fi
  for item in consul nomad norn; do
    case "$item" in consul) path=/v1/status/leader ;; nomad) path=/v1/status/leader ;; norn) path=/api/health ;; esac
    if runtime_curl "$item" "$path" -fsS --max-time 2 >/dev/null 2>&1; then echo "up   $item"; else echo "down $item"; fi
  done
  if ! $skip_cloudflared && [ -f "$cloudflared_plist_path" ]; then
    if launchctl print "gui/$(id -u)/$cloudflared_label" >/dev/null 2>&1; then echo "up   $cloudflared_label"; else echo "down $cloudflared_label"; fi
    if [ -n "$cloudflared_probe" ]; then
      if curl -fsS --max-time 5 "$cloudflared_probe" >/dev/null 2>&1; then echo "up   cloudflared-probe"; else echo "down cloudflared-probe"; fi
    fi
  fi
}

copy_state() {
  local source="$1" destination="$2" name="$3"
  [ -n "$source" ] || die "--from-$name is required"
  source="$(expand_home "$source")"
  [ -d "$source" ] || die "$name state source is not a directory: $source"
  case "$destination" in
    ""|/|"$HOME") die "refusing unsafe $name destination: $destination" ;;
  esac
  mkdir -p "$destination"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a "$source/" "$destination/"
  else
    ditto "$source" "$destination"
  fi
  note "migrated $name state: $source -> $destination"
}

migrate_state() {
  if runtime_curl nomad /v1/status/leader -fsS --max-time 1 >/dev/null 2>&1; then
    die "Nomad is still running; stop it before migrate-state"
  fi
  if runtime_curl consul /v1/status/leader -fsS --max-time 1 >/dev/null 2>&1; then
    die "Consul is still running; stop it before migrate-state"
  fi
  copy_state "$from_nomad" "$nomad_state" nomad
  copy_state "$from_consul" "$consul_state" consul
}

supervise() {
  recover_host
}

case "$mode" in
  install) install_files ;;
  prerequisites|setup) prerequisites ;;
  render) render_configs ;;
  doctor) doctor ;;
  recover) recover_host ;;
  cloudflared-recover) recover_cloudflared ;;
  assure) assure_host ;;
  status) status ;;
  migrate-state) migrate_state ;;
  security-plan) security_plan ;;
  security-init) security_init ;;
  supervise) supervise ;;
  *) usage >&2; exit 2 ;;
esac
