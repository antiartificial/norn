#!/usr/bin/env bash
# Protected, disposable historical restore. This never targets Mini's live API.
set -euo pipefail
script_dir=$(cd "$(dirname "$0")" && pwd)

[[ $# -eq 6 ]] || { echo 'usage: controller <proof> <dump> <old-shadow-receipt> <source-release> <target-release> <pinned-key>' >&2; exit 2; }
proof=$1 dump=$2 old_receipt=$3 source_release=$4 target_release=$5 public_key=$6
[[ ${NORN_M5_HISTORICAL_ISOLATED:-} == 1 ]] || { echo 'isolated historical mode is required' >&2; exit 2; }
[[ -z ${NORN_DATABASE_URL:-} && -z ${NORN_AUDIT_SIGNING_KEY:-} && -z ${NORN_API_TOKEN:-} && -z ${DIGITALOCEAN_TOKEN:-} ]] || {
  echo 'production credentials are forbidden in historical rehearsal' >&2; exit 2;
}
[[ ${NORN_M5_ISOLATION_CHECK:-} == /* && -x ${NORN_M5_ISOLATION_CHECK:-} && ! -L ${NORN_M5_ISOLATION_CHECK:-} ]] || {
  echo 'host isolation checker is unavailable' >&2; exit 2;
}
ISOLATION_CHECK="$NORN_M5_ISOLATION_CHECK" python3 - <<'PY'
import os, stat
path = os.environ['ISOLATION_CHECK']
info = os.stat(path, follow_symlinks=False)
if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) & 0o022:
    raise SystemExit('isolation checker must be root-owned and immutable to the runner')
PY
"$NORN_M5_ISOLATION_CHECK"
source_sha=${NORN_M5_SOURCE_SHA:-}
target_sha=${NORN_M5_TARGET_SHA:-}
[[ $source_sha =~ ^[0-9a-f]{40}$ && $target_sha =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ $source_sha == 3da50fe3a3c9f37d64e24c03a7dcfea94153da58 && \
   $target_sha == 3602e7e3d5fe5c0ef333b4041580d48ec15b24c5 ]] || {
  echo 'historical rehearsal is pinned to the recorded v2-to-v3 transition' >&2; exit 2;
}
[[ $(basename "$source_release") == "$source_sha" && $(basename "$target_release") == "$target_sha" ]] || exit 2
for release in "$source_release" "$target_release"; do
  [[ $release == /* && -d $release && ! -L $release ]] || exit 2
  [[ $($script_dir/platform-release-manifest verify --release "$release" --expected-sha "$(basename "$release")") == signed ]] || exit 1
  "$script_dir/platform-release-artifact" verify --release-dir "$release" --public-key "$public_key" --quiet
done
"$script_dir/mini-historical-shadow-evidence" --proof "$proof" --artifact "$dump" \
  --shadow-receipt "$old_receipt" --source-sha "$source_sha" --candidate-sha "$target_sha" >/dev/null
receipt_dir=${NORN_M5_HISTORICAL_RECEIPT_DIR:-}
[[ $receipt_dir == /* && -d $receipt_dir && ! -L $receipt_dir ]] || exit 2
receipt="$receipt_dir/historical-shadow-${GITHUB_RUN_ID:-local}-$(date -u +%Y%m%dT%H%M%SZ).json"
[[ ! -e $receipt ]] || exit 2
export NORN_M5_HISTORICAL_SHADOW_RECEIPT="$old_receipt"
export NORN_REHEARSAL_BACKUP_PROOF="$proof"
export NORN_REHEARSAL_BACKUP_ARTIFACT="$dump"
export NORN_REHEARSAL_LEGACY_RELEASE_SHA="$source_sha"
export NORN_M5_SIGNED_SHADOW_REHEARSAL=1
export NORN_M5_SHADOW_RECEIPT="$receipt"
"$script_dir/mini-signed-shadow-launchagent-rehearsal" run \
  --candidate-release "$target_release" --public-key "$public_key"
"$NORN_M5_ISOLATION_CHECK"
"$script_dir/mini-historical-shadow-evidence" --proof "$proof" --artifact "$dump" \
  --shadow-receipt "$receipt" --source-sha "$source_sha" --candidate-sha "$target_sha" >/dev/null
printf 'M5 historical private restore receipt: %s\n' "$receipt"
