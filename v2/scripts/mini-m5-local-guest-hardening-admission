#!/usr/bin/env python3
"""Bind a protected hardening run to one created Tart guest and its SSH key."""

import argparse
from datetime import datetime, timezone
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import re
import stat
import subprocess


TART_SHA256 = "6d3a455456979c138387d0660af8e956a054018f7516bd0e8bcd175382973823"
OWNER_PUBLIC_KEY_SHA256 = "ba038c8f9e5d43ff4b5c03ffb1ea7ca1e4e9127c98b5810ed0c6a5dbc1c67eeb"


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def protected(intent):
    required = {"GITHUB_ACTIONS": "true", "GITHUB_REF": "refs/heads/master",
                "GITHUB_REF_PROTECTED": "true", "RUNNER_NAME": "norn-m5-supervisor-01",
                "GITHUB_RUN_ID": intent["runId"], "GITHUB_SHA": intent["sourceSHA"],
                "NORN_M5_PROTECTED_CONTROLLER": "1"}
    if any(os.environ.get(key) != value for key, value in required.items()):
        raise ValueError("hardening requires exact protected supervisor run")


def verify(intent, root, tart, runner_key, prelaunch=False):
    fields = {"schema", "runId", "sourceSHA", "guestName", "createMarkerSHA256",
              "createdReceiptSHA256", "tartConfigSHA256", "sshHostKeySHA256",
              "runnerPublicKeySHA256", "retireBy"}
    if set(intent) != fields or intent["schema"] != "norn.m5-local-guest-hardening-intent/v1":
        raise ValueError("unexpected hardening intent")
    if (not re.fullmatch(r"[0-9]{1,20}", intent["runId"]) or
            not re.fullmatch(r"[0-9a-f]{40}", intent["sourceSHA"]) or
            not re.fullmatch(r"norn-m5-[0-9]{1,20}", intent["guestName"]) or
            any(not re.fullmatch(r"[0-9a-f]{64}", intent[key]) for key in
                ("createMarkerSHA256", "createdReceiptSHA256", "tartConfigSHA256",
                 "sshHostKeySHA256", "runnerPublicKeySHA256"))):
        raise ValueError("invalid hardening identity")
    expiry = datetime.fromisoformat(intent["retireBy"].replace("Z", "+00:00"))
    if expiry.tzinfo != timezone.utc or expiry <= datetime.now(timezone.utc):
        raise ValueError("hardening intent expired")
    protected(intent)
    root = Path(root)
    info = root.lstat()
    if not root.is_absolute() or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("journal root is not owner-only")
    info = Path(tart).lstat()
    if not Path(tart).is_absolute() or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022 or digest(tart) != TART_SHA256:
        raise ValueError("unreviewed Tart executable")
    name = intent["guestName"]
    marker = root / (name + ".create-started")
    receipt = root / (name + ".created.json")
    if digest(marker) != intent["createMarkerSHA256"] or digest(receipt) != intent["createdReceiptSHA256"]:
        raise ValueError("created guest receipts differ from signed intent")
    created = json.loads(receipt.read_bytes())
    if (created.get("schema") != "norn.m5-local-guest-created-unqualified/v1" or
            created.get("guestName") != name):
        raise ValueError("created guest receipt is invalid")
    key = Path(runner_key)
    key_info = key.lstat()
    if (not key.is_absolute() or not stat.S_ISREG(key_info.st_mode) or key_info.st_mode & 0o022 or
            digest(key) != intent["runnerPublicKeySHA256"] or
            not key.read_text().startswith("ssh-ed25519 ")):
        raise ValueError("unreviewed one-use runner public key")
    config = subprocess.run((str(tart), "get", name, "--format", "json"), check=True,
                            capture_output=True, timeout=15).stdout
    if hashlib.sha256(config).hexdigest() != intent["tartConfigSHA256"]:
        raise ValueError("Tart guest configuration changed")
    if prelaunch:
        return {"schema": "norn.m5-local-guest-hardening-prelaunch/v1", "runId": intent["runId"],
                "sourceSHA": intent["sourceSHA"], "guestName": name,
                "createMarkerSHA256": intent["createMarkerSHA256"],
                "createdReceiptSHA256": intent["createdReceiptSHA256"],
                "sshHostKeySHA256": intent["sshHostKeySHA256"]}
    ip = subprocess.run((str(tart), "ip", name, "--wait", "0", "--resolver", "dhcp"),
                        check=True, capture_output=True, text=True, timeout=15).stdout.strip()
    address = ipaddress.ip_address(ip)
    if (address.version != 4 or not address.is_private or address.is_loopback or
            address.is_link_local or address.is_unspecified or address.is_multicast):
        raise ValueError("guest address is outside the local private VM network")
    scan = subprocess.run(("/usr/bin/ssh-keyscan", "-T", "5", "-t", "ed25519", ip),
                          check=True, capture_output=True, text=True, timeout=15).stdout
    lines = [line.split() for line in scan.splitlines() if line and not line.startswith("#")]
    if len(lines) != 1 or len(lines[0]) != 3 or lines[0][1] != "ssh-ed25519":
        raise ValueError("ambiguous guest SSH host key")
    host_key = (lines[0][1] + " " + lines[0][2] + "\n").encode()
    if hashlib.sha256(host_key).hexdigest() != intent["sshHostKeySHA256"]:
        raise ValueError("guest SSH host key changed")
    return {"schema": "norn.m5-local-guest-hardening-admission/v1", "runId": intent["runId"],
            "sourceSHA": intent["sourceSHA"], "guestName": name,
            "createMarkerSHA256": intent["createMarkerSHA256"],
            "createdReceiptSHA256": intent["createdReceiptSHA256"],
            "sshHostKeySHA256": intent["sshHostKeySHA256"], "guestIP": ip,
            "sshHostKey": host_key.decode()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ("intent", "signature", "public-key", "journal-root", "tart", "runner-public-key"):
        parser.add_argument("--" + name, required=True)
    parser.add_argument("--prelaunch", action="store_true")
    args = parser.parse_args()
    if digest(args.public_key) != OWNER_PUBLIC_KEY_SHA256:
        raise ValueError("unreviewed owner public key")
    subprocess.run(("/opt/homebrew/opt/openssl@3/bin/openssl", "pkeyutl", "-verify", "-pubin",
                    "-inkey", args.public_key, "-sigfile", args.signature, "-rawin", "-in", args.intent),
                   check=True, capture_output=True, timeout=10)
    intent = json.loads(Path(args.intent).read_bytes())
    result = verify(intent, args.journal_root, args.tart, args.runner_public_key, args.prelaunch)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    main()
