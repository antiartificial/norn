#!/usr/bin/env python3
"""Emit bounded, secret-free host networking diagnostics for M5 create."""

import argparse
import ipaddress
import json
import subprocess
import sys
import re


def run(args, timeout=5):
    try:
        result = subprocess.run(args, check=False, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--guest-ip", default="192.168.80.10")
    args = parser.parse_args()
    try:
        address = ipaddress.ip_address(args.guest_ip)
        if not address.is_private:
            raise ValueError
    except ValueError:
        parser.error("guest IP must be a private address")

    route = run(("/sbin/route", "-n", "get", str(address)))
    route_fields = {}
    if route:
        for line in route.splitlines():
            key, separator, value = line.partition(":")
            if separator and key.strip() in {"destination", "gateway", "interface", "flags", "mtu"}:
                route_fields[key.strip()] = value.strip()

    interface_output = run(("/sbin/ifconfig", "-l"))
    interfaces = interface_output.split() if interface_output else None
    local_network_config = run(("/usr/bin/defaults", "read", "com.apple.network.local-network"))
    permission_log = run(("/usr/bin/log", "show", "--last", "15m", "--style", "compact",
                          "--predicate", 'subsystem == "com.apple.TCC" AND eventMessage CONTAINS[c] "local network"'), 10)
    denial_observed = bool(permission_log and re.search(r"\bdeny|denied|reject\w*\b", permission_log, re.IGNORECASE))
    result = {
        "schema": "norn.m5-host-network-diagnostics/v1",
        "guestIP": str(address),
        "route": route_fields or None,
        "interfaceCount": len(interfaces) if interfaces is not None else None,
        "tartNetworkInterfacesPresent": any(name.startswith("bridge") or name.startswith("vmnet")
                                             for name in interfaces or []),
        "localNetworkPolicyConfigured": local_network_config is not None,
        "localNetworkTCCDenialObserved": denial_observed,
    }
    print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(json.dumps({"schema": "norn.m5-host-network-diagnostics/v1", "diagnosticError": type(exc).__name__}), file=sys.stderr)
        raise SystemExit(1)
