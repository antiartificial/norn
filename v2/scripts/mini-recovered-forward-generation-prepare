#!/usr/bin/env python3
"""Prepare and activate a signed, immutable recovered-forward generation."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import hmac
import importlib.machinery
import importlib.util
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
RESOLVER_PATH = SCRIPT_DIR / "mini-recovered-forward-generation-resolve"
COMPLETED_GATE = SCRIPT_DIR / "mini-recovered-forward-completed-gate"
EVIDENCE_VERIFIER = SCRIPT_DIR / "mini-recovered-forward-verify-evidence"
POINTER_SCHEMA = "norn.recovered-forward-active-generation/v1"
MANIFEST_SCHEMA = "norn.recovered-forward-generation/v1"
JOURNAL_SCHEMA = "norn.recovered-forward-transition/v1"
GENERATION_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
TRANSITION_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$")
HEX40 = re.compile(r"^[0-9a-f]{40}$")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
MAX_BYTES = 64 * 1024


def fail(message: str) -> None:
    raise ValueError(message)


def canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def sign(value: dict[str, Any], key: bytes) -> bytes:
    unsigned = dict(value)
    schema = unsigned["schema"]
    signature = "hmac-sha256:" + hmac.new(key, schema.encode() + b"\0" + canonical(unsigned), hashlib.sha256).hexdigest()
    return canonical({**unsigned, "signature": signature}) + b"\n"


def strict_json(raw: bytes, label: str) -> dict[str, Any]:
    def unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in pairs:
            if key in result:
                fail(f"{label} contains duplicate field {key}")
            result[key] = value
        return result

    try:
        value = json.loads(raw, object_pairs_hook=unique)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(f"{label} is not strict JSON: {error}")
    if type(value) is not dict:
        fail(f"{label} must be a JSON object")
    return value


def owner_directory(path: Path, label: str) -> Path:
    if not path.is_absolute():
        fail(f"{label} must be absolute")
    info = path.lstat()
    resolved = path.resolve(strict=True)
    if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
            or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700
            or resolved != path):
        fail(f"{label} must be a canonical invoking-user-owned mode-0700 directory")
    return resolved


def private_bytes(path: Path, label: str) -> bytes:
    if not path.is_absolute() or path.is_symlink() or path.resolve(strict=True) != path:
        fail(f"{label} must be absolute and not a symlink")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size <= 0
                or info.st_size > MAX_BYTES):
            fail(f"{label} must be a nonempty invoking-user-owned mode-0600 regular file")
        with os.fdopen(fd, "rb", closefd=False) as stream:
            raw = stream.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            fail(f"{label} exceeds the {MAX_BYTES}-byte limit")
        return raw
    finally:
        os.close(fd)


def private_file_digest(path: Path, label: str) -> tuple[str, int]:
    if not path.is_absolute() or path.is_symlink() or path.resolve(strict=True) != path:
        fail(f"{label} must be absolute and not a symlink")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size <= 0:
            fail(f"{label} must be a nonempty invoking-user-owned mode-0600 regular file")
        digest = hashlib.sha256()
        total = 0
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            total += len(chunk)
        if total != info.st_size:
            fail(f"{label} changed while it was being read")
        return digest.hexdigest(), total
    finally:
        os.close(fd)


def check_current_source(current_link: Path, releases: Path, source_sha: str) -> None:
    if not current_link.is_absolute() or not current_link.is_symlink():
        fail("Mini current release must remain an exact source symlink")
    try:
        target = current_link.resolve(strict=True)
    except OSError as error:
        raise ValueError("Mini current release symlink is invalid") from error
    if target != releases / source_sha:
        fail("Mini current release no longer points to the exact prepared source")


def acquire_promotion_lock(releases: Path) -> int:
    lock_path = releases / ".promotion.lock"
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(lock_path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) & 0o077):
        os.close(fd)
        fail("platform promotion lock must be an invoking-user-owned private regular file")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        os.close(fd)
        raise ValueError("another platform promotion is already active") from error
    return fd


def parse_timestamp(value: Any, label: str) -> str:
    if not isinstance(value, str):
        fail(f"{label} timestamp is missing")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError(f"{label} timestamp is invalid") from error
    if parsed.tzinfo is None or parsed.utcoffset() != dt.timedelta(0):
        fail(f"{label} timestamp must be UTC")
    return parsed.astimezone(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def load_resolver():
    loader = importlib.machinery.SourceFileLoader("norn_recovered_forward_generation_resolve", str(RESOLVER_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        fail("generation resolver cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


RESOLVER = load_resolver()


def release_identity(releases: Path, sha: str, label: str) -> None:
    if not HEX40.fullmatch(sha):
        fail(f"{label} release SHA is invalid")
    release = releases / sha
    info = release.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(f"{label} immutable release directory is missing or unsafe")
    env_path = release / "release.env"
    env_info = env_path.lstat()
    if not stat.S_ISREG(env_info.st_mode) or stat.S_ISLNK(env_info.st_mode):
        fail(f"{label} immutable release identity file is missing or unsafe")
    raw = env_path.read_bytes()
    values = {}
    for line in raw.decode("utf-8").splitlines():
        if "=" in line:
            name, value = line.split("=", 1)
            values[name] = value
    if values.get("NORN_RELEASE_SHA") != sha:
        fail(f"{label} immutable release identity does not match its directory")


def completed_predecessor(root: Path, releases: Path, key: bytes,
                          historical_key: bytes) -> dict[str, Any]:
    journal_path = root / "transition.json"
    receipt_path = root / "preservation-receipt.json"
    journal_raw = private_bytes(journal_path, "legacy recovered-forward journal")
    journal = strict_json(journal_raw, "legacy recovered-forward journal")
    if journal.get("schema") != JOURNAL_SCHEMA or journal.get("state") != "candidate-promoted":
        fail("legacy fixed journal is not the exact candidate-promoted transition")
    required_journal_fields = {
        "schema", "state", "transitionID", "sourceSHA", "candidateReleaseSHA",
        "sourceEvidencePath", "sourceEvidenceSHA256", "backupProofPath", "backupArtifactPath",
        "shadowReceiptPath", "preservationReceiptPath", "preservationReceiptSHA256",
    }
    allowed_journal_fields = required_journal_fields | {"legacyReleaseSHA", "legacyPID"}
    if not required_journal_fields.issubset(journal) or not set(journal).issubset(allowed_journal_fields):
        fail("legacy journal fields are not the exact supported historical schema")
    transition = journal.get("transitionID")
    source = journal.get("sourceSHA")
    candidate = journal.get("candidateReleaseSHA")
    if (not isinstance(transition, str) or not TRANSITION_ID.fullmatch(transition)
            or not isinstance(source, str) or not HEX40.fullmatch(source)
            or not isinstance(candidate, str) or not HEX40.fullmatch(candidate)):
        fail("legacy journal transition or release identity is invalid")
    fixed_evidence_path = root / "transition.json.source-evidence.json"
    retargeted_evidence_path = root / f"retarget-{candidate}" / "source-evidence.json"
    evidence_value = journal.get("sourceEvidencePath")
    if evidence_value not in (str(fixed_evidence_path), str(retargeted_evidence_path)):
        fail("legacy journal source evidence is not at a supported canonical path")
    evidence_path = Path(evidence_value)
    if evidence_path == retargeted_evidence_path:
        owner_directory(evidence_path.parent, "legacy retargeted evidence directory")
    if journal.get("preservationReceiptPath") != str(receipt_path):
        fail("legacy journal preservation receipt is not at the fixed legacy path")
    evidence_raw = private_bytes(evidence_path, "legacy recovered-forward source evidence")
    receipt_raw = private_bytes(receipt_path, "legacy recovered-forward preservation receipt")
    evidence_digest = hashlib.sha256(evidence_raw).hexdigest()
    if journal.get("sourceEvidenceSHA256") != evidence_digest:
        fail("legacy journal source evidence digest changed")
    if journal.get("preservationReceiptSHA256") != hashlib.sha256(receipt_raw).hexdigest():
        fail("legacy journal preservation receipt digest changed")

    # The old preservation receipt was signed under the historical key. Keep
    # the active key available separately: the predecessor evidence may bind
    # the current adoption receipt, which remains signed by the active key.
    historical_env = os.environ.copy()
    historical_env.pop("NORN_AUDIT_HISTORICAL_SIGNING_KEY", None)
    historical_env["NORN_AUDIT_SIGNING_KEY"] = key.decode("utf-8")
    historical_env["NORN_AUDIT_HISTORICAL_SIGNING_KEY"] = historical_key.decode("utf-8")
    gate = subprocess.run(
        [str(COMPLETED_GATE), str(journal_path), str(root / "current"), str(releases), str(receipt_path), "--historical"],
        env=historical_env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if gate.returncode:
        fail("historical completed-recovery gate failed: " + gate.stderr.strip())
    fields = gate.stdout.rstrip("\n").split("\t")
    if len(fields) != 9 or fields[:3] != [transition, source, candidate]:
        fail("historical completed-recovery gate returned an unexpected binding")
    if (fields[3] != str(evidence_path) or fields[4] != evidence_digest
            or fields[5] != journal.get("backupProofPath")
            or fields[6] != journal.get("backupArtifactPath")
            or fields[7] != journal.get("shadowReceiptPath")
            or fields[8] != hashlib.sha256(receipt_raw).hexdigest()):
        fail("historical completed-recovery gate returned changed legacy paths or digests")

    proof_path = Path(journal.get("backupProofPath", ""))
    artifact_path = Path(journal.get("backupArtifactPath", ""))
    shadow_path = Path(journal.get("shadowReceiptPath", ""))
    if not all(p.is_absolute() for p in (proof_path, artifact_path, shadow_path)):
        fail("legacy backup and shadow paths must be absolute")
    verify = subprocess.run(
        [str(EVIDENCE_VERIFIER), str(evidence_path), evidence_digest, transition, source, candidate,
         str(proof_path), str(artifact_path), str(shadow_path)],
        env=historical_env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if verify.returncode or verify.stdout.strip() != "verified":
        fail("legacy signed evidence verifier failed: " + verify.stderr.strip())
    return {
        "predecessorState": "candidate-promoted",
        "predecessorTransitionID": transition,
        "predecessorSourceSHA": source,
        "predecessorCandidateSHA": candidate,
        "predecessorJournalPath": str(journal_path),
        "predecessorJournalSHA256": hashlib.sha256(journal_raw).hexdigest(),
        "predecessorEvidencePath": str(evidence_path),
        "predecessorEvidenceSHA256": evidence_digest,
        "predecessorReceiptPath": str(receipt_path),
        "predecessorReceiptSHA256": hashlib.sha256(receipt_raw).hexdigest(),
    }


def atomic_file(path: Path, raw: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb", closefd=False) as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
    finally:
        os.close(fd)


def fsync_dir(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def build_journal(args: argparse.Namespace, generation: Path, evidence_raw: bytes,
                  proof: Path, artifact: Path, shadow: Path) -> bytes:
    evidence_path = generation / "transition.json.source-evidence.json"
    value = {
        "schema": JOURNAL_SCHEMA,
        "transitionID": args.transition_id,
        "sourceSHA": args.source_sha,
        "candidateReleaseSHA": args.candidate_sha,
        "sourceEvidencePath": str(evidence_path),
        "sourceEvidenceSHA256": hashlib.sha256(evidence_raw).hexdigest(),
        "backupProofPath": str(proof),
        "backupArtifactPath": str(artifact),
        "shadowReceiptPath": str(shadow),
        "preservationReceiptPath": str(generation / "preservation-receipt.json"),
        "preservationReceiptSHA256": "",
        "state": "prepared",
    }
    return canonical(value) + b"\n"


def checked_generation_dir(path: Path, expected_files: dict[str, bytes]) -> None:
    owner_directory(path, "recovered-forward generation directory")
    actual_names = {item.name for item in path.iterdir()}
    if actual_names != set(expected_files):
        fail("generation directory contains missing or unexpected files")
    for name, expected in expected_files.items():
        raw = private_bytes(path / name, f"generation {name}")
        if not hmac.compare_digest(raw, expected):
            fail(f"existing generation file differs from deterministic preparation: {name}")


def verify_generation_evidence(generation: Path, args: argparse.Namespace, evidence_digest: str, key: bytes) -> None:
    env = os.environ.copy()
    env.pop("NORN_AUDIT_HISTORICAL_SIGNING_KEY", None)
    env["NORN_AUDIT_SIGNING_KEY"] = key.decode("utf-8")
    result = subprocess.run(
        [str(EVIDENCE_VERIFIER), str(generation / "transition.json.source-evidence.json"), evidence_digest,
         args.transition_id, args.source_sha, args.candidate_sha,
         str(generation / "backup-proof.json"), str(args.backup_artifact),
         str(generation / "shadow-receipt.json")],
        env=env,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if result.returncode or result.stdout.strip() != "verified":
        fail("generation-local signed evidence and artifacts did not verify: " + result.stderr.strip())


def prepare(args: argparse.Namespace) -> dict[str, Any]:
    key = os.environ.get("NORN_AUDIT_SIGNING_KEY", "").encode()
    # Capture then remove the historical key before any later subprocess can
    # inherit it. It is used only for the immutable predecessor verification.
    historical_key = os.environ.pop("NORN_AUDIT_HISTORICAL_SIGNING_KEY", "").encode()
    if len(key) < 32:
        fail("NORN_AUDIT_SIGNING_KEY must contain at least 32 bytes")
    if historical_key and len(historical_key) < 32:
        fail("NORN_AUDIT_HISTORICAL_SIGNING_KEY must contain at least 32 bytes when supplied")
    if not historical_key:
        historical_key = key
    if not TRANSITION_ID.fullmatch(args.transition_id):
        fail("new transition ID is invalid")
    if not HEX40.fullmatch(args.source_sha) or not HEX40.fullmatch(args.candidate_sha) or args.source_sha == args.candidate_sha:
        fail("new source and candidate must be distinct exact 40-character SHAs")

    root = owner_directory(args.root, "recovered-forward root")
    releases = args.releases_root.resolve(strict=True)
    release_identity(releases, args.source_sha, "new source")
    release_identity(releases, args.candidate_sha, "new candidate")
    predecessor = completed_predecessor(root, releases, key, historical_key)

    inputs = {
        "transition.json.source-evidence.json": private_bytes(args.source_evidence, "new source evidence"),
        "backup-proof.json": private_bytes(args.backup_proof, "new backup proof"),
        "shadow-receipt.json": private_bytes(args.shadow_receipt, "new shadow receipt"),
    }
    artifact_digest, artifact_bytes = private_file_digest(args.backup_artifact, "new backup artifact")
    proof_value = strict_json(inputs["backup-proof.json"], "new backup proof")
    shadow_value = strict_json(inputs["shadow-receipt.json"], "new shadow receipt")
    created_at = parse_timestamp(shadow_value.get("completedAt"), "new shadow receipt")
    input_digests = {name: hashlib.sha256(raw).hexdigest() for name, raw in inputs.items()}
    input_digests["backup-artifact.bin"] = artifact_digest
    input_sizes = {"backup-artifact.bin": artifact_bytes}
    identity_material = {
        "transitionID": args.transition_id,
        "sourceSHA": args.source_sha,
        "candidateSHA": args.candidate_sha,
        "inputDigests": input_digests,
        "inputSizes": input_sizes,
        "predecessor": predecessor,
    }
    generation_id = "gen-" + hashlib.sha256(canonical(identity_material)).hexdigest()[:32]
    if not GENERATION_ID.fullmatch(generation_id):
        fail("deterministic generation ID is invalid")
    generations = root / "generations"
    if not generations.exists():
        generations.mkdir(mode=0o700)
        fsync_dir(root)
    generations = owner_directory(generations, "recovered-forward generations directory")
    generation = generations / generation_id
    journal_raw = build_journal(args, generation, inputs["transition.json.source-evidence.json"],
                                generation / "backup-proof.json", args.backup_artifact,
                                generation / "shadow-receipt.json")
    expected_files = {
        **inputs,
        "transition.json": journal_raw,
    }
    manifest_value = {
        "schema": MANIFEST_SCHEMA,
        "generationID": generation_id,
        "generationPath": str(generation),
        "transitionID": args.transition_id,
        "sourceSHA": args.source_sha,
        "candidateSHA": args.candidate_sha,
        "journalPath": str(generation / "transition.json"),
        "preservationReceiptPath": str(generation / "preservation-receipt.json"),
        "createdAt": created_at,
        "sourceEvidencePath": str(generation / "transition.json.source-evidence.json"),
        "sourceEvidenceSHA256": input_digests["transition.json.source-evidence.json"],
        "backupProofPath": str(generation / "backup-proof.json"),
        "backupProofSHA256": input_digests["backup-proof.json"],
        "backupArtifactPath": str(args.backup_artifact),
        "backupArtifactSHA256": artifact_digest,
        "backupArtifactBytes": artifact_bytes,
        "shadowReceiptPath": str(generation / "shadow-receipt.json"),
        "shadowReceiptSHA256": input_digests["shadow-receipt.json"],
        **predecessor,
    }
    manifest_raw = sign(manifest_value, key)
    expected_files["generation.json"] = manifest_raw

    evidence_digest = input_digests["transition.json.source-evidence.json"]
    if proof_value.get("sourceReleaseSHA") != args.source_sha or not shadow_value:
        fail("new backup/shadow input binding is inconsistent")

    pointer_value = {
        "schema": POINTER_SCHEMA,
        "generationID": generation_id,
        "generationPath": str(generation),
        "generationManifestPath": str(generation / "generation.json"),
        "generationManifestSHA256": hashlib.sha256(manifest_raw).hexdigest(),
        "transitionID": args.transition_id,
        "sourceSHA": args.source_sha,
        "candidateSHA": args.candidate_sha,
        "activatedAt": created_at,
    }
    pointer_raw = sign(pointer_value, key)
    pointer_path = root / "active-generation.json"

    if pointer_path.exists() or pointer_path.is_symlink():
        check_current_source(args.current_link, releases, args.source_sha)
        selected = RESOLVER.resolve(root, key)
        if selected.get("selection") != "generation" or selected.get("generationID") != generation_id:
            fail("active generation pointer is incompatible with this exact preparation")
        checked_generation_dir(generation, expected_files)
        verify_generation_evidence(generation, args, evidence_digest, key)
        active_raw = private_bytes(pointer_path, "active generation pointer")
        if not hmac.compare_digest(active_raw, pointer_raw):
            fail("active generation pointer differs from the deterministic preparation")
        return result(root, generation_id, generation, manifest_raw, active_raw)

    existing_entries = {item.name for item in generations.iterdir()}
    allowed = {generation_id, f".prepare-{generation_id}"}
    if existing_entries - allowed:
        fail("unexpected generation orphan exists; refusing to activate a successor")
    staging = generations / f".prepare-{generation_id}"
    if generation.exists() or generation.is_symlink():
        checked_generation_dir(generation, expected_files)
    elif staging.exists() or staging.is_symlink():
        checked_generation_dir(staging, expected_files)
        os.rename(staging, generation)
        fsync_dir(generations)
    else:
        staging.mkdir(mode=0o700)
        try:
            for name, raw in expected_files.items():
                atomic_file(staging / name, raw)
            fsync_dir(staging)
            checked_generation_dir(staging, expected_files)
            os.rename(staging, generation)
            fsync_dir(generations)
        except BaseException:
            # Keep a deterministic staging directory for exact retry inspection.
            raise

    # Validate the full new generation and predecessor closure before publishing the pointer.
    checked_generation_dir(generation, expected_files)
    verify_generation_evidence(generation, args, evidence_digest, key)
    check_current_source(args.current_link, releases, args.source_sha)
    RESOLVER.resolve(root, key)  # pointer absent must select the immutable legacy paths
    temp_fd, temp_name = tempfile.mkstemp(prefix=".active-generation.", dir=root)
    try:
        os.fchmod(temp_fd, 0o600)
        with os.fdopen(temp_fd, "wb") as stream:
            stream.write(pointer_raw)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.link(temp_name, pointer_path)
        except FileExistsError:
            selected = RESOLVER.resolve(root, key)
            if selected.get("selection") != "generation" or selected.get("generationID") != generation_id:
                fail("a conflicting active generation pointer appeared during preparation")
        fsync_dir(root)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
    active_raw = private_bytes(pointer_path, "active generation pointer")
    selected = RESOLVER.resolve(root, key)
    if selected.get("selection") != "generation" or selected.get("generationID") != generation_id:
        fail("published generation pointer did not resolve to the exact prepared generation")
    return result(root, generation_id, generation, manifest_raw, active_raw)


def result(root: Path, generation_id: str, generation: Path, manifest_raw: bytes, pointer_raw: bytes) -> dict[str, Any]:
    return {
        "root": str(root),
        "generationID": generation_id,
        "journalPath": str(generation / "transition.json"),
        "evidencePath": str(generation / "transition.json.source-evidence.json"),
        "receiptPath": str(generation / "preservation-receipt.json"),
        "manifestSHA256": hashlib.sha256(manifest_raw).hexdigest(),
        "pointerSHA256": hashlib.sha256(pointer_raw).hexdigest(),
    }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    command = sub.add_parser("prepare")
    command.add_argument("--root", type=Path, required=True)
    command.add_argument("--transition-id", required=True)
    command.add_argument("--source-sha", required=True)
    command.add_argument("--candidate-sha", required=True)
    command.add_argument("--source-evidence", type=Path, required=True)
    command.add_argument("--backup-proof", type=Path, required=True)
    command.add_argument("--backup-artifact", type=Path, required=True)
    command.add_argument("--shadow-receipt", type=Path, required=True)
    command.add_argument("--current-link", type=Path, required=True)
    command.add_argument("--releases-root", type=Path, required=True)
    return result


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    lock_fd = acquire_promotion_lock(args.releases_root.resolve(strict=True))
    try:
        prepared = prepare(args)
    finally:
        os.close(lock_fd)
    print(json.dumps(prepared, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, json.JSONDecodeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
