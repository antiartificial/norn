#!/usr/bin/env python3
"""Require a successful full protected-master Norn CI run for a release."""

from __future__ import annotations

import json
from pathlib import Path
import re
import sys


EXPECTED_JOBS = {
    "api", "cli", "M7 mobility fixture image",
    "M4 durable replicas on three Nomad clients",
    "M1 migration process-crash recovery",
    "M1/M4 etcd deployment process-crash containment",
    "M4 private ingress transport", "M6 local mobility transfer and fence",
    "api production etcd TLS RBAC", "Mini synthetic schema fixture",
    "release bundle rehearsal", "workflow validation",
}


def validate(run: object, jobs: object, source_sha: str, run_id: str, repository: str) -> None:
    if not re.fullmatch(r"[0-9a-f]{40}", source_sha):
        raise ValueError("release source SHA is invalid")
    if not re.fullmatch(r"[1-9][0-9]*", run_id):
        raise ValueError("qualification run ID is invalid")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise ValueError("release repository is invalid")
    if not isinstance(run, dict) or any(not isinstance(run.get(name), dict)
                                        for name in ("repository", "head_repository")):
        raise ValueError("qualification run metadata is malformed")
    expected = {
        "id": int(run_id),
        "run_attempt": 1,
        "event": "workflow_dispatch",
        "path": ".github/workflows/v3-ci.yml",
        "head_branch": "master",
        "head_sha": source_sha,
        "status": "completed",
        "conclusion": "success",
    }
    if any(type(run.get(name)) is not type(value) or run[name] != value
           for name, value in expected.items()):
        raise ValueError("qualification is not the exact successful protected-master full CI run")
    if (run["repository"].get("full_name") != repository
            or run["head_repository"].get("full_name") != repository):
        raise ValueError("qualification run belongs to another repository")
    if not isinstance(jobs, dict) or type(jobs.get("total_count")) is not int or not isinstance(jobs.get("jobs"), list):
        raise ValueError("qualification jobs metadata is malformed")
    listed = jobs["jobs"]
    if jobs["total_count"] != len(EXPECTED_JOBS) or len(listed) != len(EXPECTED_JOBS):
        raise ValueError("qualification did not execute the complete full CI job set")
    names = [job.get("name") for job in listed if isinstance(job, dict)]
    if len(names) != len(EXPECTED_JOBS) or set(names) != EXPECTED_JOBS:
        raise ValueError("qualification did not execute the expected full CI jobs")
    if any(job.get("status") != "completed" or job.get("conclusion") != "success"
           for job in listed):
        raise ValueError("qualification has skipped or unsuccessful full CI jobs")


def main() -> None:
    if len(sys.argv) != 6:
        raise SystemExit("usage: platform-release-qualification RUN_JSON JOBS_JSON SOURCE_SHA RUN_ID REPOSITORY")
    payloads = []
    for filename in sys.argv[1:3]:
        raw = Path(filename).read_bytes()
        if not raw or len(raw) > 2_000_000:
            raise ValueError("qualification metadata has invalid size")
        payloads.append(json.loads(raw))
    validate(payloads[0], payloads[1], sys.argv[3], sys.argv[4], sys.argv[5])
    print("exact protected-master full Norn CI qualification verified")


if __name__ == "__main__":
    main()
