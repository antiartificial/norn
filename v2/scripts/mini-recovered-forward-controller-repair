#!/usr/bin/env python3
"""Authorize one signed controller to resume an exact fenced Mini transition.

This is deliberately separate from the candidate-pinned normal wrapper. The
target candidate and its evidence never change; only controller code changes.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import hmac
import importlib.machinery
import importlib.util
import json
import os
import plistlib
import re
import stat
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path


SCHEMA = "norn.recovered-forward-controller-repair/v1"
PLIST_SCHEMA = "norn.recovered-forward-api-plist/v1"
ORIGINAL_LAUNCHER_SHA256 = "6583bb54b29a2bf6cfc7ca4556da17b3fe7b0ed295458df131cb338addf62b12"
FIELDS = {"schema", "controllerSHA", "candidateSHA", "sourceSHA", "transitionID",
          "pointerSHA256", "manifestSHA256", "journalSHA256", "evidenceSHA256",
          "generationID", "currentReleaseSHA", "signature"}
FENCE = (b'#!/usr/bin/env bash\nprintf "norn legacy baseline fence active; '
         b'candidate recovery is required\\n" >&2\nexit 78\n')
HEX40 = re.compile(r"[0-9a-f]{40}\Z")
HEX64 = re.compile(r"[0-9a-f]{64}\Z")
REPAIR_PHASES = {"host-agent-fencing", "host-agent-fenced", "api-fencing",
                 "legacy-fenced", "migration-started", "schema-migrated",
                 "candidate-activation-started", "candidate-postflight-failed"}
SOURCE_API_PHASES = {"host-agent-fencing", "host-agent-fenced"}


def fail(message: str) -> None:
    raise ValueError(message)


def strict(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            fail("duplicate field in repair document: " + key)
        result[key] = value
    return result


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def owned(path: Path, label: str, mode: int = 0o600, limit: int = 65536) -> bytes:
    if not path.is_absolute():
        fail(label + " must be absolute")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != mode or not 0 < info.st_size <= limit):
            fail(label + " must be an owned regular file with exact mode and bounded size")
        raw = os.read(fd, limit + 1)
        if len(raw) != info.st_size:
            fail(label + " changed during read")
        return raw
    finally:
        os.close(fd)


def json_object(raw: bytes, label: str):
    value = json.loads(raw, object_pairs_hook=strict)
    if type(value) is not dict:
        fail(label + " must be a JSON object")
    return value


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def owned_binary_digest(path: Path, mode: int = 0o755) -> str:
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != mode or info.st_size <= 0):
            fail("managed candidate API binary is unsafe")
        hashed = hashlib.sha256()
        while chunk := os.read(fd, 1024 * 1024):
            hashed.update(chunk)
        if os.fstat(fd).st_size != info.st_size:
            fail("managed candidate API binary changed during validation")
        return hashed.hexdigest()
    finally:
        os.close(fd)


def verify_launchers(controller: Path) -> tuple[str, str]:
    original = Path.home() / "bin/norn-api-sops-launcher"
    signed = controller.parent / "mini-recovered-forward-api-launcher"
    original_sha = owned_binary_digest(original, 0o700)
    signed_sha = owned_binary_digest(signed)
    if original_sha != ORIGINAL_LAUNCHER_SHA256:
        fail("original Mini API launcher bytes changed from the audited source")
    return original_sha, signed_sha


def release(root: Path, sha: str, verifier: Path) -> Path:
    if not HEX40.fullmatch(sha):
        fail("release SHA must be exact")
    path = root / sha
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail("signed release directory is unavailable")
    env = (path / "release.env").read_text()
    if "NORN_RELEASE_SHA=" + sha not in env.splitlines():
        fail("signed release identity differs from its directory")
    result = subprocess.run([str(verifier), str(path), str(path / "release.json")],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if result.returncode:
        fail("external signature verification failed for " + sha)
    return path


def module(path: Path):
    loader = importlib.machinery.SourceFileLoader("norn_generation_resolver_repair", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        fail("signed generation resolver could not load")
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


def configured_verifier(home: Path) -> Path:
    config = home / ".config/norn/release.env"
    raw = owned(config, "signed release configuration", 0o600, 16384)
    values = {}
    for line in raw.decode().splitlines():
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            fail("signed release configuration has an invalid line")
        key, value = line.split("=", 1)
        if key in values:
            fail("signed release configuration repeats a key")
        values[key] = value
    name = values.get("NORN_RELEASE_VERIFY_HOOK", "")
    path = Path(name)
    if not name or not path.is_absolute() or not path.is_file() or not os.access(path, os.X_OK):
        fail("owner-only release configuration lacks an external verifier")
    supplied = os.environ.get("NORN_RELEASE_VERIFY_HOOK", name)
    if supplied != name:
        fail("release verifier differs from the owner-only configuration")
    return path


def allowed_current_releases(phase: str, journal: dict, releases: Path,
                             source: str, candidate: str, verifier: Path) -> set[Path]:
    allowed = {releases / source}
    if phase in {"candidate-activation-started", "candidate-postflight-failed",
                 "candidate-preservation-pending", "candidate-finalize-requested",
                 "candidate-normal-activation-pending", "candidate-normal-active-pending-host-agent",
                 "candidate-normal-active-pending-host-agent-restart", "candidate-promoted"}:
        allowed.add(releases / candidate)
        predecessor = journal.get("retargetedFromCandidateSHA", "")
        if predecessor:
            if (not isinstance(predecessor, str) or not HEX40.fullmatch(predecessor)
                    or predecessor in {source, candidate}):
                fail("journaled retarget predecessor is invalid")
            release(releases, predecessor, verifier)
            allowed.add(releases / predecessor)
    elif journal.get("retargetedFromCandidateSHA"):
        fail("retarget predecessor is invalid before candidate activation")
    if phase in {"candidate-postflight-failed", "candidate-preservation-pending",
                 "candidate-finalize-requested", "candidate-normal-activation-pending",
                 "candidate-normal-active-pending-host-agent", "candidate-normal-active-pending-host-agent-restart",
                 "candidate-promoted"}:
        # Failed postflight is after the candidate symlink switch. An old
        # source or predecessor symlink at this point indicates drift.
        return {releases / candidate}
    return allowed


def checked_state(args, key: bytes, allowed_phases=REPAIR_PHASES, *, allow_candidate_host=False):
    if len(key) < 32:
        fail("audit signing key must contain at least 32 bytes")
    controller = args.controller
    if controller.name != "platform-upgrade" or controller.parent.name != "bin":
        fail("repair controller must be an installed platform-upgrade")
    releases = controller.parent.parent.parent
    controller_sha = controller.parent.parent.name
    if not HEX40.fullmatch(controller_sha) or controller != releases / controller_sha / "bin/platform-upgrade":
        fail("repair controller path is not canonical")
    controller_info = controller.lstat()
    helper = Path(__file__)
    helper_info = helper.lstat()
    if (not stat.S_ISREG(controller_info.st_mode) or stat.S_ISLNK(controller_info.st_mode)
            or not stat.S_ISREG(helper_info.st_mode) or stat.S_ISLNK(helper_info.st_mode)
            or helper != controller.parent / "mini-recovered-forward-controller-repair"
            or not os.access(controller, os.X_OK)):
        fail("repair helper and controller must be regular executables in the same signed release")
    home = Path.home()
    verifier = configured_verifier(home)
    controller_release = release(releases, controller_sha, verifier)
    verify_launchers(controller)
    if controller_release == releases / args.candidate:
        fail("controller substitution requires a distinct signed release")
    release(releases, args.source, verifier)
    release(releases, args.candidate, verifier)

    root = home / ".config/norn/recovered-forward"
    resolver = module(controller.parent / "mini-recovered-forward-generation-resolve")
    historical_key = os.environ.get("NORN_AUDIT_HISTORICAL_SIGNING_KEY", "").encode()
    selected = resolver.resolve_with_audit_keys(root, key, historical_key, allow_repair_phase=True)
    if (selected.get("selection") != "generation" or selected.get("transitionID") != args.transition
            or selected.get("sourceSHA") != args.source or selected.get("candidateSHA") != args.candidate
            or selected.get("journalPath") != str(args.journal)):
        fail("active signed generation is not the exact repair target")
    generation = Path(selected["generationPath"])
    if args.journal != generation / "transition.json":
        fail("repair journal path is outside the selected generation")
    pointer_raw = owned(root / "active-generation.json", "active generation pointer")
    manifest_raw = owned(generation / "generation.json", "signed generation manifest")
    journal_raw = owned(args.journal, "transition journal")
    manifest = json_object(manifest_raw, "signed generation manifest")
    journal = json_object(journal_raw, "transition journal")
    phase = journal.get("state")
    if (phase not in allowed_phases or journal.get("transitionID") != args.transition
            or journal.get("sourceSHA") != args.source or journal.get("candidateReleaseSHA") != args.candidate):
        fail("repair requires an exact resumable pre-promotion journal")
    evidence_path = Path(manifest["sourceEvidencePath"])
    evidence_raw = owned(evidence_path, "signed source evidence")
    evidence_sha = digest(evidence_raw)
    if (evidence_sha != manifest["sourceEvidenceSHA256"]
            or evidence_sha != journal["sourceEvidenceSHA256"]):
        fail("signed source evidence changed")
    evidence_verifier = controller.parent / "mini-recovered-forward-verify-evidence"
    result = subprocess.run([str(evidence_verifier), str(evidence_path), evidence_sha,
                             args.transition, args.source, args.candidate,
                             manifest["backupProofPath"], manifest["backupArtifactPath"],
                             manifest["shadowReceiptPath"]],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode or result.stdout.strip() != "verified":
        fail("signed source evidence does not verify")

    current = home / "norn/current"
    allowed_current = allowed_current_releases(phase, journal, releases, args.source, args.candidate, verifier)
    if not current.is_symlink() or current.resolve(strict=True) not in allowed_current:
        fail("Mini current release is not valid for the journaled phase")
    current_sha = current.resolve(strict=True).name
    host = home / ".config/norn/host/bin/norn-host-agent"
    if allow_candidate_host:
        if owned_binary_digest(host) != digest((releases / args.candidate / "bin/norn-host-agent").read_bytes()):
            if owned(host, "durable host-agent fence", 0o755, 1024) != FENCE:
                fail("managed host-agent is neither candidate nor exact durable fence")
    elif owned(host, "durable host-agent fence", 0o755, 1024) != FENCE:
        fail("managed host-agent is not the exact durable fence")
    label = "com.norn.host-agent"
    plist = home / "Library/LaunchAgents/com.norn.host-agent.plist"
    plist_info = plist.lstat()
    if (not stat.S_ISREG(plist_info.st_mode) or stat.S_ISLNK(plist_info.st_mode)
            or plist_info.st_uid != os.geteuid() or stat.S_IMODE(plist_info.st_mode) & 0o022):
        fail("host-agent LaunchAgent plist is unsafe")
    with plist.open("rb") as stream:
        job = plistlib.load(stream)
    program = home / ".config/norn/host/bin/platform-upgrade"
    arguments = job.get("ProgramArguments")
    if (job.get("Label") != label or not isinstance(arguments, list) or str(host) not in arguments
            or not arguments or Path(arguments[0]).resolve() != program.resolve()):
        fail("host-agent LaunchAgent is not bound to the managed fence path")
    launched = subprocess.run(["launchctl", "print", f"gui/{os.geteuid()}/{label}"],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    if launched.returncode == 0:
        paths = re.findall(r"^\s*path\s*=\s*(.+?)\s*$", launched.stdout, re.MULTILINE)
        if len(paths) != 1 or Path(paths[0]).resolve() != plist.resolve():
            fail("loaded host-agent LaunchAgent differs from the owned plist")
    if phase in {"candidate-postflight-failed", "candidate-preservation-pending",
                 "candidate-finalize-requested", "candidate-normal-activation-pending",
                 "candidate-normal-active-pending-host-agent", "candidate-normal-active-pending-host-agent-restart",
                 "candidate-promoted"}:
        # Promotion already installed the signed candidate. Never re-run a
        # migration or replace the managed API from this recovery phase.
        api_binary = Path(os.environ.get("NORN_LEGACY_API_PATH", "")) if os.environ.get("NORN_LEGACY_API_PATH") else Path(os.environ.get("NORN_BIN_DIR", str(home / "go/bin"))) / "norn-api"
        candidate_binary = releases / args.candidate / "bin/norn-api"
        if owned_binary_digest(api_binary) != digest(candidate_binary.read_bytes()):
            fail("failed-postflight managed API differs from the signed candidate")
        api_plist = home / "Library/LaunchAgents/com.norn.api.plist"
        plist_info = api_plist.lstat()
        if (not stat.S_ISREG(plist_info.st_mode) or stat.S_ISLNK(plist_info.st_mode)
                or plist_info.st_uid != os.geteuid() or stat.S_IMODE(plist_info.st_mode) & 0o022):
            fail("candidate API LaunchAgent plist is unsafe")
        plist_raw = api_plist.read_bytes()
        api_job = plistlib.loads(plist_raw)
        allowed_launchers = {str(home / "bin/norn-api-sops-launcher"),
                             str(controller.parent / "mini-recovered-forward-api-launcher")}
        if (api_job.get("Label") != "com.norn.api"
                or api_job.get("ProgramArguments", [None])[0] not in allowed_launchers):
            fail("candidate API LaunchAgent is not the expected managed job")
        api_state = subprocess.run(["launchctl", "print", f"gui/{os.geteuid()}/com.norn.api"],
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        if api_state.returncode == 0:
            paths = re.findall(r"^\s*path\s*=\s*(.+?)\s*$", api_state.stdout, re.MULTILINE)
            if len(paths) != 1 or Path(paths[0]).resolve() != api_plist.resolve():
                fail("loaded candidate API job differs from its validated plist")
    # The source API is live only before its own fence. Later phases rely on
    # the durable journal, exact binaries and the controller's phase-specific
    # checks while holding the promotion lock.
    if phase in SOURCE_API_PHASES:
        api = os.environ.get("NORN_API_BASE", "http://127.0.0.1:8800").rstrip("/")
        if api != "http://127.0.0.1:8800":
            fail("repair requires the direct Mini loopback API")
        with urllib.request.urlopen(api + "/api/version", timeout=8) as response:
            version = json.load(response)
        with urllib.request.urlopen(api + "/api/health", timeout=8) as response:
            health = json.load(response)
        if version.get("sourceSha") != args.source or health.get("status") != "ok":
            fail("source API is not healthy and serving the exact source")
    return {
        "schema": SCHEMA, "controllerSHA": controller_sha, "candidateSHA": args.candidate,
        "sourceSHA": args.source, "transitionID": args.transition,
        "pointerSHA256": digest(pointer_raw), "manifestSHA256": digest(manifest_raw),
        "journalSHA256": digest(journal_raw), "evidenceSHA256": evidence_sha,
        "generationID": selected["generationID"], "currentReleaseSHA": current_sha,
    }, manifest


def signature(payload, key):
    return "hmac-sha256:" + hmac.new(key, SCHEMA.encode() + b"\0" + canonical(payload), hashlib.sha256).hexdigest()


def plist_signature(payload, key):
    return "hmac-sha256:" + hmac.new(key, PLIST_SCHEMA.encode() + b"\0" + canonical(payload), hashlib.sha256).hexdigest()


def atomic_replace(path: Path, raw: bytes, mode: int):
    fd, temporary = tempfile.mkstemp(prefix=".norn-api-plist.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as output:
            output.write(raw)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def api_plist_path() -> Path:
    return Path.home() / "Library/LaunchAgents/com.norn.api.plist"


def api_plist_bytes() -> tuple[bytes, int]:
    path = api_plist_path()
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        info = os.fstat(fd)
        mode = stat.S_IMODE(info.st_mode)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or mode & 0o022 or info.st_size <= 0 or info.st_size > 65536):
            fail("candidate API LaunchAgent plist is unsafe")
        raw = os.read(fd, 65537)
        if len(raw) != info.st_size:
            fail("candidate API LaunchAgent plist changed during read")
        return raw, mode
    finally:
        os.close(fd)


def plist_variant(original: bytes, added: dict[str, str], *, clear_recovery: bool,
                  signed_launcher: Path | None = None) -> bytes:
    value = plistlib.loads(original)
    if value.get("Label") != "com.norn.api" or value.get("ProgramArguments", [None])[0] != str(Path.home() / "bin/norn-api-sops-launcher"):
        fail("candidate API LaunchAgent is not the expected managed job")
    environment = value.get("EnvironmentVariables", {})
    if not isinstance(environment, dict) or any(not isinstance(k, str) or not isinstance(v, str) for k, v in environment.items()):
        fail("candidate API LaunchAgent environment is invalid")
    if any(k.startswith("NORN_RECOVERED_FORWARD_") for k in environment):
        fail("original API plist already contains recovered-forward environment")
    environment = dict(environment)
    if clear_recovery:
        environment.pop("NORN_STARTUP_MODE", None)
        environment.pop("NORN_SCHEMA_MODE", None)
    environment.update(added)
    value["EnvironmentVariables"] = environment
    if signed_launcher is not None:
        if not signed_launcher.is_file() or signed_launcher.is_symlink() or not os.access(signed_launcher, os.X_OK):
            fail("signed recovery API launcher is unavailable")
        value["ProgramArguments"] = [str(signed_launcher)]
    return plistlib.dumps(value, fmt=plistlib.FMT_XML, sort_keys=True)


def plist_record_path(journal: Path) -> Path:
    return journal.parent / "api-plist-maintenance.json"


def read_plist_record(path: Path, key: bytes) -> dict:
    value = json_object(owned(path, "signed API plist recovery record", 0o600, 262144), "signed API plist recovery record")
    recorded = value.pop("signature", None)
    if value.get("schema") != PLIST_SCHEMA or not isinstance(recorded, str) or not hmac.compare_digest(recorded, plist_signature(value, key)):
        fail("signed API plist recovery record does not verify")
    return value


def plist_maintenance_values(expected: dict, manifest: dict) -> dict[str, str]:
    return {
        "NORN_STARTUP_MODE": "active", "NORN_SCHEMA_MODE": "check",
        "NORN_RECOVERED_FORWARD_MAINTENANCE": "true",
        "NORN_RECOVERED_FORWARD_TRANSITION_ID": expected["transitionID"],
        "NORN_RECOVERED_FORWARD_CANDIDATE_SHA": expected["candidateSHA"],
        "NORN_RECOVERED_FORWARD_SOURCE_SHA": expected["sourceSHA"],
        "NORN_RECOVERED_FORWARD_SOURCE_EVIDENCE_PATH": manifest["sourceEvidencePath"],
        "NORN_RECOVERED_FORWARD_SOURCE_EVIDENCE_SHA256": manifest["sourceEvidenceSHA256"],
        "NORN_RECOVERED_FORWARD_PRESERVATION_RECEIPT_PATH": str(Path(manifest["sourceEvidencePath"]).parent / "preservation-receipt.json"),
        "NORN_RECOVERED_FORWARD_PLIST_RECORD_PATH": str(Path(manifest["sourceEvidencePath"]).parent / "api-plist-maintenance.json"),
    }


def stage_plist(journal: Path, expected: dict, manifest: dict, key: bytes):
    path = plist_record_path(journal)
    actual, mode = api_plist_bytes()
    original_launcher_sha, signed_launcher_sha = verify_launchers(Path(__file__).with_name("platform-upgrade"))
    if path.exists() or path.is_symlink():
        record = read_plist_record(path, key)
        if any(record.get(k) != expected[k] for k in ("controllerSHA", "candidateSHA", "sourceSHA", "transitionID", "generationID", "evidenceSHA256")):
            fail("signed API plist recovery record belongs to another transition")
        if (record.get("originalLauncherSHA256") != original_launcher_sha
                or record.get("signedLauncherSHA256") != signed_launcher_sha):
            fail("API launcher identity changed during recovery")
        original = base64.b64decode(record["originalPlistBase64"], validate=True)
        if digest(original) != record["originalPlistSHA256"] or mode != record["originalPlistMode"]:
            fail("signed original API plist changed")
        staged = plist_variant(original, plist_maintenance_values(expected, manifest), clear_recovery=False,
                               signed_launcher=Path(__file__).with_name("mini-recovered-forward-api-launcher"))
        if digest(staged) != record["maintenancePlistSHA256"]:
            fail("signed maintenance API plist changed")
    else:
        original = actual
        staged = plist_variant(original, plist_maintenance_values(expected, manifest), clear_recovery=False,
                               signed_launcher=Path(__file__).with_name("mini-recovered-forward-api-launcher"))
        record = {
            "schema": PLIST_SCHEMA, "controllerSHA": expected["controllerSHA"],
            "candidateSHA": expected["candidateSHA"], "sourceSHA": expected["sourceSHA"],
            "transitionID": expected["transitionID"], "generationID": expected["generationID"],
            "evidenceSHA256": expected["evidenceSHA256"], "originalPlistBase64": base64.b64encode(original).decode(),
            "originalPlistSHA256": digest(original), "originalPlistMode": mode,
            "maintenancePlistSHA256": digest(staged),
            "originalLauncherSHA256": original_launcher_sha,
            "signedLauncherSHA256": signed_launcher_sha,
        }
        signed = dict(record, signature=plist_signature(record, key))
        fd, temporary = tempfile.mkstemp(prefix=".norn-api-plist-record.", dir=path.parent)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as output:
                output.write(canonical(signed))
                output.flush()
                os.fsync(output.fileno())
            os.link(temporary, path)
            os.unlink(temporary)
            directory_fd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
    if actual == staged:
        return
    if actual != original:
        fail("API plist is neither the signed original nor the exact maintenance variant")
    atomic_replace(api_plist_path(), staged, mode)
    if api_plist_bytes()[0] != staged:
        fail("API maintenance plist did not persist")


def verified_preservation_receipt(journal: Path, expected: dict, key: bytes) -> str:
    try:
        raw = owned(journal.parent / "preservation-receipt.json", "signed preservation receipt", 0o600, 65536)
    except OSError:
        fail("signed preservation receipt is missing")
    value = json_object(raw, "signed preservation receipt")
    fields = {"schema", "transitionId", "candidateSHA", "sourceEvidenceSHA256", "beforeDigest",
              "afterDigest", "preservationMatched", "finalizedAt", "signature"}
    recorded = value.pop("signature", None)
    schema = "norn.recovered-forward-preservation/v1"
    signed = "hmac-sha256:" + hmac.new(key, schema.encode() + b"\0" + canonical(value), hashlib.sha256).hexdigest()
    if (set(value) | {"signature"} != fields or value.get("schema") != schema
            or not isinstance(recorded, str) or not hmac.compare_digest(recorded, signed)
            or value.get("transitionId") != expected["transitionID"]
            or value.get("candidateSHA") != expected["candidateSHA"]
            or value.get("sourceEvidenceSHA256") != expected["evidenceSHA256"]
            or value.get("preservationMatched") is not True
            or value.get("beforeDigest") != value.get("afterDigest")):
        fail("preservation receipt is not signed for this exact unchanged candidate")
    return digest(raw)


def normal_plist_values(expected: dict, manifest: dict, receipt_sha: str) -> dict[str, str]:
    return {
        "NORN_STARTUP_MODE": "active", "NORN_SCHEMA_MODE": "check",
        "NORN_RECOVERED_FORWARD_TRANSITION_ID": expected["transitionID"],
        "NORN_RECOVERED_FORWARD_CANDIDATE_SHA": expected["candidateSHA"],
        "NORN_RECOVERED_FORWARD_SOURCE_SHA": expected["sourceSHA"],
        "NORN_RECOVERED_FORWARD_SOURCE_EVIDENCE_PATH": manifest["sourceEvidencePath"],
        "NORN_RECOVERED_FORWARD_SOURCE_EVIDENCE_SHA256": manifest["sourceEvidenceSHA256"],
        "NORN_RECOVERED_FORWARD_PRESERVATION_RECEIPT_PATH": str(journal_receipt_path(manifest)),
        "NORN_RECOVERED_FORWARD_PRESERVATION_RECEIPT_SHA256": receipt_sha,
        "NORN_RECOVERED_FORWARD_ACTIVATE_TRANSITION_ID": expected["transitionID"],
        "NORN_RECOVERED_FORWARD_PLIST_RECORD_PATH": str(journal_receipt_path(manifest).parent / "api-plist-maintenance.json"),
    }


def journal_receipt_path(manifest: dict) -> Path:
    return Path(manifest["sourceEvidencePath"]).parent / "preservation-receipt.json"


def advance_plist(journal: Path, expected: dict, manifest: dict, key: bytes, action: str):
    path = plist_record_path(journal)
    record = read_plist_record(path, key)
    if any(record.get(k) != expected[k] for k in ("controllerSHA", "candidateSHA", "sourceSHA", "transitionID", "generationID", "evidenceSHA256")):
        fail("signed API plist recovery record belongs to another transition")
    original_launcher_sha, signed_launcher_sha = verify_launchers(Path(__file__).with_name("platform-upgrade"))
    if (record.get("originalLauncherSHA256") != original_launcher_sha
            or record.get("signedLauncherSHA256") != signed_launcher_sha):
        fail("API launcher identity changed during recovery")
    original = base64.b64decode(record["originalPlistBase64"], validate=True)
    if digest(original) != record["originalPlistSHA256"]:
        fail("signed original API plist changed")
    actual, mode = api_plist_bytes()
    if mode != record["originalPlistMode"]:
        fail("API plist mode changed during recovery")
    launcher = Path(__file__).with_name("mini-recovered-forward-api-launcher")
    maintenance = plist_variant(original, plist_maintenance_values(expected, manifest), clear_recovery=False,
                                signed_launcher=launcher)
    if digest(maintenance) != record["maintenancePlistSHA256"]:
        fail("signed maintenance API plist changed")
    receipt_sha = verified_preservation_receipt(journal, expected, key)
    normal = plist_variant(original, normal_plist_values(expected, manifest, receipt_sha), clear_recovery=True,
                           signed_launcher=launcher)
    if action == "plist-normal":
        if actual == normal:
            return
        if actual != maintenance:
            fail("API plist is not the signed maintenance variant before normal activation")
        atomic_replace(api_plist_path(), normal, mode)
        if api_plist_bytes()[0] != normal:
            fail("normal activation API plist did not persist")
    elif action == "plist-restore":
        if actual == original:
            return
        if actual != normal:
            fail("API plist is not the signed normal activation variant before restore")
        atomic_replace(api_plist_path(), original, mode)
        if api_plist_bytes()[0] != original:
            fail("original API plist did not persist")
    else:
        fail("unknown API plist recovery action")


def preserve_candidate(journal: Path, expected: dict, manifest: dict, key: bytes):
    token = os.environ.get("NORN_TOKEN") or os.environ.get("NORN_API_TOKEN", "")
    if len(token) < 32:
        fail("candidate preservation requires the protected Mini API token")
    wrapper = module(Path(__file__).with_name("mini-recovered-forward-transition"))
    api = "http://127.0.0.1:8800"
    status = wrapper.fetch_json(api, "/api/v1/platform/recovered-forward/status", token)
    wrapper.verify_maintenance_status(status, expected["transitionID"], expected["sourceSHA"],
                                      expected["candidateSHA"], expected["evidenceSHA256"])
    if status.get("finalized") is not False:
        fail("candidate is not in the pending preservation maintenance state")
    preservation = wrapper.load_preservation_module()
    after_digest = preservation.digest(preservation.stable_state(api, token))
    evidence = json_object(owned(Path(manifest["sourceEvidencePath"]), "signed source evidence"),
                           "signed source evidence")
    if (evidence.get("transitionId") != expected["transitionID"]
            or evidence.get("sourceSHA") != expected["sourceSHA"]
            or evidence.get("candidateSHA") != expected["candidateSHA"]):
        fail("preservation evidence identity changed")
    receipt_path = journal.parent / "preservation-receipt.json"
    if receipt_path.exists() or receipt_path.is_symlink():
        existing = json_object(owned(receipt_path, "signed preservation receipt"), "signed preservation receipt")
        verified_preservation_receipt(journal, expected, key)
        if existing.get("beforeDigest") != evidence.get("beforeDigest") or existing.get("afterDigest") != after_digest:
            fail("persisted preservation receipt differs from current candidate state")
        return
    raw = wrapper.build_receipt(evidence, expected["evidenceSHA256"],
                                expected["candidateSHA"], after_digest, key)
    wrapper.atomic_private_create(receipt_path, raw)
    verified_preservation_receipt(journal, expected, key)


def verify_launcher_runtime(journal: Path, expected: dict, manifest: dict, key: bytes):
    record = read_plist_record(plist_record_path(journal), key)
    if any(record.get(k) != expected[k] for k in ("controllerSHA", "candidateSHA", "sourceSHA", "transitionID", "generationID", "evidenceSHA256")):
        fail("running API launcher has another transition's signed plist record")
    original_launcher_sha, signed_launcher_sha = verify_launchers(Path(__file__).with_name("platform-upgrade"))
    if (record.get("originalLauncherSHA256") != original_launcher_sha
            or record.get("signedLauncherSHA256") != signed_launcher_sha):
        fail("running API launcher bytes differ from the signed plist record")
    original = base64.b64decode(record["originalPlistBase64"], validate=True)
    if digest(original) != record["originalPlistSHA256"]:
        fail("running API launcher original plist changed")
    actual, mode = api_plist_bytes()
    if mode != record["originalPlistMode"]:
        fail("running API launcher plist mode changed")
    phase = json_object(owned(journal, "transition journal"), "transition journal").get("state")
    maintenance = os.environ.get("NORN_RECOVERED_FORWARD_MAINTENANCE") == "true"
    if maintenance:
        if phase not in {"candidate-postflight-failed", "candidate-preservation-pending", "candidate-finalize-requested"}:
            fail("maintenance launcher is invalid for the current journal phase")
        values = plist_maintenance_values(expected, manifest)
    else:
        if phase != "candidate-normal-activation-pending":
            fail("one-process activation launcher is invalid for the current journal phase")
        values = normal_plist_values(expected, manifest, verified_preservation_receipt(journal, expected, key))
    variant = plist_variant(original, values, clear_recovery=not maintenance,
                            signed_launcher=Path(__file__).with_name("mini-recovered-forward-api-launcher"))
    if actual != variant:
        fail("running API launcher plist differs from its signed recovery variant")
    inherited = {k: v for k, v in os.environ.items() if k.startswith("NORN_RECOVERED_FORWARD_")}
    expected_recovery = {k: v for k, v in values.items() if k.startswith("NORN_RECOVERED_FORWARD_")}
    if inherited != expected_recovery:
        fail("running API launcher inherited recovery bindings differ from the signed plist")
    if (os.environ.get("NORN_STARTUP_MODE") != "active"
            or os.environ.get("NORN_SCHEMA_MODE") != "check"):
        fail("running API launcher startup mode differs from the signed plist")


def create(path: Path, document: dict, key: bytes):
    if path.exists() or path.is_symlink():
        fail("repair authorization already exists; inspect it before retrying")
    parent = path.parent
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        fail("repair authorization parent must be owner-only")
    record = dict(document, signature=signature(document, key))
    fd, temporary = tempfile.mkstemp(prefix=".controller-repair.", dir=parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as output:
            output.write(canonical(record))
            output.flush()
            os.fsync(output.fileno())
        os.link(temporary, path)
        os.unlink(temporary)
        directory_fd = os.open(parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def verify_authorization(path: Path, expected: dict, key: bytes) -> None:
    raw = owned(path, "repair authorization")
    record = json_object(raw, "repair authorization")
    if set(record) != FIELDS or record.get("schema") != SCHEMA:
        fail("repair authorization fields are not exact")
    signed = dict(record)
    recorded_signature = signed.pop("signature")
    if not isinstance(recorded_signature, str) or not hmac.compare_digest(recorded_signature, signature(signed, key)):
        fail("repair authorization HMAC does not verify")
    if signed != expected:
        fail("repair authorization is stale or points to another signed controller")


def repair_command(args, action: str) -> list[str]:
    return [str(Path(__file__)), action, "--candidate", args.candidate,
            "--source", args.source, "--transition", args.transition,
            "--journal", str(args.journal), "--controller", str(args.controller)]


def run_recovery(args):
    phase = json_object(owned(args.journal, "transition journal"), "transition journal").get("state")
    if phase == "candidate-postflight-failed":
        result = subprocess.run(repair_command(args, "prepare"), check=False)
        if result.returncode:
            fail("signed candidate postflight repair stopped; retain exact journal and retry")
        phase = json_object(owned(args.journal, "transition journal"), "transition journal").get("state")
        if phase != "candidate-preservation-pending":
            fail("signed candidate repair did not reach preservation-pending")
    if phase == "candidate-preservation-pending":
        result = subprocess.run(repair_command(args, "preserve"), check=False)
        if result.returncode:
            fail("signed candidate preservation stopped; retain exact journal and retry")
    elif phase not in {"candidate-finalize-requested", "candidate-normal-activation-pending",
                       "candidate-normal-active-pending-host-agent", "candidate-normal-active-pending-host-agent-restart",
                       "candidate-promoted"}:
        fail("D-only recovery runner cannot resume this journal phase")
    receipt = args.journal.parent / "preservation-receipt.json"
    result = subprocess.run([str(args.controller), "recovered-forward-finalize",
                             "--transition-id", args.transition, "--preservation-receipt", str(receipt)], check=False)
    if result.returncode:
        fail("signed D finalizer stopped; retain exact journal and retry this runner")
    final_phase = json_object(owned(args.journal, "transition journal"), "transition journal").get("state")
    if final_phase != "candidate-promoted":
        fail("signed D finalizer returned without promoted journal evidence")
    print("recovered-forward candidate promoted with restored original API job")


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("action", choices=("run", "prepare", "verify", "preserve", "launcher-verify", "plist-stage", "plist-normal", "plist-restore"))
    for option in ("authorization", "candidate", "source", "transition", "journal", "controller"):
        result.add_argument("--" + option, required=option != "authorization",
                            type=Path if option in {"authorization", "journal", "controller"} else str)
    return result


def main():
    args = parser().parse_args()
    key = os.environ.get("NORN_AUDIT_SIGNING_KEY", "").encode()
    phases = {
        "run": {"candidate-postflight-failed", "candidate-preservation-pending",
                "candidate-finalize-requested", "candidate-normal-activation-pending",
                "candidate-normal-active-pending-host-agent", "candidate-normal-active-pending-host-agent-restart",
                "candidate-promoted"},
        "prepare": REPAIR_PHASES, "verify": REPAIR_PHASES,
        "plist-stage": {"candidate-postflight-failed"},
        "preserve": {"candidate-preservation-pending"},
        "launcher-verify": {"candidate-postflight-failed", "candidate-preservation-pending",
                            "candidate-finalize-requested", "candidate-normal-activation-pending"},
        "plist-normal": {"candidate-normal-activation-pending"},
        "plist-restore": {"candidate-normal-active-pending-host-agent",
                          "candidate-normal-active-pending-host-agent-restart", "candidate-promoted"},
    }
    journal_phase = json_object(owned(args.journal, "transition journal"), "transition journal").get("state")
    host_restart_phases = {"candidate-normal-active-pending-host-agent-restart", "candidate-promoted"}
    expected, manifest = checked_state(args, key, phases[args.action],
                                       allow_candidate_host=(args.action in {"run", "plist-restore"}
                                                             and journal_phase in host_restart_phases))
    authorization = args.journal.parent / ("controller-repair-" + expected["journalSHA256"]
                                         + "-" + expected["currentReleaseSHA"] + ".json")
    if args.authorization is not None and args.authorization != authorization:
        fail("repair authorization path is not fixed to the selected generation")
    if args.action == "run":
        run_recovery(args)
        return
    if args.action == "plist-stage":
        verify_authorization(authorization, expected, key)
        stage_plist(args.journal, expected, manifest, key)
        print("staged")
        return
    if args.action == "preserve":
        record = read_plist_record(plist_record_path(args.journal), key)
        if any(record.get(k) != expected[k] for k in ("controllerSHA", "candidateSHA", "sourceSHA", "transitionID", "generationID", "evidenceSHA256")):
            fail("candidate preservation lacks the exact signed API plist recovery record")
        preserve_candidate(args.journal, expected, manifest, key)
        print("preserved")
        return
    if args.action == "launcher-verify":
        verify_launcher_runtime(args.journal, expected, manifest, key)
        print("verified")
        return
    if args.action in {"plist-normal", "plist-restore"}:
        advance_plist(args.journal, expected, manifest, key, args.action)
        print("verified")
        return
    if args.action == "prepare":
        if authorization.exists() or authorization.is_symlink():
            # A crash before the first journal advance may retry exactly this
            # authorization. Any changed journal, release, or pointer fails.
            verify_authorization(authorization, expected, key)
        else:
            create(authorization, expected, key)
        env = os.environ.copy()
        env["NORN_RECOVERED_FORWARD_REPAIR_AUTH"] = str(authorization)
        command = [str(args.controller), "recovered-forward-repair-controller", args.candidate,
                   "--source-sha", args.source, "--transition-id", args.transition,
                   "--source-evidence", manifest["sourceEvidencePath"],
                   "--source-evidence-sha256", manifest["sourceEvidenceSHA256"],
                   "--backup-proof", manifest["backupProofPath"],
                   "--backup-artifact", manifest["backupArtifactPath"],
                   "--shadow-receipt", manifest["shadowReceiptPath"]]
        os.execve(args.controller, command, env)
    verify_authorization(authorization, expected, key)
    print("verified")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
