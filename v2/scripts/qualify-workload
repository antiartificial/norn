#!/usr/bin/env bash
#
# Run an isolated workload qualification.  This deliberately has no defaults
# for a Norn application, allocation, host, or cloud environment: callers must
# supply a loopback endpoint and explicitly opt in to each disruptive phase.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: qualify-workload --endpoint URL --isolation-id ID [options]

Exercise a disposable, loopback-only workload and write a machine-readable
qualification report.  It never discovers, selects, or changes a Norn app.

Required:
  --endpoint URL                 Loopback HTTP(S) endpoint for the isolated app
  --isolation-id ID              Lowercase test identifier (for example norn-qual-20260826)

Load and evidence:
  --requests N                   Requests in the baseline load phase (default: 100)
  --concurrency N                Parallel curl workers (default: 10)
  --timeout SECONDS              Per-request connect and response limit (default: 5)
  --output PATH                  Report location (default: ./norn-qualification-ID-TIMESTAMP.json)
  --norn-api URL                 Optional isolated Norn API; captures host metrics/status
  --runtime-command COMMAND      Optional read-only runtime metrics command
  --fail-on-errors               Exit non-zero after writing a report with failed HTTP requests

Controlled workload recovery (all three flags required):
  --allow-workload-disruption
  --kill-command COMMAND         Command to stop only the isolated workload
  --recover-command COMMAND      Command to start only the isolated workload
  --ready-url URL                Loopback readiness endpoint (default: --endpoint)

Controlled API recovery (all flags required):
  --allow-api-restart
  --api-restart-command COMMAND  Restart command for a disposable Norn API only
  --api-ready-url URL            Its loopback health URL
  --isolated-api-confirmation ID Must exactly match --isolation-id

Network degradation through an already-running, local Toxiproxy:
  --toxiproxy-api URL            Loopback Toxiproxy API, normally http://127.0.0.1:8474
  --toxiproxy-listen-url URL     Loopback URL the proxy should listen on
  --toxiproxy-upstream HOST:PORT Loopback upstream for the proxy
  --network-latency-ms N         Fixed downstream latency to inject
  --network-requests N           Requests through the proxy (default: 25)

Safety properties:
  * Workload endpoints, Norn API, Toxiproxy API/listener, and proxy upstream
    must resolve to localhost, 127.0.0.0/8, or ::1.
  * Each workload mutation command must contain the isolation id.
  * API restart is refused unless the explicit confirmation matches the id.
  * Toxiproxy resources are named norn-qualification-ID and removed on exit.

Examples:
  # Baseline only (safe):
  v2/scripts/qualify-workload --endpoint http://127.0.0.1:18080/health \
    --isolation-id norn-qual-local

  # With a disposable Apple Container workload:
  v2/scripts/qualify-workload --endpoint http://127.0.0.1:18080/health \
    --isolation-id norn-qual-local --allow-workload-disruption \
    --kill-command 'container kill norn-qual-local-web' \
    --recover-command 'container start norn-qual-local-web'
USAGE
}

die() { echo "qualify-workload: $*" >&2; exit 2; }
note() { echo "qualify-workload: $*" >&2; }

endpoint=""
isolation_id=""
request_count=100
concurrency=10
timeout_seconds=5
output=""
norn_api=""
runtime_command=""
fail_on_errors=false
allow_workload_disruption=false
kill_command=""
recover_command=""
ready_url=""
allow_api_restart=false
api_restart_command=""
api_ready_url=""
isolated_api_confirmation=""
toxiproxy_api=""
toxiproxy_listen_url=""
toxiproxy_upstream=""
network_latency_ms=""
network_request_count=25

while [ "$#" -gt 0 ]; do
  case "$1" in
    --endpoint) endpoint="${2:-}"; shift 2 ;;
    --isolation-id) isolation_id="${2:-}"; shift 2 ;;
    --requests) request_count="${2:-}"; shift 2 ;;
    --concurrency) concurrency="${2:-}"; shift 2 ;;
    --timeout) timeout_seconds="${2:-}"; shift 2 ;;
    --output) output="${2:-}"; shift 2 ;;
    --norn-api) norn_api="${2:-}"; shift 2 ;;
    --runtime-command) runtime_command="${2:-}"; shift 2 ;;
    --fail-on-errors) fail_on_errors=true; shift ;;
    --allow-workload-disruption) allow_workload_disruption=true; shift ;;
    --kill-command) kill_command="${2:-}"; shift 2 ;;
    --recover-command) recover_command="${2:-}"; shift 2 ;;
    --ready-url) ready_url="${2:-}"; shift 2 ;;
    --allow-api-restart) allow_api_restart=true; shift ;;
    --api-restart-command) api_restart_command="${2:-}"; shift 2 ;;
    --api-ready-url) api_ready_url="${2:-}"; shift 2 ;;
    --isolated-api-confirmation) isolated_api_confirmation="${2:-}"; shift 2 ;;
    --toxiproxy-api) toxiproxy_api="${2:-}"; shift 2 ;;
    --toxiproxy-listen-url) toxiproxy_listen_url="${2:-}"; shift 2 ;;
    --toxiproxy-upstream) toxiproxy_upstream="${2:-}"; shift 2 ;;
    --network-latency-ms) network_latency_ms="${2:-}"; shift 2 ;;
    --network-requests) network_request_count="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

command -v curl >/dev/null 2>&1 || die "curl is required"
command -v python3 >/dev/null 2>&1 || die "python3 is required"

is_positive_integer() { case "$1" in ''|*[!0-9]*) return 1 ;; *) [ "$1" -gt 0 ] ;; esac; }
is_nonnegative_integer() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

[ -n "$endpoint" ] || die "--endpoint is required"
[ -n "$isolation_id" ] || die "--isolation-id is required"
printf '%s' "$isolation_id" | grep -Eq '^norn-qual-[a-z0-9][a-z0-9-]{1,54}$' || die "--isolation-id must begin norn-qual- and contain only lowercase letters, digits, and hyphens"
is_positive_integer "$request_count" || die "--requests must be a positive integer"
is_positive_integer "$concurrency" || die "--concurrency must be a positive integer"
is_positive_integer "$timeout_seconds" || die "--timeout must be a positive integer"
is_positive_integer "$network_request_count" || die "--network-requests must be a positive integer"
[ -z "$network_latency_ms" ] || is_nonnegative_integer "$network_latency_ms" || die "--network-latency-ms must be a non-negative integer"

# Keep the harness physically scoped to local disposable workloads. A host
# Toxiproxy is preferred for this reason: a container gateway is not loopback
# and is not portable across Apple Container, Docker, and Linux runtimes.
assert_loopback_url() {
  local label="$1" value="$2"
  python3 - "$label" "$value" <<'PY'
import ipaddress
import sys
from urllib.parse import urlparse

label, value = sys.argv[1:]
p = urlparse(value)
if p.scheme not in ("http", "https") or not p.hostname:
    raise SystemExit(f"{label} must be an absolute HTTP(S) URL")
host = p.hostname.rstrip(".").lower()
allowed = host == "localhost"
if not allowed:
    try:
        allowed = ipaddress.ip_address(host).is_loopback
    except ValueError:
        allowed = False
if not allowed:
    raise SystemExit(f"{label} must use localhost or loopback (got {host})")
PY
}

assert_loopback_hostport() {
  local label="$1" value="$2"
  python3 - "$label" "$value" <<'PY'
import ipaddress
import sys

label, value = sys.argv[1:]
host, sep, port = value.rpartition(":")
if not sep or not host or not port.isdigit() or not 1 <= int(port) <= 65535:
    raise SystemExit(f"{label} must be HOST:PORT")
host = host.strip("[]").rstrip(".").lower()
allowed = host == "localhost"
if not allowed:
    try:
        allowed = ipaddress.ip_address(host).is_loopback
    except ValueError:
        allowed = False
if not allowed:
    raise SystemExit(f"{label} must use localhost or loopback (got {host})")
PY
}

assert_loopback_url "--endpoint" "$endpoint"
if [ -z "$ready_url" ]; then ready_url="$endpoint"; fi
assert_loopback_url "--ready-url" "$ready_url"
if [ -n "$norn_api" ]; then assert_loopback_url "--norn-api" "$norn_api"; fi

workload_disruption_requested=false
if [ -n "$kill_command$recover_command" ] || [ "$allow_workload_disruption" = true ]; then
  workload_disruption_requested=true
  [ "$allow_workload_disruption" = true ] || die "workload disruption requires --allow-workload-disruption"
  [ -n "$kill_command" ] && [ -n "$recover_command" ] || die "workload disruption requires both --kill-command and --recover-command"
  case "$kill_command" in *"$isolation_id"*) ;; *) die "--kill-command must contain the isolation id" ;; esac
  case "$recover_command" in *"$isolation_id"*) ;; *) die "--recover-command must contain the isolation id" ;; esac
fi

api_restart_requested=false
if [ -n "$api_restart_command$api_ready_url$isolated_api_confirmation" ] || [ "$allow_api_restart" = true ]; then
  api_restart_requested=true
  [ "$allow_api_restart" = true ] || die "API restart requires --allow-api-restart"
  [ -n "$api_restart_command" ] && [ -n "$api_ready_url" ] || die "API restart requires --api-restart-command and --api-ready-url"
  [ "$isolated_api_confirmation" = "$isolation_id" ] || die "--isolated-api-confirmation must exactly match --isolation-id"
  assert_loopback_url "--api-ready-url" "$api_ready_url"
fi

network_requested=false
if [ -n "$toxiproxy_api$toxiproxy_listen_url$toxiproxy_upstream$network_latency_ms" ]; then
  network_requested=true
  [ -n "$toxiproxy_api" ] && [ -n "$toxiproxy_listen_url" ] && [ -n "$toxiproxy_upstream" ] && [ -n "$network_latency_ms" ] || die "network testing requires --toxiproxy-api, --toxiproxy-listen-url, --toxiproxy-upstream, and --network-latency-ms"
  assert_loopback_url "--toxiproxy-api" "$toxiproxy_api"
  assert_loopback_url "--toxiproxy-listen-url" "$toxiproxy_listen_url"
  assert_loopback_hostport "--toxiproxy-upstream" "$toxiproxy_upstream"
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
if [ -z "$output" ]; then output="$(pwd)/norn-qualification-${isolation_id}-${timestamp}.json"; fi
case "$output" in /*) ;; *) output="$(pwd)/$output" ;; esac
mkdir -p "$(dirname "$output")"

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/norn-qualification.XXXXXX")"
baseline_tsv="$tmpdir/baseline.tsv"
network_tsv="$tmpdir/network.tsv"
system_json="$tmpdir/system.json"
norn_metrics_json="$tmpdir/norn-host-metrics.json"
norn_status_json="$tmpdir/norn-host-status.json"
runtime_out="$tmpdir/runtime.out"
operations_json="$tmpdir/operations.json"
proxy_name="norn-qualification-${isolation_id}"
proxy_created=false

cleanup() {
  local status=$?
  if [ "$proxy_created" = true ]; then
    curl -fsS -X DELETE "${toxiproxy_api%/}/proxies/${proxy_name}" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmpdir"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

python3 - "$system_json" <<'PY'
import json, os, platform, sys, time
out = {
  "observedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
  "platform": platform.platform(),
  "machine": platform.machine(),
  "cpuCount": os.cpu_count(),
}
try:
    page = os.sysconf("SC_PAGE_SIZE")
    pages = os.sysconf("SC_PHYS_PAGES")
    out["memoryTotalBytes"] = page * pages
except (AttributeError, ValueError, OSError):
    pass
try:
    with open("/proc/loadavg", encoding="utf-8") as fh:
        out["loadAverage"] = [float(x) for x in fh.read().split()[:3]]
except (OSError, ValueError):
    pass
with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump(out, fh, sort_keys=True)
PY

capture_optional_json() {
  local url="$1" target="$2"
  local auth_config=""
  local control_token="${NORN_API_TOKEN:-${NORN_TOKEN:-}}"
  if [ -n "$control_token" ]; then
    case "$control_token" in
      *$'\n'*|*$'\r'*|*'"'*) die "NORN_API_TOKEN/NORN_TOKEN contains an unsupported character" ;;
    esac
    # Do not put a bearer token in curl's argument list (which can be visible
    # to another local process). The trap removes this 0600 temporary file.
    auth_config="$tmpdir/norn-auth.conf"
    (umask 077; printf 'header = "Authorization: Bearer %s"\n' "$control_token" >"$auth_config")
  fi
  set +e
  if [ -n "$auth_config" ]; then
    curl -sS --config "$auth_config" --connect-timeout "$timeout_seconds" --max-time "$timeout_seconds" -w '\n__NORN_HTTP_STATUS__:%{http_code}\n' "$url" >"$target"
  else
    curl -sS --connect-timeout "$timeout_seconds" --max-time "$timeout_seconds" -w '\n__NORN_HTTP_STATUS__:%{http_code}\n' "$url" >"$target"
  fi
  local rc=$?
  set -e
  printf '%s' "$rc" >"$target.rc"
}

if [ -n "$norn_api" ]; then
  capture_optional_json "${norn_api%/}/api/v1/host/metrics" "$norn_metrics_json"
  capture_optional_json "${norn_api%/}/api/v1/host/status" "$norn_status_json"
fi

if [ -n "$runtime_command" ]; then
  set +e
  NORN_QUALIFICATION_ISOLATION_ID="$isolation_id" bash -c "$runtime_command" >"$runtime_out" 2>&1
  printf '%s' "$?" >"$runtime_out.rc"
  set -e
fi

run_load() {
  local target_url="$1" total="$2" destination="$3" phase="$4"
  local workers="$concurrency"
  if [ "$workers" -gt "$total" ]; then workers="$total"; fi
  : >"$destination"
  local started completed=0 worker
  started="$(python3 -c 'import time; print(time.time())')"
  worker_load() {
    local worker_index="$1" index out rc result seconds code
    out="$tmpdir/${phase}-${worker_index}.tsv"
    : >"$out"
    index="$worker_index"
    while [ "$index" -le "$total" ]; do
      set +e
      result="$(curl -sS -o /dev/null --connect-timeout "$timeout_seconds" --max-time "$timeout_seconds" -w '%{time_total}\t%{http_code}' "$target_url")"
      rc=$?
      set -e
      seconds="${result%%$'\t'*}"
      code="${result#*$'\t'}"
      if [ "$seconds" = "$result" ] || [ -z "$seconds" ]; then seconds="0"; fi
      if [ "$code" = "$result" ] || [ -z "$code" ]; then code="000"; fi
      printf '%s\t%s\t%s\n' "$seconds" "$code" "$rc" >>"$out"
      index=$((index + workers))
    done
  }
  for worker in $(seq 1 "$workers"); do worker_load "$worker" & done
  wait
  for worker in $(seq 1 "$workers"); do cat "$tmpdir/${phase}-${worker}.tsv" >>"$destination"; done
  completed="$(python3 -c 'import time; print(time.time())')"
  python3 - "$started" "$completed" >"$destination.duration" <<'PY'
import sys
print(max(0.000001, float(sys.argv[2]) - float(sys.argv[1])))
PY
}

wait_for_ready() {
  local url="$1" label="$2" remaining=$((timeout_seconds * 6))
  while [ "$remaining" -gt 0 ]; do
    if curl -fsS --connect-timeout 1 --max-time 1 "$url" >/dev/null 2>&1; then return 0; fi
    sleep 1
    remaining=$((remaining - 1))
  done
  note "$label did not return a successful response within $((timeout_seconds * 6)) seconds"
  return 1
}

operations='[]'
append_operation() {
  local name="$1" command="$2" ready="$3" rc started finished
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  set +e
  NORN_QUALIFICATION_ISOLATION_ID="$isolation_id" bash -c "$command" >>"$tmpdir/operations.log" 2>&1
  rc=$?
  set -e
  if [ "$rc" -eq 0 ] && [ -n "$ready" ]; then
    set +e
    wait_for_ready "$ready" "$name"
    rc=$?
    set -e
  fi
  finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  operations="$(python3 - "$operations" "$name" "$started" "$finished" "$rc" <<'PY'
import json, sys
items=json.loads(sys.argv[1])
items.append({"name":sys.argv[2], "startedAt":sys.argv[3], "finishedAt":sys.argv[4], "exitCode":int(sys.argv[5]), "ready": int(sys.argv[5]) == 0})
print(json.dumps(items, separators=(",", ":")))
PY
)"
}

note "capturing baseline HTTP load (${request_count} requests, concurrency ${concurrency})"
run_load "$endpoint" "$request_count" "$baseline_tsv" baseline

if [ "$workload_disruption_requested" = true ]; then
  note "running explicitly approved isolated workload recovery"
  append_operation "workload-kill" "$kill_command" ""
  append_operation "workload-recover" "$recover_command" "$ready_url"
fi

if [ "$api_restart_requested" = true ]; then
  note "running explicitly approved disposable API restart"
  append_operation "isolated-api-restart" "$api_restart_command" "$api_ready_url"
fi
printf '%s\n' "$operations" >"$operations_json"

if [ "$network_requested" = true ]; then
  note "creating local Toxiproxy latency injection"
  proxy_config="$(python3 - "$proxy_name" "$toxiproxy_listen_url" "$toxiproxy_upstream" <<'PY'
import json, sys
from urllib.parse import urlparse
name, listen_url, upstream = sys.argv[1:]
p = urlparse(listen_url)
host = p.hostname
if ":" in host and not host.startswith("["): host = "[" + host + "]"
listen = "%s:%d" % (host, p.port or (443 if p.scheme == "https" else 80))
print(json.dumps({"name": name, "listen": listen, "upstream": upstream}))
PY
)"
  curl -fsS -X DELETE "${toxiproxy_api%/}/proxies/${proxy_name}" >/dev/null 2>&1 || true
  curl -fsS -X POST -H 'Content-Type: application/json' --data "$proxy_config" "${toxiproxy_api%/}/proxies" >/dev/null
  proxy_created=true
  toxic_config="$(python3 - "$network_latency_ms" <<'PY'
import json, sys
print(json.dumps({"name":"norn-qualification-latency", "type":"latency", "stream":"downstream", "toxicity":1.0, "attributes":{"latency":int(sys.argv[1]), "jitter":0}}))
PY
)"
  curl -fsS -X POST -H 'Content-Type: application/json' --data "$toxic_config" "${toxiproxy_api%/}/proxies/${proxy_name}/toxics" >/dev/null
  run_load "$toxiproxy_listen_url" "$network_request_count" "$network_tsv" network
fi

python3 - "$output" "$isolation_id" "$endpoint" "$baseline_tsv" "$system_json" "$norn_metrics_json" "$norn_status_json" "$runtime_out" "$operations_json" "$network_tsv" "$network_latency_ms" <<'PY'
import collections, json, os, sys, time

(output, isolation_id, endpoint, baseline_path, system_path, norn_metrics_path,
 norn_status_path, runtime_path, operations_path, network_path, latency) = sys.argv[1:]

def load_json(path):
    if not os.path.exists(path): return None
    try:
        with open(path, encoding="utf-8") as fh: return json.load(fh)
    except (OSError, json.JSONDecodeError): return None

def capture(path):
    if not os.path.exists(path): return None
    rc_path = path + ".rc"
    try:
        raw = open(path, encoding="utf-8").read()
    except OSError:
        return None
    body, marker, status = raw.rpartition("\n__NORN_HTTP_STATUS__:")
    value = None
    try: value = json.loads(body) if body.strip() else None
    except json.JSONDecodeError: value = {"raw": body[:8192]}
    try: rc = int(open(rc_path, encoding="utf-8").read().strip())
    except (OSError, ValueError): rc = None
    return {"httpStatus": status.strip() if marker else None, "exitCode": rc, "body": value}

def runtime_capture(path):
    if not os.path.exists(path): return None
    try: raw = open(path, encoding="utf-8").read()
    except OSError: return None
    try: value = json.loads(raw)
    except json.JSONDecodeError: value = {"raw": raw[:16384]}
    try: rc = int(open(path + ".rc", encoding="utf-8").read().strip())
    except (OSError, ValueError): rc = None
    return {"exitCode": rc, "output": value}

def summary(path):
    if not os.path.exists(path): return None
    rows=[]
    for line in open(path, encoding="utf-8"):
        try:
            seconds, code, rc = line.rstrip("\n").split("\t")
            rows.append((float(seconds), code, int(rc)))
        except ValueError:
            continue
    try: duration=max(0.000001, float(open(path+".duration", encoding="utf-8").read().strip()))
    except (OSError, ValueError): duration=0.000001
    latencies=sorted(seconds * 1000 for seconds, _, _ in rows)
    def percentile(p):
        if not latencies: return None
        index=max(0, min(len(latencies)-1, int(__import__("math").ceil(p*len(latencies))-1)))
        return round(latencies[index], 3)
    successful=[r for r in rows if r[2] == 0 and r[1].isdigit() and 200 <= int(r[1]) < 400]
    statuses=collections.Counter(code for _, code, _ in rows)
    return {
        "requests": len(rows), "successful": len(successful), "errors": len(rows)-len(successful),
        "durationSeconds": round(duration, 6), "throughputRps": round(len(rows)/duration, 3),
        "latencyMilliseconds": {"p50": percentile(.50), "p95": percentile(.95), "p99": percentile(.99), "max": round(latencies[-1], 3) if latencies else None},
        "httpStatusCounts": dict(sorted(statuses.items())),
    }

report = {
    "schemaVersion": "norn.workload-qualification/v1",
    "generatedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "isolation": {"id": isolation_id, "endpoint": endpoint, "loopbackOnly": True},
    "system": load_json(system_path),
    "norn": {"hostMetrics": capture(norn_metrics_path), "hostStatus": capture(norn_status_path)},
    "runtime": runtime_capture(runtime_path),
    "baseline": summary(baseline_path),
    "operations": load_json(operations_path) or [],
    "network": {"latencyInjectedMilliseconds": int(latency) if latency else None, "result": summary(network_path)},
}
with open(output, "w", encoding="utf-8") as fh:
    json.dump(report, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY

baseline_errors="$(python3 - "$baseline_tsv" <<'PY'
import sys
errors=0
for line in open(sys.argv[1], encoding="utf-8"):
    try:
        _, code, rc=line.rstrip("\n").split("\t")
        if int(rc) != 0 or not code.isdigit() or not 200 <= int(code) < 400: errors += 1
    except ValueError: errors += 1
print(errors)
PY
)"
note "report written to $output"
if [ "$fail_on_errors" = true ] && [ "$baseline_errors" -gt 0 ]; then
  note "baseline contained $baseline_errors failed request(s)"
  exit 1
fi
