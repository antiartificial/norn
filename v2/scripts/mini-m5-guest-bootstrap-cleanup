#!/usr/bin/env python3
"""Remove one-use bootstrap admin access inside the disposable M5 guest."""

from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import pwd
import re
import stat
import subprocess
import sys
import tempfile


STATE = Path("/var/db/norn-m5-window")
STARTED = STATE / "bootstrap-cleanup-started.json"
FINISHED = STATE / "bootstrap-cleanup-finished.json"
ADMIN = "admin"
RUNNER = "norn-m5-isolated-01"
OWNER_PUBLIC_KEY_SHA256 = "ba038c8f9e5d43ff4b5c03ffb1ea7ca1e4e9127c98b5810ed0c6a5dbc1c67eeb"
INTENT_VERIFIER = "/Library/PrivilegedHelperTools/norn-mini-m5-intent-verify"
INTENT_VERIFIER_SHA256 = "aaa6ceea2a7c5b091ce33467ad13ece3b096bb4fcb3aa50dabb11b3e650cf1a5"


def command(*args, timeout=30, input=None):
    return subprocess.run(args, input=input, check=True, capture_output=True,
                          text=True, timeout=timeout).stdout


def durable(path, value):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(value, stream, sort_keys=True, separators=(",", ":"))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())


def guest_guard(run_id):
    if (os.geteuid() != 0 or platform.system() != "Darwin" or platform.machine() != "arm64" or
            not re.fullmatch(r"[0-9]{1,20}", run_id) or
            not re.fullmatch(r"VirtualMac[0-9]+,[0-9]+", command("/usr/sbin/sysctl", "-n", "hw.model").strip()) or
            command("/usr/bin/sw_vers", "-productVersion").strip() != "26.6.2"):
        raise ValueError("bootstrap cleanup requires pinned disposable guest root")
    info = STATE.lstat()
    if info.st_uid != 0 or not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("guest cleanup journal is unsafe")


def private_copy(source, target, maximum):
    fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > maximum:
            raise ValueError("M5 cleanup input is unsafe")
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), "wb") as output:
            with os.fdopen(os.dup(fd), "rb") as stream:
                data = stream.read(maximum + 1)
            if len(data) > maximum:
                raise ValueError("M5 cleanup input is oversized")
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
    finally:
        os.close(fd)


def signed_intent(intent_path, signature_path, public_key_path, run_id, source_sha):
    public_key = Path(public_key_path)
    if hashlib.sha256(public_key.read_bytes()).hexdigest() != OWNER_PUBLIC_KEY_SHA256:
        raise ValueError("unreviewed M5 cleanup owner key")
    verifier_info = os.lstat(INTENT_VERIFIER)
    if (verifier_info.st_uid != 0 or not stat.S_ISREG(verifier_info.st_mode) or
            verifier_info.st_mode & 0o022 or
            hashlib.sha256(Path(INTENT_VERIFIER).read_bytes()).hexdigest() != INTENT_VERIFIER_SHA256):
        raise ValueError("unreviewed M5 intent verifier")
    subprocess.run((INTENT_VERIFIER, str(public_key), str(intent_path), str(signature_path)),
                   check=True, capture_output=True, timeout=10)
    raw = Path(intent_path).read_bytes()
    intent = json.loads(raw)
    if (set(intent) != {"schema", "runId", "sourceSHA", "runnerName", "expiresAt"} or
            intent["schema"] != "norn.m5-guest-bootstrap-cleanup-intent/v1" or
            intent["runId"] != run_id or intent["sourceSHA"] != source_sha or
            intent["runnerName"] != RUNNER or not re.fullmatch(r"[0-9a-f]{40}", source_sha)):
        raise ValueError("M5 cleanup intent differs from protected run")
    expiry = datetime.fromisoformat(intent["expiresAt"].replace("Z", "+00:00"))
    if expiry.tzinfo != timezone.utc:
        raise ValueError("M5 cleanup intent expiry is unsafe")
    digest = hashlib.sha256(raw).hexdigest()
    if expiry <= datetime.now(timezone.utc):
        if not STARTED.is_file():
            raise ValueError("M5 cleanup intent expired")
        started = json.loads(STARTED.read_bytes())
        if (started.get("schema") != "norn.m5-guest-bootstrap-cleanup-started/v1" or
                started.get("runId") != run_id or started.get("intentSHA256") != digest):
            raise ValueError("expired M5 cleanup intent has no matching started effect")
    return digest


def cleanup(run_id, intent_sha):
    guest_guard(run_id)
    if not (STATE / "account-handoff-finished.json").is_file() or not (STATE / "runner-install-started.json").is_file():
        raise ValueError("guest handoff or runner install is incomplete")
    info = STATE.lstat()
    if info.st_uid != 0 or not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("guest cleanup journal is unsafe")
    if FINISHED.exists():
        raise ValueError("guest bootstrap cleanup already finished")
    prior = STARTED.exists()
    if prior:
        started = json.loads(STARTED.read_bytes())
        if (started.get("schema") != "norn.m5-guest-bootstrap-cleanup-started/v1" or
                started.get("runId") != run_id or started.get("intentSHA256") != intent_sha):
            raise ValueError("prior guest bootstrap cleanup differs")
    try:
        admin = pwd.getpwnam(ADMIN)
    except KeyError:
        admin = None
    home = Path("/Users/admin")
    authorized = home / ".ssh/authorized_keys"
    if not prior:
        if admin is None or admin.pw_uid == 0 or admin.pw_dir != str(home):
            raise ValueError("guest bootstrap admin account differs")
        info = home.lstat()
        key_info = authorized.lstat()
        if (info.st_uid != admin.pw_uid or not stat.S_ISDIR(info.st_mode) or
                key_info.st_uid != admin.pw_uid or not stat.S_ISREG(key_info.st_mode) or
                key_info.st_nlink != 1):
            raise ValueError("guest bootstrap SSH authorization is unsafe")
        durable(STARTED, {"schema": "norn.m5-guest-bootstrap-cleanup-started/v1", "runId": run_id,
                          "runnerName": RUNNER, "intentSHA256": intent_sha,
                          "authorizedKeySHA256": hashlib.sha256(authorized.read_bytes()).hexdigest()})
    if authorized.exists() or authorized.is_symlink():
        info = authorized.lstat()
        if admin is None or info.st_uid != admin.pw_uid or not stat.S_ISREG(info.st_mode):
            raise ValueError("guest bootstrap SSH authorization changed")
        authorized.unlink()
    if os.path.lexists(authorized):
        raise ValueError("guest bootstrap SSH key remains")
    command("/usr/sbin/systemsetup", "-setremotelogin", "off", input="y\n", timeout=30)
    subprocess.run(("/bin/launchctl", "disable", "system/com.openssh.sshd"),
                   check=True, capture_output=True, timeout=10)
    subprocess.run(("/bin/launchctl", "bootout", "system/com.openssh.sshd"),
                   capture_output=True, timeout=10)
    if "off" not in command("/usr/sbin/systemsetup", "-getremotelogin").lower():
        raise ValueError("guest Remote Login remains enabled")
    listener = subprocess.run(("/usr/sbin/lsof", "-nP", "-iTCP:22", "-sTCP:LISTEN"),
                              capture_output=True, text=True, timeout=10)
    if listener.returncode not in (0, 1) or listener.stdout.strip():
        raise ValueError("guest SSH listener remains")
    if admin is not None:
        command("/usr/sbin/sysadminctl", "-deleteUser", ADMIN, timeout=60)
    try:
        pwd.getpwnam(ADMIN)
    except KeyError:
        pass
    else:
        raise ValueError("bootstrap admin account remains")
    if home.exists() or home.is_symlink():
        raise ValueError("bootstrap admin home remains")
    receipt = {"schema": "norn.m5-guest-bootstrap-cleanup-finished/v1", "runId": run_id,
               "runnerName": RUNNER, "adminAccountAbsent": True, "adminHomeAbsent": True,
               "remoteLogin": "off", "sshListenerAbsent": True}
    durable(FINISHED, receipt)
    return receipt


def main():
    if len(sys.argv) != 7 or sys.argv[1] != RUNNER:
        raise SystemExit("usage: cleanup norn-m5-isolated-01 <run-id> <source-sha> <intent> <signature> <public-key>")
    run_id, source_sha, intent_path, signature_path, public_key_path = sys.argv[2:]
    guest_guard(run_id)
    with tempfile.TemporaryDirectory(prefix="cleanup-input-", dir=STATE) as private:
        private = Path(private)
        for source, name, maximum in ((intent_path, "intent", 4096),
                                      (signature_path, "signature", 512),
                                      (public_key_path, "owner-public-key", 4096)):
            private_copy(source, private / name, maximum)
        intent_sha = signed_intent(private / "intent", private / "signature",
                                  private / "owner-public-key", run_id, source_sha)
    print(json.dumps(cleanup(run_id, intent_sha), sort_keys=True))


if __name__ == "__main__":
    main()
